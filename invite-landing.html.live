<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Schnupperstunde — Socialy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #FBF5EA;
  --surface: #F4E9D1;
  --surface-alt: #EBDCC3;
  --ink: #1F1D18;
  --ink-muted: #67625A;
  --primary: #D96C45;
  --primary-hover: #C45A35;
  --primary-soft: #F7B79C;
  --accent: #A8B6A3;
  --accent-deep: #6A7863;
  --border: rgba(31, 29, 24, 0.08);
  --border-strong: rgba(31, 29, 24, 0.14);
  --shadow: 0 4px 16px rgba(31, 29, 24, 0.06);
  --shadow-lg: 0 12px 40px rgba(31, 29, 24, 0.12);
  --font-body: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
  --font-accent: "Instrument Serif", ui-serif, Georgia, serif;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-pill: 999px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { background: var(--bg); color: var(--ink); font-family: var(--font-body); -webkit-font-smoothing: antialiased; line-height: 1.5; min-height: 100vh; }
em { font-family: var(--font-accent); font-style: italic; font-weight: 400; }

.topbar {
  padding: 18px 24px;
  background: rgba(251, 245, 234, 0.9);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}
.topbar-inner {
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 12px;
}
.brand-logo {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 18px;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.brand-logo em { color: var(--primary); font-weight: 500; font-size: 19px; }

.page {
  max-width: 560px;
  margin: 0 auto;
  padding: 36px 24px 60px;
}

/* Hero */
.invite-kicker {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--accent-deep);
  font-weight: 600;
  margin-bottom: 14px;
}
.invite-title {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 40px;
  line-height: 1.08;
  color: var(--ink);
  letter-spacing: -0.02em;
  margin-bottom: 16px;
}
.invite-title em {
  font-weight: 400;
  font-size: 42px;
  color: var(--primary);
}
.invite-lead {
  font-size: 16px;
  color: var(--ink-muted);
  line-height: 1.6;
  margin-bottom: 26px;
}

/* Course Card */
.course-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
}
.course-card-head {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}
.course-emoji {
  width: 44px; height: 44px;
  background: var(--surface);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px;
}
.course-info h2 {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 19px;
  color: var(--ink);
  margin-bottom: 2px;
  letter-spacing: -0.01em;
}
.course-info-sub {
  font-size: 13px;
  color: var(--ink-muted);
}
.course-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 18px;
  font-size: 13px;
}
.course-meta-row { display: flex; justify-content: space-between; }
.course-meta-label { color: var(--ink-muted); }
.course-meta-value { color: var(--ink); font-weight: 500; }

/* Benefits */
.benefits {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
  margin-bottom: 26px;
}
.benefit {
  text-align: center;
  padding: 14px 8px;
  background: var(--surface);
  border-radius: var(--radius-md);
}
.benefit-icon {
  width: 28px; height: 28px;
  background: #fff;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
  color: var(--primary);
}
.benefit-label {
  font-size: 11.5px;
  color: var(--ink);
  font-weight: 500;
  line-height: 1.3;
}

/* Form */
.form-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow);
}
.form-head {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 18px;
  color: var(--ink);
  margin-bottom: 4px;
  letter-spacing: -0.01em;
}
.form-head em { color: var(--primary); font-weight: 400; font-size: 19px; }
.form-sub {
  font-size: 13px;
  color: var(--ink-muted);
  margin-bottom: 20px;
}

.field { margin-bottom: 14px; }
.field-full { grid-column: span 2; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
.field label {
  display: block;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-muted);
  font-weight: 600;
  margin-bottom: 5px;
}
.field input, .field select {
  width: 100%;
  font-family: var(--font-body);
  font-size: 14.5px;
  color: var(--ink);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  transition: border-color 180ms, box-shadow 180ms;
}
.field input:focus, .field select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(217,108,69,0.15);
}

.btn-cta {
  width: 100%;
  background: var(--ink);
  color: var(--bg);
  border: none;
  border-radius: var(--radius-pill);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 15px;
  padding: 14px;
  cursor: pointer;
  margin-top: 10px;
  transition: background 180ms, transform 140ms;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.btn-cta:hover { background: var(--primary); }
.btn-cta:disabled { background: var(--accent); cursor: not-allowed; opacity: 0.6; }

.form-footer {
  margin-top: 16px;
  font-size: 11.5px;
  color: var(--ink-muted);
  text-align: center;
  line-height: 1.5;
}

/* States */
.state {
  padding: 28px 24px;
  text-align: center;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
}
.state-icon {
  width: 54px; height: 54px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}
.state.success .state-icon { background: var(--accent); color: #fff; }
.state.error .state-icon { background: var(--primary-soft); color: var(--primary-hover); }
.state-title {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 24px;
  color: var(--ink);
  margin-bottom: 8px;
  letter-spacing: -0.01em;
}
.state-title em { color: var(--primary); }
.state-text {
  font-size: 14px;
  color: var(--ink-muted);
  line-height: 1.6;
  max-width: 380px;
  margin: 0 auto;
}

/* Coupon-Display (nach Schnupper-Buchung) */
.coupon-gift {
  background: linear-gradient(135deg, #fff 0%, var(--surface) 100%);
  border: 1px dashed var(--primary);
  border-radius: var(--radius-md);
  padding: 18px 20px;
  margin-top: 20px;
  text-align: left;
}
.coupon-gift-head {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.coupon-gift-title {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 17px;
  color: var(--ink);
  margin-bottom: 3px;
}
.coupon-gift-title em { color: var(--primary); font-weight: 500; font-size: 18px; }
.coupon-gift-sub {
  font-size: 12.5px;
  color: var(--ink-muted);
  line-height: 1.5;
  margin-bottom: 12px;
}
.coupon-code-box {
  display: flex;
  align-items: stretch;
  gap: 0;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.coupon-code-value {
  flex: 1;
  padding: 10px 14px;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.05em;
  text-align: center;
}
.coupon-copy-btn {
  background: var(--ink);
  color: var(--bg);
  border: none;
  padding: 0 16px;
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-body);
  cursor: pointer;
  transition: background 140ms;
}
.coupon-copy-btn:hover { background: var(--primary); }
.coupon-copy-btn.copied { background: var(--accent-deep); }

.footer {
  margin-top: 26px;
  text-align: center;
  font-size: 11px;
  color: var(--ink-muted);
  letter-spacing: 0.04em;
}
.footer a { color: var(--ink-muted); text-decoration: none; }
.footer strong { color: var(--ink); font-weight: 500; }

@media (max-width: 480px) {
  .invite-title { font-size: 32px; }
  .invite-title em { font-size: 34px; }
  .benefits { grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
  .benefit { padding: 10px 4px; }
  .benefit-label { font-size: 10.5px; }
  .course-meta { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
    <div class="brand-logo">Socialy<em>.</em></div>
  </div>
</div>

<div class="page" id="page">
  <div id="loading" style="text-align:center;padding:60px 0;color:var(--ink-muted);">Einladung wird geladen…</div>
</div>

<div class="footer" id="footer" style="display:none;">
  <strong>Powered by Urban Kids Club</strong> &middot; <a href="#">Datenschutz</a> &middot; <a href="#">Impressum</a>
</div>

<script>
// Course lookup (demo — produktiv aus API)
const COURSES = {
  'pekip-basis':        { emoji: '👶', title: 'PEKiP Basis', sub: 'Eltern-Kind · 0-6 Monate', day: 'Dienstags', time: '09:30 – 10:45 Uhr', room: 'Raum 2', duration: '75 Minuten' },
  'eltern-kind-turnen': { emoji: '🤸', title: 'Eltern-Kind-Turnen', sub: 'Bewegung · 1-3 Jahre', day: 'Mittwochs', time: '10:00 – 11:00 Uhr', room: 'Raum 1', duration: '60 Minuten' },
  'musikgarten-junior': { emoji: '🎵', title: 'Musikgarten Junior', sub: 'Musik · 2-4 Jahre', day: 'Donnerstags', time: '09:30 – 10:30 Uhr', room: 'Raum 2', duration: '60 Minuten' },
  'babymassage':        { emoji: '🌿', title: 'Babymassage Kompakt', sub: 'Eltern-Kind · 0-3 Monate', day: 'Freitags', time: '11:00 – 12:00 Uhr', room: 'Raum 3', duration: '60 Minuten' },
  'zwergerl-yoga':      { emoji: '🧘', title: 'Zwergerl-Yoga', sub: 'Bewegung · 3-5 Jahre', day: 'Samstags', time: '10:00 – 11:00 Uhr', room: 'Raum 1', duration: '60 Minuten' },
  'kreativ-werkstatt':  { emoji: '🎨', title: 'Kreativ-Werkstatt', sub: 'Kreativ · 4-6 Jahre', day: 'Montags', time: '15:00 – 16:30 Uhr', room: 'Raum 1', duration: '90 Minuten' },
};

const code = (location.pathname.match(/\/invite\/([a-z0-9]+)/) || [])[1];

function renderError(title, text) {
  document.getElementById('page').innerHTML = `
    <div class="state error">
      <div class="state-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
      <div class="state-title">${title}</div>
      <div class="state-text">${text}</div>
    </div>
  `;
  document.getElementById('footer').style.display = '';
}

function renderSuccess(childName, coupon) {
  let couponHtml = '';
  if (coupon && coupon.code && !coupon.used) {
    const validUntil = coupon.validUntil ? new Date(coupon.validUntil).toLocaleDateString('de-DE', { day: '2-digit', month: 'short' }) : '';
    couponHtml = `
      <div class="coupon-gift">
        <div class="coupon-gift-head">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
          Dein Geschenk
        </div>
        <div class="coupon-gift-title">${coupon.percentOff}% Rabatt auf deine <em>erste Buchung</em>.</div>
        <div class="coupon-gift-sub">
          Wenn euch die Stunde gefällt und ihr richtig dabei sein wollt — mit diesem Code bekommt ihr ${coupon.percentOff}% auf den ersten Block${coupon.maxEuroOff ? ` (max. ${coupon.maxEuroOff} € Rabatt)` : ''}${validUntil ? `. Gültig bis ${validUntil}` : ''}.
        </div>
        <div class="coupon-code-box">
          <div class="coupon-code-value" id="coupon-code">${coupon.code}</div>
          <button class="coupon-copy-btn" id="coupon-copy-btn" onclick="copyCoupon()">Kopieren</button>
        </div>
      </div>
    `;
  }

  document.getElementById('page').innerHTML = `
    <div class="state success">
      <div class="state-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
      <div class="state-title">Reserviert<em>!</em></div>
      <div class="state-text">
        Wir haben dir einen Platz reserviert&nbsp;— ${childName} ist dabei.<br><br>
        Du bekommst in den nächsten Minuten eine E-Mail mit allen Details, Anfahrt und was ihr mitbringen solltet.
        <br><br>
        <strong>Bis bald&nbsp;💛</strong>
      </div>
      ${couponHtml}
    </div>
  `;
  document.getElementById('footer').style.display = '';
}

function copyCoupon() {
  const code = document.getElementById('coupon-code').textContent;
  const btn = document.getElementById('coupon-copy-btn');
  navigator.clipboard.writeText(code).then(() => {
    btn.textContent = 'Kopiert ✓';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'Kopieren'; btn.classList.remove('copied'); }, 2000);
  });
}

function renderInvite(invite) {
  // Prefer dynamic activity-data from API; fall back to legacy hardcoded COURSES.
  const dayLabels = { MO: 'Montags', TU: 'Dienstags', WE: 'Mittwochs', TH: 'Donnerstags', FR: 'Freitags', SA: 'Samstags', SU: 'Sonntags' };
  const categoryEmoji = { tanz: '💃', yoga: '🧘', musik: '🎵', bewegung: '🤸', kreativ: '🎨', 'eltern-kind': '👶', babymassage: '🌿', sport: '⚽' };
  let course;
  if (invite.activity) {
    const a = invite.activity;
    const slot = (a.schedule && Array.isArray(a.schedule.slots) && a.schedule.slots[0]) || {};
    const dayKey = slot.day || '';
    const timeStr = slot.startTime ? `${slot.startTime} – ${slot.endTime || '?'} Uhr` : 'Nach Absprache';
    const ageStr = (a.ageMin != null && a.ageMax != null)
      ? `${a.ageMin}-${a.ageMax} ${a.ageUnit === 'months' ? 'Monate' : 'Jahre'}`
      : '';
    course = {
      emoji: categoryEmoji[a.category] || '✨',
      title: a.title || 'Kurs',
      sub: ((a.category ? (a.category.charAt(0).toUpperCase() + a.category.slice(1)) : 'Kurs') + (ageStr ? ' · ' + ageStr : '')),
      day: dayLabels[dayKey] || (dayKey || 'Nach Absprache'),
      time: timeStr,
      room: invite.provider && invite.provider.city ? invite.provider.city : '—',
      duration: a.duration ? `${a.duration} Minuten` : '—',
    };
  } else {
    course = COURSES[invite.activityId] || {
      emoji: '✨',
      title: 'Kurs-Einladung',
      sub: 'Schnupperstunde',
      day: 'Nach Absprache',
      time: 'Nach Absprache',
      room: '—',
      duration: '—',
    };
  }

  document.getElementById('page').innerHTML = `
    <div class="invite-kicker">Persönliche Einladung</div>
    <h1 class="invite-title">Schnupper mal <em>rein</em>.</h1>
    <p class="invite-lead">
      Jemand, der dich kennt, hat gedacht: <em>Das könnte etwas für euch sein.</em> Die erste Stunde ist kostenlos, unverbindlich, und du entscheidest danach in Ruhe.
    </p>

    <div class="course-card">
      <div class="course-card-head">
        <div class="course-emoji">${course.emoji}</div>
        <div class="course-info">
          <h2>${course.title}</h2>
          <div class="course-info-sub">${course.sub}</div>
        </div>
      </div>
      <div class="course-meta">
        <div class="course-meta-row"><span class="course-meta-label">Wann</span><span class="course-meta-value">${course.day}</span></div>
        <div class="course-meta-row"><span class="course-meta-label">Uhrzeit</span><span class="course-meta-value">${course.time}</span></div>
        <div class="course-meta-row"><span class="course-meta-label">Raum</span><span class="course-meta-value">${course.room}</span></div>
        <div class="course-meta-row"><span class="course-meta-label">Dauer</span><span class="course-meta-value">${course.duration}</span></div>
      </div>
    </div>

    <div class="benefits">
      <div class="benefit">
        <div class="benefit-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
        <div class="benefit-label">Komplett<br>kostenlos</div>
      </div>
      <div class="benefit">
        <div class="benefit-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <div class="benefit-label">Keine<br>Verpflichtung</div>
      </div>
      <div class="benefit">
        <div class="benefit-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/></svg></div>
        <div class="benefit-label">Absage jederzeit<br>möglich</div>
      </div>
    </div>

    <div class="form-card">
      <div class="form-head">Platz <em>reservieren</em></div>
      <div class="form-sub">Dauert eine Minute. Keine Kreditkarte nötig.</div>

      <div class="field-row">
        <div class="field">
          <label>Dein Name</label>
          <input type="text" id="parent-name" placeholder="z.B. Lena" required>
        </div>
        <div class="field">
          <label>E-Mail</label>
          <input type="email" id="parent-email" placeholder="lena@mail.de" required>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label>Kind-Name</label>
          <input type="text" id="child-name" placeholder="z.B. Mia" required>
        </div>
        <div class="field">
          <label>Geboren</label>
          <input type="number" id="child-year" min="2018" max="2026" placeholder="2024">
        </div>
      </div>

      <div class="field">
        <label>Wunsch-Termin</label>
        <select id="date-slot" required>
          <option value="">Wann passt es dir?</option>
          <option value="2026-04-28|09:30">Di, 28. Apr · 09:30</option>
          <option value="2026-05-05|09:30">Di, 05. Mai · 09:30</option>
          <option value="2026-05-12|09:30">Di, 12. Mai · 09:30</option>
        </select>
      </div>

      <button class="btn-cta" id="submit-btn" onclick="bookTrial()">
        Jetzt kostenlos schnuppern →
      </button>

      <div class="form-footer">
        Mit dem Reservieren stimmst du unseren <a href="#" style="color:var(--primary);">Teilnahmebedingungen</a> zu. Kein Newsletter, keine Werbemails.
      </div>
    </div>
  `;
  document.getElementById('footer').style.display = '';
}

let __coupon = null; // Cache aus resolve()

async function bookTrial() {
  const name = document.getElementById('parent-name').value.trim();
  const email = document.getElementById('parent-email').value.trim();
  const childName = document.getElementById('child-name').value.trim();
  const childYear = document.getElementById('child-year').value;
  const slot = document.getElementById('date-slot').value;
  const btn = document.getElementById('submit-btn');

  if (!name || !email || !childName || !slot) {
    alert('Bitte fülle alle Pflichtfelder aus.');
    return;
  }

  const [date, time] = slot.split('|');
  btn.disabled = true;
  btn.innerHTML = 'Reserviere…';

  try {
    const res = await fetch(`/api/public/share-invites/${code}/book-trial`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        inviteeParentId: 'guest-' + Math.random().toString(36).slice(2, 10),
        childName,
        childBirthYear: childYear ? parseInt(childYear, 10) : undefined,
        scheduledDate: date,
        scheduledTime: time,
        guestName: name,
        guestEmail: email,
      }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Fehler');
    renderSuccess(childName, __coupon);
  } catch (err) {
    btn.disabled = false;
    btn.innerHTML = 'Jetzt kostenlos schnuppern →';
    alert('Das hat nicht geklappt: ' + err.message);
  }
}

async function init() {
  if (!code) {
    renderError('Kein Einladungs-Code.', 'Bitte nutze den vollständigen Link, den du erhalten hast.');
    return;
  }

  try {
    const res = await fetch(`/api/public/share-invites/${code}`);
    const json = await res.json();
    if (!res.ok) {
      if (res.status === 404) {
        renderError('Einladung nicht gefunden.', 'Der Link ist möglicherweise falsch oder zurückgezogen worden.');
      } else {
        renderError('Einladung nicht verfügbar.', json.error || 'Unbekannter Fehler');
      }
      return;
    }
    const invite = json.data;
    __coupon = invite.coupon;  // cache for renderSuccess
    if (invite.expired) {
      renderError('Einladung abgelaufen.', 'Diese Einladung ist leider nicht mehr gültig. Frage dein:e Freund:in nach einem neuen Link.');
      return;
    }
    if (invite.alreadyUsed) {
      renderError('Schon eingelöst.', 'Diese Einladung wurde bereits genutzt. Jede Einladung gilt nur einmal.');
      return;
    }
    renderInvite(invite);
  } catch (err) {
    renderError('Verbindungsfehler.', 'Versuche es in ein paar Minuten erneut.');
  }
}

init();
</script>
<script src="/assets/socialy-polish.js"></script>
</body>
</html>
