      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "Ordner existiert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "jsCode": "// Ordner wurde gefunden - ID durchreichen\nconst folderResult = $input.first().json;\nconst verarbeitet = $('Antwort verarbeiten').first().json;\n\nreturn [{\n  json: {\n    ...verarbeitet,\n    ziel_ordner_id: folderResult.id,\n    ziel_ordner_name: folderResult.name\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
