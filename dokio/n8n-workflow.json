        },
        "text": "Analysiere dieses Dokument präzise. Antworte NUR mit validem JSON ohne Markdown-Backticks:\n{\n  \"dokumenttyp\": \"Rechnung|Vertrag|Kontoauszug|Behoerdenpost|Mahnung|Bescheid|Sonstiges\",\n  \"datum\": \"YYYY-MM-DD oder null\",\n  \"absender\": \"Vollständiger Name des Absenders\",\n  \"absender_kurz\": \"Kurzer eindeutiger Name fuer Ordner z.B. Finanzamt, AOK, IHK, Telekom - maximal 30 Zeichen, keine Sonderzeichen ausser Bindestrich\",\n  \"empfaenger\": \"Name des Empfaengers\",\n  \"betrag\": \"Betrag als Zahl in EUR oder null\",\n  \"faelligkeit\": \"YYYY-MM-DD oder null\",\n  \"prioritaet\": \"hoch|mittel|niedrig\",\n  \"zusammenfassung\": \"Kurze praezise Zusammenfassung auf Deutsch in einem Satz\",\n  \"aktion_empfohlen\": \"Konkrete naechste Aktion\"\n}",
        "inputType": "binary",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        -3168,
        688
      ],
      "id": "8254c104-3f6d-4a9f-a6af-6af147881637",
      "name": "Analyze document",
      "credentials": {
        "anthropicApi": {
          "id": "bUDD64wRwbXpXKJu",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || $input.first().json.content?.[0]?.text || '';\nlet analysis;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  analysis = JSON.parse(cleaned);\n} catch(e) {\n  analysis = { dokumenttyp: 'Sonstiges', datum: null, absender: 'Unbekannt', absender_kurz: 'Sonstiges', empfaenger: '', betrag: null, faelligkeit: null, prioritaet: 'niedrig', zusammenfassung: 'Konnte nicht analysiert werden', aktion_empfohlen: 'Manuell pruefen' };\n}\nconst trigger = $('Google Drive – Neue PDF in _inbox').first().json;\nconst fileId = trigger.id;\nconst originalName = trigger.name || 'Dokument.pdf';\nconst heute = new Date().toISOString().split('T')[0];\nconst docDatum = analysis.datum || heute;\nconst datumFormatiert = docDatum.substring(0, 10);\nlet absenderKurz = (analysis.absender_kurz || 'Sonstiges').replace(/[^a-zA-Z0-9äöüÄÖÜß\\s\\-]/g, '').trim().substring(0, 30);\nif (!absenderKurz) absenderKurz = 'Sonstiges';\nconst betrag = analysis.betrag ? `_${String(analysis.betrag).replace('.', '-')}EUR` : '';\nconst typ = (analysis.dokumenttyp || 'Dokument').replace(/[^a-zA-Z0-9äöüÄÖÜß]/g, '-');\nconst neuerName = `${datumFormatiert}_${typ}${betrag}.pdf`;\nreturn [{ json: { ...analysis, file_id: fileId, original_dateiname: originalName, neuer_dateiname: neuerName, absender_kurz: absenderKurz, scan_datum: heute, timestamp: new Date().toISOString() } }];"
      },
