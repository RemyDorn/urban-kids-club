    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst prio = d.prioritaet === 'hoch' ? '🔴' : d.prioritaet === 'mittel' ? '🟡' : '🟢';\nconst betrag = d.betrag ? d.betrag + ' EUR' : '-';\nconst faellig = d.faelligkeit || '-';\n\nconst text = `📄 *Neues Dokument verarbeitet*\\n\\n`\n  + `${prio} *${d.dokumenttyp}*\\n`\n  + `📨 Absender: ${d.absender}\\n`\n  + `📅 Datum: ${d.datum || '-'}\\n`\n  + `💰 Betrag: ${betrag}\\n`\n  + `⏰ Faellig: ${faellig}\\n`\n  + `📊 Prioritaet: ${d.prioritaet}\\n\\n`\n  + `📝 ${d.zusammenfassung}\\n\\n`\n  + `💡 *Empfohlene Aktion:*\\n${d.aktion_empfohlen}\\n\\n`\n  + `📁 Abgelegt in: _sorted/${d.absender_kurz}/${d.neuer_dateiname}`;\n\nreturn [{ json: { text: text } }];"
      },
