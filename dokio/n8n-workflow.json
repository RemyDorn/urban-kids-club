    {
      "parameters": {
        "__HINWEIS__": "Diesen Node MANUELL konfigurieren: + > Anthropic > Analyze Document. Model: claude-sonnet-4-6, Input Type: Binary, Binary Property: data. Prompt siehe README."
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Analyze document",
      "type": "MANUELL_KONFIGURIEREN",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "// Claude Antwort parsen\nconst input = $input.first();\nlet text = '';\n\n// Antwort aus dem Anthropic Node extrahieren\nif (input.json.message && input.json.message.content) {\n  text = input.json.message.content[0].text;\n} else if (input.json.content) {\n  text = input.json.content[0].text;\n} else if (input.json.text) {\n  text = input.json.text;\n} else {\n  // Fallback: gesamtes JSON durchsuchen\n  text = JSON.stringify(input.json);\n  const match = text.match(/\\{[\\s\\S]*dokumenttyp[\\s\\S]*\\}/);\n  if (match) text = match[0];\n}\n\n// JSON extrahieren (Backticks entfernen)\ntext = text.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch(e) {\n  // Fallback: JSON aus Text extrahieren\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  } else {\n    throw new Error('Konnte JSON nicht parsen: ' + text.substring(0, 200));\n  }\n}\n\n// file_id vom Download Node durchreichen\nconst fileId = $('PDF herunterladen').first().json.id || $input.first().json.file_id || '';\nconst fileName = $('PDF herunterladen').first().json.name || '';\n\n// Neuen Dateinamen erstellen: YYYY-MM-DD_Typ_Absender_Betrag.pdf\nconst datum = parsed.datum || new Date().toISOString().split('T')[0];\nconst typ = (parsed.dokumenttyp || 'Dokument').replace(/[^a-zA-Z0-9äöüÄÖÜß]/g, '-').substring(0, 20);\nconst absender = (parsed.absender_kurz || parsed.absender || 'Unbekannt').replace(/[^a-zA-Z0-9äöüÄÖÜß\\-]/g, '-').substring(0, 30);\nconst betrag = parsed.betrag ? '_' + parsed.betrag + 'EUR' : '';\nconst neuerName = datum + '_' + typ + '_' + absender + betrag + '.pdf';\n\nreturn [{\n  json: {\n    ...parsed,\n    file_id: fileId,\n    original_dateiname: fileName,\n    neuer_dateiname: neuerName,\n    absender_kurz: parsed.absender_kurz || absender,\n    scan_datum: new Date().toISOString().split('T')[0]\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Antwort verarbeiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "operation": "search",
        "queryString": "={{ $json.absender_kurz }}",
        "searchType": "folder",
        "driveId": "myDrive",
        "folderId": {
          "__rl": true,
          "value": "DEINE_SORTED_FOLDER_ID",
          "mode": "id"
        },
        "options": {
          "fields": ["id", "name"]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
