      "id": "a1b2c3d4-0001-4000-8000-000000000014",
      "name": "Google Sheets – Eintrag loggen",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2200, 120],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CREDENTIAL_ID",
