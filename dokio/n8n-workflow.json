    {
      "parameters": {
        "jsCode": "const d = $('Antwort verarbeiten').first().json;\nconst prio = d.prioritaet === 'hoch' ? '🔴' : d.prioritaet === 'mittel' ? '🟡' : '🟢';\nconst betrag = d.betrag ? ` | 💶 ${d.betrag}€` : '';\nconst faellig = d.faelligkeit ? `\\n⏰ Fällig: ${d.faelligkeit}` : '';\nconst text = `📄 *Neues Dokument gescannt*\\n\\n${prio} *${d.dokumenttyp}*\\n📤 Von: ${d.absender}\\n📅 Datum: ${d.datum || 'unbekannt'}${betrag}${faellig}\\n\\n📁 Abgelegt in: _sorted/${d.absender_kurz}\\n📝 ${d.zusammenfassung}\\n\\n✅ *Empfehlung:* ${d.aktion_empfohlen}`;\nreturn [{ json: { text } }];"
      },
