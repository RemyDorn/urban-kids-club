# ============================================================
# Urban Kids Club – Environment Variables
# ============================================================
# Kopiere diese Datei nach .env und passe die Werte an.
# ============================================================

# --- Server ---
PORT=3000
PLATFORM_PORT=3001
NODE_ENV=development

# --- Datenquelle ---
# "memory" = In-Memory (Entwicklung), "supabase" = PostgreSQL (Produktion)
DATA_SOURCE=memory

# --- Supabase ---
SUPABASE_URL=https://yuilhiqnrjuuqoqggihm.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- CORS ---
# "*" für Entwicklung, "https://urbankidsclub.de" für Produktion
CORS_ORIGIN=*

# --- E-Mail ---
# Leer = Console-Logger (Entwicklung), gesetzt = echter Versand
RESEND_API_KEY=

# --- Stripe (Zahlungen) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
