          <div class="funnel-step-sub">letzten 30 Tage</div>
        </div>
        <div class="funnel-step">
          <div class="funnel-step-label">Geschnuppert</div>
          <div class="funnel-step-num">&mdash; <em>&middot; &mdash; %</em></div>
          <div class="funnel-step-sub">Klick-zu-Buchung</div>
        </div>
        <div class="funnel-step">
          <div class="funnel-step-label">Gebucht</div>
          <div class="funnel-step-num">&mdash; <em>&middot; &mdash; %</em></div>
          <div class="funnel-step-sub">Trial-zu-Conversion</div>
        </div>
        <div class="funnel-step highlight">
          <div class="funnel-step-label">Credits</div>
          <div class="funnel-step-num">&mdash; <em>Credits</em></div>
          <div class="funnel-step-sub">ausgezahlt + pending</div>
        </div>
      </div>

      <!-- KPI Row -->
