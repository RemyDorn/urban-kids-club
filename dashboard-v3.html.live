          <div style="padding:36px 20px;text-align:center;color:var(--muted);font-size:13px"><div style="font-family:Fraunces,serif;font-style:italic;font-size:18px;color:var(--ink);margin-bottom:6px">Lade Empfehlungen &hellip;</div></div>
        </div>

        <!-- ACTIVITY -->
        <div class="card">
          <div class="card-head">
            <div class="card-title">Letzte <em>Aktivit&auml;t</em></div>
          </div>
          <div style="padding:36px 20px;text-align:center;color:var(--muted);font-size:13px"><div style="font-family:Fraunces,serif;font-style:italic;font-size:18px;color:var(--ink);margin-bottom:6px">Lade Aktivit&auml;t &hellip;</div></div>
        </div>
      </div>

      <!-- CONFIG SNAPSHOT -->
      <div class="card">
        <div class="card-head">
          <div class="card-title">Aktuelle <em>Regeln</em></div>
          <a href="#" class="card-link">&Auml;ndern &rarr;</a>
        </div>
