    </div>
      </div>

      <div class="section" data-section="einstellungen" hidden>
        <div class="page">
      <div class="page-head">
        <div class="page-head-text">
          <div class="page-kicker">Provider-Konto &middot; Profil &middot; Zahlungsdaten</div>
          <h1 class="page-title">Deine <em class="italic">Einstellungen</em></h1>
          <p class="page-sub" id="phSetSub">L&auml;dt&hellip;</p>
        </div>
        <div>
          <button class="btn btn-primary" onclick="alert('Speichern folgt')">Speichern</button>
        </div>
      </div>

      <div class="card" style="padding:24px;">
        <h3 style="font-family:var(--font-heading);font-weight:700;font-size:18px;margin-bottom:18px;">Allgemein</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <label class="kk-field"><span class="kk-label">Studio-Name</span><input class="kk-input" id="phSetName" type="text" placeholder="L&auml;dt&hellip;" disabled></label>
          <label class="kk-field"><span class="kk-label">E-Mail</span><input class="kk-input" id="phSetEmail" type="email" placeholder="L&auml;dt&hellip;" disabled></label>
          <label class="kk-field"><span class="kk-label">Telefon</span><input class="kk-input" id="phSetPhone" type="tel" placeholder="L&auml;dt&hellip;" disabled></label>
          <label class="kk-field"><span class="kk-label">Stadt</span><input class="kk-input" id="phSetCity" type="text" placeholder="L&auml;dt&hellip;" disabled></label>
        </div>
      </div>

      <div class="card" style="padding:24px;margin-top:18px;">
        <h3 style="font-family:var(--font-heading);font-weight:700;font-size:18px;margin-bottom:12px;">Zahlungsmethoden</h3>
        <div id="phSetPayments" style="display:flex;gap:10px;flex-wrap:wrap;">
          <span style="color:var(--muted);font-size:13px">L&auml;dt&hellip;</span>
        </div>
      </div>

      <div class="card" style="padding:24px;margin-top:18px;">
        <h3 style="font-family:var(--font-heading);font-weight:700;font-size:18px;margin-bottom:14px;">Add-Up &amp; Credits</h3>
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px;line-height:1.55;">Add-Up-Plätze sind zusätzliche, für Eltern unsichtbare Plätze in jedem Kurs. Sie werden vergeben für Probestunden, Warteliste-Angebote und Nachhol-Buchungen mit Credits.</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <label class="kk-field">
            <span class="kk-label">Add-Up-System aktivieren</span>
            <select class="kk-input" id="phSetAddUpEnabled">
              <option value="true" selected>Ja — Add-Up-Plätze sind verfügbar</option>
              <option value="false">Nein — nur reguläre Plätze</option>
            </select>
          </label>
          <label class="kk-field">
            <span class="kk-label">Krank-Cutoff (Stunden vor Termin)</span>
            <input class="kk-input" id="phSetCancelCutoff" type="number" min="0" max="168" value="24">
            <span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px;">Eltern, die später krank melden, bekommen keinen Credit.</span>
          </label>
          <label class="kk-field">
            <span class="kk-label">Credit-Verfall (Monate)</span>
            <input class="kk-input" id="phSetCreditExpiry" type="number" min="0" max="36" value="12">
            <span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px;">0 = unbegrenzt gültig.</span>
          </label>
          <label class="kk-field">
            <span class="kk-label">Standard Add-Up-Plätze</span>
            <input class="kk-input" id="phSetDefaultAddUp" type="number" min="0" max="20" value="2">
            <span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px;">Voreinstellung beim Anlegen neuer Kurse.</span>
          </label>
        </div>
        <div style="margin-top:18px;display:flex;gap:8px;">
          <button class="btn btn-primary btn-sm" onclick="window.__settingsSaveAddUp()">Speichern</button>
          <button class="btn btn-ghost btn-sm" onclick="window.showSection('kurse')">Abbrechen</button>
        </div>
      </div>

      <div class="card" style="padding:24px;margin-top:18px;">
        <h3 style="font-family:var(--font-heading);font-weight:700;font-size:18px;margin-bottom:8px;">&Ouml;ffnungszeiten</h3>
        <p style="font-size:13px;color:var(--muted);margin-bottom:18px;line-height:1.55;">Au&szlig;erhalb deiner &Ouml;ffnungszeiten k&ouml;nnen keine Kurse mehr angelegt werden. Tage ohne &Ouml;ffnungszeit gelten als geschlossen.</p>
        <div id="phSetOpeningHours" style="display:flex;flex-direction:column;gap:8px;"></div>
        <div style="margin-top:18px;display:flex;gap:8px;">
          <button class="btn btn-primary btn-sm" onclick="window.__settingsSaveOpeningHours()">Speichern</button>
          <button class="btn btn-ghost btn-sm" onclick="window.__settingsLoadOpeningHours()">Zur&uuml;cksetzen</button>
        </div>
      </div>

      <div class="card" style="padding:24px;margin-top:18px;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:24px;flex-wrap:wrap;">
          <div style="flex:1;min-width:240px;">
            <h3 style="font-family:var(--font-heading);font-weight:700;font-size:18px;margin-bottom:8px;">QR-Code &middot; Check-In</h3>
            <p style="font-size:13px;color:var(--muted);margin-bottom:14px;line-height:1.55;">
              Drucke deinen pers&ouml;nlichen QR-Code aus und h&auml;nge ihn am Eingang auf. Eltern scannen ihn beim Eintreffen, w&auml;hlen ihr Kind &mdash; und sind eingecheckt. Anwesenheit landet sofort in deinem Dashboard.
            </p>
            <div style="font-size:12px;color:var(--muted-2);margin-bottom:14px;">
              <strong style="color:var(--text)">Check-In-URL:</strong>
              <code id="phSetCheckinUrl" style="display:inline-block;background:rgba(0,0,0,.04);padding:3px 8px;border-radius:4px;font-size:11px;margin-top:4px;word-break:break-all;">L&auml;dt&hellip;</code>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              <button class="btn btn-primary btn-sm" onclick="window.__openQrCheckin()">QR anzeigen &amp; drucken</button>
              <button class="btn btn-ghost btn-sm" onclick="window.__settingsCopyCheckinUrl()">URL kopieren</button>
              <button class="btn btn-ghost btn-sm" onclick="window.__settingsOpenCheckinPreview()">Vorschau</button>
            </div>

            <div style="margin-top:22px;padding-top:18px;border-top:1px dashed var(--border);">
              <h4 style="font-family:var(--font-heading);font-weight:600;font-size:14px;margin-bottom:6px;">Check-In-Zeitfenster</h4>
              <p style="font-size:12px;color:var(--muted);margin-bottom:14px;line-height:1.5;">
                Au&szlig;erhalb dieses Fensters wird Eltern beim Scannen eine Fehlermeldung mit der fr&uuml;hesten Check-In-Zeit angezeigt. So vermeidest du, dass Leute schon Stunden vorher eingecheckt sind.
              </p>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <label class="kk-field">
                  <span class="kk-label">Vor Kursstart (Min.)</span>
                  <input class="kk-input" id="phSetCheckinBefore" type="number" min="0" max="240" step="5" value="20">
                  <span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px;">Wie fr&uuml;h darf eingecheckt werden? Default 20.</span>
                </label>
                <label class="kk-field">
                  <span class="kk-label">Nach Kursstart (Min.)</span>
                  <input class="kk-input" id="phSetCheckinAfter" type="number" min="0" max="240" step="5" value="10">
                  <span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px;">Bis wann sp&auml;testens? Default 10.</span>
                </label>
              </div>
              <div style="margin-top:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <button class="btn btn-primary btn-sm" onclick="window.__settingsSaveCheckinWindow()">Speichern</button>
                <span id="phSetCheckinExample" style="font-size:12px;color:var(--muted-2);">Beispiel: Kursstart 14:00 &rarr; Check-In 13:40 bis 14:10.</span>
              </div>
            </div>
          </div>
          <div style="flex-shrink:0;">
            <div style="background:#fff;padding:14px;border-radius:14px;border:1px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,.04);">
              <img id="phSetQrThumb" alt="QR-Code Vorschau" style="display:block;width:160px;height:160px;image-rendering:pixelated;background:#f4ede5;">
            </div>
          </div>
        </div>
      </div>

      <div class="card" style="padding:24px;margin-top:18px;">
        <h3 style="font-family:var(--font-heading);font-weight:700;font-size:18px;margin-bottom:8px;">Pflicht-Dokumente fürs Team</h3>
        <p style="font-size:13px;color:var(--muted);margin-bottom:14px;line-height:1.55;">
          Welche Dokumente m&uuml;ssen alle Mitarbeiter:innen vorlegen? F&uuml;r Kinderbetreuung sind Erweitertes F&uuml;hrungszeugnis und Belehrung &sect;43 IfSG meist Pflicht. Mitarbeiter ohne g&uuml;ltiges Pflicht-Dokument bekommen ein Warn-Badge.
        </p>
        <div id="phSetReqDocs" style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px;">
          <span style="color:var(--muted);font-size:13px">L&auml;dt&hellip;</span>
        </div>
        <button class="btn btn-primary btn-sm" onclick="window.__settingsSaveRequiredDocs()">Speichern</button>
      </div>

      <div class="card" style="padding:24px;margin-top:18px;">
        <h3 style="font-family:var(--font-heading);font-weight:700;font-size:18px;margin-bottom:12px;">Erweiterte Einstellungen</h3>
        <p style="font-size:13px;color:var(--muted);">Rollen-System, Steuer-Einstellungen, Benachrichtigungs-Templates, Backup &amp; Export &mdash; folgen in Sprint D.</p>
      </div>

      </div>  <!-- close .page -->
      </div>  <!-- close page-host -->

    </div>
  </div>
</div>

<script>
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebar-overlay').classList.toggle('open');
}
</script>
<script src="/assets/kurs-creator-v2.js"></script>
<script src="/assets/dashboard-ui.js"></script>

<script>
// ============================================================
// dashboard-v3 Backend-Wiring (Phase 1d)
// ============================================================
(async function() {
  // 1. Find Supabase session
  let session = null;
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.startsWith('sb-') && k.endsWith('-auth-token')) {
        const raw = localStorage.getItem(k);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed.access_token) { session = parsed; break; }
        }
      }
    }
  } catch (e) { console.warn('[v3] localStorage parse failed', e); }

  if (!session?.access_token) {
    const banner = document.createElement('div');
    banner.style.cssText = 'position:fixed;top:0;left:0;right:0;background:#B4523A;color:#FFEFE1;padding:12px 20px;text-align:center;z-index:99999;font-family:Inter,sans-serif;font-size:13px;font-weight:500;box-shadow:0 2px 8px rgba(0,0,0,0.15)';
    banner.innerHTML = 'Bitte zuerst auf <a href="/" style="color:#FDE4D3;text-decoration:underline">app.urbankids.club</a> einloggen.';
    document.body.appendChild(banner);
    setTimeout(() => { window.location.href = '/'; }, 3000);
    return;
  }

  const token = session.access_token;
  async function api(path, opts = {}) {
    const headers = { 'Authorization': 'Bearer ' + token, ...(opts.headers || {}) };
    const res = await fetch('/api' + path, { ...opts, headers });
    if (res.status === 401) {
      window.location.href = '/';
      throw new Error('unauthorized');
    }
    if (!res.ok) {
      let bodyText = '';
      try { const j = await res.clone().json(); bodyText = j.error || j.message || JSON.stringify(j); }
      catch { try { bodyText = await res.text(); } catch {} }
      const err = new Error('API ' + path + ' → ' + res.status + (bodyText ? ' — ' + bodyText : ''));
      err.status = res.status; err.body = bodyText;
      throw err;
    }
    return res.json();
  }

  function fmtEuros(cents) {
    return (cents / 100).toLocaleString('de-DE', { maximumFractionDigits: 0 });
  }

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  try {
    // 2. Provider laden
    const provRes = await api('/providers');
    const providers = provRes.data || provRes.providers || provRes || [];
    if (!providers.length) {
      console.warn('[v3] Keine Provider gefunden');
      return;
    }
    const cp = providers[0];
    const pname = cp.displayName || cp.name || 'Provider';
    const pinitial = pname.charAt(0).toUpperCase();

    // 3. Greeting + Header
    const hour = new Date().getHours();
    const greeting = hour < 12 ? 'Guten Morgen' : hour < 18 ? 'Guten Tag' : 'Guten Abend';
    const days = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];
    const months = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
    const today = new Date();
    const dateStr = days[today.getDay()] + ', ' + today.getDate() + '. ' + months[today.getMonth()];
    const todayWeekday = days[today.getDay()];

    document.querySelectorAll('.user-chip-name').forEach(el => el.textContent = pname);
    document.querySelectorAll('.user-avatar').forEach(el => el.textContent = pinitial);
    // Greeting + date scoped to dashboard section only — other sections keep their static page-title/page-kicker
    const _dashTitle = document.querySelector('[data-section="dashboard"] .page-title');
    if (_dashTitle) _dashTitle.innerHTML = greeting + ', <em>' + escapeHtml(pname) + '</em>.';
    const _dashKicker = document.querySelector('[data-section="dashboard"] .page-kicker');
    if (_dashKicker) _dashKicker.textContent = dateStr;
    const phTodayWeekday = document.getElementById('phTodayWeekday');
    if (phTodayWeekday) phTodayWeekday.textContent = todayWeekday;

    // 4. Activities + Bookings parallel
    let activities = [], bookings = [];
    try {
      const r = await api('/providers/' + cp.id + '/activities');
      activities = r.data || r.activities || r || [];
    } catch (e) { console.warn('[v3] activities load failed', e); }

    try {
      const r = await api('/providers/' + cp.id + '/bookings');
      bookings = r.data || r.bookings || r || [];
    } catch (e) { console.warn('[v3] bookings load failed', e); }

    // 5. KPI-Werte
    const activeCourses = activities.filter(a => !a.archivedAt && !a.deletedAt && a.status !== 'archived' && a.status !== 'cancelled').length;
    const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
    const _isCancelled = b => {
      const st = (b.status || '').toLowerCase();
      const ps = (b.paymentStatus || b.payment_status || '').toLowerCase();
      return st === 'cancelled' || st === 'canceled' || ps === 'cancelled' || ps === 'refunded' || ps === 'refund_failed' || !!b.cancelledAt;
    };
    const monthBookings = bookings.filter(b => {
      const d = new Date(b.createdAt || b.bookedAt || 0);
      return d >= monthStart && !_isCancelled(b);
    });
    // amountPaid kommt aus API in Euro (numeric), nicht Cents — auf Cents normalisieren für KPI-Sums.
    const _bCents = (b) => {
      if (typeof b.amountCents === 'number') return b.amountCents;
      if (typeof b.priceCents === 'number') return b.priceCents;
      const ap = typeof b.amountPaid === 'number' ? b.amountPaid : (typeof b.amountPaid === 'string' ? parseFloat(b.amountPaid) : 0);
      return Math.round((isNaN(ap) ? 0 : ap) * 100);
    };
    const monthRevenue = monthBookings.reduce((s, b) => s + _bCents(b), 0);

    const prevMonthStart = new Date(today.getFullYear(), today.getMonth() - 1, 1);
    const prevMonthEnd = new Date(today.getFullYear(), today.getMonth(), 0, 23, 59, 59);
    const prevMonthBookings = bookings.filter(b => {
      const d = new Date(b.createdAt || b.bookedAt || 0);
      return d >= prevMonthStart && d <= prevMonthEnd && !_isCancelled(b);
    });
    const prevMonthRevenue = prevMonthBookings.reduce((s, b) => s + _bCents(b), 0);

    const bookingsDelta = prevMonthBookings.length > 0 ? Math.round((monthBookings.length - prevMonthBookings.length) / prevMonthBookings.length * 100) : null;
    const revenueDelta = prevMonthRevenue > 0 ? Math.round((monthRevenue - prevMonthRevenue) / prevMonthRevenue * 100) : null;

    const stats = document.querySelectorAll('.stats .stat');
    if (stats[0]) {
      const v = stats[0].querySelector('.stat-value');
      const d = stats[0].querySelector('.stat-delta');
      if (v) v.innerHTML = monthBookings.length + ' <em>Stück</em>';
      if (d && bookingsDelta !== null) {
        const cls = bookingsDelta >= 0 ? 'up' : 'down';
        d.className = 'stat-delta ' + cls;
        d.innerHTML = '<strong>' + (bookingsDelta >= 0 ? '+' : '') + bookingsDelta + ' %</strong> vs. ' + months[(today.getMonth() - 1 + 12) % 12];
      } else if (d) {
        d.className = 'stat-delta';
        d.textContent = 'Erstmonat';
      }
    }
    if (stats[1]) {
      const v = stats[1].querySelector('.stat-value');
      const d = stats[1].querySelector('.stat-delta');
      if (v) v.innerHTML = fmtEuros(monthRevenue) + '<em>€</em>';
      if (d && revenueDelta !== null) {
        const cls = revenueDelta >= 0 ? 'up' : 'down';
        d.className = 'stat-delta ' + cls;
        d.innerHTML = '<strong>' + (revenueDelta >= 0 ? '+' : '') + revenueDelta + ' %</strong> vs. ' + months[(today.getMonth() - 1 + 12) % 12];
      } else if (d) {
        d.className = 'stat-delta';
        d.textContent = 'Erstmonat';
      }
    }
    if (stats[2]) {
      const v = stats[2].querySelector('.stat-value');
      const d = stats[2].querySelector('.stat-delta');
      if (v) v.innerHTML = activeCourses + ' <em>laufend</em>';
      if (d) d.textContent = activeCourses === 0 ? 'Lege deinen ersten Kurs an' : '\u00A0';
    }

    // 6. Letzte Buchungen-Tabelle (5 letzte) — nutzt class="data-table" + .cust pattern
    const recentBookings = [...bookings].sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0)).slice(0, 5);
    const tbody = document.getElementById('phRecentBookingsBody') || document.querySelector('.data-table tbody');
    if (tbody) {
      if (recentBookings.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="padding:30px;color:var(--muted);text-align:center;font-size:13px">Noch keine Buchungen.</td></tr>';
      } else {
        tbody.innerHTML = recentBookings.map(b => {
          const c = b.customer || {};
          const cname = c.name || c.email || (b.customerName) || 'Unbekannt';
          const childName = b.childName || (b.child && b.child.name) || '';
          const childAge = b.childAge || (b.child && b.child.age) || '';
          const childInfo = childName ? '<div class="cust-sub">Kind: ' + escapeHtml(childName) + (childAge ? ' (' + childAge + ')' : '') + '</div>' : '';
          const date = new Date(b.createdAt || 0);
          const dateStr = date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' }) + ', ' + date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
          const amount = (typeof b.amountPaid === 'number' ? b.amountPaid : ((b.amountCents || b.priceCents || 0) / 100)).toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €';
          // Cancelled-Override: Buchungs-Status hat Vorrang vor payment_status (Storno-Konsistenz)
          const isCancelled = b.status === 'cancelled' || b.paymentStatus === 'cancelled';
          const status = isCancelled ? 'cancelled' : (b.paymentStatus || b.status || 'pending').toLowerCase();
          const statusLabels = { paid: 'Bezahlt', pending: 'Offen', unpaid: 'Offen', failed: 'Fehlgeschlagen', cancelled: 'Storniert', refunded: 'Erstattet', waitlisted: 'Warteliste', confirmed: 'Bestätigt' };
          const statusLabel = statusLabels[status] || status.charAt(0).toUpperCase() + status.slice(1);
          const pillCls = { paid: 'pill-ok', pending: 'pill-pending', unpaid: 'pill-pending', confirmed: 'pill-ok', waitlisted: 'pill-pending', cancelled: 'pill-err', refunded: 'pill-err', failed: 'pill-err' }[status] || 'pill-pending';
          const initial = cname.charAt(0).toUpperCase();
          const avCls = ['', 'sage', ''][Math.floor(Math.random()*3)]; // optional sage-Variant
          return '<tr><td><div class="cust"><div class="cust-av' + (avCls ? ' ' + avCls : '') + '">' + escapeHtml(initial) + '</div><div class="cust-info"><div class="cust-name">' + escapeHtml(cname) + '</div>' + childInfo + '</div></div></td><td>' + escapeHtml(b.activityName || b.activityTitle || '\u2014') + '</td><td>' + dateStr + '</td><td>' + amount + '</td><td><span class="pill ' + pillCls + '">' + statusLabel + '</span></td></tr>';
        }).join('');
      }
    }

    // 7. Heute-Sessions
    let todaySessions = [];
    try {
      // Bug-Fix 2026-04-29: /attendance/today liefert nur AttendanceRecords, keine Sessions.
      // Logik gespiegelt von renderWeekGlance, damit Wochenleiste + Heute konsistent sind.
      const _today = new Date();
      const _dayKeys = ['SU','MO','TU','WE','TH','FR','SA'];
      const _todayDayKey = _dayKeys[_today.getDay()];
      const _ymd = (d) => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      const _todayYmd = _ymd(_today);
      const _inRange = (ymd, sd, ed) => {
        if (sd && ymd < String(sd).slice(0,10)) return false;
        if (ed && ymd > String(ed).slice(0,10)) return false;
        return true;
      };
      const _toMin = (t) => { const p = String(t||'').split(':'); return (parseInt(p[0],10)||0)*60 + (parseInt(p[1],10)||0); };
      const _bookedByActivity = (bookings || []).reduce((acc, b) => {
        if (!b || b.status === 'cancelled') return acc;
        const aid = b.activityId || b.activity_id;
        if (aid) acc[aid] = (acc[aid] || 0) + 1;
        return acc;
      }, {});
      (activities || []).forEach(a => {
        if (!a) return;
        if (a.status === 'archived' || a.status === 'cancelled' || a.status === 'paused') return;
        const sched = a.schedule || {};
        const _push = (start, end) => {
          const sm = _toMin(start), em = _toMin(end);
          const dur = em > sm ? em - sm : 60;
          todaySessions.push({
            activityId: a.id,
            activityTitle: a.title || 'Kurs',
            startTime: String(start || '').slice(0,5),
            endTime: String(end || '').slice(0,5),
            durationMin: dur,
            roomName: a.roomName || a.locationName || a.location || '',
            capacity: a.capacity || 0,
            bookedCount: _bookedByActivity[a.id] || 0,
          });
        };
        if (sched.type === 'recurring' && Array.isArray(sched.slots)) {
          sched.slots.forEach(slot => {
            if (!slot || slot.day !== _todayDayKey) return;
            if (!_inRange(_todayYmd, sched.startDate, sched.endDate)) return;
            _push(slot.startTime, slot.endTime);
          });
        } else if (sched.type === 'single' && String(sched.date || '').slice(0,10) === _todayYmd) {
          _push(sched.startTime, sched.endTime);
        }
      });
      todaySessions.sort((x, y) => (x.startTime || '').localeCompare(y.startTime || ''));
    } catch (e) { console.warn('[v3] today sessions derive failed', e); }

    // Krank-Konsistenz: Today-Cancellations enrichen
    let _todayCancByActivity = {};
    try {
      const cancResp = await api('/today-cancellations');
      _todayCancByActivity = (cancResp && cancResp.data && cancResp.data.byActivity) || {};
      window.dashboardState.todayCancByActivity = _todayCancByActivity;
    } catch (e) { console.warn('[v3] today-cancellations failed', e); }

    const todayList = document.getElementById('phTodayList');
    if (todayList) {
      if (!todaySessions.length) {
        todayList.innerHTML = '<div style="padding:30px;color:var(--muted);text-align:center;font-size:13px">Heute keine Termine.</div>';
      } else {
        todayList.innerHTML = todaySessions.slice(0, 5).map(s => {
          // s.startTime ist jetzt "HH:MM" (client-side aus schedule.slot abgeleitet), kein ISO-Timestamp mehr
          const hour = s.startTime || '\u2014';
          const dur = s.durationMin || s.duration || 60;
          const title = s.activityTitle || s.title || s.activityName || '\u2014';
          const room = s.roomName || s.locationName || s.room || '';
          const bookedRaw = s.bookedCount ?? s.attendees ?? 0;
          const cap = s.capacity ?? 0;
          const cancMeta = _todayCancByActivity[s.activityId] || { cancelled: 0, addUp: 0 };
          const sickC = cancMeta.cancelled || 0;
          const addUpC = cancMeta.addUp || 0;
          const booked = Math.max(0, bookedRaw - sickC + addUpC);
          const isFull = cap > 0 && booked >= cap;
          const isAlmost = cap > 0 && booked / cap >= 0.8 && !isFull;
          const statusCls = isFull ? 'full' : isAlmost ? 'warn' : 'ok';
          const statusLabel = isFull ? 'Ausgebucht' : isAlmost ? 'Fast voll' : 'Alles gut';
          let metaExtra = '';
          if (sickC > 0) metaExtra += ' · ' + sickC + ' krank';
          if (addUpC > 0) metaExtra += ' · ' + addUpC + ' Add-Up';
          return '<div class="agenda-item"><div class="agenda-time"><div class="agenda-time-hour">' + hour + '</div><div class="agenda-time-min">' + dur + ' Min</div></div><div class="agenda-body"><div class="agenda-name">' + escapeHtml(title) + '</div><div class="agenda-meta"><strong>' + booked + ' von ' + cap + '</strong> Teilnehmer' + (room ? ' · ' + escapeHtml(room) : '') + metaExtra + '</div></div><span class="agenda-status ' + statusCls + '">' + statusLabel + '</span></div>';
        }).join('');
      }
    }

    // 8. Zu-Tun-Liste
    const todos = [];
    let trialsCount = 0;
    try {
      const r = await api('/providers/' + cp.id + '/trials');
      const trials = r.data || r.trials || r || [];
      const pending = trials.filter(t => t.status === 'pending' || t.status === 'requested' || t.status === 'open' || !t.status);
      trialsCount = pending.length;
      if (pending.length > 0) {
        todos.push({
          icon: '!',
          iconCls: '',
          title: pending.length + ' offene Probestund' + (pending.length === 1 ? 'e' : 'en'),
          meta: 'Anfrage prüfen und bestätigen',
        });
      }
    } catch (e) { console.warn('[v3] trials failed', e); }

    try {
      const r = await api('/providers/' + cp.id + '/invoices?status=open');
      const openInv = r.data || r.invoices || r || [];
      const overdue = openInv.filter(i => i.dueAt && new Date(i.dueAt) < new Date());
      if (overdue.length > 0) {
        todos.push({
          icon: '€',
          iconCls: 'sage',
          title: overdue.length + ' überfällige Rechnung' + (overdue.length === 1 ? '' : 'en'),
          meta: 'Mahnung versenden',
        });
      }
      const dueOpen = openInv.length - overdue.length;
      if (dueOpen > 0) {
        todos.push({
          icon: '€',
          iconCls: 'sage',
          title: dueOpen + ' offene Rechnung' + (dueOpen === 1 ? '' : 'en'),
          meta: 'Zahlungseingang prüfen',
        });
      }
    } catch (e) { console.warn('[v3] invoices failed', e); }

    let unreadMessages = 0;
    let unreadThreads = 0;
    try {
      const r = await api('/providers/' + cp.id + '/messages?unread=true');
      unreadMessages = r.unreadCount ?? (r.data || r.messages || r || []).length;
      if (unreadMessages > 0) {
        todos.push({
          icon: '✉',
          iconCls: 'sage',
          title: unreadMessages + ' ungelesene Nachricht' + (unreadMessages === 1 ? '' : 'en'),
          meta: 'Postfach öffnen',
        });
      }
    } catch (e) { console.warn('[v3] messages failed', e); }
    try {
      const tr = await api('/messages/threads');
      unreadThreads = (tr.data || []).filter(t => (t.unread || 0) > 0).length;
    } catch (e) { console.warn('[v3] threads failed', e); }

    const todoList = document.getElementById('phTodoList');
    if (todoList) {
      if (!todos.length) {
        todoList.innerHTML = '<div style="padding:30px;color:var(--muted);text-align:center;font-size:13px">Alles erledigt 🎉</div>';
      } else {
        todoList.innerHTML = todos.slice(0, 6).map(t => {
          const iconClass = t.iconCls ? 'action-icon ' + t.iconCls : 'action-icon';
          return '<div class="action-item"><div class="' + iconClass + '">' + t.icon + '</div><div class="action-body"><div class="action-title">' + escapeHtml(t.title) + '</div><div class="action-meta">' + escapeHtml(t.meta) + '</div></div></div>';
        }).join('');
      }
    }

    // 9. KPI "Heute zu tun" mit echtem Count
    if (stats[3]) {
      const v = stats[3].querySelector('.stat-value');
      const d = stats[3].querySelector('.stat-delta');
      if (v) v.innerHTML = todos.length + ' <em>Aufgabe' + (todos.length === 1 ? '' : 'n') + '</em>';
      if (d) d.textContent = todos.length === 0 ? 'Alles erledigt' : todos.length + ' offen';
    }

    // 10. Sub-Headline
    const sub = document.querySelector('.page-sub');
    if (sub) {
      const parts = [];
      if (todaySessions.length > 0) parts.push(todaySessions.length + ' Termin' + (todaySessions.length === 1 ? '' : 'e') + ' heute');
      if (todos.length > 0) parts.push(todos.length + ' offene Aufgabe' + (todos.length === 1 ? '' : 'n'));
      sub.textContent = parts.length > 0 ? 'Heute: ' + parts.join(' · ') + '.' : 'Heute: alles ruhig.';
    }

    // 11. Sidebar-Counter (alle Items) — nutzt data-section-target nach Phase 2a SPA-Conversion
    const customerCount = new Set(bookings.map(b => (b.customer && b.customer.email) || b.customerEmail).filter(Boolean)).size;
    document.querySelectorAll('button.nav-item').forEach(btn => {
      const target = btn.dataset.sectionTarget;
      const badge = btn.querySelector('.badge');
      if (!badge || !target) return;
      switch(target) {
        case 'kurse': badge.textContent = activeCourses; break;
        case 'buchungen': badge.textContent = bookings.length; break;
        case 'kunden': badge.textContent = customerCount; break;
        case 'postfach':
          if (unreadThreads > 0) { badge.textContent = unreadThreads; badge.style.display = ''; }
          else { badge.style.display = 'none'; }
          break;
        case 'probestunden': badge.textContent = trialsCount; break;
      }
    });

    window.dashboardState = { provider: cp, activities, bookings, token, api };
    console.log('[v3] Phase 1d komplett — Provider:', pname, '| Activities:', activities.length, '| Bookings:', bookings.length, '| Today:', todaySessions.length, '| Todos:', todos.length);
    if (typeof window.__initClockWidget === 'function') {
      window.__initClockWidget();
    }
    // Apply role-based nav restrictions (hide sections trainers can't access)
    if (typeof window.__applyRoleBasedNav === 'function') {
      window.__applyRoleBasedNav();
    }
    if (typeof window.renderWeekGlance === 'function') {
      try { window.renderWeekGlance(activities); } catch (e) { console.warn('[Dashboard] renderWeekGlance failed', e); }
    }
    const _h = location.hash.slice(1) || 'dashboard';
    if (window.sectionLoaders && window.sectionLoaders[_h]) {
      try { window.sectionLoaders[_h](); window.sectionLoaded[_h] = true; } catch(e) { console.error('[v3] section loader failed:', _h, e); }
    }
  } catch (e) {
    console.error('[v3] Backend-Wiring failed:', e);
  }
})();



// ============================================================
// Sprint A.2: Kurse-Section Loader
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};
window.sectionLoaders.kurse = function() {
  const state = window.dashboardState;
  if (!state) {
    console.warn('[v3] kurse: dashboardState not ready');
    return;
  }
  const { provider, activities, api } = state;

  // ---------- helpers ----------
  function escapeHtml(str) { return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtPrice(cents) { return cents ? (cents/100).toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €' : '—'; }
  function statusOf(a) {
    if (a.archivedAt || a.deletedAt || a.status === 'archived') return 'archived';
    if (a.status === 'paused' || a.pausedAt) return 'paused';
    if (a.status === 'planning' || a.status === 'draft' || (a.startsAt && new Date(a.startsAt) > new Date())) return 'planning';
    return 'active';
  }
  function statusLabel(s) { return ({active:'Aktiv', paused:'Pausiert', planning:'In Planung', archived:'Archiv'})[s] || s; }
  function statusPillClass(s) { return ({active:'pill-ok', paused:'pill-pending', planning:'pill-info', archived:''})[s] || ''; }
  function categoryOf(a) { return a.category || a.kategorie || a.activityType || '—'; }
  function ageOf(a) {
    const ar = a.ageRange || {};
    const min = ar.min ?? a.minAgeMonths ?? a.ageMin;
    const max = ar.max ?? a.maxAgeMonths ?? a.ageMax;
    const unit = ar.unit || (a.minAgeMonths != null ? 'months' : 'years');
    if (min == null && max == null) return '—';
    const label = unit === 'months' ? ' Monate' : ' Jahre';
    const lo = min == null ? '?' : min;
    const hi = max == null ? '?' : max;
    return lo + '–' + hi + label;
  }
  function terminOf(a) {
    // Returns the day+time line (use terminSubOf for the date range sub)
    const dayKeys = { MO:'Mo', TU:'Di', WE:'Mi', TH:'Do', FR:'Fr', SA:'Sa', SU:'So' };
    const sched = a.schedule || {};
    const slot = (sched.slots || [])[0] || {};
    const day = dayKeys[slot.day] || (a.weekday != null ? ['So','Mo','Di','Mi','Do','Fr','Sa'][a.weekday] : '');
    const st = (slot.startTime || a.startTime || a.time || '').slice(0,5);
    const et = (slot.endTime || '').slice(0,5);
    if (day && st) return day + ' ' + st + (et ? '–' + et : '');
    if (st) return st;
    return '—';
  }
  function terminSubOf(a) {
    const sched = a.schedule || {};
    const sd = sched.startDate;
    const ed = sched.endDate;
    function fmt(s) {
      if (!s) return '';
      const m = String(s).match(/^(\d{4})-(\d{2})-(\d{2})/);
      if (!m) return s;
      return parseInt(m[3],10) + '.' + parseInt(m[2],10) + '.' + m[1].slice(2);
    }
    let range = '';
    if (sd && ed) range = fmt(sd) + '–' + fmt(ed);
    else if (sd) range = 'ab ' + fmt(sd);
    const pkg = (a.pricing && a.pricing[0] && a.pricing[0].packageSize) || 0;
    const cnt = pkg ? pkg + ' Termine' : '';
    if (range && cnt) return range + ' · ' + cnt;
    return range || cnt || '';
  }
  function priceOf(a) {
    // Brutto Block-Preis aus pricing[0].amount; Fallback priceCents (legacy)
    const p = (a.pricing && a.pricing[0]) || {};
    const amt = (p.amount != null) ? Number(p.amount) : (a.priceCents ? a.priceCents/100 : 0);
    if (!amt) return { total: '—', perSession: '' };
    const totalLabel = amt.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    const pkg = p.packageSize || 0;
    let perSession = '';
    if (pkg > 0) {
      const per = amt / pkg;
      perSession = per.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' € / Termin';
    } else if (p.type === 'subscription') {
      perSession = '/ Monat';
    } else if (p.type === 'single') {
      perSession = '/ Einzelstunde';
    }
    return { total: totalLabel, perSession };
  }
  function capacityOf(a) {
    let booked = a.bookedCount ?? a.enrollmentCount;
    if (booked == null) {
      const all = (state && state.bookings) || [];
      booked = all.filter(function(b) {
        return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
      }).length;
    }
    const cap = a.capacity ?? 0;
    return { booked, cap, ratio: cap > 0 ? booked/cap : 0 };
  }

  // ---------- KPIs ----------
  const counts = { all: activities.length, active: 0, paused: 0, planning: 0, archived: 0 };
  let totalKinder = 0, totalCap = 0, totalUmsatz = 0;
  activities.forEach(a => {
    const s = statusOf(a);
    counts[s] = (counts[s] || 0) + 1;
    const { booked, cap } = capacityOf(a);
    if (s === 'active' || s === 'planning') {
      totalKinder += booked;
      totalCap += cap;
      totalUmsatz += (((a.pricing && a.pricing[0] && a.pricing[0].amount) ? a.pricing[0].amount * 100 : (a.priceCents || 0))) * booked;
    }
  });
  const auslastung = totalCap > 0 ? Math.round(totalKinder/totalCap*100) : 0;

  document.getElementById('phKurseKicker').textContent = (provider.name || provider.displayName || '');
  const sub = document.getElementById('phKurseSub');
  if (counts.all === 0) {
    sub.textContent = 'Noch keine Kurse angelegt.';
  } else {
    const parts = [counts.all + ' Kurs' + (counts.all === 1 ? '' : 'e') + ' insgesamt'];
    if (counts.active) parts.push(counts.active + ' aktiv');
    if (counts.paused) parts.push(counts.paused + ' pausiert');
    if (counts.planning) parts.push(counts.planning + ' in Planung');
    sub.textContent = parts.join(' · ') + '.';
  }
  document.getElementById('phKurseActive').innerHTML = counts.active + ' <em>laufend</em>';
  document.getElementById('phKurseTeilnehmer').innerHTML = totalKinder + ' <em>Kinder</em>';
  document.getElementById('phKurseAuslastung').innerHTML = auslastung + '<em>%</em>';
  document.getElementById('phKurseUmsatz').innerHTML = (totalUmsatz/100).toLocaleString('de-DE', { maximumFractionDigits: 0 }) + '<em>€</em>';

  // tab counts
  Object.keys(counts).forEach(k => {
    const el = document.querySelector('#phKurseTabs .count[data-count="' + k + '"]');
    if (el) el.textContent = counts[k];
  });

  // categories
  const catSet = new Set(activities.map(categoryOf).filter(c => c && c !== '—'));
  const catSel = document.getElementById('phKurseCat');
  catSet.forEach(c => {
    const opt = document.createElement('option');
    opt.value = c; opt.textContent = c;
    catSel.appendChild(opt);
  });

  // ---------- Render ----------
  let activeStatus = 'all';
  let activeCat = 'all';
  let activeSort = 'newest';

  function render() {
    let list = activities.slice();
    if (activeStatus !== 'all') list = list.filter(a => statusOf(a) === activeStatus);
    if (activeCat !== 'all') list = list.filter(a => categoryOf(a) === activeCat);
    list.sort((a,b) => {
      if (activeSort === 'name') return (a.title || a.name || '').localeCompare(b.title || b.name || '');
      if (activeSort === 'capacity') return capacityOf(b).ratio - capacityOf(a).ratio;
      if (activeSort === 'price') return (b.priceCents||0) - (a.priceCents||0);
      return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
    });

    const tbody = document.getElementById('phKurseTbody');
    const mobile = document.getElementById('phKurseMobile');
    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="padding:40px;color:var(--muted);text-align:center;font-size:13px">Keine Kurse in dieser Ansicht. <a href="#kurse" style="color:var(--primary);cursor:pointer" onclick="event.preventDefault(); window.openKursCreatorV2 && window.openKursCreatorV2()">+ Neuen Kurs anlegen</a></td></tr>';
      mobile.innerHTML = '';
      return;
    }
    tbody.innerHTML = list.map(a => {
      const { booked, cap, ratio } = capacityOf(a);
      const s = statusOf(a);
      const fillCls = ratio >= 1 ? 'full' : ratio >= 0.8 ? '' : ratio < 0.4 ? 'low' : '';
      return '<tr style="cursor:default">'
        + '<td style="padding-left:20px;" class="kurs-name-cell"><div class="kurs-name">' + escapeHtml(a.title || a.name || 'Unbenannt') + '</div></td>'
        + '<td><span class="kategorie-tag">' + escapeHtml(categoryOf(a)) + '</span></td>'
        + '<td>' + escapeHtml(ageOf(a)) + '</td>'
        + '<td>' + escapeHtml(terminOf(a)) + (terminSubOf(a) ? '<br><span style="font-size:11px;color:var(--muted)">' + escapeHtml(terminSubOf(a)) + '</span>' : '') + '</td>'
        + '<td><div class="auslastung"><div class="auslastung-track"><div class="auslastung-fill ' + fillCls + '" style="width:' + Math.min(100, Math.round(ratio*100)) + '%"></div></div><span class="auslastung-label">' + booked + '/' + cap + '</span></div></td>'
        + '<td>' + (function() {
            var p = priceOf(a);
            return p.total + (p.perSession ? '<br><span style="font-size:11px;color:var(--muted)">' + escapeHtml(p.perSession) + '</span>' : '<br><span style="font-size:11px;color:var(--muted)">pro Block</span>');
          })() + '</td>'
        + '<td><span class="pill ' + statusPillClass(s) + '">' + statusLabel(s) + '</span></td>'
        + '<td style="padding-right:20px;text-align:right;">'
        + '<button class="row-action-btn" title="Ansehen" onclick="window.viewCourseDetail(\'' + a.id + '\')">⊙</button> '
        + '<button class="row-action-btn" title="Bearbeiten" onclick="window.editCourseQuick(\'' + a.id + '\')">✎</button> '
        + '<button class="row-action-btn" title="Mehr Aktionen" onclick="window.handleCourseAction(\'' + a.id + '\', null, this)">⋯</button>'
        + '</td>'
        + '</tr>';
    }).join('');

    mobile.innerHTML = list.map(a => {
      const { booked, cap, ratio } = capacityOf(a);
      const s = statusOf(a);
      const fillCls = ratio >= 1 ? 'full' : ratio >= 0.8 ? '' : ratio < 0.4 ? 'low' : '';
      return '<div class="kurse-mobile-card">'
        + '<div class="kurse-mobile-head"><div><div class="kurs-name">' + escapeHtml(a.title || a.name || 'Unbenannt') + '</div><div class="kurs-meta"><span class="kategorie-tag">' + escapeHtml(categoryOf(a)) + '</span> · ' + escapeHtml(ageOf(a)) + '</div></div><span class="pill ' + statusPillClass(s) + '">' + statusLabel(s) + '</span></div>'
        + '<div class="kurs-meta" style="margin-bottom:4px">' + escapeHtml(terminOf(a)) + '</div>'
        + '<div class="auslastung"><div class="auslastung-track"><div class="auslastung-fill ' + fillCls + '" style="width:' + Math.min(100, Math.round(ratio*100)) + '%"></div></div><span class="auslastung-label">' + booked + '/' + cap + '</span></div>'
        + '<div class="kurse-mobile-stats"><div>Preis<strong>' + fmtPrice(a.priceCents) + '</strong></div><div>Warteliste<strong>' + (a.waitlistCount ?? 0) + '</strong></div></div>'
        + '</div>';
    }).join('');
  }

  // wire filter tabs
  document.querySelectorAll('#phKurseTabs .filter-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('#phKurseTabs .filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status;
      render();
    };
  });
  document.getElementById('phKurseCat').onchange = (e) => { activeCat = e.target.value; render(); };
  document.getElementById('phKurseSort').onchange = (e) => { activeSort = e.target.value; render(); };

  render();
};


// ============================================================
// Sprint A.3: Buchungen-Section Loader
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};
window.sectionLoaders.buchungen = function() {
  const state = window.dashboardState;
  if (!state) { console.warn('[v3] buchungen: state not ready'); return; }
  const { bookings, activities } = state;

  function escapeHtml(str) { return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtPrice(cents) { return ((cents||0)/100).toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €'; }
  // API liefert amountPaid in Euro (numeric), nicht Cents. Helper normalisiert auf Cents für fmtPrice/Sums.
  function bAmountCents(b) {
    if (typeof b.amountCents === 'number') return b.amountCents;
    if (typeof b.priceCents === 'number') return b.priceCents;
    if (typeof b.amountPaid === 'number') return Math.round(b.amountPaid * 100);
    if (typeof b.amount_paid === 'number') return Math.round(b.amount_paid * 100);
    if (typeof b.amountPaid === 'string') { const n = parseFloat(b.amountPaid); return isNaN(n) ? 0 : Math.round(n * 100); }
    return 0;
  }
  function fmtDate(d) { if (!d) return '—'; const x = new Date(d); return x.toLocaleDateString('de-DE',{day:'2-digit',month:'short'}) + ' · ' + x.toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'}); }
  function statusOf(b) {
    const s = (b.status || b.paymentStatus || '').toLowerCase();
    if (s === 'cancelled' || s === 'canceled' || s === 'storniert' || b.cancelledAt) return 'cancelled';
    if (s === 'paid' || s === 'bezahlt' || s === 'completed' || b.paidAt) return 'paid';
    return 'open';
  }
  function statusLabel(s) { return ({paid:'Bezahlt', open:'Offen', cancelled:'Storniert'})[s] || s; }
  function statusPill(s) { return ({paid:'pill-ok', open:'pill-pending', cancelled:'pill-err'})[s] || ''; }
  function methodLabel(b) {
    const m = (b.paymentMethod || b.method || '').toLowerCase();
    if (m.includes('stripe') || m.includes('card') || m.includes('kart')) return 'Kreditkarte';
    if (m.includes('paypal')) return 'PayPal';
    if (m.includes('sepa')) return 'SEPA';
    if (m.includes('rechnung') || m.includes('invoice')) return 'Rechnung';
    if (m.includes('bar') || m.includes('cash')) return 'Bar';
    return b.paymentMethod || b.method || '—';
  }

  // ---------- KPIs (this month) ----------
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const prevMonthStart = new Date(now.getFullYear(), now.getMonth()-1, 1);
  const prevMonthEnd = new Date(now.getFullYear(), now.getMonth(), 0, 23, 59, 59);
  const monthBookings = bookings.filter(b => { const d = new Date(b.createdAt || b.bookedAt || 0); return d >= monthStart && statusOf(b) !== 'cancelled'; });
  const prevMonthBookings = bookings.filter(b => { const d = new Date(b.createdAt || b.bookedAt || 0); return d >= prevMonthStart && d <= prevMonthEnd && statusOf(b) !== 'cancelled'; });
  // Brutto-Umsatz: alle nicht-stornierten Buchungen (paid + offen). Onsite-Buchungen sind 'open' bis Provider als bezahlt markiert.
  const monthPaidRevenue = monthBookings.filter(b => statusOf(b) !== 'cancelled').reduce((s,b) => s + bAmountCents(b), 0);
  const prevMonthPaidRevenue = prevMonthBookings.filter(b => statusOf(b) !== 'cancelled').reduce((s,b) => s + bAmountCents(b), 0);
  const monthDelta = prevMonthBookings.length > 0 ? Math.round((monthBookings.length - prevMonthBookings.length)/prevMonthBookings.length*100) : null;
  const revDelta = prevMonthPaidRevenue > 0 ? Math.round((monthPaidRevenue - prevMonthPaidRevenue)/prevMonthPaidRevenue*100) : null;

  const counts = { all: bookings.length, paid: 0, open: 0, cancelled: 0 };
  bookings.forEach(b => { counts[statusOf(b)]++; });
  const openBookings = bookings.filter(b => statusOf(b) === 'open');
  const totalOpen = openBookings.reduce((s,b) => s + bAmountCents(b), 0);
  const recentCancel = bookings.filter(b => statusOf(b) === 'cancelled').sort((a,b) => new Date(b.cancelledAt || b.updatedAt || 0) - new Date(a.cancelledAt || a.updatedAt || 0))[0];

  const months = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
  document.getElementById('phBuchKicker').textContent = months[now.getMonth()] + ' ' + now.getFullYear() + ' · ' + bookings.length + ' Buchung' + (bookings.length === 1 ? '' : 'en') + ' insgesamt';
  const sub = document.getElementById('phBuchSub');
  if (bookings.length === 0) {
    sub.textContent = 'Noch keine Buchungen.';
  } else {
    sub.textContent = fmtPrice(monthPaidRevenue) + ' Umsatz · ' + counts.open + ' offen · ' + counts.cancelled + ' storniert · ' + counts.paid + ' bezahlt.';
  }
  document.getElementById('phBuchMonat').innerHTML = monthBookings.length + ' <em>Buchungen</em>';
  const monatDelta = document.getElementById('phBuchMonatDelta');
  if (monthDelta !== null) { monatDelta.className = 'stat-delta ' + (monthDelta >= 0 ? 'up' : 'down'); monatDelta.innerHTML = '<strong>' + (monthDelta >= 0 ? '+' : '') + monthDelta + ' %</strong> vs. ' + months[(now.getMonth()-1+12)%12]; }
  else { monatDelta.textContent = bookings.length === 0 ? 'Noch keine Buchungen' : 'Erstmonat'; }
  document.getElementById('phBuchUmsatz').innerHTML = (monthPaidRevenue/100).toLocaleString('de-DE', { maximumFractionDigits: 0 }) + '<em>€</em>';
  const uDelta = document.getElementById('phBuchUmsatzDelta');
  if (revDelta !== null) { uDelta.className = 'stat-delta ' + (revDelta >= 0 ? 'up' : 'down'); uDelta.innerHTML = '<strong>' + (revDelta >= 0 ? '+' : '') + revDelta + ' %</strong> vs. ' + months[(now.getMonth()-1+12)%12]; }
  else { uDelta.textContent = ' '; }
  document.getElementById('phBuchOffen').innerHTML = counts.open + ' <em>offen</em>';
  document.getElementById('phBuchOffenDelta').textContent = totalOpen > 0 ? fmtPrice(totalOpen) + ' ausstehend' : ' ';
  document.getElementById('phBuchStorno').innerHTML = counts.cancelled + ' <em>Stk.</em>';
  if (recentCancel) {
    const days = Math.floor((Date.now() - new Date(recentCancel.cancelledAt || recentCancel.updatedAt || 0)) / 86400000);
    document.getElementById('phBuchStornoDelta').textContent = days === 0 ? 'letzte: heute' : 'letzte: vor ' + days + ' Tag' + (days === 1 ? '' : 'en');
  } else {
    document.getElementById('phBuchStornoDelta').textContent = ' ';
  }

  // tab counts
  Object.keys(counts).forEach(k => {
    const el = document.querySelector('#phBuchTabs .count[data-count="' + k + '"]');
    if (el) el.textContent = counts[k];
  });

  // populate course filter
  const courseSel = document.getElementById('phBuchKurs');
  const courseTitles = new Set();
  bookings.forEach(b => { const t = b.activityName || b.activityTitle; if (t) courseTitles.add(t); });
  activities.forEach(a => { const t = a.title || a.name; if (t) courseTitles.add(t); });
  Array.from(courseTitles).sort().forEach(t => {
    const opt = document.createElement('option'); opt.value = t; opt.textContent = t; courseSel.appendChild(opt);
  });

  // ---------- Render ----------
  let activeStatus = 'all', activeCourse = 'all', activeRange = 'month';
  let showCancelled = false; // default: stornierte ausgeblendet im "Alle"-View

  function inRange(b) {
    const d = new Date(b.createdAt || b.bookedAt || 0);
    if (activeRange === 'all') return true;
    if (activeRange === 'month') return d >= monthStart;
    if (activeRange === 'prevmonth') return d >= prevMonthStart && d <= prevMonthEnd;
    if (activeRange === '7d') return d >= new Date(Date.now() - 7*86400000);
    if (activeRange === '30d') return d >= new Date(Date.now() - 30*86400000);
    if (activeRange === 'quarter') return d >= new Date(now.getFullYear(), Math.floor(now.getMonth()/3)*3, 1);
    return true;
  }

  function render() {
    let list = bookings.slice();
    if (activeStatus !== 'all') list = list.filter(b => statusOf(b) === activeStatus);
    else if (!showCancelled) list = list.filter(b => statusOf(b) !== 'cancelled');
    if (activeCourse !== 'all') list = list.filter(b => (b.activityName || b.activityTitle) === activeCourse);
    list = list.filter(inRange);
    list.sort((a,b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));

    const tbody = document.getElementById('phBuchTbody');
    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="padding:40px;color:var(--muted);text-align:center;font-size:13px">Keine Buchungen in dieser Ansicht.</td></tr>';
      return;
    }
    tbody.innerHTML = list.slice(0, 50).map(b => {
      const c = b.customer || {};
      const cname = c.name || c.email || b.customerName || 'Unbekannt';
      const childName = b.childName || (b.child && b.child.name) || '';
      const childInfo = childName ? '<div class="cust-sub">Kind: ' + escapeHtml(childName) + '</div>' : '';
      const initial = cname.charAt(0).toUpperCase();
      const s = statusOf(b);
      return '<tr style="cursor:default">'
        + '<td style="padding-left:20px;"><div class="cust"><div class="cust-av">' + escapeHtml(initial) + '</div><div class="cust-info"><div class="cust-name">' + escapeHtml(cname) + '</div>' + childInfo + '</div></div></td>'
        + '<td>' + escapeHtml(b.activityName || b.activityTitle || '—') + '</td>'
        + '<td>' + fmtDate(b.createdAt) + '</td>'
        + '<td>' + escapeHtml(methodLabel(b)) + '</td>'
        + '<td>' + fmtPrice(bAmountCents(b)) + '</td>'
        + '<td><span class="pill ' + statusPill(s) + '">' + statusLabel(s) + '</span></td>'
        + '<td style="padding-right:20px;text-align:right;">'
        + '<button class="row-action-btn" title="Ansehen" onclick="window.viewBookingDetail(\'' + b.id + '\')">⊙</button> '
        + '<button class="row-action-btn" title="Mehr Aktionen" onclick="window.handleBookingAction(\'' + b.id + '\', null, this)">⋯</button>'
        + '</td>'
        + '</tr>';
    }).join('');

    const pager = document.getElementById('phBuchPager');
    if (list.length > 50) {
      pager.style.display = 'flex';
      pager.innerHTML = '<div>1–50 von ' + list.length + ' Buchungen</div>';
    } else {
      pager.style.display = 'none';
    }
  }

  document.querySelectorAll('#phBuchTabs .filter-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('#phBuchTabs .filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status;
      render();
    };
  });
  document.getElementById('phBuchKurs').onchange = (e) => { activeCourse = e.target.value; render(); };
  document.getElementById('phBuchRange').onchange = (e) => { activeRange = e.target.value; render(); };
  const showCancelledBox = document.getElementById('phBuchShowCancelled');
  if (showCancelledBox) {
    showCancelledBox.checked = showCancelled;
    showCancelledBox.onchange = (e) => { showCancelled = !!e.target.checked; render(); };
  }

  render();
};


// ============================================================
// Sprint A.4: Kunden-Section Loader
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};
window.sectionLoaders.kunden = async function() {
  const state = window.dashboardState;
  if (!state) { console.warn('[v3] kunden: state not ready'); return; }
  const { provider, bookings, api } = state;

  function escapeHtml(str) { return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtPrice(cents) { return ((cents||0)/100).toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €'; }
  function fmtMonthYear(d) { if (!d) return '—'; const x = new Date(d); const months = ['Jan','Feb','Mrz','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez']; return months[x.getMonth()] + ' ' + x.getFullYear(); }
  function fmtDateShort(d) { if (!d) return '—'; const x = new Date(d); const today = new Date(); const days = Math.floor((today - x)/86400000); if (days === 0) return 'heute'; if (days === 1) return 'gestern'; if (days < 31) return new Date(d).toLocaleDateString('de-DE',{day:'2-digit',month:'short'}); return new Date(d).toLocaleDateString('de-DE',{day:'2-digit',month:'short'}); }
  function ageOfChild(c) {
    if (c.birthDate) { const m = (Date.now() - new Date(c.birthDate))/86400000/30.44; return m < 24 ? Math.floor(m) + ' Mo' : Math.floor(m/12) + ' J'; }
    if (c.ageMonths != null) return c.ageMonths < 24 ? c.ageMonths + ' Mo' : Math.floor(c.ageMonths/12) + ' J';
    if (c.birthYear) { const y = new Date().getFullYear() - c.birthYear; return y > 0 ? y + ' J' : (y === 0 ? '<1 J' : '?'); }
    if (c.age != null && c.age > 0) return c.age + ' J';
    return '?';
  }

  // Fetch full parents list
  let parents = [];
  try {
    const r = await api('/parents');
    parents = r.data || r.parents || r || [];
  } catch (e) { console.warn('[v3] /parents failed', e); }

  // Build children-per-parent from bookings (data-source-of-truth: provider_bookings.child_info)
  const childrenByParentId = {};
  const childrenByEmail = {};
  bookings.forEach(b => {
    const pid = b.parentId || (b.parent && b.parent.id) || (b.customer && b.customer.id);
    const email = (b.customer && b.customer.email) || b.customerEmail || (b.parent && b.parent.email);
    let chName = null, chFirst = null, chLast = null;
    if (b.child) {
      chName = b.child.name || (b.child.firstName ? (b.child.firstName + ' ' + (b.child.lastName || '')).trim() : null);
      chFirst = b.child.firstName || null;
      chLast = b.child.lastName || null;
    }
    if (!chName) return;
    const childRec = {
      name: chName,
      firstName: chFirst,
      lastName: chLast,
      birthYear: (b.child && (b.child.birthYear || b.child.birth_year)) || null,
      age: (b.child && b.child.age) || null,
    };
    if (pid) {
      if (!childrenByParentId[pid]) childrenByParentId[pid] = {};
      if (!childrenByParentId[pid][chName]) childrenByParentId[pid][chName] = childRec;
    }
    if (email) {
      const k = email.toLowerCase();
      if (!childrenByEmail[k]) childrenByEmail[k] = {};
      if (!childrenByEmail[k][chName]) childrenByEmail[k][chName] = childRec;
    }
  });

  // Aggregate per-parent bookings + revenue
  const byEmail = {};
  bookings.forEach(b => {
    const key = (b.customer && b.customer.email) || b.customerEmail || (b.parent && b.parent.email);
    if (!key) return;
    if (!byEmail[key]) byEmail[key] = { count: 0, revenue: 0, lastBooking: null, firstBooking: null };
    byEmail[key].count++;
    if ((b.status || b.paymentStatus || '').toLowerCase() === 'paid' || b.paidAt) {
      byEmail[key].revenue += (b.amountCents || b.priceCents || 0);
    }
    const d = new Date(b.createdAt || b.bookedAt || 0);
    if (!byEmail[key].lastBooking || d > new Date(byEmail[key].lastBooking)) byEmail[key].lastBooking = b.createdAt || b.bookedAt;
    if (!byEmail[key].firstBooking || d < new Date(byEmail[key].firstBooking)) byEmail[key].firstBooking = b.createdAt || b.bookedAt;
  });

  // Determine status per parent
  function statusOfParent(p) {
    if ((p.status || '').toLowerCase() === 'waitlist' || p.onWaitlist) return 'waitlist';
    const stats = byEmail[p.email] || {};
    if (!stats.lastBooking) return p.createdAt ? 'inactive' : 'active';
    const days = (Date.now() - new Date(stats.lastBooking))/86400000;
    if (days > 90) return 'inactive';
    return 'active';
  }
  function statusLabel(s) { return ({active:'Aktiv', waitlist:'Warteliste', inactive:'Inaktiv'})[s] || s; }
  function statusPill(s) { return ({active:'pill-ok', waitlist:'pill-pending', inactive:''})[s] || ''; }

  // KPIs
  const counts = { all: parents.length, active: 0, waitlist: 0, inactive: 0 };
  let totalRevenue = 0, returning = 0;
  parents.forEach(p => {
    const s = statusOfParent(p);
    counts[s]++;
    const stats = byEmail[p.email] || {};
    totalRevenue += stats.revenue || 0;
    if ((stats.count || 0) >= 2) returning++;
  });
  const avgRev = parents.length > 0 ? Math.round(totalRevenue / parents.length / 100) : 0;
  const returningPct = parents.length > 0 ? Math.round(returning / parents.length * 100) : 0;

  document.getElementById('phKundenKicker').textContent = 'Menschen · ' + parents.length + ' Famili' + (parents.length === 1 ? 'e' : 'en') + ' insgesamt';
  const sub = document.getElementById('phKundenSub');
  if (parents.length === 0) {
    sub.textContent = 'Noch keine Kunden — komme nach erster Buchung.';
  } else {
    sub.textContent = counts.active + ' aktive Famili' + (counts.active === 1 ? 'e' : 'en') + ' · ' + counts.waitlist + ' auf Warteliste · ' + counts.inactive + ' inaktiv seit > 90 Tagen.';
  }
  document.getElementById('phKundenAktiv').innerHTML = counts.active + ' <em>aktiv</em>';
  document.getElementById('phKundenAktivDelta').textContent = parents.length === 0 ? 'Noch leer' : ' ';
  document.getElementById('phKundenUmsatz').innerHTML = avgRev.toLocaleString('de-DE') + '<em>€</em>';
  document.getElementById('phKundenUmsatzDelta').textContent = parents.length === 0 ? ' ' : 'pro Familie · gesamt';
  document.getElementById('phKundenWarteliste').innerHTML = counts.waitlist + ' <em>offen</em>';
  document.getElementById('phKundenWartelisteDelta').textContent = ' ';
  document.getElementById('phKundenReturning').innerHTML = returningPct + '<em>%</em>';
  document.getElementById('phKundenReturningDelta').textContent = parents.length === 0 ? ' ' : 'mit ≥2 Buchungen';

  // tab counts
  Object.keys(counts).forEach(k => {
    const el = document.querySelector('#phKundenTabs .count[data-count="' + k + '"]');
    if (el) el.textContent = counts[k];
  });

  // course filter
  const courseSel = document.getElementById('phKundenKurs');
  const courseTitles = new Set();
  bookings.forEach(b => { const t = b.activityName || b.activityTitle; if (t) courseTitles.add(t); });
  Array.from(courseTitles).sort().forEach(t => {
    const opt = document.createElement('option'); opt.value = t; opt.textContent = t; courseSel.appendChild(opt);
  });

  let activeStatus = 'all', activeCourse = 'all', activeSort = 'lastactive';

  function render() {
    let list = parents.slice();
    if (activeStatus !== 'all') list = list.filter(p => statusOfParent(p) === activeStatus);
    if (activeCourse !== 'all') {
      const emails = new Set(bookings.filter(b => (b.activityName || b.activityTitle) === activeCourse).map(b => (b.customer && b.customer.email) || b.customerEmail).filter(Boolean));
      list = list.filter(p => emails.has(p.email));
    }
    list.sort((a,b) => {
      const sa = byEmail[a.email] || {}, sb = byEmail[b.email] || {};
      if (activeSort === 'name') return (a.name || '').localeCompare(b.name || '');
      if (activeSort === 'revenue') return (sb.revenue || 0) - (sa.revenue || 0);
      if (activeSort === 'firstvisit') return new Date(sa.firstBooking || a.createdAt || 0) - new Date(sb.firstBooking || b.createdAt || 0);
      return new Date(sb.lastBooking || b.createdAt || 0) - new Date(sa.lastBooking || a.createdAt || 0);
    });

    const tbody = document.getElementById('phKundenTbody');
    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="padding:40px;color:var(--muted);text-align:center;font-size:13px">Keine Kunden in dieser Ansicht.</td></tr>';
      return;
    }
    tbody.innerHTML = list.slice(0, 50).map(p => {
      const stats = byEmail[p.email] || {};
      const s = statusOfParent(p);
      const initial = (p.name || p.email || '?').charAt(0).toUpperCase();
      // Merge: parents.children (DB-stored) + childrenByParentId/Email (from bookings)
      const baseChildren = Array.isArray(p.children) ? p.children : [];
      const fromBookings = Object.values(childrenByParentId[p.id] || childrenByEmail[(p.email||'').toLowerCase()] || {});
      const merged = {};
      baseChildren.forEach(c => { if (c && c.name) merged[c.name] = c; });
      fromBookings.forEach(c => { if (c && c.name && !merged[c.name]) merged[c.name] = c; });
      const allChildren = Object.values(merged);
      const childYear = c => {
        if (c.birthDate) return new Date(c.birthDate).getFullYear();
        if (c.birthYear) return c.birthYear;
        return null;
      };
      const childMeta = c => {
        const y = childYear(c);
        const a = ageOfChild(c);
        return y ? (y + ' · ' + a) : a;
      };
      const kidsStr = allChildren.length > 0
        ? allChildren.map(c => escapeHtml(c.name || 'Kind') + ' <span style="color:var(--muted-2);font-size:11px">(' + childMeta(c) + ')</span>').join('<br>')
        : '<span style="color:var(--muted-2)">—</span>';
      const safeName = (p.name || '').replace(/'/g, '&#39;');
      const safeEmail = (p.email || '').replace(/'/g, '&#39;');
      return '<tr style="cursor:default">'
        + '<td style="padding-left:20px;"><div class="cust"><div class="cust-av">' + escapeHtml(initial) + '</div><div class="cust-info"><div class="cust-name" style="cursor:pointer" onclick="window.__kdShowParent(\'' + p.id + '\')">' + escapeHtml(p.name || 'Unbekannt') + '</div><div class="cust-sub">' + escapeHtml(p.email || '') + '</div></div></div></td>'
        + '<td>' + kidsStr + '</td>'
        + '<td>' + fmtMonthYear(stats.firstBooking || p.createdAt) + '</td>'
        + '<td>' + fmtDateShort(stats.lastBooking) + '</td>'
        + '<td>' + (stats.count > 0
            ? '<a class="card-link" style="cursor:pointer;font-weight:600" onclick="window.__kdShowParentBookings(\'' + p.id + '\', \'' + safeName + '\')">' + stats.count + '</a>'
            : '<span style="color:var(--muted-2)">0</span>') + '</td>'
        + '<td>' + fmtPrice(stats.revenue) + '<br><span style="font-size:11px;color:var(--muted)">insgesamt</span></td>'
        + '<td><span class="pill ' + statusPill(s) + '">' + statusLabel(s) + '</span></td>'
        + '<td style="padding-right:20px;text-align:right;white-space:nowrap;">'
        + '<button class="row-action-btn" title="Profil anzeigen" onclick="window.__kdShowParent(\'' + p.id + '\')">⊙</button> '
        + '<button class="row-action-btn" title="E-Mail" onclick="window.location.href=\'mailto:' + escapeHtml(p.email || '') + '\'">✉</button> '
        + '<button class="row-action-btn" title="Weitere Aktionen" onclick="window.__openKundenActions(event, \'' + p.id + '\', \'' + safeName + '\', \'' + safeEmail + '\')">⋯</button>'
        + '</td>'
        + '</tr>';
    }).join('');

    const pager = document.getElementById('phKundenPager');
    if (list.length > 50) {
      pager.style.display = 'flex';
      pager.innerHTML = '<div>1–50 von ' + list.length + ' Kunden</div>';
    } else {
      pager.style.display = 'none';
    }
  }

  document.querySelectorAll('#phKundenTabs .filter-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('#phKundenTabs .filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status;
      render();
    };
  });
  document.getElementById('phKundenKurs').onchange = (e) => { activeCourse = e.target.value; render(); };
  document.getElementById('phKundenSort').onchange = (e) => { activeSort = e.target.value; render(); };

  render();
};


// ============================================================
// Sprint A.2.1: Kurs-Creator API Integration
// ============================================================
(function() {
  function waitForState(cb, tries) {
    if (window.dashboardState && window.dashboardState.api) return cb();
    if ((tries||0) > 50) return; // 5s max
    setTimeout(function(){ waitForState(cb, (tries||0)+1); }, 100);
  }

  // Override window.openKursCreatorV2 to inject API callback + dynamic Trainers/Rooms
  waitForState(function() {
    var state = window.dashboardState;
    var origOpen = window.openKursCreatorV2;
    if (!origOpen) {
      console.warn('[v3] kurs-creator not loaded yet');
      return;
    }

    // Load rooms + team async, populate after modal opens
    async function populateLists(overlay) {
      try {
        const r = await state.api('/rooms');
        const rooms = r.data || r.rooms || r || [];
        const sel = overlay.querySelector('select[name="room"]');
        if (sel && rooms.length) {
          // Keep first option ("Kein Raum"), append real rooms
          rooms.forEach(function(rm) {
            var opt = document.createElement('option');
            opt.value = rm.id || rm.name;
            opt.textContent = rm.name || ('Raum ' + rm.id);
            sel.appendChild(opt);
          });
        }
      } catch (e) { console.warn('[v3] /rooms load failed', e); }

      try {
        const provider = state.provider;
        const r = await state.api('/providers/' + provider.id + '/team');
        const team = r.data || r.team || r.members || r || [];
        const sel = overlay.querySelector('select[name="trainer"]');
        if (sel) {
          // Clear existing mockup options except first ("Kein Kursleiter")
          while (sel.options.length > 1) sel.remove(1);
          team.forEach(function(m) {
            var opt = document.createElement('option');
            opt.value = m.id || m.userId || m.email;
            opt.textContent = m.name || m.displayName || m.email;
            sel.appendChild(opt);
          });
          // If no team members, hide trainer field or show hint
          if (team.length === 0) {
            sel.options[0].textContent = 'Noch kein Team angelegt';
          }
        }
      } catch (e) {
        // Endpoint may not exist yet — fall back to "no team"
        const sel = overlay.querySelector('select[name="trainer"]');
        if (sel) {
          while (sel.options.length > 1) sel.remove(1);
          sel.options[0].textContent = 'Noch kein Team angelegt';
        }
        console.warn('[v3] team load failed (ok if no team API)', e);
      }
    }

    // Wrap openKursCreatorV2 — inject our submit callback + populate lists
    window.openKursCreatorV2 = function(opts) {
      opts = opts || {};
      var userOnSubmit = opts.onSubmit;
      // Edit-Mode: skip POST wrapper, the userOnSubmit (PUT) handles persistence directly.
      if (opts.mode === 'edit' && typeof userOnSubmit === 'function') {
        opts.onSubmit = function(data) { userOnSubmit(data); };
        var resultEdit = origOpen.call(this, opts);
        setTimeout(function() {
          var overlay = document.querySelector('.ukc-kurs-overlay');
          if (overlay) populateLists(overlay);
        }, 50);
        return resultEdit;
      }
      opts.onSubmit = async function(data) {
        // Day mapping: modal uses German abbrev (MO/DI/MI/DO/FR/SA/SO),
        // API expects English (MO/TU/WE/TH/FR/SA/SU)
        const dayMap = { MO:'MO', DI:'TU', MI:'WE', DO:'TH', FR:'FR', SA:'SA', SO:'SU' };
        const slots = (data.schedule || [])
          .filter(s => s.day && s.start && s.end)
          .map(s => ({ day: dayMap[s.day] || s.day, startTime: s.start, endTime: s.end }));
        if (slots.length === 0) {
          alert('Bitte mindestens einen Tag mit Uhrzeit eingeben.');
          return;
        }
        const startDate = (data.schedule[0] && data.schedule[0].from) || new Date().toISOString().slice(0,10);
        const endDate = (data.schedule[0] && data.schedule[0].until) || undefined;

        // Pricing
        const priceTypeMap = { package: 'package', single: 'single', monthly: 'subscription', free: 'package' };
        const pricing = [{
          label: data.priceLabel || (data.priceModel === 'package' ? 'Paket' : 'Einzelstunde'),
          type: priceTypeMap[data.priceModel] || 'package',
          amount: parseFloat(data.priceAmount) || 0,
          currency: 'EUR',
          packageSize: data.priceModel === 'package' ? (parseInt(data.priceUnits) || 8) : undefined,
          intervalMonths: data.priceModel === 'monthly' ? (parseInt(data.priceUnits) || 1) : undefined,
          siblingDiscount: parseFloat(data.siblingDiscount) || 0,
        }];
        if (data.addSecondPrice && parseFloat(data.priceAmount2) > 0) {
          pricing.push({
            label: data.priceLabel2 || 'Zweite Option',
            type: priceTypeMap[data.priceModel2] || 'single',
            amount: parseFloat(data.priceAmount2),
            currency: 'EUR',
            packageSize: data.priceModel2 === 'package' ? (parseInt(data.priceUnits2) || 1) : undefined,
            intervalMonths: data.priceModel2 === 'monthly' ? (parseInt(data.priceUnits2) || 1) : undefined,
          });
        }

        // Filter out string-default values for instructor/room (they are placeholders, not UUIDs)
        const trainerVal = (data.trainer && data.trainer !== 'Kein Kursleiter zugewiesen' && data.trainer !== '') ? data.trainer : undefined;
        const roomVal = (data.room && data.room !== 'Kein Raum zugewiesen' && data.room !== '') ? data.room : undefined;

        const payload = {
          providerId: state.provider.id,
          title: data.title,
          description: data.description || '',
          category: data.category || 'sonstige',
          ageRange: (function() {
            function parseAge(v) {
              if (v == null) return { val: 0, unit: 'years' };
              var s = String(v);
              if (s.charAt(0) === 'm') return { val: parseInt(s.slice(1), 10) || 0, unit: 'months' };
              return { val: parseInt(s, 10) || 0, unit: 'years' };
            }
            var pmin = parseAge(data.ageMin);
            var pmax = parseAge(data.ageMax);
            // If units differ, normalize to months for safety (1J = 12 Mo)
            var unit = pmin.unit;
            if (pmin.unit !== pmax.unit) {
              var minM = pmin.unit === 'months' ? pmin.val : pmin.val * 12;
              var maxM = pmax.unit === 'months' ? pmax.val : pmax.val * 12;
              return { min: Math.min(minM, maxM), max: Math.max(minM, maxM), unit: 'months' };
            }
            return { min: Math.min(pmin.val, pmax.val), max: Math.max(pmin.val, pmax.val), unit: unit };
          })(),
          schedule: { type: 'recurring', slots, startDate, endDate },
          capacity: parseInt(data.capacity) || 10,
          pricing,
          paymentOnline: !!data.payOnline,
          paymentOnsite: !!data.payOnSite,
          waitlistEnabled: data.waitlistEnabled !== false,
          makeupCapacity: data.addUpSlots != null ? Math.max(0, parseInt(data.addUpSlots, 10)) : 2,
          color: data.color || undefined,
          // roomId  -> activities.room_id  (FK rooms.id)
          // instructorId -> activities.instructor_id (FK team_members.id)
          roomId: roomVal,
          instructorId: trainerVal,
        };
        try {
          console.log('[v3] POST /activities payload:', JSON.parse(JSON.stringify(payload)));
          const r = await state.api('/activities', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const saved = r.data || r.activity || r;
          state.activities.push(saved);
          if (location.hash === '#kurse' && window.sectionLoaders && window.sectionLoaders.kurse) {
            window.sectionLoaders.kurse();
          }
          // Update Sidebar-Badge + Dashboard-KPIs
          if (typeof window.refreshDashboardCards === 'function') window.refreshDashboardCards(); if (typeof window.renderWeekGlance === 'function') window.renderWeekGlance();
          console.log('[v3] Kurs angelegt:', saved);
        } catch (e) {
          console.error('[v3] Kurs anlegen failed', e);
          alert('Kurs konnte nicht gespeichert werden: ' + e.message);
        }
        if (typeof userOnSubmit === 'function') userOnSubmit(data);
      };
      const result = origOpen.call(this, opts);
      // After modal mounts, populate dynamic lists
      setTimeout(function() {
        const overlay = document.querySelector('.ukc-kurs-overlay');
        if (overlay) populateLists(overlay);
      }, 50);
      return result;
    };

    console.log('[v3] kurs-creator-v2 API integration ready');
  });
})();


// ============================================================
// Sprint A.2.4: Dashboard KPI Refresh Helper
// ============================================================
window.refreshDashboardCards = function() {
  const state = window.dashboardState;
  if (!state) return;
  const { activities, bookings } = state;
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const monthBookings = bookings.filter(b => { const d = new Date(b.createdAt || b.bookedAt || 0); return d >= monthStart && (b.status||'').toLowerCase() !== 'cancelled'; });
  const monthRevenue = monthBookings.reduce((s,b) => s + (b.amountCents || b.priceCents || 0), 0);
  const activeCourses = activities.filter(a => !a.archivedAt && !a.deletedAt && a.status !== 'archived' && a.status !== 'cancelled').length;
  const customerCount = new Set(bookings.map(b => (b.customer && b.customer.email) || b.customerEmail).filter(Boolean)).size;

  // Dashboard stats — must use scoped query (only dashboard section's stats)
  const dashSec = document.querySelector('[data-section="dashboard"] .stats');
  if (dashSec) {
    const stats = dashSec.querySelectorAll('.stat');
    if (stats[0]) {
      const v = stats[0].querySelector('.stat-value'); if (v) v.innerHTML = monthBookings.length + ' <em>Stück</em>';
    }
    if (stats[1]) {
      const v = stats[1].querySelector('.stat-value'); if (v) v.innerHTML = (monthRevenue/100).toLocaleString('de-DE',{maximumFractionDigits:0}) + '<em>€</em>';
    }
    if (stats[2]) {
      const v = stats[2].querySelector('.stat-value'); if (v) v.innerHTML = activeCourses + ' <em>laufend</em>';
      const d = stats[2].querySelector('.stat-delta'); if (d) d.textContent = activeCourses === 0 ? 'Lege deinen ersten Kurs an' : ' ';
    }
  }

  // Sidebar badges
  document.querySelectorAll('button.nav-item').forEach(btn => {
    const target = btn.dataset.sectionTarget;
    const badge = btn.querySelector('.badge');
    if (!badge || !target) return;
    switch(target) {
      case 'kurse': badge.textContent = activeCourses; break;
      case 'buchungen': badge.textContent = bookings.length; break;
      case 'kunden': badge.textContent = customerCount; break;
    }
  });
};

// Re-run on hash → #dashboard navigation
window.addEventListener('hashchange', function() {
  if (location.hash === '#dashboard' || location.hash === '') {
    setTimeout(window.refreshDashboardCards, 50);
  }
});


// ============================================================
// Sprint B.1: Probestunden-Section Loader
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};
window.sectionLoaders.probestunden = async function() {
  const state = window.dashboardState;
  if (!state) { console.warn('[v3] probestunden: state not ready'); return; }
  const { provider, api } = state;

  function escapeHtml(str) { return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtDate(d) {
    if (!d) return '—';
    const x = new Date(d);
    const days = ['So','Mo','Di','Mi','Do','Fr','Sa'];
    const months = ['Jan','Feb','Mrz','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
    return days[x.getDay()] + ' ' + x.getDate() + '. ' + months[x.getMonth()];
  }
  function fmtTime(d, dur) {
    if (!d) return '';
    const x = new Date(d);
    const start = x.toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'});
    if (!dur) return start;
    const end = new Date(x.getTime() + dur*60000);
    return start + ' – ' + end.toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'});
  }

  let trials = [];
  try {
    const r = await api('/providers/' + provider.id + '/trials');
    trials = r.data || r.trials || r || [];
  } catch (e) { console.warn('[v3] /trials failed', e); }

  // Status-Buckets
  const now = new Date();
  const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const todayEnd = new Date(todayStart.getTime() + 86400000);
  const weekStart = new Date(todayStart.getTime() - todayStart.getDay() * 86400000);
  const weekEnd = new Date(weekStart.getTime() + 7*86400000);

  function bucketOf(t) {
    const s = (t.status || '').toLowerCase();
    if (s === 'cancelled' || s === 'canceled' || s === 'no_show' || s === 'noshow' || t.cancelledAt) return 'cancelled';
    const d = new Date(t.scheduledAt || t.dateTime || t.startsAt || 0);
    if (s === 'completed' && !t.convertedAt) return 'followup';
    if (d >= todayStart && d < todayEnd) return 'today';
    if (d >= now) return 'upcoming';
    return 'all';
  }

  const counts = { upcoming: 0, today: 0, followup: 0, cancelled: 0, all: trials.length };
  let weekCount = 0, momGraphCount = 0, completedCount = 0, convertedCount = 0;
  trials.forEach(t => {
    counts[bucketOf(t)] = (counts[bucketOf(t)] || 0) + 1;
    const d = new Date(t.scheduledAt || t.dateTime || t.startsAt || 0);
    if (d >= weekStart && d < weekEnd) weekCount++;
    if (t.via === 'mom-graph' || t.source === 'mom-graph' || t.referredBy) momGraphCount++;
    if ((t.status || '').toLowerCase() === 'completed' || t.convertedAt) completedCount++;
    if (t.convertedAt || (t.status || '').toLowerCase() === 'converted') convertedCount++;
  });
  const conv = completedCount > 0 ? Math.round(convertedCount / completedCount * 100) : 0;
  const mgPct = trials.length > 0 ? Math.round(momGraphCount / trials.length * 100) : 0;

  document.getElementById('phTrialsSub').textContent = trials.length === 0
    ? 'Noch keine Probestunden geplant.'
    : counts.upcoming + ' bevorstehend · ' + counts.today + ' heute · ' + counts.followup + ' Follow-ups · aus Schnuppern werden Buchungen.';

  document.getElementById('phTrialsWeek').textContent = weekCount;
  document.getElementById('phTrialsWeekDelta').textContent = weekCount === 0 ? 'Noch leer' : ' ';
  document.getElementById('phTrialsConv').textContent = trials.length === 0 ? '–' : conv + '%';
  document.getElementById('phTrialsOpen').textContent = counts.followup;
  document.getElementById('phTrialsMG').textContent = momGraphCount;
  document.getElementById('phTrialsMGDelta').textContent = trials.length === 0 ? ' ' : mgPct + '% aller Trials';

  Object.keys(counts).forEach(k => {
    const el = document.querySelector('#phTrialsTabs .badge[data-count="' + k + '"]');
    if (el) el.textContent = counts[k];
  });

  let activeStatus = 'upcoming';

  function render() {
    let list = trials.slice();
    if (activeStatus !== 'all') list = list.filter(t => bucketOf(t) === activeStatus);
    list.sort((a,b) => new Date(a.scheduledAt || a.dateTime || a.startsAt || 0) - new Date(b.scheduledAt || b.dateTime || b.startsAt || 0));
    const tbody = document.getElementById('phTrialsTbody');
    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="padding:40px;color:var(--muted);text-align:center;font-size:13px">Keine Probestunden in dieser Ansicht.</td></tr>';
      return;
    }
    tbody.innerHTML = list.slice(0, 50).map(t => {
      const d = t.scheduledAt || t.dateTime || t.startsAt;
      const dur = t.durationMinutes || t.duration || 45;
      const child = t.childName || (t.child && t.child.name) || '—';
      const childAge = t.childAgeMonths ? (t.childAgeMonths < 24 ? t.childAgeMonths + ' Mo' : Math.floor(t.childAgeMonths/12) + ' J.') : '';
      const parent = t.parentName || (t.parent && t.parent.name) || '—';
      const phone = (t.parent && t.parent.phone) || t.parentPhone || '';
      const room = t.roomName || (t.room && t.room.name) || '';
      const origin = t.via || t.source || (t.referredBy ? 'mom-graph' : 'direkt');
      const originLabel = origin === 'mom-graph' ? 'Mom-Graph' : (origin === 'widget' ? 'Widget' : 'Direkt');
      const originPill = origin === 'mom-graph' ? 'origin-momgraph' : (origin === 'widget' ? 'origin-widget' : 'origin-direct');
      const refBy = t.referredByName ? '<br><span class="cell-sub">via ' + escapeHtml(t.referredByName) + '</span>' : '';
      const status = (t.status || '').toLowerCase();
      const statusLabels = { confirmed: 'Bestätigt', scheduled: 'Geplant', completed: 'Abgeschlossen', no_show: 'No-Show', cancelled: 'Storniert', converted: 'Konvertiert' };
      const statusClasses = { confirmed: 'status-active', scheduled: 'status-active', completed: 'status-info', no_show: 'status-warn', cancelled: 'status-err', converted: 'status-success' };
      const statusLabel = statusLabels[status] || (status.charAt(0).toUpperCase() + status.slice(1)) || 'Geplant';
      const statusCls = statusClasses[status] || 'status-active';
      return '<tr>'
        + '<td><strong>' + fmtDate(d) + '</strong><br><span class="cell-sub">' + fmtTime(d, dur) + '</span></td>'
        + '<td>' + escapeHtml(t.activityName || t.activityTitle || '—') + (room ? '<br><span class="cell-sub">' + escapeHtml(room) + '</span>' : '') + '</td>'
        + '<td>' + escapeHtml(child) + (childAge ? '<br><span class="cell-sub">' + childAge + '</span>' : '') + '</td>'
        + '<td>' + escapeHtml(parent) + (phone ? '<br><span class="cell-sub">' + escapeHtml(phone) + '</span>' : '') + '</td>'
        + '<td><span class="origin-pill ' + originPill + '">' + originLabel + '</span>' + refBy + '</td>'
        + '<td><span class="status-pill ' + statusCls + '">' + statusLabel + '</span></td>'
        + '<td class="table-actions"><button class="btn btn-ghost btn-sm" onclick="alert(\'Bearbeiten folgt\')">Bearbeiten</button></td>'
        + '</tr>';
    }).join('');
  }

  document.querySelectorAll('#phTrialsTabs .filter-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('#phTrialsTabs .filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status;
      render();
    };
  });

  render();
};


// ============================================================
// Sprint B.2: Kursbloecke-Section Loader
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};
window.sectionLoaders.kursbloecke = async function() {
  const state = window.dashboardState;
  if (!state) { console.warn('[v3] kursbloecke: state not ready'); return; }
  const { provider, api } = state;

  function escapeHtml(str) { return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtDate(d) {
    if (!d) return '—';
    const x = new Date(d);
    const months = ['Jan','Feb','Mrz','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
    return x.getDate() + '. ' + months[x.getMonth()] + ' ' + x.getFullYear();
  }
  function statusOf(b) {
    const s = (b.status || '').toLowerCase();
    if (s === 'archived' || b.archivedAt) return 'archived';
    // Activity-Pause = Parent-Status: pausiert den Block automatisch mit. Block kann eigenständig pausiert sein.
    const _aid = b.activityId || b.activity_id;
    const _pa = _aid ? actMap[_aid] : null;
    const activityPaused = _pa && (_pa.status === 'paused' || _pa.pausedAt);
    if (s === 'paused' || b.pausedAt || activityPaused) return 'paused';
    if (s === 'planning' || s === 'draft' || (b.startDate && new Date(b.startDate) > new Date())) return 'planning';
    return 'active';
  }
  function statusLabel(s) { return ({active:'Laufend', planning:'Geplant', paused:'Pausiert', archived:'Archiviert'})[s] || s; }
  function statusCls(s) { return ({active:'status-active', planning:'status-info', paused:'status-archived', archived:'status-archived'})[s] || ''; }

  let blocks = [];
  try {
    const r = await api('/providers/' + provider.id + '/course-blocks');
    blocks = r.data || r.blocks || r || [];
  } catch (e) { console.warn('[v3] /course-blocks failed', e); }

  // Activity-Lookup: Block API gibt activityId zurück, aber kein activityName/Title.
  // Falls state.activities leer ist, fetchen wir nach.
  let activities = state.activities || [];
  if (activities.length === 0) {
    try {
      const r = await api('/providers/' + provider.id + '/activities');
      activities = r.data || r.activities || r || [];
      state.activities = activities;
    } catch (e) { console.warn('[v3] activities reload failed', e); }
  }
  const actMap = {};
  activities.forEach(function(a) { if (a && a.id) actMap[a.id] = a; });
  console.log('[v3] kursbloecke: blocks=', blocks.length, 'activities=', activities.length, 'actMap-keys=', Object.keys(actMap).length);
  blocks.forEach(function(b) {
    const aid = b.activityId || b.activity_id;
    const a = aid ? actMap[aid] : null;
    if (a) {
      // Override even if activityName already exists — backend's value may be empty
      b.activityName = a.title || a.name || b.activityName || b.activityTitle || '';
      if (!b.capacity) b.capacity = a.capacity || a.maxParticipants || 0;
    }
    if (!b.activityName && !b.activityTitle) {
      console.warn('[v3] block has no activity match', { blockId: b.id, activityId: aid });
    }
  });

  // Block-Nummerierung pro Kurs: fortlaufend nach startDate (1, 2, 3, …).
  // Wenn Backend einen seasonLabel liefert (manuell vergeben), respektieren wir den.
  const blocksByActivity = {};
  blocks.forEach(function(b) {
    const aid = b.activityId || b.activity_id;
    if (!aid) return;
    if (!blocksByActivity[aid]) blocksByActivity[aid] = [];
    blocksByActivity[aid].push(b);
  });
  Object.keys(blocksByActivity).forEach(function(aid) {
    blocksByActivity[aid]
      .sort(function(x, y) { return new Date(x.startDate || x.start_date || 0) - new Date(y.startDate || y.start_date || 0); })
      .forEach(function(b, idx) { b._blockNumber = idx + 1; });
  });

  const counts = { all: blocks.length, active: 0, planning: 0, paused: 0, archived: 0 };
  blocks.forEach(b => { counts[statusOf(b)] = (counts[statusOf(b)] || 0) + 1; });

  document.getElementById('phBlocksSub').textContent = blocks.length === 0
    ? 'Noch keine Kursblöcke. Wenn du einen Kurs anlegst, wird automatisch ein Block 1 mit Sessions erstellt.'
    : counts.active + ' laufend · ' + counts.planning + ' geplant · ' + (counts.paused ? counts.paused + ' pausiert · ' : '') + counts.archived + ' archiviert.';

  Object.keys(counts).forEach(k => {
    const el = document.querySelector('#phBlocksTabs .badge[data-count="' + k + '"]');
    if (el) el.textContent = counts[k];
  });

  let activeStatus = 'all';

  function render() {
    let list = blocks.slice();
    if (activeStatus !== 'all') list = list.filter(b => statusOf(b) === activeStatus);
    list.sort((a,b) => new Date(b.startDate || b.createdAt || 0) - new Date(a.startDate || a.createdAt || 0));
    const grid = document.getElementById('phBlocksGrid');
    if (list.length === 0) {
      grid.innerHTML = '<div style="grid-column:1/-1;padding:40px;color:var(--muted);text-align:center;font-size:13px">Keine Blöcke in dieser Ansicht.</div>';
      return;
    }
    grid.innerHTML = list.map(b => {
      const totalSessions = b.totalSessions || b.total_sessions || 0;
      const completed = b.completedSessions || b.completed_sessions || 0;
      // Count from in-memory bookings filtered by activityId (most reliable)
      let enrolled = b.enrollmentCount || b.enrolled_count || b.enrolled;
      if (enrolled == null || enrolled === 0) {
        const dashState = window.dashboardState;
        const allB = (dashState && dashState.bookings) || [];
        enrolled = allB.filter(function(x) {
          return x && x.activityId === (b.activityId || b.activity_id) && x.status !== 'cancelled' && x.status !== 'refunded';
        }).length;
      }
      const cap = b.capacity || 0;
      const pct = totalSessions > 0 ? Math.round(completed/totalSessions*100) : 0;
      const s = statusOf(b);
      const dayMap = { MO:'Mo', TU:'Di', WE:'Mi', TH:'Do', FR:'Fr', SA:'Sa', SU:'So' };
      const dayLabel = dayMap[(b.recurringDay || b.recurring_day || '').toUpperCase()] || '';
      const rawTime = b.recurringTime || b.recurring_time || '';
      const startHM = rawTime ? String(rawTime).slice(0, 5) : '';
      const durMin = b.durationMinutes || b.duration_minutes || 0;
      let endHM = '';
      if (startHM && durMin) {
        const sh = parseInt(startHM.slice(0,2), 10);
        const sm = parseInt(startHM.slice(3,5), 10);
        const total = sh*60 + sm + durMin;
        endHM = String(Math.floor(total/60)).padStart(2,'0') + ':' + String(total%60).padStart(2,'0');
      }
      const time = startHM ? (startHM + (endHM ? '–' + endHM : '')) : '';
      const room = b.roomName || (b.room && b.room.name) || (window.__kalRoomName ? window.__kalRoomName(b.roomId || b.room_id) : '') || '';
      const roomLine = (room || dayLabel) ? (room + (room && (dayLabel || time) ? ' · ' : '') + dayLabel + (time ? ' ' + time : '')) : '—';
      // Title: fett der Kursname, darunter italic Block-Nummerierung.
      const courseTitle = b.activityName || b.activityTitle || (b.activityId && actMap[b.activityId] ? (actMap[b.activityId].title || actMap[b.activityId].name) : '') || 'Kurs';
      const blockLabel = b.seasonLabel || b.season_label || ('Block ' + (b._blockNumber || 1));
      return '<article class="block-card">'
        + '<div class="block-card-head"><div class="block-badge">' + totalSessions + ' Wochen</div><div class="status-pill ' + statusCls(s) + '">' + statusLabel(s) + '</div></div>'
        + '<h3 class="block-title">' + escapeHtml(courseTitle) + '</h3>'
        + '<div class="italic" style="font-size:18px;color:var(--ink-2);margin-top:-8px">' + escapeHtml(blockLabel) + '</div>'
        + '<div class="block-meta">'
        + '<div class="block-meta-row"><span class="block-meta-label">Start</span><span class="block-meta-val">' + fmtDate(b.startDate || b.start_date) + '</span></div>'
        + '<div class="block-meta-row"><span class="block-meta-label">Ende</span><span class="block-meta-val">' + fmtDate(b.endDate || b.end_date) + '</span></div>'
        + '<div class="block-meta-row"><span class="block-meta-label">Teilnehmer</span><span class="block-meta-val">' + enrolled + ' · ' + cap + '</span></div>'
        + '<div class="block-meta-row"><span class="block-meta-label">Raum</span><span class="block-meta-val">' + escapeHtml(roomLine) + '</span></div>'
        + '</div>'
        + '<div class="progress-wrap"><div class="progress-bar" style="width:' + pct + '%"></div></div>'
        + '<div class="block-foot"><span class="progress-label">Woche ' + completed + ' · ' + completed + ' / ' + totalSessions + '</span><button class="btn btn-ghost btn-sm" onclick="window.viewBlockDetail(\'' + b.id + '\')">Details</button></div>'
        + '</article>';
    }).join('');
  }

  document.querySelectorAll('#phBlocksTabs .filter-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('#phBlocksTabs .filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status;
      render();
    };
  });

  render();
};


// ============================================================
// Sprint B.3: Rechnungen-Section Loader
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};
window.sectionLoaders.rechnungen = async function() {
  const state = window.dashboardState;
  if (!state) { console.warn('[v3] rechnungen: state not ready'); return; }
  const { provider, api } = state;

  function escapeHtml(str) { return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtPrice(cents) { return ((cents||0)/100).toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €'; }
  function fmtDate(d) { if (!d) return '—'; return new Date(d).toLocaleDateString('de-DE',{day:'2-digit',month:'short',year:'numeric'}); }
  function statusOf(inv) {
    const s = (inv.status || '').toLowerCase();
    if (s === 'draft' || s === 'entwurf') return 'draft';
    if (s === 'paid' || s === 'bezahlt' || inv.paidAt) return 'paid';
    if (s === 'cancelled' || s === 'canceled' || s === 'storniert') return 'cancelled';
    if (inv.dueAt && new Date(inv.dueAt) < new Date()) return 'overdue';
    return 'open';
  }
  function statusLabel(s) { return ({paid:'Bezahlt', open:'Offen', overdue:'Überfällig', draft:'Entwurf', cancelled:'Storniert'})[s] || s; }
  function statusPill(s) { return ({paid:'pill-ok', open:'pill-pending', overdue:'pill-err', draft:'', cancelled:'pill-err'})[s] || ''; }

  let invoices = [];
  try {
    const r = await api('/providers/' + provider.id + '/invoices');
    invoices = r.data || r.invoices || r || [];
  } catch (e) { console.warn('[v3] /invoices failed', e); }

  // ---- KPIs ----
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const months = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
  const monthInvs = invoices.filter(i => { const d = new Date(i.createdAt || i.issuedAt || 0); return d >= monthStart; });
  const monthRevenue = monthInvs.filter(i => statusOf(i) === 'paid').reduce((s,i) => s + (i.amountCents || i.totalCents || 0), 0);
  const openSum = invoices.filter(i => statusOf(i) === 'open').reduce((s,i) => s + (i.amountCents || i.totalCents || 0), 0);
  const overdueInvs = invoices.filter(i => statusOf(i) === 'overdue');
  const overdueSum = overdueInvs.reduce((s,i) => s + (i.amountCents || i.totalCents || 0), 0);

  // Average payment days
  const paidWithDays = invoices.filter(i => statusOf(i) === 'paid' && i.paidAt && (i.issuedAt || i.createdAt));
  const avgDays = paidWithDays.length > 0
    ? (paidWithDays.reduce((s,i) => s + (new Date(i.paidAt) - new Date(i.issuedAt || i.createdAt))/86400000, 0) / paidWithDays.length).toFixed(1)
    : '–';

  const counts = { all: invoices.length, paid: 0, open: 0, overdue: 0, draft: 0, cancelled: 0 };
  invoices.forEach(i => { counts[statusOf(i)]++; });

  document.getElementById('phInvKicker').textContent = 'Rechnungsausgang · ' + months[now.getMonth()] + ' ' + now.getFullYear();
  document.getElementById('phInvSub').textContent = invoices.length === 0
    ? 'Noch keine Rechnungen erstellt.'
    : invoices.length + ' Rechnungen insgesamt · ' + counts.paid + ' bezahlt · ' + counts.open + ' offen · ' + counts.overdue + ' überfällig.';

  document.getElementById('phInvRevenue').innerHTML = (monthRevenue/100).toLocaleString('de-DE',{maximumFractionDigits:0}) + '<em>€</em>';
  document.getElementById('phInvRevenueDelta').textContent = invoices.length === 0 ? 'Noch leer' : ' ';
  document.getElementById('phInvOpen').innerHTML = (openSum/100).toLocaleString('de-DE',{maximumFractionDigits:0}) + '<em>€</em>';
  document.getElementById('phInvOpenDelta').textContent = counts.open + ' Rechnung' + (counts.open === 1 ? '' : 'en');
  document.getElementById('phInvOverdue').innerHTML = (overdueSum/100).toLocaleString('de-DE',{maximumFractionDigits:0}) + '<em>€</em>';
  document.getElementById('phInvOverdueDelta').textContent = counts.overdue === 0 ? ' ' : counts.overdue + ' Mahnung' + (counts.overdue === 1 ? '' : 'en') + ' fällig';
  document.getElementById('phInvAvgPay').innerHTML = avgDays + ' <em>Tage</em>';
  document.getElementById('phInvAvgPayDelta').textContent = paidWithDays.length === 0 ? ' ' : ' ';

  Object.keys(counts).forEach(k => {
    const el = document.querySelector('#phInvTabs .count[data-count="' + k + '"]');
    if (el) el.textContent = counts[k];
  });

  let activeStatus = 'all', activeRange = 'month', activeSort = 'newest';

  function inRange(i) {
    const d = new Date(i.createdAt || i.issuedAt || 0);
    if (activeRange === 'all') return true;
    if (activeRange === 'month') return d >= monthStart;
    if (activeRange === '30d') return d >= new Date(Date.now() - 30*86400000);
    if (activeRange === 'quarter') return d >= new Date(now.getFullYear(), Math.floor(now.getMonth()/3)*3, 1);
    if (activeRange === 'year') return d >= new Date(now.getFullYear(), 0, 1);
    return true;
  }

  function render() {
    let list = invoices.slice();
    if (activeStatus !== 'all') list = list.filter(i => statusOf(i) === activeStatus);
    list = list.filter(inRange);
    list.sort((a,b) => {
      if (activeSort === 'amount') return (b.amountCents||b.totalCents||0) - (a.amountCents||a.totalCents||0);
      if (activeSort === 'due') return new Date(a.dueAt || 0) - new Date(b.dueAt || 0);
      if (activeSort === 'overdue') {
        const oa = (statusOf(a) === 'overdue') ? (Date.now() - new Date(a.dueAt)) : -1;
        const ob = (statusOf(b) === 'overdue') ? (Date.now() - new Date(b.dueAt)) : -1;
        return ob - oa;
      }
      return new Date(b.createdAt || b.issuedAt || 0) - new Date(a.createdAt || a.issuedAt || 0);
    });

    const tbody = document.getElementById('phInvTbody');
    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="padding:40px;color:var(--muted);text-align:center;font-size:13px">Keine Rechnungen in dieser Ansicht.</td></tr>';
      return;
    }
    tbody.innerHTML = list.slice(0, 50).map(i => {
      const c = i.customer || {};
      const cname = c.name || c.email || i.customerName || 'Unbekannt';
      const activity = i.activityName || i.activityTitle || (i.lineItems && i.lineItems[0] && i.lineItems[0].title) || '';
      const s = statusOf(i);
      const num = i.invoiceNumber || i.number || '—';
      return '<tr>'
        + '<td style="padding-left:20px;"><strong>' + escapeHtml(num) + '</strong></td>'
        + '<td>' + escapeHtml(cname) + (activity ? '<br><span style="font-size:11px;color:var(--muted)">' + escapeHtml(activity) + '</span>' : '') + '</td>'
        + '<td>' + fmtDate(i.dueAt) + '</td>'
        + '<td>' + fmtPrice(i.amountCents || i.totalCents) + '</td>'
        + '<td><span class="pill ' + statusPill(s) + '">' + statusLabel(s) + '</span></td>'
        + '<td style="padding-right:20px;text-align:right;">'
        + '<button class="row-action-btn" title="Ansehen" onclick="window.viewInvoiceDetail(\'' + (i.id || '') + '\')">⊙</button> '
        + '<button class="row-action-btn" title="Erinnerung senden" onclick="window.__invoiceSendReminder(\'' + (i.id || '') + '\', \'' + escapeHtml(num) + '\')">✉</button> '
        + '<button class="row-action-btn" title="Mehr Aktionen" onclick="window.__invoiceMore(\'' + (i.id || '') + '\', \'' + s + '\', \'' + escapeHtml(num) + '\', this)">⋯</button>'
        + '</td>'
        + '</tr>';
    }).join('');
  }

  // ─── Aktionen-Menu pro Rechnung ────────────────────────────
  window.__invoiceMore = function(id, status, num, btn) {
    document.querySelectorAll('.inv-pop').forEach(p => p.remove());
    var pop = document.createElement('div');
    pop.className = 'inv-pop';
    pop.style.cssText = 'position:absolute;background:var(--bg);border:1px solid var(--border);border-radius:10px;box-shadow:0 6px 24px rgba(31,29,24,0.12);padding:6px;z-index:200;min-width:200px;font-size:13px;';
    var rect = btn.getBoundingClientRect();
    pop.style.top = (rect.bottom + window.scrollY + 4) + 'px';
    pop.style.left = (rect.right + window.scrollX - 200) + 'px';

    function mkItem(label, danger, onClick) {
      var a = document.createElement('button');
      a.className = 'inv-pop-item';
      a.style.cssText = 'display:block;width:100%;text-align:left;padding:9px 12px;background:transparent;border:0;cursor:pointer;border-radius:6px;font-size:13px;color:' + (danger ? 'var(--danger,#B8392A)' : 'var(--ink)') + ';';
      a.textContent = label;
      a.onmouseenter = function(){ a.style.background = 'var(--surface)'; };
      a.onmouseleave = function(){ a.style.background = 'transparent'; };
      a.onclick = function(){ pop.remove(); onClick(); };
      pop.appendChild(a);
    }

    mkItem('PDF herunterladen', false, function(){ window.open('/api/invoices/' + id + '/view', '_blank'); });

    if (status === 'draft') {
      mkItem('Versenden', false, function(){ window.__invoiceSend(id, num); });
      mkItem('Löschen', true, function(){ window.__invoiceDelete(id, num); });
    } else if (status === 'sent' || status === 'open' || status === 'overdue') {
      mkItem('Als bezahlt markieren', false, function(){ window.__invoiceMarkPaid(id, num); });
      mkItem('Stornieren (→ Storno-Rechnung)', true, function(){ window.__invoiceCancel(id, num); });
    } else if (status === 'paid') {
      mkItem('Stornieren (→ Storno-Rechnung)', true, function(){ window.__invoiceCancel(id, num); });
    }
    document.body.appendChild(pop);
    setTimeout(function(){
      var close = function(e){ if (!pop.contains(e.target) && e.target !== btn) { pop.remove(); document.removeEventListener('click', close); } };
      document.addEventListener('click', close);
    }, 0);
  };

  window.__invoiceSendReminder = async function(id, num) {
    if (!confirm('Zahlungserinnerung für Rechnung ' + num + ' senden?')) return;
    try {
      // Re-send via POST /api/invoices/:id/send (existing endpoint). Backend kümmert sich um Email.
      var resp = await api('/invoices/' + id + '/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
      if (window.ukcToast) window.ukcToast('Erinnerung versendet');
    } catch(e) {
      alert('Fehler: ' + (e.message || e));
    }
  };

  window.__invoiceSend = async function(id, num) {
    if (!confirm('Rechnung ' + num + ' jetzt an den Kunden versenden? Die Rechnung wird damit final gespeichert (Entwurf wird ungültig).')) return;
    try {
      await api('/invoices/' + id + '/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
      if (window.ukcToast) window.ukcToast('Rechnung versendet');
      window.sectionLoaders.rechnungen();
    } catch(e) { alert('Fehler: ' + (e.message || e)); }
  };

  window.__invoiceMarkPaid = async function(id, num) {
    if (!confirm('Rechnung ' + num + ' als bezahlt markieren?')) return;
    try {
      await api('/invoices/' + id + '/pay', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
      if (window.ukcToast) window.ukcToast('Rechnung als bezahlt markiert');
      window.sectionLoaders.rechnungen();
    } catch(e) { alert('Fehler: ' + (e.message || e)); }
  };

  window.__invoiceCancel = async function(id, num) {
    if (!confirm('Rechnung ' + num + ' wirklich stornieren?\n\nDa die Rechnung bereits versendet/bezahlt wurde, wird automatisch eine Storno-Rechnung mit negativen Beträgen erstellt (§14 UStG).')) return;
    try {
      await api('/invoices/' + id + '/cancel', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
      if (window.ukcToast) window.ukcToast('Rechnung storniert · Storno-Rechnung erstellt');
      window.sectionLoaders.rechnungen();
    } catch(e) { alert('Fehler: ' + (e.message || e)); }
  };

  window.__invoiceDelete = async function(id, num) {
    if (!confirm('Entwurf ' + num + ' endgültig löschen?\n\nDas ist erlaubt, weil die Rechnung noch nicht versendet wurde.')) return;
    try {
      await api('/invoices/' + id, { method: 'DELETE' });
      if (window.ukcToast) window.ukcToast('Entwurf gelöscht');
      window.sectionLoaders.rechnungen();
    } catch(e) { alert('Fehler: ' + (e.message || e)); }
  };

  document.querySelectorAll('#phInvTabs .filter-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('#phInvTabs .filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status;
      render();
    };
  });
  document.getElementById('phInvRange').onchange = (e) => { activeRange = e.target.value; render(); };
  document.getElementById('phInvSort').onchange = (e) => { activeSort = e.target.value; render(); };

  render();
};


// ============================================================
// Sprint B.4: Anwesenheit-Section Loader
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};
window.sectionLoaders.anwesenheit = async function() {
  const state = window.dashboardState;
  if (!state) { console.warn('[v3] anwesenheit: state not ready'); return; }
  const { provider, api } = state;

  function escapeHtml(str) { return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtDayDate(d) {
    const days = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];
    const months = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
    return days[d.getDay()] + ', ' + d.getDate() + '. <em>' + months[d.getMonth()] + '</em> ' + d.getFullYear();
  }
  function getKW(d) { const t = new Date(d); t.setHours(0,0,0,0); t.setDate(t.getDate() + 4 - (t.getDay()||7)); const ys = new Date(t.getFullYear(),0,1); return Math.ceil((((t-ys)/86400000) + 1)/7); }

  // Try to load today overview — may fail if attendance.provider_id schema is missing
  let todayResp = null;
  try {
    const r = await api('/attendance/today');
    todayResp = r.data || r;
  } catch (e) {
    console.warn('[v3] /attendance/today failed (likely schema bug)', e);
  }

  const sessions = (todayResp && (todayResp.sessions || (Array.isArray(todayResp) ? todayResp : []))) || [];
  const records = (todayResp && (todayResp.records || [])) || [];

  const today = new Date();
  const expected = sessions.reduce((s, x) => s + (x.expected || x.bookedCount || 0), 0);
  const present = records.filter(r => r.checkedIn || r.checked_in).length;
  const sick = sessions.reduce((s, x) => s + (x.sickCount || 0), 0);
  const quote = expected > 0 ? Math.round(present/expected*100) : 0;

  // KPIs
  document.getElementById('phAttHeuteLabel').textContent = 'Heute · ' + today.toLocaleDateString('de-DE');
  document.getElementById('phAttKurseHeute').innerHTML = sessions.length + ' <em>Kurse</em>';
  document.getElementById('phAttKurseDelta').textContent = expected > 0 ? expected + ' Anmeldungen erwartet' : 'Keine Termine heute';
  document.getElementById('phAttAnwesend').textContent = present || '0';
  document.getElementById('phAttQuote').innerHTML = expected > 0 ? '<strong>' + quote + '%</strong> Auslastung' : ' ';
  document.getElementById('phAttKrank').textContent = sick || '0';
  document.getElementById('phAttKrankDelta').textContent = sick > 0 ? 'Add-Up automatisch gutgeschrieben' : ' ';
  document.getElementById('phAttNoShow').innerHTML = '– <em>%</em>';  // would need 30d aggregation API
  document.getElementById('phAttNoShowDelta').textContent = '30-Tage-Statistik in Sprint C';

  // Date picker
  const dateEl = document.getElementById('phAttDate');
  const dateMeta = document.getElementById('phAttDateMeta');
  dateEl.innerHTML = 'Heute, ' + today.getDate() + '. <em>' + ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'][today.getMonth()] + '</em> ' + today.getFullYear();
  const dayName = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'][today.getDay()];
  dateMeta.textContent = dayName + ' · KW ' + getKW(today) + ' · ' + sessions.length + ' Kurs' + (sessions.length === 1 ? '' : 'e') + ' · ' + expected + ' erwartet';

  // Sub headline
  document.getElementById('phAttSub').textContent = sessions.length === 0
    ? (todayResp ? 'Heute keine Termine geplant.' : 'Anwesenheit-API nicht verfügbar — Schema-Migration ausstehend (siehe Memory).')
    : 'Wer ist heute da, wer fehlt? Eine Geste pro Kind reicht — alles synchronisiert ins Eltern-Portal.';

  // Class list
  const classList = document.getElementById('phAttClassList');
  if (sessions.length === 0) {
    classList.innerHTML = '<div style="padding:60px 40px;text-align:center;color:var(--muted)">'
      + '<div style="font-size:32px;margin-bottom:12px">📋</div>'
      + '<div style="font-size:15px;font-weight:500;margin-bottom:6px;color:var(--ink-2)">' + (todayResp ? 'Heute keine Kurse.' : 'Anwesenheit derzeit nicht verfügbar') + '</div>'
      + '<div style="font-size:13px">' + (todayResp ? 'Sobald Kurse angelegt sind und Sessions heute stattfinden, erscheinen sie hier.' : 'Backend-Schema-Migration für attendance.provider_id ausstehend. Code-Fix bereit, wartet auf Apply-OK.') + '</div>'
      + '</div>';
    return;
  }

  classList.innerHTML = sessions.map(sess => {
    const title = sess.activityTitle || sess.activityName || sess.title || 'Kurs';
    const startTime = sess.startTime || sess.start_time || '—';
    const endTime = sess.endTime || sess.end_time || '';
    const room = sess.roomName || sess.room || '';
    const trainer = sess.trainerName || sess.trainer || sess.instructorName || '';
    const expected = sess.expected || sess.bookedCount || 0;
    const sessRecords = records.filter(r => r.activityId === sess.activityId || r.sessionId === sess.id);
    const presentCount = sessRecords.filter(r => r.checkedIn || r.checked_in).length;
    const sickCount = sessRecords.filter(r => !(r.checkedIn || r.checked_in) && r.note).length;
    const sessQuote = expected > 0 ? Math.round(presentCount/expected*100) : 0;

    return '<div class="att-class">'
      + '<div class="att-class-head">'
      + '<div><div class="att-class-title">' + escapeHtml(title) + ' · ' + startTime + (endTime ? ' – ' + endTime : '') + '</div>'
      + '<div class="att-class-meta">' + (room ? escapeHtml(room) + ' · ' : '') + (trainer ? escapeHtml(trainer) + ' · ' : '') + expected + ' Anmeldung' + (expected === 1 ? '' : 'en') + '</div></div>'
      + '<div class="att-class-stats">'
      + '<div class="stat-item"><div class="stat-num" style="color:var(--sage-deep);">' + presentCount + '</div><div class="stat-label">Anwesend</div></div>'
      + '<div class="stat-item"><div class="stat-num" style="color:var(--signal);">' + sickCount + '</div><div class="stat-label">Krank</div></div>'
      + ''  // Quote-Metrik vorerst ausgeblendet
      + '</div>'
      + '<button class="btn btn-ghost btn-sm" onclick="window.__attBulkPresent(\'' + sess.id + '\')">Alle markieren</button>'
      + '</div>'
      + '<div class="att-rows">'
      + (sessRecords.length === 0
        ? '<div style="padding:20px;color:var(--muted);font-size:13px;text-align:center">Noch keine Anmeldungen geladen</div>'
        : sessRecords.slice(0, 12).map(r => {
            const name = r.parentName || r.childName || 'Teilnehmer';
            const initial = name.charAt(0).toUpperCase();
            const isPresent = r.checkedIn || r.checked_in;
            return '<div class="att-row"><div class="att-avatar">' + escapeHtml(initial) + '</div>'
              + '<div><div class="att-name">' + escapeHtml(name) + '</div></div>'
              + '<div class="att-toggle">'
              + '<button class="' + (isPresent ? 'active' : '') + '" onclick="window.__attMark(\'' + (r.id||r.attendance_id||'') + '\',\'' + (r.sessionId||r.session_id||sess.id) + '\',\'attended\')">Anwesend</button>'
              + '<button onclick="window.__attMark(\'' + (r.id||r.attendance_id||'') + '\',\'' + (r.sessionId||r.session_id||sess.id) + '\',\'attended_late\')">Spät</button>'
              + '<button onclick="window.__attMark(\'' + (r.id||r.attendance_id||'') + '\',\'' + (r.sessionId||r.session_id||sess.id) + '\',\'absent_unexcused\')">Fehlt</button>'
              + '<button onclick="window.__attMark(\'' + (r.id||r.attendance_id||'') + '\',\'' + (r.sessionId||r.session_id||sess.id) + '\',\'absent_sick\')">Krank</button>'
              + '</div></div>';
          }).join(''))
      + '</div></div>';
  }).join('');
};


// ============================================================
// Sprint C: Credits, Team, Raeume, Ferien, Einstellungen
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};

function _escSC(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

window.sectionLoaders.credits = async function() {
  const state = window.dashboardState; if (!state) return;
  const { provider, api } = state;
  let credits = [];
  try {
    const r = await api('/parents');
    const parents = r.data || r.parents || r || [];
    for (const p of parents) {
      try {
        const cr = await api('/parents/' + p.id + '/credits');
        const list = cr.data || cr.credits || cr || [];
        list.forEach(c => credits.push({ ...c, parentName: p.name, parentEmail: p.email }));
      } catch (e) {}
    }
  } catch (e) { console.warn('[v3] credits load failed', e); }
  const sub = document.getElementById('phCreditsSub');
  if (sub) sub.textContent = credits.length === 0
    ? 'Noch keine Credit-Bewegungen. Credits werden automatisch beim Block-Kauf gutgeschrieben.'
    : credits.length + ' Credit-Bewegungen insgesamt.';
  const tbody = document.getElementById('phCreditsTbody');
  if (!tbody) return;
  if (credits.length === 0) {
    tbody.innerHTML = '<tr><td colspan="5" style="padding:40px;color:var(--muted);text-align:center;font-size:13px">Noch keine Credit-Bewegungen.</td></tr>';
    return;
  }
  credits.sort((a,b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));
  tbody.innerHTML = credits.slice(0, 50).map(c => {
    const status = (c.status || 'active').toLowerCase();
    const pill = status === 'used' ? 'pill-pending' : (status === 'expired' ? '' : 'pill-ok');
    return '<tr><td style="padding-left:20px;">' + _escSC(c.parentName || '—') + '</td><td>' + _escSC(c.action || c.reason || 'Gutschrift') + '</td><td>' + (c.amount || 1) + '</td><td>' + new Date(c.createdAt || 0).toLocaleDateString('de-DE') + '</td><td style="padding-right:20px;text-align:right;"><span class="pill ' + pill + '">' + status + '</span></td></tr>';
  }).join('');
};

const ROLE_LABEL_DE = { owner:'Inhaber', admin:'Admin', trainer:'Trainer', frontdesk:'Rezeption', accounting:'Buchhaltung', readonly:'Nur-Lesen', instructor:'Trainer', manager:'Manager', staff:'Mitarbeiter', assistant:'Assistenz' };

window.sectionLoaders.team = async function() {
  const state = window.dashboardState; if (!state) return;
  const { provider, api } = state;
  let team = [];
  let invites = [];
  try {
    const r = await api('/providers/' + provider.id + '/team');
    team = r.data || r.team || r.members || r || [];
  } catch (e) { console.warn('[v3] /team failed', e); }
  try {
    const r = await api('/providers/' + provider.id + '/team-invites');
    invites = r.data || [];
  } catch (e) { console.warn('[v3] /team-invites failed', e); }
  const pendingInvites = invites.filter(i => i.status === 'pending');

  const active = team.filter(m => m.active !== false && m.status !== 'inactive');
  const admins = team.filter(m => /admin|owner/i.test(m.role || ''));
  const trainers = team.filter(m => /trainer|instructor/i.test(m.role || ''));
  const subEl = document.getElementById('phTeamSub');
  if (subEl) subEl.textContent = team.length === 0
    ? 'Noch kein Team angelegt — fang mit dir selbst als Inhaber:in an.'
    : active.length + ' aktiv · ' + pendingInvites.length + ' offene Einladungen.';
  const setText = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  setText('phTeamActive', active.length);
  setText('phTeamRoles', admins.length + ' Admin · ' + trainers.length + ' Trainer');
  setText('phTeamPending', pendingInvites.length);
  setText('phTeamPendingDelta', pendingInvites.length === 0 ? ' ' : 'wartend');
  setText('phTeamHours', '–');
  setText('phTeamNPS', '–');
  const grid = document.getElementById('phTeamGrid');
  if (!grid) return;
  if (team.length === 0 && pendingInvites.length === 0) {
    grid.innerHTML = '<div style="grid-column:1/-1;padding:40px;color:var(--muted);text-align:center;font-size:13px">Noch keine Team-Mitglieder. Klicke oben auf „+ Person einladen".</div>';
    return;
  }
  // Active members + pending invites — pending invites at the bottom with distinct style
  // Sort: active first, then inactive
  const sortedTeam = team.slice().sort((a, b) => (b.active === false ? 0 : 1) - (a.active === false ? 0 : 1));
  let html = sortedTeam.map(m => {
    const initial = ((m.firstName || m.name || m.email || '?').charAt(0) || '?').toUpperCase();
    const role = m.role || 'trainer';
    const roleLabel = ROLE_LABEL_DE[role] || role;
    const isOwner = role === 'owner';
    const isInactive = m.active === false;
    const displayName = m.name || ((m.firstName || '') + ' ' + (m.lastName || '')).trim() || m.email || '—';
    const inactiveStyle = isInactive ? ';opacity:.55;background:rgba(0,0,0,.02)' : '';
    return '<article class="team-card' + (isOwner ? ' team-card-owner' : '') + '" style="cursor:pointer' + inactiveStyle + '" onclick="window.__openTeamMemberDrawer(\'' + m.id + '\')">'
      + '<div class="team-head"><div class="team-avatar">' + _escSC(initial) + '</div>'
      + '<div><div class="team-name">' + _escSC(displayName) + (isInactive ? ' <span class="pill" style="background:rgba(0,0,0,.06);color:var(--muted-2);font-size:10px;margin-left:4px">Deaktiviert</span>' : '') + '</div><div class="team-role">' + _escSC(roleLabel) + '</div></div></div>'
      + '<div style="font-size:13px;color:var(--muted-2);margin-top:8px;">' + _escSC(m.email || '') + '</div></article>';
  }).join('');

  if (pendingInvites.length > 0) {
    html += pendingInvites.map(inv => {
      const initial = (inv.invited_email || '?').charAt(0).toUpperCase();
      const roleLabel = ROLE_LABEL_DE[inv.role] || inv.role;
      const expires = inv.expires_at ? new Date(inv.expires_at) : null;
      const daysLeft = expires ? Math.max(0, Math.floor((expires - Date.now()) / (1000 * 60 * 60 * 24))) : 0;
      return '<article class="team-card" style="border:1.5px dashed var(--border);background:rgba(0,0,0,.015)">'
        + '<div class="team-head"><div class="team-avatar" style="background:#f4ede5;color:#8B7355">' + _escSC(initial) + '</div>'
        + '<div><div class="team-name" style="color:var(--muted-2)">' + _escSC(inv.invited_email) + '</div>'
        + '<div class="team-role"><span class="pill pill-pending">Einladung offen</span> ' + _escSC(roleLabel) + '</div></div></div>'
        + '<div style="font-size:11px;color:var(--muted-2);margin-top:8px;">Läuft ab in ' + daysLeft + ' Tag' + (daysLeft === 1 ? '' : 'en') + '</div>'
        + '<div style="display:flex;gap:6px;margin-top:10px;">'
        + '<button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();window.__resendTeamInvite(\'' + inv.id + '\')">Erneut senden</button>'
        + '<button class="btn btn-ghost btn-sm" style="color:var(--signal)" onclick="event.stopPropagation();window.__revokeTeamInvite(\'' + inv.id + '\')">Widerrufen</button>'
        + '</div></article>';
    }).join('');
  }
  grid.innerHTML = html;
};

// =====================================================================
// Team-Invite Modal + Actions
// =====================================================================
window.__openTeamInviteModal = function() {
  const s = window.dashboardState; if (!s) return;
  // Build modal via ukcShowDetailModal
  const ROLES = [
    { value: 'admin', label: 'Admin', desc: 'Voller Zugriff außer Owner-Wechsel und Billing.' },
    { value: 'trainer', label: 'Trainer', desc: 'Eigene Kurse, Anwesenheit, eigene Buchungen.', recommended: true },
    { value: 'frontdesk', label: 'Rezeption', desc: 'Buchungen verwalten, Vor-Ort-Zahlungen, Warteliste.' },
    { value: 'accounting', label: 'Buchhaltung', desc: 'Rechnungen voll, Reports, sonst Lese-Zugriff.' },
    { value: 'readonly', label: 'Nur-Lesen', desc: 'Alles sehen, nichts ändern.' },
  ];
  const roleHtml = ROLES.map(r =>
    '<label style="display:block;padding:12px;border:1.5px solid var(--border);border-radius:10px;margin-bottom:8px;cursor:pointer">'
    + '<input type="radio" name="teamInviteRole" value="' + r.value + '"' + (r.recommended ? ' checked' : '') + ' style="margin-right:10px;accent-color:var(--ochre)">'
    + '<strong>' + r.label + '</strong>'
    + (r.recommended ? ' <span class="pill pill-ok" style="margin-left:6px;font-size:10px">empfohlen</span>' : '')
    + '<div style="font-size:12px;color:var(--muted-2);margin-top:4px;margin-left:24px">' + r.desc + '</div>'
    + '</label>'
  ).join('');

  const bodyHtml = '<div style="padding:4px 0">'
    + '<div class="kk-field" style="margin-bottom:14px"><label class="kk-label">E-Mail-Adresse *</label>'
    +   '<input class="kk-input" type="email" id="teamInviteEmail" placeholder="kollege@example.de" required></label></div>'
    + '<div class="kk-field" style="margin-bottom:14px"><label class="kk-label" style="margin-bottom:8px;display:block">Rolle</label>'
    +   roleHtml
    + '</div>'
    + '<div class="kk-field"><label class="kk-label">Persönliche Nachricht (optional)</label>'
    +   '<textarea class="kk-input" id="teamInviteMessage" rows="3" placeholder="Hi, willkommen im Team!" maxlength="500" style="resize:vertical"></textarea></div>'
    + '<div id="teamInviteError" style="margin-top:12px"></div>'
    + '<div style="margin-top:18px;padding:12px;background:#fff9f5;border-left:3px solid var(--ochre);border-radius:6px;font-size:12px;color:var(--muted)">'
    + 'Die eingeladene Person erhält einen Link per E-Mail (7 Tage gültig, einmalige Verwendung). Sie muss zwei Bestätigungsschritte durchlaufen, bevor sie Zugriff bekommt — Schutz vor versehentlich falschen Adressen.'
    + '</div>'
    + '</div>';

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Team',
      titleHtml: 'Person <em>einladen</em>',
      rows: [],
      bodyExtraHtml: bodyHtml,
      footerHtml: '<button class="btn btn-primary" onclick="window.__sendTeamInvite()">Einladung senden</button>'
        + ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>',
    });
  }
};

window.__sendTeamInvite = async function() {
  const s = window.dashboardState; if (!s) return;
  const email = (document.getElementById('teamInviteEmail') || {}).value || '';
  const role = (document.querySelector('input[name="teamInviteRole"]:checked') || {}).value || 'trainer';
  const message = (document.getElementById('teamInviteMessage') || {}).value || '';
  const errEl = document.getElementById('teamInviteError');
  if (errEl) errEl.innerHTML = '';
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">Bitte gültige E-Mail eingeben.</div>';
    return;
  }
  try {
    await s.api('/providers/' + s.provider.id + '/team-invites', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email.trim().toLowerCase(), role, message: message.trim() }),
    });
    if (window.ukcToast) window.ukcToast('Einladung gesendet an ' + email, 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    if (window.sectionLoaders && window.sectionLoaders.team) window.sectionLoaders.team();
  } catch (e) {
    if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">' + (e.message || 'Fehler beim Senden') + '</div>';
  }
};

window.__resendTeamInvite = async function(inviteId) {
  const s = window.dashboardState; if (!s) return;
  if (!confirm('Erinnerungs-E-Mail an die eingeladene Person senden?')) return;
  try {
    await s.api('/providers/' + s.provider.id + '/team-invites/' + inviteId + '/resend', { method: 'POST' });
    if (window.ukcToast) window.ukcToast('E-Mail erneut gesendet', 'success');
    if (window.sectionLoaders && window.sectionLoaders.team) window.sectionLoaders.team();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Senden fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Senden fehlgeschlagen: ' + (e.message || ''));
  }
};

window.__revokeTeamInvite = async function(inviteId) {
  const s = window.dashboardState; if (!s) return;
  if (!confirm('Einladung widerrufen? Der Empfänger kann den Link dann nicht mehr nutzen.')) return;
  try {
    await s.api('/providers/' + s.provider.id + '/team-invites/' + inviteId, { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Einladung widerrufen', 'success');
    if (window.sectionLoaders && window.sectionLoaders.team) window.sectionLoaders.team();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Widerruf fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Widerruf fehlgeschlagen');
  }
};

// Mitarbeiter-Detail-Drawer mit Profil + Permissions + Notizen
const TEAM_PERMISSION_AREAS = [
  { area: 'courses',   label: 'Kurse',         actions: ['view','create','edit','move','delete'] },
  { area: 'bookings',  label: 'Buchungen',     actions: ['view','confirm','cancel'] },
  { area: 'customers', label: 'Kunden',        actions: ['view','contact'] },
  { area: 'invoices',  label: 'Rechnungen',    actions: ['view','create','send'] },
  { area: 'team',      label: 'Team',          actions: ['view','invite','edit'] },
  { area: 'settings',  label: 'Einstellungen', actions: ['view','edit'] },
  { area: 'marketing', label: 'Marketing',     actions: ['view','edit'] },
  { area: 'embed',     label: 'Einbettung',    actions: ['view','edit'] },
  { area: 'reports',   label: 'Berichte',      actions: ['view'] },
  { area: 'documents', label: 'Dokumente',     actions: ['view','upload'] },
];
const ACTION_LABEL = { view:'Ansehen', create:'Anlegen', edit:'Bearbeiten', delete:'Löschen', move:'Verschieben', send:'Versenden', confirm:'Bestätigen', cancel:'Stornieren', invite:'Einladen', contact:'Kontaktieren', upload:'Hochladen' };
let __teamRolePresets = null;

window.__openTeamMemberDrawer = async function(memberId) {
  const s = window.dashboardState; if (!s) return;
  // Loading skeleton
  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Team-Mitglied',
      titleHtml: 'Profil <em>laden…</em>',
      rows: [],
      bodyExtraHtml: '<div style="padding:32px;text-align:center;color:var(--muted-2)">Lade…</div>',
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>',
    });
  }

  let member = null;
  try { const r = await s.api('/team/members/' + memberId); member = r.data || r; }
  catch (e) {
    if (window.ukcToast) window.ukcToast('Profil konnte nicht geladen werden: ' + (e.message || ''), 'error');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    return;
  }

  if (!__teamRolePresets) {
    try { const r = await s.api('/team/role-presets'); __teamRolePresets = r.data; }
    catch(e) { __teamRolePresets = { presets: {}, labels: {} }; }
  }

  window.__teamMemberDraft = JSON.parse(JSON.stringify(member));
  // Initialize permissions if missing
  if (!window.__teamMemberDraft.permissions || typeof window.__teamMemberDraft.permissions !== 'object') {
    window.__teamMemberDraft.permissions = (__teamRolePresets.presets || {})[member.role] || {};
  }

  __renderTeamMemberDrawer(memberId);
};

function __renderTeamMemberDrawer(memberId) {
  const m = window.__teamMemberDraft || {};
  const fullName = m.name || ((m.first_name || '') + ' ' + (m.last_name || '')).trim() || m.email || 'Profil';
  const initial = (fullName.charAt(0) || '?').toUpperCase();
  const roleLabel = (ROLE_LABEL_DE[m.role] || m.role);
  const isOwner = m.role === 'owner';
  const profileComplete = !!m.profile_completed_at;

  function fld(label, id, type, val, opts) {
    opts = opts || {};
    const placeholder = opts.placeholder ? ' placeholder="' + opts.placeholder + '"' : '';
    const max = opts.max ? ' maxlength="' + opts.max + '"' : '';
    const disabled = opts.disabled ? ' disabled' : '';
    return '<label class="kk-field" style="margin-bottom:10px"><span class="kk-label">' + label + '</span>'
      + '<input class="kk-input" type="' + type + '" id="' + id + '" value="' + (val == null ? '' : String(val).replace(/"/g, '&quot;')) + '"' + placeholder + max + disabled + '></label>';
  }

  const addr = m.address || {};
  const ec = m.emergency_contact || {};

  const tabs = '<div style="display:flex;gap:0;border-bottom:1px solid var(--border);margin:-4px -4px 14px">'
    + '<button class="team-tab" data-tab="profile" onclick="__teamSwitchTab(\'profile\')" style="flex:1;padding:10px 14px;background:transparent;border:0;border-bottom:2px solid var(--ochre);font-weight:600;cursor:pointer;font-family:inherit;color:var(--text)">Profil</button>'
    + '<button class="team-tab" data-tab="perms" onclick="__teamSwitchTab(\'perms\')" style="flex:1;padding:10px 14px;background:transparent;border:0;border-bottom:2px solid transparent;cursor:pointer;font-family:inherit;color:var(--muted-2)">Rolle & Rechte</button>'
    + '<button class="team-tab" data-tab="docs" onclick="__teamSwitchTab(\'docs\');__teamLoadDocuments(\'' + memberId + '\')" style="flex:1;padding:10px 14px;background:transparent;border:0;border-bottom:2px solid transparent;cursor:pointer;font-family:inherit;color:var(--muted-2)">Dokumente</button>'
    + '<button class="team-tab" data-tab="notes" onclick="__teamSwitchTab(\'notes\')" style="flex:1;padding:10px 14px;background:transparent;border:0;border-bottom:2px solid transparent;cursor:pointer;font-family:inherit;color:var(--muted-2)">Notizen</button>'
    + '</div>';

  const profileTab = '<div id="teamTab-profile">'
    + '<div class="kk-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'
    +   fld('Vorname', 'tmFirstName', 'text', m.first_name || '', { max: 100 })
    +   fld('Nachname', 'tmLastName', 'text', m.last_name || '', { max: 100 })
    + '</div>'
    + '<div class="kk-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'
    +   fld('E-Mail', 'tmEmail', 'email', m.email || '', { disabled: true })
    +   fld('Telefon', 'tmPhone', 'tel', m.phone || '', { max: 30 })
    + '</div>'
    + '<div class="kk-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'
    +   fld('Geburtsdatum', 'tmBirthDate', 'date', (m.birth_date || '').slice(0, 10))
    +   fld('Eintrittsdatum', 'tmHiredAt', 'date', (m.hired_at || '').slice(0, 10))
    + '</div>'
    + '<hr style="border:none;border-top:1px dashed var(--border);margin:14px 0">'
    + '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin-bottom:8px">Anschrift</div>'
    + fld('Straße + Hausnummer', 'tmStreet', 'text', addr.street || '', { max: 200 })
    + '<div class="kk-row" style="display:grid;grid-template-columns:120px 1fr;gap:10px">'
    +   fld('PLZ', 'tmZip', 'text', addr.zip || '', { max: 20 })
    +   fld('Stadt', 'tmCity', 'text', addr.city || '', { max: 100 })
    + '</div>'
    + '<hr style="border:none;border-top:1px dashed var(--border);margin:14px 0">'
    + '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin-bottom:8px">Anstellung &amp; Vergütung</div>'
    + '<div class="kk-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'
    +   '<label class="kk-field" style="margin-bottom:10px"><span class="kk-label">Anstellungsart</span>'
    +     '<select class="kk-input" id="tmEmpType">'
    +       '<option value="employee"' + (m.employment_type === 'employee' ? ' selected' : '') + '>Festangestellt</option>'
    +       '<option value="freelance"' + (m.employment_type === 'freelance' ? ' selected' : '') + '>Freelancer</option>'
    +       '<option value="volunteer"' + (m.employment_type === 'volunteer' ? ' selected' : '') + '>Ehrenamt</option>'
    +     '</select></label>'
    +   '<label class="kk-field" style="margin-bottom:10px"><span class="kk-label">Stundenlohn (€, brutto)</span>'
    +     '<input class="kk-input" type="number" id="tmHourlyRate" step="0.50" min="0" max="1000" value="' + (m.hourly_rate_cents ? (m.hourly_rate_cents / 100).toFixed(2) : '') + '" placeholder="z.B. 25.00"></label>'
    + '</div>'
    + '<hr style="border:none;border-top:1px dashed var(--border);margin:14px 0">'
    + '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin-bottom:8px">Notfallkontakt</div>'
    + '<div class="kk-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'
    +   fld('Name', 'tmEcName', 'text', ec.name || '', { max: 100 })
    +   fld('Telefon', 'tmEcPhone', 'tel', ec.phone || '', { max: 30 })
    + '</div>'
    + fld('Beziehung', 'tmEcRelation', 'text', ec.relation || '', { max: 50, placeholder: 'z.B. Partner, Mutter' })
    + (profileComplete ? '' : '<div style="margin-top:14px;padding:10px 14px;background:#fff9f5;border-left:3px solid var(--ochre);border-radius:6px;font-size:12px;color:var(--muted)">Profil noch nicht von der Person selbst ausgefüllt — Daten erscheinen nach Annahme der Einladung.</div>')
    + '</div>';

  const ROLES_FOR_PICKER = [
    { value: 'admin', label: 'Admin' },
    { value: 'trainer', label: 'Trainer' },
    { value: 'frontdesk', label: 'Rezeption' },
    { value: 'accounting', label: 'Buchhaltung' },
    { value: 'readonly', label: 'Nur-Lesen' },
  ];
  if (m.role === 'owner') ROLES_FOR_PICKER.unshift({ value: 'owner', label: 'Inhaber' });
  const rolePicker = '<div class="kk-field" style="margin-bottom:14px"><span class="kk-label">Rolle</span>'
    + '<select class="kk-input" id="tmRole" onchange="__teamApplyRolePreset(this.value)"' + (isOwner ? ' disabled' : '') + '>'
    + ROLES_FOR_PICKER.map(r => '<option value="' + r.value + '"' + (m.role === r.value ? ' selected' : '') + '>' + r.label + '</option>').join('')
    + '</select>'
    + (isOwner ? '<span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px">Inhaber-Rolle kann nicht hier geändert werden.</span>' : '<span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px">Rolle wechseln setzt automatisch die Standard-Rechte. Du kannst sie unten überschreiben.</span>')
    + '</div>';

  const permTable = '<div style="border:1px solid var(--border);border-radius:10px;overflow:hidden">'
    + TEAM_PERMISSION_AREAS.map(a => {
        const granted = (m.permissions && m.permissions[a.area]) || [];
        return '<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border);font-size:13px">'
          + '<div style="font-weight:500">' + a.label + '</div>'
          + '<div style="display:flex;gap:6px;flex-wrap:wrap">'
          + a.actions.map(act => {
              const isOn = granted.indexOf(act) >= 0;
              return '<label style="display:flex;align-items:center;gap:4px;padding:4px 8px;border:1px solid ' + (isOn ? 'var(--ochre)' : 'var(--border)') + ';background:' + (isOn ? '#fff9f5' : 'transparent') + ';border-radius:6px;cursor:pointer;font-size:11px">'
                + '<input type="checkbox" data-area="' + a.area + '" data-action="' + act + '"' + (isOn ? ' checked' : '') + ' onchange="__teamTogglePerm(this)" style="margin:0;accent-color:var(--ochre)">'
                + (ACTION_LABEL[act] || act) + '</label>';
            }).join('')
          + '</div></div>';
      }).join('')
    + '</div>';

  const permsTab = '<div id="teamTab-perms" style="display:none">'
    + rolePicker
    + '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin:6px 0 8px">Detail-Rechte</div>'
    + permTable
    + '<div style="margin-top:14px;padding:10px 14px;background:#fff9f5;border-left:3px solid var(--ochre);border-radius:6px;font-size:12px;color:var(--muted)">'
    +   'Owner und Admin haben automatisch alle Rechte. Trainer können nur eigene Kurse / Anwesenheit. Rezeption kann Buchungen + Kunden aber keine Finanzen. Buchhaltung sieht Rechnungen + Reports. Nur-Lesen kann beobachten ohne zu ändern.'
    + '</div>'
    + '</div>';

  const notesTab = '<div id="teamTab-notes" style="display:none">'
    + '<label class="kk-field"><span class="kk-label">Interne Notizen</span>'
    +   '<textarea class="kk-input" id="tmNotes" rows="8" maxlength="5000" style="resize:vertical">' + (m.internal_notes || '').replace(/</g, '&lt;') + '</textarea>'
    +   '<span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px">Nur für Owner und Admins sichtbar — z.B. Beobachtungen, Performance-Notizen, Unterhaltspauschalen.</span>'
    + '</label>'
    + '</div>';

  const docsTab = '<div id="teamTab-docs" style="display:none">'
    + '<div id="teamDocsLoading" style="text-align:center;padding:32px;color:var(--muted-2)">Lade Dokumente…</div>'
    + '<div id="teamDocsContent" style="display:none"></div>'
    + '</div>';

  const bodyHtml = tabs + profileTab + permsTab + docsTab + notesTab;

  let footer = '<button class="btn btn-primary" onclick="__teamSaveMember(\'' + memberId + '\')">Speichern</button>';
  if (!isOwner) {
    if (m.active === false) {
      // Already deactivated → reactivate or hard-delete
      footer += ' <button class="btn btn-ghost btn-sm" onclick="__teamReactivateMember(\'' + memberId + '\')">Wieder aktivieren</button>';
      footer += ' <button class="btn btn-ghost btn-sm" style="color:var(--signal)" onclick="__teamHardDeleteMember(\'' + memberId + '\', \'' + (fullName || '').replace(/\'/g, '&#39;') + '\')">Endgültig löschen</button>';
    } else {
      footer += ' <button class="btn btn-ghost btn-sm" style="color:var(--signal)" onclick="__teamDeleteMember(\'' + memberId + '\')">Deaktivieren</button>';
    }
  }
  footer += ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>';

  document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Team-Mitglied · ' + roleLabel,
      titleHtml: (window.escapeHtml ? window.escapeHtml(fullName.split(' ')[0]) : fullName.split(' ')[0]) + ' <em>' + (window.escapeHtml ? window.escapeHtml(fullName.split(' ').slice(1).join(' ') || '') : (fullName.split(' ').slice(1).join(' ') || '')) + '</em>',
      rows: [
        { label: 'E-Mail', val: m.email || '—' },
        { label: 'Status', html: profileComplete ? '<span class="pill pill-ok">Profil vollständig</span>' : '<span class="pill pill-pending">Profil unvollständig</span>' },
      ],
      bodyExtraHtml: bodyHtml,
      footerHtml: footer,
    });
  }
}

window.__teamSwitchTab = function(tab) {
  ['profile','perms','docs','notes'].forEach(t => {
    const el = document.getElementById('teamTab-' + t);
    if (el) el.style.display = (t === tab) ? '' : 'none';
  });
  document.querySelectorAll('.team-tab').forEach(b => {
    const isActive = b.dataset.tab === tab;
    b.style.borderBottom = isActive ? '2px solid var(--ochre)' : '2px solid transparent';
    b.style.fontWeight = isActive ? '600' : '400';
    b.style.color = isActive ? 'var(--text)' : 'var(--muted-2)';
  });
};

const TEAM_DOC_LABELS = {
  fuehrungszeugnis: 'Führungszeugnis',
  fuehrungszeugnis_erweitert: 'Erweitertes Führungszeugnis',
  hygiene_belehrung: 'Belehrung § 43 IfSG (Hygiene)',
  erste_hilfe: 'Erste-Hilfe-Schein',
  qualifikation: 'Qualifikation / Zertifikat',
  arbeitsvertrag: 'Arbeitsvertrag / Honorarvertrag',
  sonstiges: 'Sonstiges',
};
let __teamDocsCache = null;
let __teamDocsCurrentMemberId = null;

window.__teamLoadDocuments = async function(memberId) {
  __teamDocsCurrentMemberId = memberId;
  const s = window.dashboardState; if (!s) return;
  document.getElementById('teamDocsLoading').style.display = '';
  document.getElementById('teamDocsContent').style.display = 'none';
  try {
    const r = await s.api('/team/members/' + memberId + '/documents');
    __teamDocsCache = r.data || r;
    __renderTeamDocs();
  } catch (e) {
    document.getElementById('teamDocsLoading').textContent = 'Fehler beim Laden: ' + (e.message || '');
  }
};

function __renderTeamDocs() {
  const data = __teamDocsCache || { documents: [], required: [], compliance: [] };
  document.getElementById('teamDocsLoading').style.display = 'none';
  const container = document.getElementById('teamDocsContent');
  container.style.display = '';

  let html = '';

  // Compliance Übersicht
  if (data.compliance && data.compliance.length > 0) {
    html += '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin:0 0 8px">Pflicht-Status</div>'
      + '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">'
      + data.compliance.map(c => {
          const color = c.worstStatus === 'missing' ? '#dc2626' : (c.worstStatus === 'expiring_soon' ? '#d97706' : '#059669');
          const bg = c.worstStatus === 'missing' ? '#fef2f2' : (c.worstStatus === 'expiring_soon' ? '#fffbeb' : '#ecfdf5');
          const icon = c.worstStatus === 'missing' ? '⚠' : (c.worstStatus === 'expiring_soon' ? '⏳' : '✓');
          return '<div style="padding:6px 10px;background:' + bg + ';color:' + color + ';border-radius:8px;font-size:11px;font-weight:500">' + icon + ' ' + c.label + '</div>';
        }).join('')
      + '</div>';
  } else {
    html += '<div style="padding:10px 14px;background:#fff9f5;border-left:3px solid var(--ochre);border-radius:6px;font-size:12px;color:var(--muted);margin-bottom:14px">'
      + 'Du hast in den Einstellungen noch keine Pflicht-Dokumente festgelegt.</div>';
  }

  // Upload-Bereich
  html += '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin:0 0 8px">Hochladen</div>'
    + '<div style="border:1.5px dashed var(--border);border-radius:10px;padding:14px;background:rgba(0,0,0,.015);margin-bottom:18px">'
    +   '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">'
    +     '<label class="kk-field"><span class="kk-label">Typ</span>'
    +       '<select class="kk-input" id="docUploadType">'
    +         Object.keys(TEAM_DOC_LABELS).map(k => '<option value="' + k + '">' + TEAM_DOC_LABELS[k] + '</option>').join('')
    +       '</select></label>'
    +     '<label class="kk-field"><span class="kk-label">Titel (optional)</span>'
    +       '<input class="kk-input" type="text" id="docUploadTitle" maxlength="200" placeholder="z.B. Erweitert §30a"></label>'
    +   '</div>'
    +   '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">'
    +     '<label class="kk-field"><span class="kk-label">Ausgestellt am</span><input class="kk-input" type="date" id="docUploadIssued"></label>'
    +     '<label class="kk-field"><span class="kk-label">Gültig bis</span><input class="kk-input" type="date" id="docUploadExpires"></label>'
    +   '</div>'
    +   '<input type="file" id="docUploadFile" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" style="display:block;width:100%;margin-bottom:10px;font-size:13px">'
    +   '<button class="btn btn-primary btn-sm" onclick="__teamUploadDoc()">Hochladen</button>'
    +   '<span id="docUploadStatus" style="margin-left:10px;font-size:12px;color:var(--muted-2)"></span>'
    + '</div>';

  // Bestehende Dokumente
  html += '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin:0 0 8px">Vorhandene Dokumente · ' + (data.documents || []).length + '</div>';
  if (!data.documents || data.documents.length === 0) {
    html += '<div style="padding:24px;text-align:center;color:var(--muted-2);font-size:13px">Noch keine Dokumente hochgeladen.</div>';
  } else {
    html += '<div style="display:flex;flex-direction:column;gap:8px">'
      + data.documents.map(d => {
          const statusBadge = (function() {
            if (d.status === 'expired') return '<span class="pill" style="background:#fef2f2;color:#dc2626">Abgelaufen</span>';
            if (d.status === 'expiring_soon') return '<span class="pill" style="background:#fffbeb;color:#d97706">Läuft bald ab</span>';
            if (d.status === 'valid') return '<span class="pill pill-ok">Gültig</span>';
            return '';
          })();
          const expires = d.expires_date ? new Date(d.expires_date).toLocaleDateString('de-DE') : '';
          const issued = d.issued_date ? new Date(d.issued_date).toLocaleDateString('de-DE') : '';
          const sizeKb = d.file_size_bytes ? Math.round(d.file_size_bytes / 1024) + ' KB' : '';
          return '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border:1px solid var(--border);border-radius:10px;font-size:13px">'
            + '<div style="flex:1;min-width:0">'
            +   '<div style="font-weight:600">' + (d.typeLabel || TEAM_DOC_LABELS[d.doc_type] || d.doc_type) + ' ' + statusBadge + '</div>'
            +   (d.title ? '<div style="font-size:12px;color:var(--muted-2);margin-top:2px">' + (window.escapeHtml ? window.escapeHtml(d.title) : d.title) + '</div>' : '')
            +   '<div style="font-size:11px;color:var(--muted-2);margin-top:4px">'
            +     (d.file_name || 'Datei') + (sizeKb ? ' · ' + sizeKb : '')
            +     (issued ? ' · Ausgestellt: ' + issued : '')
            +     (expires ? ' · Gültig bis: ' + expires : '')
            +   '</div>'
            + '</div>'
            + '<div style="display:flex;gap:6px;flex-shrink:0;margin-left:10px">'
            +   '<button class="btn btn-ghost btn-sm" onclick="__teamDownloadDoc(\'' + d.id + '\')">Ansehen</button>'
            +   '<button class="btn btn-ghost btn-sm" style="color:var(--signal)" onclick="__teamDeleteDoc(\'' + d.id + '\')">×</button>'
            + '</div>'
            + '</div>';
        }).join('')
      + '</div>';
  }

  container.innerHTML = html;
}

window.__teamUploadDoc = async function() {
  const s = window.dashboardState; if (!s || !__teamDocsCurrentMemberId) return;
  const fileInput = document.getElementById('docUploadFile');
  const file = fileInput.files && fileInput.files[0];
  if (!file) { alert('Bitte eine Datei auswählen.'); return; }
  if (file.size > 10 * 1024 * 1024) { alert('Datei zu groß (max 10 MB).'); return; }
  const allowed = ['application/pdf','image/png','image/jpeg','image/jpg'];
  if (!allowed.includes(file.type)) { alert('Nur PDF, PNG, JPG erlaubt.'); return; }

  const status = document.getElementById('docUploadStatus');
  status.textContent = 'Hochladen…';
  const reader = new FileReader();
  reader.onload = async function(ev) {
    const base64 = (ev.target.result || '').toString();
    const docType = document.getElementById('docUploadType').value;
    const title = document.getElementById('docUploadTitle').value;
    const issued = document.getElementById('docUploadIssued').value;
    const expires = document.getElementById('docUploadExpires').value;
    try {
      await s.api('/team/members/' + __teamDocsCurrentMemberId + '/documents', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          docType, title: title || null,
          fileName: file.name, mimeType: file.type, fileBase64: base64,
          issuedDate: issued || null, expiresDate: expires || null,
        }),
      });
      status.textContent = 'Hochgeladen ✓';
      if (window.ukcToast) window.ukcToast('Dokument hochgeladen', 'success');
      fileInput.value = '';
      document.getElementById('docUploadTitle').value = '';
      document.getElementById('docUploadIssued').value = '';
      document.getElementById('docUploadExpires').value = '';
      __teamLoadDocuments(__teamDocsCurrentMemberId);
    } catch (e) {
      status.textContent = '';
      if (window.ukcToast) window.ukcToast('Upload fehlgeschlagen: ' + (e.message || ''), 'error');
      else alert('Upload fehlgeschlagen: ' + (e.message || ''));
    }
  };
  reader.readAsDataURL(file);
};

window.__teamDownloadDoc = async function(docId) {
  const s = window.dashboardState; if (!s) return;
  try {
    const r = await s.api('/team/documents/' + docId + '/download');
    const d = r.data || r;
    if (d.url) window.open(d.url, '_blank');
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Download fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};

window.__teamDeleteDoc = async function(docId) {
  const s = window.dashboardState; if (!s) return;
  if (!confirm('Dokument unwiderruflich löschen?')) return;
  try {
    await s.api('/team/documents/' + docId, { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Dokument gelöscht', 'success');
    __teamLoadDocuments(__teamDocsCurrentMemberId);
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Löschen fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};

window.__teamApplyRolePreset = function(role) {
  if (!__teamRolePresets || !__teamRolePresets.presets) return;
  const preset = __teamRolePresets.presets[role];
  if (!preset) return;
  window.__teamMemberDraft.role = role;
  window.__teamMemberDraft.permissions = JSON.parse(JSON.stringify(preset));
  // Re-render perms tab
  TEAM_PERMISSION_AREAS.forEach(a => {
    a.actions.forEach(act => {
      const cb = document.querySelector('input[data-area="' + a.area + '"][data-action="' + act + '"]');
      if (cb) {
        const isOn = (preset[a.area] || []).indexOf(act) >= 0;
        cb.checked = isOn;
        const label = cb.closest('label');
        if (label) {
          label.style.borderColor = isOn ? 'var(--ochre)' : 'var(--border)';
          label.style.background = isOn ? '#fff9f5' : 'transparent';
        }
      }
    });
  });
};

window.__teamTogglePerm = function(cb) {
  const area = cb.dataset.area; const action = cb.dataset.action;
  if (!window.__teamMemberDraft.permissions) window.__teamMemberDraft.permissions = {};
  if (!window.__teamMemberDraft.permissions[area]) window.__teamMemberDraft.permissions[area] = [];
  const list = window.__teamMemberDraft.permissions[area];
  if (cb.checked) { if (list.indexOf(action) < 0) list.push(action); }
  else { const i = list.indexOf(action); if (i >= 0) list.splice(i, 1); }
  const label = cb.closest('label');
  if (label) {
    label.style.borderColor = cb.checked ? 'var(--ochre)' : 'var(--border)';
    label.style.background = cb.checked ? '#fff9f5' : 'transparent';
  }
};

window.__teamSaveMember = async function(memberId) {
  const s = window.dashboardState; if (!s) return;
  const v = id => (document.getElementById(id) || {}).value || '';
  const hourlyEur = parseFloat(v('tmHourlyRate'));
  const payload = {
    firstName: v('tmFirstName'), lastName: v('tmLastName'),
    phone: v('tmPhone'),
    birthDate: v('tmBirthDate') || null,
    hiredAt: v('tmHiredAt') || null,
    address: { street: v('tmStreet'), zip: v('tmZip'), city: v('tmCity'), country: 'DE' },
    emergencyContact: { name: v('tmEcName'), phone: v('tmEcPhone'), relation: v('tmEcRelation') },
    employmentType: v('tmEmpType'),
    hourlyRateCents: !isNaN(hourlyEur) && hourlyEur >= 0 ? Math.round(hourlyEur * 100) : null,
    role: v('tmRole') || window.__teamMemberDraft.role,
    permissions: window.__teamMemberDraft.permissions,
    internalNotes: v('tmNotes'),
  };
  try {
    await s.api('/team/members/' + memberId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (window.ukcToast) window.ukcToast('Profil gespeichert', 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    if (window.sectionLoaders && window.sectionLoaders.team) window.sectionLoaders.team();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Speichern fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Speichern fehlgeschlagen: ' + (e.message || ''));
  }
};

// Provider-wide Stunden & Kosten Übersicht
window.__openTeamHoursOverview = async function() {
  const s = window.dashboardState; if (!s) return;
  // Default range: current month
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().slice(0, 10);
  const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0).toISOString().slice(0, 10);
  window.__teamHoursRange = { from: monthStart, to: monthEnd };

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Team',
      titleHtml: 'Stunden &amp; <em>Kosten</em>',
      rows: [],
      bodyExtraHtml: '<div id="teamHoursBody" style="padding:8px 0"><div style="text-align:center;padding:30px;color:var(--muted-2)">Lade…</div></div>',
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>',
    });
  }
  __renderTeamHoursOverview();
};

async function __renderTeamHoursOverview() {
  const s = window.dashboardState; if (!s) return;
  const range = window.__teamHoursRange;
  const body = document.getElementById('teamHoursBody');
  if (!body) return;

  let data = { entries: [], summary: [] };
  try {
    const r = await s.api('/providers/' + s.provider.id + '/time-entries?from=' + range.from + '&to=' + range.to);
    data = r.data || r;
  } catch (e) {
    body.innerHTML = '<div style="text-align:center;padding:30px;color:var(--signal)">Fehler beim Laden: ' + (e.message || '') + '</div>';
    return;
  }

  function fmtMoney(cents) { return ((cents || 0) / 100).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; }
  function fmtHours(min) { return ((min || 0) / 60).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' h'; }

  // Date filter UI
  let html = '<div style="display:flex;gap:10px;align-items:flex-end;margin-bottom:14px;flex-wrap:wrap">'
    + '<label class="kk-field" style="margin-bottom:0"><span class="kk-label" style="font-size:11px">Von</span><input class="kk-input" type="date" id="teamHrFrom" value="' + range.from + '"></label>'
    + '<label class="kk-field" style="margin-bottom:0"><span class="kk-label" style="font-size:11px">Bis</span><input class="kk-input" type="date" id="teamHrTo" value="' + range.to + '"></label>'
    + '<button class="btn btn-ghost btn-sm" onclick="window.__teamHoursReload()">Aktualisieren</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="window.__teamHoursExportCsv()">CSV-Export</button>'
    + '</div>';

  // Aggregate totals
  const totalMinutes = (data.summary || []).reduce((acc, s) => acc + (s.totalMinutes || 0), 0);
  const totalCents = (data.summary || []).reduce((acc, s) => acc + (s.totalBruttoCents || 0), 0);
  const loggedCents = (data.summary || []).reduce((acc, s) => acc + (s.loggedBruttoCents || 0), 0);
  const approvedCents = (data.summary || []).reduce((acc, s) => acc + (s.approvedBruttoCents || 0), 0);
  const paidCents = (data.summary || []).reduce((acc, s) => acc + (s.paidBruttoCents || 0), 0);

  html += '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px">'
    + '<div style="padding:12px;background:var(--bg-soft);border-radius:8px"><div style="font-size:11px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.1em">Stunden</div><div style="font-weight:600;font-size:18px;margin-top:4px">' + fmtHours(totalMinutes) + '</div></div>'
    + '<div style="padding:12px;background:#fef2f2;border-radius:8px"><div style="font-size:11px;color:#b91c1c;text-transform:uppercase;letter-spacing:.1em">Erfasst (offen)</div><div style="font-weight:600;font-size:18px;margin-top:4px;color:#b91c1c">' + fmtMoney(loggedCents) + '</div></div>'
    + '<div style="padding:12px;background:#fffbeb;border-radius:8px"><div style="font-size:11px;color:#a16207;text-transform:uppercase;letter-spacing:.1em">Genehmigt</div><div style="font-weight:600;font-size:18px;margin-top:4px;color:#a16207">' + fmtMoney(approvedCents) + '</div></div>'
    + '<div style="padding:12px;background:#ecfdf5;border-radius:8px"><div style="font-size:11px;color:#047857;text-transform:uppercase;letter-spacing:.1em">Ausgezahlt</div><div style="font-weight:600;font-size:18px;margin-top:4px;color:#047857">' + fmtMoney(paidCents) + '</div></div>'
    + '</div>';

  // Per-member summary
  if ((data.summary || []).length === 0) {
    html += '<div style="text-align:center;padding:40px;color:var(--muted-2)">Keine Zeiteinträge im gewählten Zeitraum.</div>';
  } else {
    html += '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin:0 0 8px">Pro Mitarbeiter</div>';
    html += '<div style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px">';
    for (const sm of data.summary) {
      const name = (sm.member && sm.member.name) || 'Unbekannt';
      const empType = sm.member && sm.member.employment_type;
      const rate = sm.member && sm.member.hourly_rate_cents;
      const empBadge = empType === 'freelance' ? '<span class="pill" style="background:#fff9f5;color:#a16207;margin-left:6px;font-size:10px">Freelance</span>'
        : empType === 'volunteer' ? '<span class="pill" style="background:#f0fdf4;color:#047857;margin-left:6px;font-size:10px">Ehrenamt</span>'
        : '<span class="pill" style="background:rgba(0,0,0,.05);margin-left:6px;font-size:10px">Festangestellt</span>';
      html += '<div style="padding:14px;border:1px solid var(--border);border-radius:10px;font-size:13px">'
        + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">'
        +   '<div style="font-weight:600">' + (window.escapeHtml ? window.escapeHtml(name) : name) + empBadge + '</div>'
        +   '<div style="font-weight:600;font-size:15px">' + fmtMoney(sm.totalBruttoCents) + '</div>'
        + '</div>'
        + '<div style="font-size:12px;color:var(--muted-2)">'
        +   fmtHours(sm.totalMinutes) + ' · ' + sm.entries + ' Eintr.'
        +   (rate ? ' · ' + fmtMoney(rate) + '/h' : ' · kein Stundenlohn gesetzt')
        + '</div>'
        + (sm.loggedMinutes ? '<div style="font-size:11px;color:#b91c1c;margin-top:4px">Offen: ' + fmtHours(sm.loggedMinutes) + ' · ' + fmtMoney(sm.loggedBruttoCents) + '</div>' : '')
        + '</div>';
    }
    html += '</div>';
  }

  // Detail entries table
  html += '<div style="font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted-2);margin:0 0 8px">Einträge · ' + (data.entries || []).length + '</div>';
  if ((data.entries || []).length > 0) {
    html += '<div style="max-height:300px;overflow:auto;border:1px solid var(--border);border-radius:10px">'
      + '<table style="width:100%;border-collapse:collapse;font-size:12px">'
      + '<thead style="background:var(--bg-soft);position:sticky;top:0;z-index:1"><tr>'
      +   '<th style="text-align:left;padding:8px 10px;font-weight:600">Mitarbeiter</th>'
      +   '<th style="text-align:left;padding:8px 10px;font-weight:600">Datum</th>'
      +   '<th style="text-align:right;padding:8px 10px;font-weight:600">Stunden</th>'
      +   '<th style="text-align:left;padding:8px 10px;font-weight:600">Quelle</th>'
      +   '<th style="text-align:left;padding:8px 10px;font-weight:600">Status</th>'
      +   '<th style="text-align:right;padding:8px 10px;font-weight:600">Aktion</th>'
      + '</tr></thead><tbody>';
    for (const e of data.entries.slice(0, 100)) {
      const dur = e.duration_minutes || 0;
      const date = new Date(e.started_at).toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: '2-digit' });
      const time = new Date(e.started_at).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
      const sourceLabel = { auto_session: 'Auto', manual_clock: 'Stempel', manual_adjust: 'Manuell' }[e.source] || e.source;
      const statusLabel = { logged: 'Offen', approved: 'Genehmigt', paid: 'Ausgezahlt', rejected: 'Abgelehnt' }[e.status] || e.status;
      const statusColor = { logged: '#b91c1c', approved: '#a16207', paid: '#047857', rejected: '#6b7280' }[e.status] || '#6b7280';
      const actions = e.status === 'logged' ? '<button class="btn btn-ghost btn-sm" onclick="window.__teamApproveEntry(\'' + e.id + '\')">Genehmigen</button>'
        : e.status === 'approved' ? '<button class="btn btn-ghost btn-sm" onclick="window.__teamMarkEntryPaid(\'' + e.id + '\')">Bezahlt</button>'
        : '';
      html += '<tr style="border-top:1px solid var(--border)">'
        + '<td style="padding:8px 10px">' + (window.escapeHtml ? window.escapeHtml(e.memberName || '—') : (e.memberName || '—')) + '</td>'
        + '<td style="padding:8px 10px;color:var(--muted-2)">' + date + ' · ' + time + '</td>'
        + '<td style="padding:8px 10px;text-align:right;font-weight:500">' + fmtHours(dur) + '</td>'
        + '<td style="padding:8px 10px;color:var(--muted-2);font-size:11px">' + sourceLabel + '</td>'
        + '<td style="padding:8px 10px;color:' + statusColor + ';font-weight:500">' + statusLabel + '</td>'
        + '<td style="padding:8px 10px;text-align:right">' + actions + '</td>'
        + '</tr>';
    }
    html += '</tbody></table></div>';
  }

  body.innerHTML = html;
  window.__teamHoursLastData = data;
}

window.__teamHoursReload = function() {
  const from = (document.getElementById('teamHrFrom') || {}).value;
  const to = (document.getElementById('teamHrTo') || {}).value;
  if (!from || !to) return;
  window.__teamHoursRange = { from, to };
  __renderTeamHoursOverview();
};

window.__teamApproveEntry = async function(id) {
  const s = window.dashboardState; if (!s) return;
  try {
    await s.api('/time-entries/' + id, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: 'approved' }),
    });
    if (window.ukcToast) window.ukcToast('Eintrag genehmigt', 'success');
    __renderTeamHoursOverview();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Fehler: ' + (e.message || ''), 'error');
  }
};

window.__teamMarkEntryPaid = async function(id) {
  const s = window.dashboardState; if (!s) return;
  if (!confirm('Eintrag als bezahlt markieren?\n\nWird mit aktuellem Datum als ausgezahlt verbucht.')) return;
  try {
    await s.api('/time-entries/' + id, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: 'paid' }),
    });
    if (window.ukcToast) window.ukcToast('Als bezahlt markiert', 'success');
    __renderTeamHoursOverview();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Fehler: ' + (e.message || ''), 'error');
  }
};

// =====================================================================
// Postfach: Auto-Reply Modal + New Message Modal
// =====================================================================
window.__openAutoReplyModal = async function() {
  const s = window.dashboardState; if (!s) return;
  let cfg = { outOfOfficeEnabled: false, outOfOfficeMessage: '', outOfOfficeUntil: null, welcomeEnabled: false, welcomeMessage: '' };
  try { const r = await s.api('/providers/' + s.provider.id + '/auto-reply'); cfg = r.data || cfg; } catch(e) {}

  const escAttr = v => String(v || '').replace(/"/g, '&quot;');
  const escTxt = v => String(v || '').replace(/</g, '&lt;');

  const bodyHtml = '<div style="padding:4px 0">'
    + '<div style="border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:14px">'
    +   '<label style="display:flex;align-items:center;gap:10px;cursor:pointer;margin-bottom:10px">'
    +     '<input type="checkbox" id="oooEnabled"' + (cfg.outOfOfficeEnabled ? ' checked' : '') + ' style="accent-color:var(--ochre);width:18px;height:18px">'
    +     '<strong style="font-size:14px">Out-of-Office aktiv</strong>'
    +   '</label>'
    +   '<p style="font-size:12px;color:var(--muted-2);margin-bottom:10px;line-height:1.5">Wird automatisch an Eltern gesendet, die dich kontaktieren — z.B. während Urlaub oder Krankheit.</p>'
    +   '<label class="kk-field" style="margin-bottom:10px"><span class="kk-label">Antwort-Text</span>'
    +     '<textarea class="kk-input" id="oooMessage" rows="4" maxlength="2000" placeholder="Hi! Ich bin bis zum DD.MM. nicht erreichbar — antworte direkt bei meiner Rückkehr. Bei dringenden Anliegen: ...">' + escTxt(cfg.outOfOfficeMessage) + '</textarea></label>'
    +   '<label class="kk-field"><span class="kk-label">Bis (optional)</span>'
    +     '<input class="kk-input" type="date" id="oooUntil" value="' + escAttr(cfg.outOfOfficeUntil) + '">'
    +     '<span class="kk-hint" style="font-size:11px;color:var(--muted-2);margin-top:4px">Nach diesem Datum wird die Auto-Antwort automatisch deaktiviert.</span></label>'
    + '</div>'
    + '<div style="border:1px solid var(--border);border-radius:10px;padding:14px">'
    +   '<label style="display:flex;align-items:center;gap:10px;cursor:pointer;margin-bottom:10px">'
    +     '<input type="checkbox" id="wlcEnabled"' + (cfg.welcomeEnabled ? ' checked' : '') + ' style="accent-color:var(--ochre);width:18px;height:18px">'
    +     '<strong style="font-size:14px">Begrüßung beim Erstkontakt</strong>'
    +   '</label>'
    +   '<p style="font-size:12px;color:var(--muted-2);margin-bottom:10px;line-height:1.5">Wird einmalig gesendet, wenn ein Elternteil zum ersten Mal eine Nachricht schreibt.</p>'
    +   '<label class="kk-field"><span class="kk-label">Begrüßungs-Text</span>'
    +     '<textarea class="kk-input" id="wlcMessage" rows="4" maxlength="2000" placeholder="Hi und herzlich willkommen! Ich melde mich in der Regel innerhalb von 24h zurück. Schöne Grüße!">' + escTxt(cfg.welcomeMessage) + '</textarea></label>'
    + '</div>'
    + '</div>';

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Postfach',
      titleHtml: 'Auto-<em>Antworten</em>',
      rows: [],
      bodyExtraHtml: bodyHtml,
      footerHtml: '<button class="btn btn-primary" onclick="window.__saveAutoReply()">Speichern</button>'
        + ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>',
    });
  }
};

window.__saveAutoReply = async function() {
  const s = window.dashboardState; if (!s) return;
  const v = id => (document.getElementById(id) || {});
  const payload = {
    outOfOfficeEnabled: !!v('oooEnabled').checked,
    outOfOfficeMessage: v('oooMessage').value || '',
    outOfOfficeUntil: v('oooUntil').value || null,
    welcomeEnabled: !!v('wlcEnabled').checked,
    welcomeMessage: v('wlcMessage').value || '',
  };
  try {
    await s.api('/providers/' + s.provider.id + '/auto-reply', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (window.ukcToast) window.ukcToast('Auto-Antworten gespeichert', 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Speichern fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};

window.__openNewMessageModal = async function() {
  const s = window.dashboardState; if (!s) return;
  // Load parents list (already done by /providers/:id/customers)
  let parents = [];
  try {
    const r = await s.api('/providers/' + s.provider.id + '/customers');
    parents = r.data || r.customers || r || [];
  } catch (e) {}

  const optionsHtml = parents.length === 0
    ? '<option value="">Keine Eltern vorhanden</option>'
    : '<option value="">— Eltern auswählen —</option>' + parents.map(p =>
        '<option value="' + p.id + '">' + (p.name || p.email || '?').replace(/</g, '&lt;') + (p.email ? ' · ' + p.email : '') + '</option>'
      ).join('');

  const bodyHtml = '<div style="padding:4px 0">'
    + '<label class="kk-field" style="margin-bottom:12px"><span class="kk-label">An *</span>'
    +   '<select class="kk-input" id="msgRecipient">' + optionsHtml + '</select></label>'
    + '<label class="kk-field" style="margin-bottom:12px"><span class="kk-label">Betreff</span>'
    +   '<input class="kk-input" type="text" id="msgSubject" maxlength="200" placeholder="z.B. Erinnerung Termin"></label>'
    + '<label class="kk-field"><span class="kk-label">Nachricht *</span>'
    +   '<textarea class="kk-input" id="msgBody" rows="6" maxlength="10000" placeholder="Hi …" required></textarea></label>'
    + '<div id="msgError" style="margin-top:10px"></div>'
    + '</div>';

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Postfach',
      titleHtml: 'Neue <em>Nachricht</em>',
      rows: [],
      bodyExtraHtml: bodyHtml,
      footerHtml: '<button class="btn btn-primary" onclick="window.__sendNewMessage()">Senden</button>'
        + ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>',
    });
  }
};

window.__sendNewMessage = async function() {
  const s = window.dashboardState; if (!s) return;
  const recipient = (document.getElementById('msgRecipient') || {}).value || '';
  const subject = (document.getElementById('msgSubject') || {}).value || '';
  const body = (document.getElementById('msgBody') || {}).value || '';
  const errEl = document.getElementById('msgError');
  if (errEl) errEl.innerHTML = '';
  if (!recipient) {
    if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">Bitte einen Empfänger wählen.</div>';
    return;
  }
  if (!body.trim()) {
    if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">Nachricht darf nicht leer sein.</div>';
    return;
  }
  try {
    await s.api('/messages', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        providerId: s.provider.id,
        parentId: recipient,
        type: 'direct',
        subject: subject.trim() || undefined,
        body: body.trim(),
      }),
    });
    if (window.ukcToast) window.ukcToast('Nachricht gesendet', 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    // Reload postfach if currently visible
    if (location.hash === '#postfach' && window.sectionLoaders.postfach) window.sectionLoaders.postfach();
  } catch (e) {
    if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">' + (e.message || 'Senden fehlgeschlagen') + '</div>';
  }
};

// =====================================================================
// Clock-In/Out Widget für eingeloggte Team-Mitglieder
// =====================================================================
let __clockState = { running: null, timer: null };

window.__initClockWidget = async function() {
  const s = window.dashboardState; if (!s) return;
  try {
    const r = await s.api('/me/time-entries?from=' + new Date(Date.now() - 24*60*60*1000).toISOString().slice(0,10));
    const data = r.data || r;
    __clockState.member = data.member;
    __clockState.running = data.running || null;
    const btn = document.getElementById('phClockBtn');
    if (btn && data.member) {
      btn.style.display = 'inline-flex';
      __renderClockBtn();
      if (__clockState.running) __startClockTimer();
    }
  } catch (e) {
    // Not a team member or API down — hide widget silently
    const btn = document.getElementById('phClockBtn');
    if (btn) btn.style.display = 'none';
  }
};

// Role-based UI restrictions: hide sections the user can't access
window.__applyRoleBasedNav = async function() {
  const s = window.dashboardState; if (!s) return;
  let me = null;
  try {
    const r = await s.api('/me');
    me = r.data || r;
  } catch (e) { return; }
  if (!me) return;
  s.role = me.role;
  s.permissions = me.permissions || {};

  const role = me.role;
  const perms = me.permissions || {};

  // Owner & admin see everything — no restrictions
  if (role === 'owner' || role === 'admin') return;

  // Permission-Area → required-permission tuple. If user lacks → hide nav item.
  const navMatrix = {
    'kurse': () => (perms.courses || []).includes('view'),
    'buchungen': () => (perms.bookings || []).includes('view'),
    'kursbloecke': () => (perms.courses || []).includes('view'),
    'kunden': () => (perms.customers || []).includes('view'),
    'probestunden': () => (perms.bookings || []).includes('view'),
    'team': () => (perms.team || []).includes('view'),
    'postfach': () => (perms.customers || []).includes('view'),
    'rechnungen': () => (perms.invoices || []).includes('view'),
    'berichte': () => (perms.reports || []).includes('view'),
    'credits': () => (perms.invoices || []).includes('view'),
    'anwesenheit': () => true, // Trainer always sees attendance
    'raeume': () => (perms.settings || []).includes('view'),
    'ferien': () => (perms.settings || []).includes('view'),
    'embed': () => (perms.embed || []).includes('view'),
    'marketing': () => (perms.marketing || []).includes('view'),
    'ki-assistent': () => (perms.reports || []).includes('view'),
    'integrationen': () => (perms.settings || []).includes('view'),
    'einstellungen': () => (perms.settings || []).includes('view'),
  };

  let hiddenCount = 0;
  document.querySelectorAll('.nav-item[data-section-target]').forEach(btn => {
    const target = btn.dataset.sectionTarget;
    if (target === 'dashboard') return; // always show
    const checker = navMatrix[target];
    if (checker && !checker()) {
      btn.style.display = 'none';
      hiddenCount++;
    }
  });

  // If current hash points to a hidden section, redirect to dashboard
  const currentHash = (location.hash || '').slice(1);
  if (currentHash && navMatrix[currentHash] && !navMatrix[currentHash]()) {
    location.hash = '#dashboard';
  }

  // Show small role-badge in user-chip area
  const userChip = document.querySelector('.user-chip-name');
  if (userChip && role && role !== 'owner') {
    const labels = { admin:'Admin', trainer:'Trainer', frontdesk:'Rezeption', accounting:'Buchhaltung', readonly:'Nur-Lesen' };
    const badge = document.createElement('span');
    badge.style.cssText = 'background:rgba(255,255,255,.15);color:inherit;padding:2px 8px;border-radius:6px;font-size:10px;margin-left:6px;font-weight:500';
    badge.textContent = labels[role] || role;
    userChip.appendChild(badge);
  }

  console.log('[v3] Role:', role, '— hidden', hiddenCount, 'nav items');
};

function __renderClockBtn() {
  const btn = document.getElementById('phClockBtn');
  const label = document.getElementById('phClockLabel');
  if (!btn || !label) return;
  if (__clockState.running) {
    const elapsed = Math.floor((Date.now() - new Date(__clockState.running.started_at).getTime()) / 1000);
    const h = Math.floor(elapsed / 3600);
    const m = Math.floor((elapsed % 3600) / 60);
    const s = elapsed % 60;
    label.textContent = (h > 0 ? h + ':' : '') + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    btn.title = 'Ausstempeln (läuft seit ' + new Date(__clockState.running.started_at).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) + ')';
    btn.style.background = '#fef2f2';
    btn.style.borderColor = '#dc2626';
    btn.style.color = '#dc2626';
  } else {
    label.textContent = 'Einstempeln';
    btn.title = 'Jetzt einstempeln';
    btn.style.background = '#fff9f5';
    btn.style.borderColor = 'var(--ochre)';
    btn.style.color = 'var(--ochre)';
  }
}

function __startClockTimer() {
  if (__clockState.timer) clearInterval(__clockState.timer);
  __clockState.timer = setInterval(__renderClockBtn, 1000);
}

function __stopClockTimer() {
  if (__clockState.timer) { clearInterval(__clockState.timer); __clockState.timer = null; }
}

window.__toggleClockIn = async function() {
  const s = window.dashboardState; if (!s) return;
  try {
    if (__clockState.running) {
      // Clock out
      const note = window.prompt('Notiz zum Stempeln (optional):', '') || '';
      const r = await s.api('/me/time-entries/clock-out', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notes: note }),
      });
      const ended = r.data || r;
      const dur = ended.duration_minutes || 0;
      __clockState.running = null;
      __stopClockTimer();
      __renderClockBtn();
      if (window.ukcToast) window.ukcToast('Ausgestempelt — ' + (dur / 60).toFixed(1) + 'h erfasst', 'success');
    } else {
      const r = await s.api('/me/time-entries/clock-in', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      });
      __clockState.running = r.data || r;
      __startClockTimer();
      __renderClockBtn();
      if (window.ukcToast) window.ukcToast('Eingestempelt — Timer läuft', 'success');
    }
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Fehler: ' + (e.message || ''), 'error');
  }
};

window.__teamHoursExportCsv = function() {
  const data = window.__teamHoursLastData;
  if (!data || !data.entries) return;
  const range = window.__teamHoursRange;
  let csv = 'Mitarbeiter;Datum;Start;Ende;Stunden;Stundenlohn (€);Brutto (€);Quelle;Status;Notizen\n';
  for (const e of data.entries) {
    const dur = e.duration_minutes || 0;
    const rate = ((e.hourly_rate_cents_snapshot || 0) / 100).toFixed(2).replace('.', ',');
    const brutto = (((dur / 60) * (e.hourly_rate_cents_snapshot || 0)) / 100).toFixed(2).replace('.', ',');
    const start = new Date(e.started_at);
    const end = e.ended_at ? new Date(e.ended_at) : null;
    csv += [
      '"' + (e.memberName || '').replace(/"/g, '""') + '"',
      start.toLocaleDateString('de-DE'),
      start.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }),
      end ? end.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) : '',
      (dur / 60).toFixed(2).replace('.', ','),
      rate, brutto,
      e.source, e.status,
      '"' + (e.notes || '').replace(/"/g, '""') + '"',
    ].join(';') + '\n';
  }
  const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'stunden_' + range.from + '_' + range.to + '.csv';
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
};

window.__teamDeleteMember = async function(memberId) {
  const s = window.dashboardState; if (!s) return;
  if (!confirm('Mitarbeiter deaktivieren?\n\nProfildaten und Zeiterfassung bleiben erhalten — die Person kann sich aber nicht mehr einloggen.\n\nKann später wieder aktiviert oder endgültig gelöscht werden.')) return;
  try {
    await s.api('/team/members/' + memberId, { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Mitarbeiter deaktiviert', 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    if (window.sectionLoaders && window.sectionLoaders.team) window.sectionLoaders.team();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Deaktivieren fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};

window.__teamReactivateMember = async function(memberId) {
  const s = window.dashboardState; if (!s) return;
  try {
    await s.api('/team/members/' + memberId + '/reactivate', { method: 'POST' });
    if (window.ukcToast) window.ukcToast('Mitarbeiter wieder aktiv', 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    if (window.sectionLoaders && window.sectionLoaders.team) window.sectionLoaders.team();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Reaktivieren fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};

window.__teamHardDeleteMember = async function(memberId, name) {
  const s = window.dashboardState; if (!s) return;
  // Fetch data summary first
  let summary = { timeEntries: 0, documents: 0 };
  try {
    const r = await s.api('/team/members/' + memberId + '/data-summary');
    summary = r.data || r;
  } catch (e) {}

  const warningParts = [];
  if (summary.timeEntries > 0) warningParts.push(summary.timeEntries + ' Zeiteinträge');
  if (summary.documents > 0) warningParts.push(summary.documents + ' Dokumente');
  const cascadeWarn = warningParts.length > 0
    ? '\n\nDamit werden ENDGÜLTIG mitgelöscht:\n• ' + warningParts.join('\n• ')
    : '\n\nKeine zugehörigen Daten — nur das Profil wird entfernt.';

  const confirmText = 'ENDGÜLTIG LÖSCHEN: ' + (name || 'Mitarbeiter') + '?' + cascadeWarn
    + '\n\nDieser Vorgang kann NICHT rückgängig gemacht werden.\n\nTippe LÖSCHEN um zu bestätigen:';
  const typed = window.prompt(confirmText, '');
  if (typed !== 'LÖSCHEN') {
    if (typed != null && typed !== '') {
      if (window.ukcToast) window.ukcToast('Bestätigung fehlgeschlagen — exakt „LÖSCHEN" tippen', 'error');
    }
    return;
  }
  try {
    await s.api('/team/members/' + memberId + '?hard=true', { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Mitarbeiter endgültig gelöscht', 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    if (window.sectionLoaders && window.sectionLoaders.team) window.sectionLoaders.team();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Löschen fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Löschen fehlgeschlagen: ' + (e.message || ''));
  }
};

window.sectionLoaders.raeume = async function() {
  const state = window.dashboardState; if (!state) return;
  const { provider, api } = state;
  let rooms = [];
  try {
    const r = await api('/rooms');
    rooms = r.data || r.rooms || r || [];
  } catch (e) { console.warn('[v3] /rooms failed', e); }
  window.__roomCache = rooms; // exposed für __roomOpen(id) Bearbeiten-Modal
  const activeRooms = rooms.filter(r => !r.archivedAt && r.status !== 'archived');
  const setText = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  const setHTML = (id, val) => { const el = document.getElementById(id); if (el) el.innerHTML = val; };
  setText('phRoomsKicker', provider.name || provider.displayName || '');
  setText('phRoomsSub', rooms.length === 0
    ? 'Noch keine Räume definiert. Sobald du Räume anlegst, prüfe ich automatisch Kollisionen beim Kurs-Anlegen.'
    : 'Definiere deine Räume — Kollisionen beim Kurs-Anlegen werden automatisch geblockt.');
  setHTML('phRoomsActive', activeRooms.length + (rooms.length !== activeRooms.length ? ' <em>von ' + rooms.length + '</em>' : ''));
  setText('phRoomsActiveDelta', rooms.length === 0 ? 'Noch keine Räume' : ' ');
  setHTML('phRoomsUtil', '– <em>%</em>');
  setText('phRoomsConflicts', '0');
  setText('phRoomsTodayBookings', '0');
  const grid = document.getElementById('phRoomsGrid');
  if (!grid) return;
  if (rooms.length === 0) {
    grid.innerHTML = '<div style="grid-column:1/-1;padding:40px;color:var(--muted);text-align:center;font-size:13px">Noch keine Räume.</div>';
    return;
  }
  grid.innerHTML = rooms.map(r => {
    const isActive = !r.archivedAt && r.status !== 'archived';
    return '<article class="block-card">'
      + '<div class="block-card-head"><div class="block-badge">' + (r.capacity || 0) + ' Plätze</div><div class="status-pill ' + (isActive ? 'status-active' : 'status-archived') + '">' + (isActive ? 'Aktiv' : 'Archiv') + '</div></div>'
      + '<h3 class="block-title">' + _escSC(r.name || 'Raum') + '</h3>'
      + '<div class="block-meta"><div class="block-meta-row"><span class="block-meta-label">Typ</span><span class="block-meta-val">' + _escSC(r.type || 'Standard') + '</span></div></div>'
      + '<div class="block-foot"><span class="progress-label">&nbsp;</span><button class="btn btn-ghost btn-sm" onclick="window.__roomOpen(\'' + r.id + '\')">Bearbeiten</button></div></article>';
  }).join('');
};

// ============================================================
// Räume-CRUD — Anlegen / Bearbeiten / Archivieren
// Re-uses .mf-* modal styles (siehe Marketing-Flow-Modal weiter unten)
// ============================================================
window.__roomCache = window.__roomCache || [];

// Belegungsplan-Modal: Tagesübersicht der Räume × Stunden mit Auslastung
window.__belegungsplanState = { date: new Date() };
window.__openBelegungsplan = function() {
  var d = new Date(); d.setHours(0,0,0,0);
  window.__belegungsplanState.date = d;
  var html =
    '<div class="mf-backdrop" onclick="if(event.target===this)window.__belegungsplanClose()">' +
    '<div class="mf-modal" role="dialog" style="max-width:1100px;width:96vw;max-height:88vh;overflow:auto;">' +
      '<div class="mf-head">' +
        '<div class="mf-kicker">R&auml;ume &middot; Belegungsplan</div>' +
        '<h2 class="mf-title">Belegung am <em id="bplanDayLabel">heute</em></h2>' +
        '<button class="mf-close" onclick="window.__belegungsplanClose()" aria-label="Schlie&szlig;en">&times;</button>' +
      '</div>' +
      '<div class="mf-body">' +
        '<div style="display:flex;gap:10px;align-items:center;margin-bottom:18px;flex-wrap:wrap;">' +
          '<button class="btn btn-ghost btn-sm" onclick="window.__belegungsplanNav(-1)">&lsaquo; Vortag</button>' +
          '<input type="date" id="bplanDateInput" class="kk-input" style="padding:6px 10px;font-size:13px;width:160px;" onchange="window.__belegungsplanSetDate(this.value)">' +
          '<button class="btn btn-ghost btn-sm" onclick="window.__belegungsplanToday()">Heute</button>' +
          '<button class="btn btn-ghost btn-sm" onclick="window.__belegungsplanNav(1)">Folgetag &rsaquo;</button>' +
          '<div style="margin-left:auto;font-size:12px;color:var(--muted);" id="bplanSummary">&nbsp;</div>' +
        '</div>' +
        '<div id="bplanGrid" style="overflow-x:auto;"></div>' +
      '</div>' +
    '</div></div>';
  var wrap = document.createElement('div');
  wrap.id = 'belegungsplanOverlay';
  wrap.innerHTML = html;
  document.body.appendChild(wrap);
  window.__belegungsplanRender();
};
window.__belegungsplanClose = function() {
  var el = document.getElementById('belegungsplanOverlay');
  if (el) el.remove();
};
window.__belegungsplanNav = function(delta) {
  var st = window.__belegungsplanState;
  var d = new Date(st.date); d.setDate(d.getDate() + delta);
  st.date = d;
  window.__belegungsplanRender();
};
window.__belegungsplanToday = function() {
  var d = new Date(); d.setHours(0,0,0,0);
  window.__belegungsplanState.date = d;
  window.__belegungsplanRender();
};
window.__belegungsplanSetDate = function(yyyymmdd) {
  if (!yyyymmdd) return;
  var p = yyyymmdd.split('-');
  if (p.length !== 3) return;
  var d = new Date(parseInt(p[0],10), parseInt(p[1],10)-1, parseInt(p[2],10));
  window.__belegungsplanState.date = d;
  window.__belegungsplanRender();
};
window.__belegungsplanRender = function() {
  var s = window.dashboardState; if (!s) return;
  var st = window.__belegungsplanState;
  var date = st.date;
  var label = date.toLocaleDateString('de-DE', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
  var iso = date.getFullYear() + '-' + String(date.getMonth()+1).padStart(2,'0') + '-' + String(date.getDate()).padStart(2,'0');
  var lblEl = document.getElementById('bplanDayLabel'); if (lblEl) lblEl.textContent = label;
  var inp = document.getElementById('bplanDateInput'); if (inp) inp.value = iso;
  var rooms = (window.__roomCache || []).filter(function(r){ return r && r.status !== 'archived'; });
  if (rooms.length === 0) rooms = [{ id: '_none_', name: 'Kein Raum konfiguriert', capacity: 0 }];
  var events = window.__kalActivitiesOnDate(date) || [];
  // Toggle filter: kein room-filter im modal — alle Räume zeigen
  var prevRoomFilter = window.__kalState ? window.__kalState.room : '';
  if (window.__kalState) window.__kalState.room = '';
  events = window.__kalActivitiesOnDate(date) || [];
  if (window.__kalState) window.__kalState.room = prevRoomFilter;

  var hourMin = 8, hourMax = 22; // 08-22
  var pxPerHour = 56;
  var totalHeight = (hourMax - hourMin) * pxPerHour + 8;

  // Group events by roomId
  var byRoom = {};
  rooms.forEach(function(r) { byRoom[r.id] = []; });
  byRoom['_none_'] = byRoom['_none_'] || [];
  events.forEach(function(ev) {
    var rid = ev.a.roomId || '_none_';
    if (!byRoom[rid]) byRoom[rid] = [];
    byRoom[rid].push(ev);
  });
  // Add Räume aus events that aren't in the rooms array (legacy)
  Object.keys(byRoom).forEach(function(rid) {
    if (rid === '_none_') {
      if (!rooms.find(function(r){ return r.id === '_none_'; })) {
        if (byRoom['_none_'].length > 0) rooms.push({ id: '_none_', name: 'Ohne Raum', capacity: 0 });
      }
      return;
    }
    if (!rooms.find(function(r){ return r.id === rid; })) {
      rooms.push({ id: rid, name: window.__kalRoomName(rid) || ('Raum ' + rid), capacity: 0 });
    }
  });

  // Build header with hours
  var header = '<thead><tr style="background:var(--bg);position:sticky;top:0;z-index:2;">'
    + '<th style="text-align:left;padding:8px 10px;font-size:11.5px;letter-spacing:0.04em;text-transform:uppercase;color:var(--muted);min-width:160px;border-bottom:1px solid var(--border);">Raum</th>';
  for (var h = hourMin; h < hourMax; h++) {
    header += '<th style="padding:8px 4px;font-size:10px;font-weight:600;color:var(--muted);text-align:left;border-bottom:1px solid var(--border);min-width:' + pxPerHour + 'px;width:' + pxPerHour + 'px;">' + String(h).padStart(2,'0') + ':00</th>';
  }
  header += '</tr></thead>';

  // Rows
  var totalSlots = rooms.length * (hourMax - hourMin);
  var occupiedSlots = 0;
  var bodyRows = rooms.map(function(r) {
    var rowEvents = byRoom[r.id] || [];
    // Cells per hour
    var cells = '<td style="padding:8px 10px;font-size:13px;font-weight:500;border-bottom:1px solid var(--border);background:var(--bg);position:sticky;left:0;z-index:1;"><div>' + (r.name || 'Raum') + '</div>'
      + (r.capacity ? '<div style="font-size:10px;color:var(--muted);">Kapazit&auml;t: ' + r.capacity + '</div>' : '')
      + '</td>';
    cells += '<td colspan="' + (hourMax - hourMin) + '" style="padding:0;border-bottom:1px solid var(--border);position:relative;height:' + (pxPerHour - 4) + 'px;">';
    // Hour grid lines
    for (var hh = hourMin + 1; hh < hourMax; hh++) {
      var leftPct = ((hh - hourMin) / (hourMax - hourMin)) * 100;
      cells += '<div style="position:absolute;left:' + leftPct + '%;top:0;bottom:0;width:1px;background:rgba(31,29,24,0.06);"></div>';
    }
    // Event bars
    rowEvents.forEach(function(ev) {
      var st = ev.slot.startTime || '00:00';
      var et = ev.slot.endTime || '00:00';
      var sH = parseFloat(st.split(':')[0]) + parseFloat(st.split(':')[1] || 0)/60;
      var eH = parseFloat(et.split(':')[0]) + parseFloat(et.split(':')[1] || 0)/60;
      if (eH <= hourMin || sH >= hourMax) return;
      sH = Math.max(sH, hourMin); eH = Math.min(eH, hourMax);
      var leftPct = ((sH - hourMin) / (hourMax - hourMin)) * 100;
      var widthPct = ((eH - sH) / (hourMax - hourMin)) * 100;
      occupiedSlots += (eH - sH);
      var cls = window.__kalCatClass ? window.__kalCatClass(ev.a) : 'eltern-kind';
      var bplDate = window.__belegungsplanState && window.__belegungsplanState.date;
      var booked = window.__kalEffectiveBooked ? window.__kalEffectiveBooked(ev.a, bplDate) : (window.__kalCountBooked ? window.__kalCountBooked(ev.a) : 0);
      var cap = ev.a.capacity || 0;
      var bplMeta = window.__kalCancMeta ? window.__kalCancMeta(ev.a, bplDate) : { sick: 0, addUp: 0 };
      var bplHints = [];
      if (bplMeta.sick > 0) bplHints.push(bplMeta.sick + ' krank');
      if (bplMeta.addUp > 0) bplHints.push(bplMeta.addUp + ' Add-Up');
      var bplHint = bplHints.length ? ' · ' + bplHints.join(' · ') : '';
      var titleEsc = (window.escapeHtml || function(x){ return x; })(ev.a.title || 'Kurs');
      cells += '<div class="cal-event ' + cls + '" style="position:absolute;left:' + leftPct + '%;width:calc(' + widthPct + '% - 4px);top:4px;bottom:4px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:11px;line-height:1.3;" onclick="window.viewCourseDetail(\'' + ev.a.id + '\');window.__belegungsplanClose();" title="' + titleEsc + ' · ' + st + '-' + et + ' · ' + booked + '/' + cap + bplHint + '">'
        + '<div style="font-weight:600;">' + titleEsc + '</div>'
        + '<div style="opacity:0.8;">' + st + '-' + et + ' · ' + booked + '/' + cap + bplHint + '</div>'
        + '</div>';
    });
    cells += '</td>';
    return '<tr>' + cells + '</tr>';
  });

  var grid = '<table style="border-collapse:collapse;width:100%;table-layout:fixed;">'
    + header
    + '<tbody>' + bodyRows.join('') + '</tbody>'
    + '</table>';
  document.getElementById('bplanGrid').innerHTML = grid;

  var pct = totalSlots > 0 ? Math.round((occupiedSlots / totalSlots) * 100) : 0;
  var sumEl = document.getElementById('bplanSummary');
  if (sumEl) sumEl.textContent = events.length + ' Termin' + (events.length === 1 ? '' : 'e') + ' · Auslastung ' + pct + '%';
};


window.__roomOpen = function(idOrNull) {
  var state = window.dashboardState; if (!state) return;
  var existing = idOrNull ? (window.__roomCache || []).find(function(r){ return r && r.id === idOrNull; }) : null;
  var r = existing || { id: null, name: '', capacity: 10, type: 'Standard', status: 'active' };

  function escAttr(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
  function escTxt(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  var html =
    '<div class="mf-backdrop" onclick="if(event.target===this)window.__roomClose()">' +
    '<div class="mf-modal" role="dialog" aria-labelledby="rmTitle">' +
      '<div class="mf-head">' +
        '<div class="mf-kicker">R&auml;ume &middot; Verwaltung</div>' +
        '<h2 id="rmTitle" class="mf-title">' + (existing ? 'Raum <em>bearbeiten</em>' : 'Neuer <em>Raum</em>') + '</h2>' +
        '<button class="mf-close" onclick="window.__roomClose()" aria-label="Schlie&szlig;en">&times;</button>' +
      '</div>' +
      '<div class="mf-body">' +
        '<label class="mf-label">Name <span class="mf-req">*</span></label>' +
        '<input class="mf-input" id="rmName" type="text" placeholder="z.B. Studio 1, Saal Nord, Bewegungsraum" value="' + escAttr(r.name) + '" />' +
        '<div class="mf-row">' +
          '<div class="mf-col">' +
            '<label class="mf-label">Kapazit&auml;t (Pl&auml;tze)</label>' +
            '<input class="mf-input" id="rmCapacity" type="number" min="1" max="200" value="' + (r.capacity || 10) + '" />' +
            '<div class="mf-hint">Maximale Teilnehmerzahl, die der Raum fasst.</div>' +
          '</div>' +
          '<div class="mf-col">' +
            '<label class="mf-label">Typ</label>' +
            '<input class="mf-input" id="rmType" type="text" placeholder="z.B. Standard, Gym, Studio" value="' + escAttr(r.type || 'Standard') + '" />' +
            '<div class="mf-hint">Optionales Label zur Kategorisierung.</div>' +
          '</div>' +
        '</div>' +
      '</div>' +
      '<div class="mf-foot">' +
        (existing ? '<button class="mf-btn mf-btn-ghost" onclick="window.__roomArchive(\'' + escAttr(r.id) + '\')">Archivieren</button>' : '<span></span>') +
        '<div class="mf-foot-right">' +
          '<button class="mf-btn mf-btn-ghost" onclick="window.__roomClose()">Abbrechen</button>' +
          '<button class="mf-btn mf-btn-primary" id="rmSubmit" onclick="window.__roomSave(' + (existing ? '\'' + escAttr(r.id) + '\'' : 'null') + ')">' + (existing ? 'Speichern' : 'Anlegen') + '</button>' +
        '</div>' +
      '</div>' +
    '</div>' +
    '</div>';

  var root = document.getElementById('mf-modal-root');
  if (!root) {
    root = document.createElement('div');
    root.id = 'mf-modal-root';
    document.body.appendChild(root);
  }
  root.innerHTML = html;
  setTimeout(function(){ var f = document.getElementById('rmName'); if (f) f.focus(); }, 50);
};

window.__roomClose = function() {
  var root = document.getElementById('mf-modal-root');
  if (root) root.innerHTML = '';
};

window.__roomSave = async function(idOrNull) {
  var state = window.dashboardState; if (!state) return;
  var btn = document.getElementById('rmSubmit'); if (btn) { btn.disabled = true; btn.textContent = 'Speichert…'; }
  var name = (document.getElementById('rmName').value || '').trim();
  var capacity = parseInt(document.getElementById('rmCapacity').value, 10) || 0;
  var type = (document.getElementById('rmType').value || '').trim() || 'Standard';
  if (!name) {
    if (window.ukcToast) window.ukcToast('Bitte Name eingeben', 'warning');
    if (btn) { btn.disabled = false; btn.textContent = idOrNull ? 'Speichern' : 'Anlegen'; }
    return;
  }
  if (capacity < 1) {
    if (window.ukcToast) window.ukcToast('Kapazität mindestens 1', 'warning');
    if (btn) { btn.disabled = false; btn.textContent = idOrNull ? 'Speichern' : 'Anlegen'; }
    return;
  }
  try {
    var url = idOrNull ? '/api/rooms/' + encodeURIComponent(idOrNull) : '/api/rooms';
    var method = idOrNull ? 'PUT' : 'POST';
    var resp = await fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (state.token || '') },
      body: JSON.stringify({ name: name, capacity: capacity, type: type }),
    });
    if (!resp.ok) {
      var err = await resp.json().catch(function(){ return {}; });
      throw new Error(err.error || err.message || ('HTTP ' + resp.status));
    }
    if (window.ukcToast) window.ukcToast(idOrNull ? 'Raum gespeichert' : 'Raum angelegt', 'success');
    window.__roomClose();
    if (window.sectionLoaders && window.sectionLoaders.raeume) await window.sectionLoaders.raeume();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Fehler: ' + (e.message || e), 'error');
    if (btn) { btn.disabled = false; btn.textContent = idOrNull ? 'Speichern' : 'Anlegen'; }
  }
};

window.__roomArchive = async function(id) {
  var state = window.dashboardState; if (!state || !id) return;
  var ok = window.ukcConfirm
    ? await window.ukcConfirm({ title: 'Raum archivieren?', message: 'Bestehende Buchungen bleiben erhalten. Der Raum verschwindet aus der Auswahl beim Kurs-Anlegen.', okLabel: 'Archivieren', variant: 'danger' })
    : confirm('Raum wirklich archivieren? Bestehende Buchungen bleiben erhalten.');
  if (!ok) return;
  try {
    var resp = await fetch('/api/rooms/' + encodeURIComponent(id), {
      method: 'DELETE',
      headers: { 'Authorization': 'Bearer ' + (state.token || '') },
    });
    if (!resp.ok) {
      var err = await resp.json().catch(function(){ return {}; });
      throw new Error(err.error || ('HTTP ' + resp.status));
    }
    if (window.ukcToast) window.ukcToast('Raum archiviert', 'success');
    window.__roomClose();
    if (window.sectionLoaders && window.sectionLoaders.raeume) await window.sectionLoaders.raeume();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Fehler: ' + (e.message || e), 'error');
  }
};

window.sectionLoaders.ferien = async function() {
  const state = window.dashboardState; if (!state) return;
  const { api, provider } = state;
  const year = new Date().getFullYear();
  const setText = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  setText('phFerienYear', year);

  // Load both: public German holidays + provider's own breaks
  let publicHolidays = [], ownBreaks = [];
  try {
    const r = await api('/holidays/bundeslaender?bundesland=BE&year=' + year);
    publicHolidays = (r.data || r.holidays || r || []).map(h => ({ ...h, _own: false }));
  } catch (e) { console.warn('[v3] /holidays public failed', e); }
  try {
    const r = await api('/providers/' + provider.id + '/holidays');
    ownBreaks = (r.data || []).map(h => ({ ...h, _own: true }));
  } catch (e) { console.warn('[v3] /providers/holidays failed', e); }

  const all = [...publicHolidays, ...ownBreaks].map(h => ({
    id: h.id || null,
    date: h.date || h.startDate || h.start_date,
    endDate: h.endDate || h.end_date || null,
    name: h.name,
    own: !!h._own,
  })).filter(h => h.date).sort((a, b) => new Date(a.date) - new Date(b.date));

  setText('phFerienBundesland', 'Berlin · automatisch');
  const future = all.filter(h => new Date(h.date) >= new Date());
  const next = future[0];
  const heroTitle = document.querySelector('#phFerienHero .hero-title');
  const heroSub = document.getElementById('phFerienHeroSub');
  if (next && heroTitle) {
    const days = Math.ceil((new Date(next.date) - new Date())/86400000);
    heroTitle.innerHTML = 'Nächste Schließung: <em class="italic">' + _escSC(next.name) + '</em>';
    if (heroSub) heroSub.textContent = new Date(next.date).toLocaleDateString('de-DE',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}) + ' · in ' + days + ' Tag' + (days === 1 ? '' : 'en');
    setText('phFerienNextDays', days);
    setText('phFerienNextLabel', 'Tag' + (days === 1 ? '' : 'en'));
  } else if (heroTitle) {
    heroTitle.textContent = 'Keine bevorstehenden Schließungen';
    if (heroSub) heroSub.textContent = ' ';
    setText('phFerienNextDays', '–');
  }
  setText('phFerienHolidays', publicHolidays.length);
  setText('phFerienOwnBreaks', ownBreaks.length);
  setText('phFerienAffected', '0');
  setText('phFerienSub', all.length === 0
    ? 'Keine Feiertage geladen.'
    : publicHolidays.length + ' Feiertage + ' + ownBreaks.length + ' eigene Pausen · automatisch im Kalender geblockt.');
  const tbody = document.getElementById('phFerienTbody');
  if (!tbody) return;
  if (all.length === 0) {
    tbody.innerHTML = '<tr><td colspan="5" style="padding:40px;color:var(--muted);text-align:center;font-size:13px">Keine Feiertage oder Pausen.</td></tr>';
    return;
  }
  tbody.innerHTML = all.slice(0, 50).map(h => {
    const past = new Date(h.date) < new Date();
    const dateStr = h.endDate && h.endDate !== h.date
      ? new Date(h.date).toLocaleDateString('de-DE',{day:'2-digit',month:'short'}) + ' – ' + new Date(h.endDate).toLocaleDateString('de-DE',{day:'2-digit',month:'short'})
      : new Date(h.date).toLocaleDateString('de-DE',{weekday:'short',day:'2-digit',month:'short'});
    const typeLabel = h.own ? 'Eigene Pause' : 'Feiertag';
    const action = h.own && h.id
      ? '<button class="row-action-btn" title="Löschen" onclick="window.__deleteBreak(\'' + h.id + '\', \'' + (h.name || '').replace(/\'/g, '&#39;') + '\')" style="color:var(--signal)">×</button>'
      : '<span style="color:var(--muted-2);font-size:11px">automatisch</span>';
    return '<tr><td style="padding-left:20px;">' + dateStr + '</td>'
      + '<td>' + _escSC(h.name) + '</td><td>' + typeLabel + '</td>'
      + '<td><span class="pill ' + (past ? '' : 'pill-ok') + '">' + (past ? 'Vergangen' : 'Geplant') + '</span></td>'
      + '<td style="padding-right:20px;text-align:right;">' + action + '</td></tr>';
  }).join('');
};

window.__openNewBreakModal = function() {
  const s = window.dashboardState; if (!s) return;
  const today = new Date().toISOString().slice(0, 10);
  const bodyHtml = '<div style="padding:4px 0">'
    + '<label class="kk-field" style="margin-bottom:12px"><span class="kk-label">Anlass *</span>'
    +   '<input class="kk-input" type="text" id="brkName" maxlength="200" placeholder="z.B. Sommerpause, Wartung, Fortbildung"></label>'
    + '<div class="kk-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">'
    +   '<label class="kk-field"><span class="kk-label">Von *</span><input class="kk-input" type="date" id="brkStart" value="' + today + '"></label>'
    +   '<label class="kk-field"><span class="kk-label">Bis *</span><input class="kk-input" type="date" id="brkEnd" value="' + today + '"></label>'
    + '</div>'
    + '<label style="display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--border);border-radius:8px;margin-top:6px;cursor:pointer">'
    +   '<input type="checkbox" id="brkCancel" style="accent-color:var(--ochre)">'
    +   '<div><div style="font-size:13px;font-weight:500">Buchungen automatisch absagen</div>'
    +   '<div style="font-size:11px;color:var(--muted-2);margin-top:2px">Termine an diesen Tagen werden storniert + Eltern informiert.</div></div>'
    + '</label>'
    + '<div id="brkError" style="margin-top:10px"></div>'
    + '</div>';
  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Ferien & Saisons',
      titleHtml: 'Neue <em>Pause</em>',
      rows: [],
      bodyExtraHtml: bodyHtml,
      footerHtml: '<button class="btn btn-primary" onclick="window.__saveBreak()">Pause anlegen</button>'
        + ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>',
    });
  }
};

window.__saveBreak = async function() {
  const s = window.dashboardState; if (!s) return;
  const v = id => (document.getElementById(id) || {}).value || '';
  const name = v('brkName').trim();
  const startDate = v('brkStart');
  const endDate = v('brkEnd');
  const cancelActivities = !!(document.getElementById('brkCancel') || {}).checked;
  const errEl = document.getElementById('brkError');
  if (errEl) errEl.innerHTML = '';
  if (!name) { if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">Anlass eingeben.</div>'; return; }
  if (!startDate || !endDate) { if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">Datum fehlt.</div>'; return; }
  if (new Date(endDate) < new Date(startDate)) { if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">Bis-Datum vor Von-Datum.</div>'; return; }
  try {
    await s.api('/holidays', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ providerId: s.provider.id, name, startDate, endDate, cancelActivities }),
    });
    if (window.ukcToast) window.ukcToast('Pause angelegt', 'success');
    document.querySelectorAll('.ukc-detail-overlay').forEach(o => o.remove());
    if (window.sectionLoaders.ferien) window.sectionLoaders.ferien();
  } catch (e) {
    if (errEl) errEl.innerHTML = '<div style="color:var(--signal);font-size:13px">' + (e.message || 'Speichern fehlgeschlagen') + '</div>';
  }
};

window.__deleteBreak = async function(id, name) {
  const s = window.dashboardState; if (!s) return;
  if (!confirm('Pause „' + (name || 'unbenannt') + '" löschen?')) return;
  try {
    await s.api('/holidays/' + id, { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Pause gelöscht', 'success');
    if (window.sectionLoaders.ferien) window.sectionLoaders.ferien();
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Löschen fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};


window.__settingsSaveAddUp = async function() {
  var s = window.dashboardState; if (!s) return;
  var addUpEnabled = (document.getElementById('phSetAddUpEnabled') || {}).value === 'true';
  var cutoff = parseInt((document.getElementById('phSetCancelCutoff') || {}).value, 10);
  var expiry = parseInt((document.getElementById('phSetCreditExpiry') || {}).value, 10);
  var defaultAU = parseInt((document.getElementById('phSetDefaultAddUp') || {}).value, 10);
  if (isNaN(cutoff) || cutoff < 0 || cutoff > 168) cutoff = 24;
  if (isNaN(expiry) || expiry < 1 || expiry > 24) expiry = 6;
  if (isNaN(defaultAU) || defaultAU < 0 || defaultAU > 50) defaultAU = 2;
  try {
    var resp = await fetch('/api/providers/' + s.provider.id + '/settings', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
      body: JSON.stringify({
        makeupEnabled: addUpEnabled,
        cancelCutoffHours: cutoff,
        defaultAddupSlots: defaultAU,
        creditExpiryMonths: expiry,
      }),
    });
    var json = await resp.json().catch(function(){ return {}; });
    if (resp.ok) {
      s.provider = Object.assign({}, s.provider || {}, {
        makeupEnabled: addUpEnabled,
        cancel_cutoff_hours: cutoff,
        default_addup_slots: defaultAU,
        credit_expiry_months: expiry,
      });
      if (window.ukcToast) window.ukcToast('Einstellungen gespeichert');
    } else {
      if (window.ukcToast) window.ukcToast('Speichern fehlgeschlagen: ' + (json.error || resp.status));
    }
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Netzwerkfehler beim Speichern');
  }
};

// ─── Öffnungszeiten Editor ──────────────────────────────────
window.__OH_DAYS = [
  { key: 'MO', label: 'Montag' },
  { key: 'TU', label: 'Dienstag' },
  { key: 'WE', label: 'Mittwoch' },
  { key: 'TH', label: 'Donnerstag' },
  { key: 'FR', label: 'Freitag' },
  { key: 'SA', label: 'Samstag' },
  { key: 'SU', label: 'Sonntag' },
];

window.__settingsRenderOpeningHours = function(oh) {
  oh = oh || {};
  var container = document.getElementById('phSetOpeningHours');
  if (!container) return;
  container.innerHTML = window.__OH_DAYS.map(function(d) {
    var dh = oh[d.key] || null;
    var open = dh && dh.open ? dh.open : '09:00';
    var close = dh && dh.close ? dh.close : '18:00';
    var checked = dh ? 'checked' : '';
    return '<div class="oh-row" data-day="' + d.key + '" style="display:grid;grid-template-columns:130px 80px 1fr 1fr;gap:12px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);">'
      + '<label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;font-weight:500;">'
      +   '<input type="checkbox" class="oh-active" ' + checked + ' onchange="window.__ohToggleDay(this)">'
      +   '<span>' + d.label + '</span>'
      + '</label>'
      + '<span class="oh-state" style="font-size:11px;color:var(--muted);">' + (dh ? 'Offen' : 'Geschlossen') + '</span>'
      + '<input type="time" class="kk-input oh-open" value="' + open + '" ' + (dh ? '' : 'disabled') + ' style="padding:6px 10px;font-size:13px;">'
      + '<input type="time" class="kk-input oh-close" value="' + close + '" ' + (dh ? '' : 'disabled') + ' style="padding:6px 10px;font-size:13px;">'
      + '</div>';
  }).join('');
};

window.__ohToggleDay = function(cb) {
  var row = cb.closest('.oh-row'); if (!row) return;
  var on = !!cb.checked;
  row.querySelector('.oh-state').textContent = on ? 'Offen' : 'Geschlossen';
  row.querySelectorAll('.oh-open, .oh-close').forEach(function(i) { i.disabled = !on; });
};

window.__settingsLoadOpeningHours = async function() {
  var s = window.dashboardState; if (!s) return;
  try {
    var resp = await fetch('/api/opening-hours', { headers: { 'Authorization': 'Bearer ' + (s.token || '') } });
    var json = await resp.json().catch(function(){ return {}; });
    window.__settingsRenderOpeningHours(json.data || {});
  } catch (e) {
    console.warn('[Settings] opening-hours load failed', e);
    window.__settingsRenderOpeningHours({});
  }
};

window.__settingsSaveOpeningHours = async function() {
  var s = window.dashboardState; if (!s) return;
  var rows = document.querySelectorAll('#phSetOpeningHours .oh-row');
  var oh = {};
  var hasError = false;
  rows.forEach(function(row) {
    if (hasError) return;
    var day = row.dataset.day;
    var active = row.querySelector('.oh-active').checked;
    if (!active) { oh[day] = null; return; }
    var open = row.querySelector('.oh-open').value;
    var close = row.querySelector('.oh-close').value;
    if (!open || !close) { hasError = true; if (window.ukcToast) window.ukcToast('Bitte Öffnungs- und Schließzeit für ' + day + ' angeben.'); return; }
    if (open >= close) { hasError = true; if (window.ukcToast) window.ukcToast('Schließzeit muss nach Öffnungszeit liegen (' + day + ').'); return; }
    oh[day] = { open: open, close: close };
  });
  if (hasError) return;
  try {
    var resp = await fetch('/api/opening-hours', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
      body: JSON.stringify(oh),
    });
    var json = await resp.json().catch(function(){ return {}; });
    if (resp.ok) {
      if (window.ukcToast) window.ukcToast('Öffnungszeiten gespeichert');
    } else {
      if (window.ukcToast) window.ukcToast('Speichern fehlgeschlagen: ' + (json.error || resp.status));
    }
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Netzwerkfehler beim Speichern');
  }
};

// Load current settings into the form when Einstellungen section opens
window.__settingsLoadAddUp = async function() {
  var s = window.dashboardState; if (!s) return;
  try {
    var resp = await fetch('/api/providers/' + s.provider.id + '/settings', {
      headers: { 'Authorization': 'Bearer ' + (s.token || '') },
    });
    var json = await resp.json();
    var d = json.data || {};
    var setVal = function(id, val) { var el = document.getElementById(id); if (el && val != null) el.value = val; };
    setVal('phSetAddUpEnabled', d.makeup_enabled === false ? 'false' : 'true');
    setVal('phSetCancelCutoff', d.cancel_cutoff_hours != null ? d.cancel_cutoff_hours : 24);
    setVal('phSetCreditExpiry', d.credit_expiry_months != null ? d.credit_expiry_months : 6);
    setVal('phSetDefaultAddUp', d.default_addup_slots != null ? d.default_addup_slots : 2);
  } catch(e) { console.warn('[Settings] load failed', e); }
};

window.sectionLoaders.einstellungen = async function() {
  const state = window.dashboardState; if (!state) return;
  const { provider, api } = state;
  let me = Object.assign({}, provider);
  try {
    const r = await api('/me');
    const meData = r.data || r;
    if (meData && typeof meData === 'object') me = Object.assign({}, me, meData);
  } catch (e) {}
  // Fallback: also fetch full provider record if name still missing
  if (!me.name && !me.displayName && provider && provider.id) {
    try {
      const r = await api('/providers/' + provider.id);
      const pData = r.data || r;
      if (pData && typeof pData === 'object') me = Object.assign({}, pData, me);
    } catch (e) {}
  }
  const setText = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };
  const contact = me.contact || {};
  const addr = me.address || {};
  const pname = me.displayName || me.name || me.businessName || 'Provider';
  setText('phSetSub', 'Profil von ' + pname);
  setVal('phSetName', pname !== 'Provider' ? pname : '');
  setVal('phSetEmail', me.email || contact.email || me.contactEmail || '');
  setVal('phSetPhone', me.phone || contact.phone || me.contactPhone || '');
  setVal('phSetCity', addr.city || me.city || me.locationCity || '');
  const pay = document.getElementById('phSetPayments');
  if (!pay) return;
  const methods = [];
  if (me.paymentOnline || me.stripeConnected) methods.push({ name: 'Stripe', active: !!me.stripeConnected });
  if (me.paypalEnabled) methods.push({ name: 'PayPal', active: true });
  if (me.sepaEnabled) methods.push({ name: 'SEPA', active: true });
  if (me.invoiceEnabled !== false) methods.push({ name: 'Rechnung', active: true });
  if (me.cashEnabled) methods.push({ name: 'Bar', active: true });
  pay.innerHTML = methods.length === 0
    ? '<span style="color:var(--muted);font-size:13px">Noch keine Zahlungsmethoden konfiguriert.</span>'
    : methods.map(m => '<span class="pill ' + (m.active ? 'pill-ok' : '') + '" style="padding:6px 12px;">' + _escSC(m.name) + '</span>').join('');

  // Load Add-Up & Credits settings from server
  if (typeof window.__settingsLoadAddUp === 'function') window.__settingsLoadAddUp();
  if (typeof window.__settingsLoadOpeningHours === 'function') window.__settingsLoadOpeningHours();

  // QR-Code section
  if (provider && provider.id) {
    const checkinUrl = window.location.origin + '/checkin/' + provider.id;
    const urlEl = document.getElementById('phSetCheckinUrl');
    if (urlEl) urlEl.textContent = checkinUrl;
    const thumbEl = document.getElementById('phSetQrThumb');
    if (thumbEl) thumbEl.src = 'https://api.qrserver.com/v1/create-qr-code/?size=320x320&margin=2&format=png&data=' + encodeURIComponent(checkinUrl);
  }

  // Check-In-Zeitfenster laden
  if (typeof window.__settingsLoadCheckinWindow === 'function') window.__settingsLoadCheckinWindow();

  // Pflicht-Dokumente laden
  if (typeof window.__settingsLoadRequiredDocs === 'function') window.__settingsLoadRequiredDocs();
};

// Pflicht-Dokumente in Einstellungen
window.__settingsLoadRequiredDocs = async function() {
  const s = window.dashboardState; if (!s) return;
  const DOC_TYPES = [
    { value: 'fuehrungszeugnis', label: 'Führungszeugnis' },
    { value: 'fuehrungszeugnis_erweitert', label: 'Erweitertes Führungszeugnis (§ 30a BZRG)' },
    { value: 'hygiene_belehrung', label: 'Belehrung § 43 IfSG (Hygiene)' },
    { value: 'erste_hilfe', label: 'Erste-Hilfe-Schein' },
    { value: 'qualifikation', label: 'Qualifikation / Zertifikat' },
    { value: 'arbeitsvertrag', label: 'Arbeitsvertrag / Honorarvertrag' },
  ];
  let required = [];
  try {
    const r = await s.api('/providers/' + s.provider.id + '/required-documents');
    required = (r.data && r.data.required) || [];
  } catch (e) { console.warn('[v3] required-docs load failed', e); }
  const container = document.getElementById('phSetReqDocs');
  if (!container) return;
  container.innerHTML = DOC_TYPES.map(d =>
    '<label style="display:flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid var(--border);border-radius:10px;cursor:pointer">'
    + '<input type="checkbox" data-doctype="' + d.value + '"' + (required.indexOf(d.value) >= 0 ? ' checked' : '') + ' style="accent-color:var(--ochre)">'
    + '<span style="font-size:14px">' + d.label + '</span></label>'
  ).join('');
};

window.__settingsSaveRequiredDocs = async function() {
  const s = window.dashboardState; if (!s) return;
  const checked = Array.from(document.querySelectorAll('#phSetReqDocs input:checked')).map(cb => cb.dataset.doctype);
  try {
    await s.api('/providers/' + s.provider.id + '/required-documents', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ required: checked }),
    });
    if (window.ukcToast) window.ukcToast('Pflicht-Dokumente gespeichert', 'success');
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Speichern fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};

// Lade Check-In-Window aus DB
window.__settingsLoadCheckinWindow = async function() {
  const s = window.dashboardState; if (!s) return;
  try {
    const r = await s.api('/providers/' + s.provider.id + '/checkin-settings');
    const d = r.data || r;
    var before = (d.checkinBeforeMinutes != null) ? d.checkinBeforeMinutes : 20;
    var after = (d.checkinAfterMinutes != null) ? d.checkinAfterMinutes : 10;
    var bEl = document.getElementById('phSetCheckinBefore');
    var aEl = document.getElementById('phSetCheckinAfter');
    if (bEl) bEl.value = before;
    if (aEl) aEl.value = after;
    window.__updateCheckinExample();
    if (bEl && !bEl.__listenerAttached) {
      bEl.addEventListener('input', window.__updateCheckinExample);
      bEl.__listenerAttached = true;
    }
    if (aEl && !aEl.__listenerAttached) {
      aEl.addEventListener('input', window.__updateCheckinExample);
      aEl.__listenerAttached = true;
    }
  } catch (e) { console.warn('[v3] checkin-settings load failed', e); }
};

// Live-Beispiel für 14:00 Kursstart
window.__updateCheckinExample = function() {
  var bEl = document.getElementById('phSetCheckinBefore');
  var aEl = document.getElementById('phSetCheckinAfter');
  var exEl = document.getElementById('phSetCheckinExample');
  if (!bEl || !aEl || !exEl) return;
  var before = parseInt(bEl.value, 10) || 0;
  var after = parseInt(aEl.value, 10) || 0;
  // Beispiel: 14:00 - before / 14:00 + after
  function fmt(min) {
    var h = Math.floor(min / 60);
    var m = min % 60;
    return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
  }
  var startMin = 14 * 60;
  exEl.textContent = 'Beispiel: Kursstart 14:00 → Check-In von ' + fmt(startMin - before) + ' bis ' + fmt(startMin + after) + '.';
};

// Speichern
window.__settingsSaveCheckinWindow = async function() {
  const s = window.dashboardState; if (!s) return;
  var before = parseInt(document.getElementById('phSetCheckinBefore').value, 10);
  var after = parseInt(document.getElementById('phSetCheckinAfter').value, 10);
  if (isNaN(before) || before < 0 || before > 240) {
    if (window.ukcToast) window.ukcToast('Vor-Wert muss zwischen 0 und 240 liegen', 'error');
    else alert('Vor-Wert muss zwischen 0 und 240 liegen');
    return;
  }
  if (isNaN(after) || after < 0 || after > 240) {
    if (window.ukcToast) window.ukcToast('Nach-Wert muss zwischen 0 und 240 liegen', 'error');
    else alert('Nach-Wert muss zwischen 0 und 240 liegen');
    return;
  }
  try {
    await s.api('/providers/' + s.provider.id + '/checkin-settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ checkinBeforeMinutes: before, checkinAfterMinutes: after }),
    });
    if (window.ukcToast) window.ukcToast('Check-In-Zeitfenster gespeichert', 'success');
    else alert('Gespeichert');
  } catch (e) {
    console.error('[v3] save checkin-settings failed', e);
    if (window.ukcToast) window.ukcToast('Speichern fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Speichern fehlgeschlagen');
  }
};

// Helper: copy current provider's check-in URL
window.__settingsCopyCheckinUrl = function() {
  const s = window.dashboardState;
  if (!s || !s.provider) return;
  const url = window.location.origin + '/checkin/' + s.provider.id;
  navigator.clipboard.writeText(url).then(function() {
    if (window.ukcToast) window.ukcToast('URL kopiert: ' + url, 'success');
  }).catch(function() {
    window.prompt('URL zum Kopieren:', url);
  });
};

// Helper: open the public check-in page in a new tab
window.__settingsOpenCheckinPreview = function() {
  const s = window.dashboardState;
  if (!s || !s.provider) return;
  window.open(window.location.origin + '/checkin/' + s.provider.id, '_blank');
};

// ============================================================
// Sprint D: Marketing-Section Loader (Smart-Flows + Templates + Stats)
// ============================================================
window.sectionLoaders.marketing = async function() {
  const state = window.dashboardState; if (!state) return;
  const { provider, api } = state;

  function escMk(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  const TRIGGER_LABEL = {
    customer_signup:'Neuer Kunde registriert', booking_confirmed:'Buchung bestätigt',
    booking_reminder_24h:'24h vor Termin', booking_completed:'Kurs abgeschlossen',
    trial_completed:'Probestunde abgeschlossen', trial_no_conversion:'Probestunde ohne Buchung',
    payment_received:'Zahlung eingegangen', payment_overdue:'Zahlung überfällig',
    waitlist_spot_available:'Warteliste-Platz frei', child_birthday:'Kind hat Geburtstag',
    inactive_customer:'Kunde inaktiv', course_ending_soon:'Kurspaket endet bald',
    loyalty_tier_upgrade:'Treuestufe Aufstieg', review_request:'Bewertung anfragen',
    seasonal_reminder:'Saisonstart',
  };
  const CHANNEL_ICON = { whatsapp:'💬', email:'✉', sms:'📱' };
  const STATUS_LABEL = { active:'Aktiv', paused:'Pausiert', draft:'Entwurf' };
  const STATUS_PILL = { active:'pill-ok', paused:'pill-pending', draft:'' };

  // ──────────────────────────────────────────────────────────────
  // Mom-Graph Block: Funnel + KPIs + Leaderboard + Activity
  // ──────────────────────────────────────────────────────────────
  function mgRelTime(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    const diff = Date.now() - d.getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'gerade eben';
    if (mins < 60) return 'vor ' + mins + ' Min.';
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return 'vor ' + hrs + ' Std.';
    const days = Math.floor(hrs / 24);
    if (days === 1) return 'gestern, ' + d.toLocaleTimeString('de-DE', { hour:'2-digit', minute:'2-digit' });
    if (days < 7) return 'vor ' + days + ' Tagen';
    return d.toLocaleDateString('de-DE', { day:'2-digit', month:'short' });
  }
  try {
    const mgR = await api('/providers/' + provider.id + '/mom-graph/dashboard').catch(() => null);
    const mg = mgR && mgR.data;
    if (mg) {
      const root = document.querySelector('[data-section="marketing"]');
      if (root) {
        // 1. Funnel — 4 Steps in Reihenfolge: Versendet, Geschnuppert, Gebucht, Credits
        const steps = root.querySelectorAll('.funnel .funnel-step');
        if (steps.length === 4) {
          const sent = mg.funnel.sent || 0;
          const tb = mg.funnel.trial_booked || 0;
          const conv = mg.funnel.converted || 0;
          const cr = mg.funnel.credits_issued || 0;
          const trialPct = sent > 0 ? Math.round((tb / sent) * 100) : 0;
          const convPct = tb > 0 ? Math.round((conv / tb) * 100) : 0;
          steps[0].querySelector('.funnel-step-num').innerHTML = sent + ' <em>Invites</em>';
          steps[1].querySelector('.funnel-step-num').innerHTML = tb + ' <em>· ' + trialPct + ' %</em>';
          steps[2].querySelector('.funnel-step-num').innerHTML = conv + ' <em>· ' + convPct + ' %</em>';
          steps[3].querySelector('.funnel-step-num').innerHTML = cr + ' <em>Credits</em>';
        }
        // 2. KPIs — 4 stat-cards (NICHT die smart-flows stats #phMarketingStats)
        const kpiStats = root.querySelectorAll('.stats:not(#phMarketingStats) .stat');
        if (kpiStats.length >= 4) {
          const k = mg.kpis || {};
          const set = (idx, val, em) => {
            const v = kpiStats[idx] && kpiStats[idx].querySelector('.stat-value');
            if (v) v.innerHTML = (val == null ? '0' : String(val).replace('.', ',')) + (em ? '<em>' + em + '</em>' : '');
          };
          set(0, k.viral_k_factor != null ? k.viral_k_factor : 0, '×');
          set(1, k.new_via_momgraph || 0, ' Fam.');
          set(2, k.credits_open || 0, ' Credits');
          set(3, k.credits_cac_savings_euro || 0, '€');
        }
        // 3. Leaderboard + Activity Cards (in .detail-grid)
        const cards = root.querySelectorAll('.detail-grid .card');
        let lbCard = null, actCard = null;
        cards.forEach(c => {
          const t = (c.querySelector('.card-title') || {}).textContent || '';
          if (t.toLowerCase().includes('empfehler')) lbCard = c;
          if (t.toLowerCase().includes('aktivität') || t.toLowerCase().includes('aktivit')) actCard = c;
        });
        if (lbCard) {
          const head = lbCard.querySelector('.card-head');
          lbCard.innerHTML = '';
          if (head) lbCard.appendChild(head);
          const lb = mg.leaderboard || [];
          if (!lb.length) {
            lbCard.insertAdjacentHTML('beforeend', '<div style="padding:36px 20px;text-align:center;color:var(--muted);font-size:13px"><div style="font-family:Fraunces,serif;font-style:italic;font-size:18px;color:var(--ink);margin-bottom:6px">Noch keine Empfehlungen.</div>Sobald die ersten Eltern einladen, taucht hier das Leaderboard auf.</div>');
          } else {
            const colorClasses = ['', 'sage', 'taupe', '', '', '', '', ''];
            lb.forEach((e, i) => {
              const rankCls = i < 3 ? 'top' : '';
              const html = '<div class="lb-row">'
                + '<div class="lb-rank' + (rankCls ? ' ' + rankCls : '') + '">' + String(i+1).padStart(2,'0') + '</div>'
                + '<div class="lb-avatar' + (colorClasses[i] ? ' ' + colorClasses[i] : '') + '">' + escMk(e.initial || 'E') + '</div>'
                + '<div class="lb-main">'
                +   '<div class="lb-name">' + escMk(e.name || 'Eltern') + '</div>'
                +   '<div class="lb-sub">' + (e.invited||0) + ' eingeladen · ' + (e.converted||0) + ' gebucht · K-Faktor ' + (e.kFactor != null ? String(e.kFactor).replace('.', ',') : '0') + '</div>'
                + '</div>'
                + '<div class="lb-credits">' + (e.credits||0) + ' <em>Credits</em></div>'
                + '</div>';
              lbCard.insertAdjacentHTML('beforeend', html);
            });
          }
        }
        if (actCard) {
          const head = actCard.querySelector('.card-head');
          actCard.innerHTML = '';
          if (head) actCard.appendChild(head);
          const acts = mg.activity || [];
          if (!acts.length) {
            actCard.insertAdjacentHTML('beforeend', '<div style="padding:36px 20px;text-align:center;color:var(--muted);font-size:13px"><div style="font-family:Fraunces,serif;font-style:italic;font-size:18px;color:var(--ink);margin-bottom:6px">Noch ruhig.</div>Mom-Graph-Events landen hier — von der ersten Einladung bis zum Credit-Payout.</div>');
          } else {
            const wrap = document.createElement('div');
            wrap.className = 'activity-feed';
            actCard.appendChild(wrap);
            acts.forEach(ev => {
              const inviter = ev.inviterName || 'Eltern';
              const invitee = ev.inviteeName || 'Eltern';
              let dotCls = 'invite', main = '';
              switch (ev.type) {
                case 'invite_sent':
                  dotCls = 'invite';
                  main = '<strong>' + escMk(inviter) + '</strong> hat eine neue <em>Einladung</em> versendet.';
                  break;
                case 'trial_booked':
                  dotCls = 'trial';
                  main = '<strong>' + escMk(invitee) + '</strong> hat via ' + escMk(inviter) + 's Einladung <em>geschnuppert</em>.';
                  break;
                case 'converted':
                  dotCls = 'booking';
                  main = '<strong>' + escMk(invitee) + '</strong> hat nach Schnuppern einen <em>' + (ev.weeks || '?') + '-Wochen-Block</em> gebucht.';
                  break;
                case 'rewarded':
                  dotCls = 'reward';
                  main = '<strong>' + escMk(inviter) + '</strong> hat <em>' + (ev.credits || 0) + ' Credits</em> bekommen.';
                  break;
              }
              wrap.insertAdjacentHTML('beforeend', '<div class="activity-row">'
                + '<div class="activity-dot ' + dotCls + '"></div>'
                + '<div class="activity-main">' + main
                +   '<div class="activity-time">' + escMk(mgRelTime(ev.at)) + '</div>'
                + '</div>'
                + '</div>');
            });
          }
        }
      }
    }
  } catch (e) { console.warn('[Marketing] mom-graph load failed', e); }

  let flows = [], templates = [], sends = {};
  try {
    const [fR, tR, sR] = await Promise.all([
      api('/providers/' + provider.id + '/marketing/flows').catch(() => ({ data: [] })),
      api('/providers/' + provider.id + '/marketing/templates').catch(() => ({ data: [] })),
      api('/providers/' + provider.id + '/marketing/send-counts').catch(() => ({ data: {} })),
    ]);
    flows = fR.data || []; templates = tR.data || []; sends = sR.data || {};
  } catch (e) { console.warn('[Marketing] load failed', e); }

  // Flow rendering
  const flowList = document.getElementById('phMarketingFlowList');
  let activeStatus = 'all';
  function renderFlows() {
    let list = activeStatus === 'all' ? flows : flows.filter(f => f.status === activeStatus);
    if (!list.length) {
      const msg = !flows.length
        ? 'Noch keine Flows. Lege einen an, der automatisch verschickt wird wenn etwas passiert (z.B. „24h-Erinnerung").'
        : 'Keine Flows in dieser Ansicht.';
      flowList.innerHTML = '<div style="padding:36px 24px;text-align:center;color:var(--muted);font-size:13px">' + msg + ' <button class="btn btn-ghost btn-sm" style="margin-left:6px" onclick="window.openFlowEditor()">+ Neuer Flow</button></div>';
      return;
    }
    flowList.innerHTML = list.map(f => {
      const tmpl = templates.find(t => t.id === f.templateId);
      const sent = (f.stats && f.stats.sent) || 0;
      return '<div style="display:flex;align-items:center;gap:14px;padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer" onclick="window.editFlow(\'' + f.id + '\')">'
        + '<div style="width:36px;height:36px;border-radius:10px;background:var(--surface-alt);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0">' + (CHANNEL_ICON[f.channel] || '?') + '</div>'
        + '<div style="flex:1;min-width:0">'
        +   '<div style="font-weight:600;color:var(--ink);margin-bottom:2px">' + escMk(f.name) + '</div>'
        +   '<div style="font-size:12px;color:var(--muted)">' + escMk(TRIGGER_LABEL[f.trigger] || f.trigger) + ' · '
        +     (f.delayMinutes ? f.delayMinutes + ' Min Verzögerung · ' : 'Sofort · ')
        +     (tmpl ? 'Template: ' + escMk(tmpl.name) : '<span style="color:var(--signal,#B4523A)">Kein Template</span>')
        +   '</div>'
        + '</div>'
        + '<div style="font-size:12px;color:var(--muted);text-align:right;flex-shrink:0;min-width:80px">' + sent + ' versendet</div>'
        + '<span class="pill ' + STATUS_PILL[f.status] + '" style="cursor:pointer;margin-left:8px" onclick="event.stopPropagation();window.toggleFlow(\'' + f.id + '\')">' + STATUS_LABEL[f.status] + '</span>'
        + '<button class="row-action-btn" style="margin-left:4px" onclick="event.stopPropagation();window.deleteFlow(\'' + f.id + '\')" title="Löschen">🗑</button>'
        + '</div>';
    }).join('');
  }

  // Tab counts
  const counts = { all: flows.length, active: 0, paused: 0, draft: 0 };
  flows.forEach(f => counts[f.status] = (counts[f.status] || 0) + 1);
  Object.keys(counts).forEach(k => {
    const el = document.querySelector('#phMarketingFlowTabs .count[data-count="' + k + '"]');
    if (el) el.textContent = counts[k];
  });

  // Tab clicks
  document.querySelectorAll('#phMarketingFlowTabs .filter-tab').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('#phMarketingFlowTabs .filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeStatus = btn.dataset.status;
      renderFlows();
    };
  });
  renderFlows();

  // Templates rendering
  const tmplList = document.getElementById('phMarketingTemplates');
  const seedBtn = document.getElementById('phMarketingSeedBtn');
  if (!templates.length) {
    tmplList.innerHTML = '<div style="grid-column:1/-1;padding:32px 20px;text-align:center;color:var(--muted);font-size:13px;background:var(--surface-alt);border-radius:12px"><div style="font-size:15px;color:var(--ink);margin-bottom:6px;font-family:Fraunces,serif;font-style:italic">Noch keine Vorlagen.</div>Wir haben 11 fertige Templates für Buchung/Erinnerung/Geburtstag/Reaktivierung — direkt loslegen?</div>';
    if (seedBtn) seedBtn.style.display = '';
  } else {
    if (seedBtn) seedBtn.style.display = 'none';
    tmplList.innerHTML = templates.map(t => {
      const bodyPreview = (t.body || '').slice(0, 140) + (t.body && t.body.length > 140 ? '…' : '');
      const vars = (t.variables || []).slice(0, 5);
      return '<div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px">'
        + '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">'
        +   '<span style="font-size:16px">' + (CHANNEL_ICON[t.channel] || '?') + '</span>'
        +   '<strong style="flex:1;color:var(--ink);font-size:13.5px">' + escMk(t.name) + '</strong>'
        +   (t.isDefault ? '<span class="pill" style="font-size:10px;padding:2px 8px">SYSTEM</span>' : '')
        + '</div>'
        + (t.subject ? '<div style="font-size:11.5px;color:var(--muted);margin-bottom:6px">Betreff: ' + escMk(t.subject) + '</div>' : '')
        + '<div style="font-size:12.5px;color:var(--ink-2,#5E3D3F);line-height:1.5;margin-bottom:10px;white-space:pre-wrap">' + escMk(bodyPreview) + '</div>'
        + (vars.length ? '<div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px">' + vars.map(v => '<code style="background:var(--surface-alt);padding:2px 6px;border-radius:4px;font-size:10.5px;color:var(--ink-2,#5E3D3F)">{{' + escMk(v) + '}}</code>').join('') + '</div>' : '')
        + '<div style="display:flex;gap:6px;justify-content:flex-end">'
        +   '<button class="btn btn-ghost btn-sm" onclick="window.editTemplate(\'' + t.id + '\')">Bearbeiten</button>'
        +   (!t.isDefault ? '<button class="row-action-btn" onclick="window.deleteTemplate(\'' + t.id + '\')" title="Löschen">🗑</button>' : '')
        + '</div>'
        + '</div>';
    }).join('');
  }

  // Send counts
  const stats = document.getElementById('phMarketingStats');
  if (stats) {
    ['whatsapp','email','sms'].forEach(ch => {
      const el = stats.querySelector('[data-channel="' + ch + '"]');
      if (el) el.innerHTML = (sends[ch] || 0) + ' <em>Sends</em>';
    });
  }
};

// ============================================================
// Sprint D: Berichte-Section Loader (KPIs + Top-Performer)
// ============================================================
// Period helper: returns { from, to, label } based on key
window.__berichteRange = function(key) {
  var now = new Date();
  var y = now.getFullYear(), m = now.getMonth(), d = now.getDate();
  var start, end, label;
  if (key === 'today') {
    start = new Date(y, m, d);
    end = new Date(y, m, d, 23, 59, 59);
    label = 'Heute, ' + start.toLocaleDateString('de-DE', { day:'2-digit', month:'long', year:'numeric' });
  } else if (key === '7d') {
    start = new Date(y, m, d - 6);
    end = new Date(y, m, d, 23, 59, 59);
    label = 'Letzte 7 Tage';
  } else if (key === 'quarter') {
    var qm = Math.floor(m / 3) * 3;
    start = new Date(y, qm, 1);
    end = new Date(y, qm + 3, 0, 23, 59, 59);
    label = 'Q' + (Math.floor(m/3) + 1) + ' ' + y;
  } else if (key === 'ytd') {
    start = new Date(y, 0, 1);
    end = new Date(y, 11, 31, 23, 59, 59);
    label = 'Jahr ' + y + ' (YTD)';
  } else if (key === 'custom' && window.__berichteCustomRange) {
    start = new Date(window.__berichteCustomRange.from);
    end = new Date(window.__berichteCustomRange.to + 'T23:59:59');
    label = start.toLocaleDateString('de-DE') + ' – ' + new Date(window.__berichteCustomRange.to).toLocaleDateString('de-DE');
  } else {
    // 'month' default
    start = new Date(y, m, 1);
    end = new Date(y, m + 1, 0, 23, 59, 59);
    var monthsDE = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
    label = monthsDE[m] + ' ' + y;
  }
  return { from: start, to: end, label: label };
};

window.sectionLoaders.berichte = async function() {
  var state = window.dashboardState; if (!state) return;
  var provider = state.provider, api = state.api;
  if (!provider || !api) return;
  var bookings = (state.bookings && Array.isArray(state.bookings)) ? state.bookings : [];
  if (!bookings.length) {
    try { var br = await api('/providers/' + provider.id + '/bookings').catch(function(){ return null; });
      if (br && br.data) bookings = br.data; state.bookings = bookings;
    } catch(_){}
  }
  var occ = [];
  try { var or = await api('/providers/' + provider.id + '/reports/occupancy').catch(function(){ return null; });
    if (or && or.data) occ = or.data;
  } catch(_){}
  var now = new Date();
  var periodKey = state.berichtePeriod || 'month';
  var range = window.__berichteRange(periodKey);
  state.berichteRangeResolved = range;
  var monthStart = range.from;
  var monthEnd = range.to;
  // Previous period (same length, immediately before)
  var rangeMs = monthEnd - monthStart;
  var prevMonthStart = new Date(monthStart.getTime() - rangeMs - 1);
  var prevMonthEnd = new Date(monthStart.getTime() - 1);
  var monthsDE = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];

  // Update period UI
  document.querySelectorAll('#phBerPeriodTabs .filter-tab').forEach(function(b) {
    b.classList.toggle('active', b.dataset.period === periodKey);
  });
  var rangeDisp = document.getElementById('phBerRangeDisplay');
  if (rangeDisp) rangeDisp.textContent = range.label + ' · ' + monthStart.toLocaleDateString('de-DE') + ' – ' + monthEnd.toLocaleDateString('de-DE');
  var subEl = document.getElementById('phBerSub');
  if (subEl) subEl.textContent = 'Zeitraum: ' + range.label + ' · ' + bookings.length + ' Buchungen geladen.';

  function statusOfB(b){ return (b && (b.status||'').toLowerCase()) || ''; }
  function bCents(b){
    if (typeof b.amountCents === 'number') return b.amountCents;
    if (typeof b.priceCents === 'number') return b.priceCents;
    var ap = typeof b.amountPaid === 'number' ? b.amountPaid : (typeof b.amountPaid === 'string' ? parseFloat(b.amountPaid) : 0);
    return Math.round((isNaN(ap) ? 0 : ap) * 100);
  }
  function fmtEuro(c){ return (c/100).toLocaleString('de-DE', { maximumFractionDigits: 0 }); }
  // === KPI 1: Umsatz im gewählten Zeitraum ===
  var monthB = bookings.filter(function(b){ var d = new Date(b.createdAt || b.bookedAt || 0); return d >= monthStart && d <= monthEnd && statusOfB(b) !== 'cancelled'; });
  var monthRev = monthB.reduce(function(s,b){ return s + bCents(b); }, 0);
  var prevB = bookings.filter(function(b){ var d = new Date(b.createdAt || b.bookedAt || 0); return d >= prevMonthStart && d <= prevMonthEnd && statusOfB(b) !== 'cancelled'; });
  var prevRev = prevB.reduce(function(s,b){ return s + bCents(b); }, 0);
  var revDelta = prevRev > 0 ? Math.round((monthRev - prevRev) / prevRev * 100) : null;
  var elU = document.getElementById('phBerKpiUmsatz');
  if (elU) elU.innerHTML = fmtEuro(monthRev) + '<em>&nbsp;&euro;</em>';
  var elUL = document.getElementById('phBerKpiUmsatzLabel');
  if (elUL) elUL.textContent = 'Umsatz ' + monthsDE[now.getMonth()];
  var elUT = document.getElementById('phBerKpiUmsatzTrend');
  if (elUT) {
    if (revDelta !== null) {
      elUT.className = 'kpi-trend ' + (revDelta >= 0 ? 'positive' : 'negative');
      elUT.textContent = (revDelta >= 0 ? '+' : '') + revDelta + '% vs. ' + monthsDE[(now.getMonth()-1+12)%12];
    } else {
      elUT.className = 'kpi-trend';
      elUT.textContent = bookings.length === 0 ? 'Noch keine Buchungen' : 'Erstmonat';
    }
  }
  // Bars: Tagesumsatz aktueller Monat (max 31 Tage, normalisiert)
  var elBars = document.getElementById('phBerKpiUmsatzBars');
  if (elBars) {
    var daysInMonth = new Date(now.getFullYear(), now.getMonth()+1, 0).getDate();
    var daily = new Array(daysInMonth).fill(0);
    monthB.forEach(function(b){
      var d = new Date(b.createdAt || b.bookedAt || 0);
      if (d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear()) {
        daily[d.getDate()-1] += bCents(b);
      }
    });
    var maxDay = Math.max.apply(null, daily.concat([1]));
    elBars.innerHTML = daily.map(function(v){ var h = Math.max(8, Math.round(v/maxDay*100)); return '<span style="height:' + h + '%"></span>'; }).join('');
  }
  // === SVG-Chart: Tagesumsatz aktueller Monat (viewBox 0 0 720 240) ===
  (function(){
    var area = document.getElementById('phBerChartArea');
    var line = document.getElementById('phBerChartLine');
    var target = document.getElementById('phBerChartTarget');
    var axis = document.getElementById('phBerChartAxis');
    if (!area || !line) return;
    var dim = new Date(now.getFullYear(), now.getMonth()+1, 0).getDate();
    var dailyArr = new Array(dim).fill(0);
    monthB.forEach(function(b){
      var d = new Date(b.createdAt || b.bookedAt || 0);
      if (d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear()) {
        dailyArr[d.getDate()-1] += bCents(b);
      }
    });
    var maxV = Math.max.apply(null, dailyArr.concat([1]));
    var W = 720, H = 240, paddingTop = 20, paddingBottom = 20;
    var innerH = H - paddingTop - paddingBottom;
    function x(i){ return Math.round((i/(dim-1)) * W); }
    function y(v){ return Math.round(H - paddingBottom - (v/maxV) * innerH); }
    var lineD = '';
    var areaD = 'M0,' + H + ' ';
    for (var i = 0; i < dim; i++) {
      var px = x(i), py = y(dailyArr[i]);
      lineD += (i === 0 ? 'M' : ' L') + px + ',' + py;
      areaD += 'L' + px + ',' + py + ' ';
    }
    areaD += 'L' + W + ',' + H + ' Z';
    line.setAttribute('d', lineD || 'M0,' + H);
    area.setAttribute('d', areaD);
    // Ziel-Linie: Tagesziel = monthRev / dim (Durchschnitt) — als Referenz
    if (target && maxV > 0) {
      var dailyAvg = monthRev / dim;
      var ty = y(dailyAvg);
      target.setAttribute('y1', String(ty));
      target.setAttribute('y2', String(ty));
    }
    // Axis: 7 Marker basierend auf dim
    if (axis) {
      var marks = [1, Math.round(dim*0.17), Math.round(dim*0.33), Math.round(dim*0.5), Math.round(dim*0.67), Math.round(dim*0.83), dim];
      axis.innerHTML = marks.map(function(m){ return '<span>' + String(m).padStart(2,'0') + '</span>'; }).join('');
    }
  })();
  // === KPI 2: Auslastung Durchschnitt (occupancy aus reports endpoint) ===
  var occList = Array.isArray(occ) ? occ : [];
  var avgOcc = 0;
  if (occList.length) {
    var sumOcc = occList.reduce(function(s,o){ return s + (Number(o.occupancy) || 0); }, 0);
    avgOcc = Math.round(sumOcc / occList.length);
  }
  var elA = document.getElementById('phBerKpiAuslastung'); if (elA) elA.textContent = avgOcc + '%';
  var elAB = document.getElementById('phBerKpiAuslastungBar'); if (elAB) elAB.style.width = Math.min(100, avgOcc) + '%';
  var elAT = document.getElementById('phBerKpiAuslastungTrend');
  if (elAT) {
    elAT.className = 'kpi-trend';
    elAT.textContent = occList.length + ' aktiver Kurs' + (occList.length === 1 ? '' : 'e');
  }
  // === KPI 3: Neue Kunden (parents mit erster Buchung in aktuellem Monat) ===
  var firstByParent = {};
  bookings.forEach(function(b){
    var pid = b.parentId || (b.parent && b.parent.id);
    if (!pid) return;
    var d = new Date(b.createdAt || b.bookedAt || 0);
    if (!firstByParent[pid] || d < firstByParent[pid]) firstByParent[pid] = d;
  });
  var newThisMonth = 0, newPrevMonth = 0;
  Object.keys(firstByParent).forEach(function(pid){
    var d = firstByParent[pid];
    if (d >= monthStart) newThisMonth++;
    else if (d >= prevMonthStart && d <= prevMonthEnd) newPrevMonth++;
  });
  var elK = document.getElementById('phBerKpiKunden'); if (elK) elK.textContent = String(newThisMonth);
  var elKT = document.getElementById('phBerKpiKundenTrend');
  if (elKT) {
    if (newPrevMonth > 0) {
      var deltaK = newThisMonth - newPrevMonth;
      elKT.className = 'kpi-trend ' + (deltaK >= 0 ? 'positive' : 'negative');
      elKT.textContent = (deltaK >= 0 ? '+' : '') + deltaK + ' vs. ' + monthsDE[(now.getMonth()-1+12)%12];
    } else {
      elKT.className = 'kpi-trend';
      elKT.textContent = newThisMonth === 0 ? 'Noch keine neuen Kunden' : 'Erste Neukunden';
    }
  }
  // === KPI 4: Stornierungen ===
  var monthCancelled = bookings.filter(function(b){ var d = new Date(b.cancelledAt || b.updatedAt || b.createdAt || 0); return d >= monthStart && statusOfB(b) === 'cancelled'; }).length;
  var monthAll = bookings.filter(function(b){ var d = new Date(b.createdAt || b.bookedAt || 0); return d >= monthStart; }).length;
  var cancelPct = monthAll > 0 ? Math.round(monthCancelled / monthAll * 1000) / 10 : 0;
  var elS = document.getElementById('phBerKpiStorno'); if (elS) elS.textContent = String(monthCancelled);
  var elST = document.getElementById('phBerKpiStornoTrend');
  if (elST) {
    elST.className = 'kpi-trend';
    elST.textContent = monthAll === 0 ? '–' : (String(cancelPct).replace('.', ',') + '% der Buchungen');
  }
  // === Top-Performer Table ===
  var tbody = document.getElementById('phBerTopPerformerTbody');
  if (tbody) {
    if (!occList.length) {
      tbody.innerHTML = '<tr><td colspan="3" style="padding:32px;text-align:center;color:var(--muted);font-size:13px"><div style="font-family:Fraunces,serif;font-style:italic;font-size:18px;color:var(--ink);margin-bottom:6px">Noch keine Kurs-Performance.</div>Sobald Buchungen reinkommen, taucht hier das Ranking auf.</td></tr>';
    } else {
      var actMap = {};
      (state.activities && state.activities.list || []).forEach(function(a){ actMap[a.id] = a; });
      // Compute revenue per activity from monthB
      var revByAct = {};
      monthB.forEach(function(b){ var aid = b.activityId || (b.activity && b.activity.id); if (aid) revByAct[aid] = (revByAct[aid] || 0) + bCents(b); });
      var rows = occList.slice().sort(function(a,b){ return (Number(b.occupancy)||0) - (Number(a.occupancy)||0); }).slice(0, 8);
      tbody.innerHTML = rows.map(function(o){
        var rev = revByAct[o.activityId] || 0;
        var occPct = Math.round(Number(o.occupancy) || 0);
        var title = o.title || (actMap[o.activityId] && actMap[o.activityId].title) || 'Kurs';
        return '<tr><td>' + (window.escapeHtml ? window.escapeHtml(title) : title) + '</td>'
          + '<td class="right"><strong>' + fmtEuro(rev) + '&nbsp;&euro;</strong></td>'
          + '<td class="right">' + occPct + '%</td></tr>';
      }).join('');
    }
  }

  // ─── Donut: Zahlungs-Methoden (echte DB-Daten) ───────────────
  var paymentDonut = document.getElementById('phBerPaymentDonut');
  if (paymentDonut) {
    var bookingsInPeriod = bookings.filter(function(b){
      var d = new Date(b.createdAt || b.bookedAt || b.created_at || 0);
      var stat = (b.status || '').toLowerCase();
      return d >= monthStart && d <= monthEnd && stat !== 'cancelled' && stat !== 'refunded';
    });
    var pmCounts = {};
    bookingsInPeriod.forEach(function(b){
      var pm = (b.paymentMethod || b.payment_method || 'unknown').toLowerCase();
      pmCounts[pm] = (pmCounts[pm] || 0) + 1;
    });
    var pmLabels = {
      stripe: 'Karte (Stripe)', card: 'Kreditkarte', sepa: 'SEPA-Lastschrift', sepa_debit: 'SEPA-Lastschrift',
      paypal: 'PayPal', invoice: 'Rechnung', bank_transfer: 'Banküberweisung',
      onsite: 'Bar vor Ort', cash: 'Bar vor Ort', unknown: 'Unbekannt',
    };
    var pmColors = ['#CC895E', '#B4523A', '#93A388', '#C49980', '#3C2124', '#A78776', '#627A5A'];
    var pmTotal = Object.values(pmCounts).reduce(function(a,b){ return a+b; }, 0);
    if (pmTotal === 0) {
      paymentDonut.innerHTML = '<div style="padding:18px;color:var(--muted-2);font-size:13px;text-align:center">Noch keine Buchungen im Zeitraum.</div>';
    } else {
      var pmEntries = Object.keys(pmCounts).map(function(k){
        return { key: k, label: pmLabels[k] || k, count: pmCounts[k], pct: Math.round(pmCounts[k] / pmTotal * 100) };
      }).sort(function(a,b){ return b.count - a.count; });
      paymentDonut.innerHTML = pmEntries.map(function(e, i){
        return '<div class="donut-row"><span class="donut-dot" style="background:' + pmColors[i % pmColors.length] + '"></span><span>' + (window.escapeHtml ? window.escapeHtml(e.label) : e.label) + '</span><span class="right-val"><strong>' + e.pct + '%</strong></span></div>';
      }).join('');
    }
  }

  // ─── Donut: Storno-Gründe (echte DB-Daten) ──────────────────
  var crEl = document.getElementById('phBerCancelReasonsDonut');
  if (crEl) {
    var cancelledInPeriod = bookings.filter(function(b){
      var d = new Date(b.cancelledAt || b.cancelled_at || b.updatedAt || b.createdAt || 0);
      var stat = (b.status || '').toLowerCase();
      return d >= monthStart && d <= monthEnd && stat === 'cancelled';
    });
    var crCounts = {};
    cancelledInPeriod.forEach(function(b){
      var code = b.cancellationReasonCode || b.cancellation_reason_code || 'no_reason';
      crCounts[code] = (crCounts[code] || 0) + 1;
    });
    // Auch session_attendance_records cancelled_excused/late
    try {
      var sars = (state.attendance || []).filter(function(r){
        var d = new Date(r.cancelled_at || r.created_at || 0);
        var st = (r.status || '');
        return d >= monthStart && d <= monthEnd && (st.indexOf('cancelled') === 0 || st === 'absent_sick');
      });
      sars.forEach(function(r){
        var code = r.cancellation_reason_code || 'no_reason';
        crCounts[code] = (crCounts[code] || 0) + 1;
      });
    } catch(_){}
    var crLabels = {
      sick: 'Kind krank',
      family_emergency: 'Familie / Notfall',
      schedule_conflict: 'Zeitlich nicht passend',
      transport: 'Anfahrt nicht möglich',
      weather: 'Wetter / Krankheit',
      too_expensive: 'Zu teuer',
      child_unhappy: 'Kind hat keinen Spaß',
      moving: 'Umzug / Entfernung',
      wrong_age: 'Falsche Altersgruppe',
      other: 'Anderer Grund',
      no_reason: 'Kein Grund angegeben',
    };
    var crTotal = Object.values(crCounts).reduce(function(a,b){ return a+b; }, 0);
    if (crTotal === 0) {
      crEl.innerHTML = '<div style="padding:18px;color:var(--muted-2);font-size:13px;text-align:center">Keine Stornierungen im Zeitraum.</div>';
    } else {
      var crEntries = Object.keys(crCounts).map(function(k){
        return { key: k, label: crLabels[k] || k, count: crCounts[k], pct: Math.round(crCounts[k] / crTotal * 100) };
      }).sort(function(a,b){ return b.count - a.count; });
      crEl.innerHTML = crEntries.map(function(e, i){
        return '<div class="donut-row"><span class="donut-dot" style="background:' + pmColors[i % pmColors.length] + '"></span><span>' + (window.escapeHtml ? window.escapeHtml(e.label) : e.label) + '</span><span class="right-val"><strong>' + e.pct + '%</strong></span></div>';
      }).join('');
    }
  }

  // Period-Selector Click-Handler (idempotent — added once)
  if (!window.__berichteHandlersWired) {
    document.querySelectorAll('#phBerPeriodTabs .filter-tab').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var key = btn.dataset.period;
        if (key === 'custom') {
          var picked = await window.__berichteCustomRangePicker();
          if (!picked) {
            // M7: User hat Modal geschlossen → visuelle Tab-Selection auf vorigen Period zurücksetzen
            var prevKey = window.dashboardState.berichtePeriod || 'month';
            document.querySelectorAll('#phBerPeriodTabs .filter-tab').forEach(function(b) {
              b.classList.toggle('active', b.dataset.period === prevKey);
            });
            return;
          }
          window.__berichteCustomRange = picked;
        }
        window.dashboardState.berichtePeriod = key;
        window.sectionLoaders.berichte();
      });
    });
    window.__berichteHandlersWired = true;
  }
};

// Custom-Range-Modal (statt prompt). Resolved zu { from, to } oder null bei Abbruch.
window.__berichteCustomRangePicker = function() {
  return new Promise(function(resolve) {
    var prev = window.__berichteCustomRange || {};
    var defaultFrom = prev.from || new Date(Date.now() - 30*86400000).toISOString().slice(0,10);
    var defaultTo = prev.to || new Date().toISOString().slice(0,10);
    var ov = document.createElement('div');
    ov.className = 'ukc-detail-overlay';
    ov.innerHTML = '<div class="ukc-detail-card" role="dialog" aria-modal="true" style="max-width:440px">'
      + '<div class="ukc-detail-head">'
      +   '<div class="ukc-detail-kicker">Berichte</div>'
      +   '<h2 class="ukc-detail-title">Eigener <em>Zeitraum</em></h2>'
      +   '<button class="ukc-detail-close" aria-label="Schließen">×</button>'
      + '</div>'
      + '<div style="padding:12px 24px 6px;display:flex;flex-direction:column;gap:14px;font-size:14px">'
      +   '<div><label style="display:block;font-size:12px;color:var(--ink-2);margin-bottom:4px">Von</label>'
      +     '<input type="date" id="phBerFrom" value="' + defaultFrom + '" style="width:100%;padding:9px 11px;border:1px solid rgba(60,33,36,.18);border-radius:10px;background:white"></div>'
      +   '<div><label style="display:block;font-size:12px;color:var(--ink-2);margin-bottom:4px">Bis</label>'
      +     '<input type="date" id="phBerTo" value="' + defaultTo + '" style="width:100%;padding:9px 11px;border:1px solid rgba(60,33,36,.18);border-radius:10px;background:white"></div>'
      + '</div>'
      + '<div class="ukc-detail-foot">'
      +   '<button class="btn btn-ghost btn-sm" data-cancel>Abbrechen</button>'
      +   '<button class="btn btn-primary btn-sm" data-ok>Anwenden</button>'
      + '</div>'
      + '</div>';
    function cleanup(val) { ov.remove(); document.removeEventListener('keydown', onKey); resolve(val); }
    function onKey(e) { if (e.key === 'Escape') cleanup(null); else if (e.key === 'Enter') doApply(); }
    function doApply() {
      var f = (document.getElementById('phBerFrom') || {}).value || '';
      var t = (document.getElementById('phBerTo') || {}).value || '';
      if (!/^\d{4}-\d{2}-\d{2}$/.test(f) || !/^\d{4}-\d{2}-\d{2}$/.test(t)) {
        if (window.ukcToast) window.ukcToast('Bitte Von und Bis wählen', 'error');
        return;
      }
      if (f > t) { if (window.ukcToast) window.ukcToast('Bis muss nach Von liegen', 'error'); return; }
      cleanup({ from: f, to: t });
    }
    ov.querySelector('[data-ok]').addEventListener('click', doApply);
    ov.querySelector('[data-cancel]').addEventListener('click', function() { cleanup(null); });
    ov.querySelector('.ukc-detail-close').addEventListener('click', function() { cleanup(null); });
    ov.addEventListener('click', function(e) { if (e.target === ov) cleanup(null); });
    document.addEventListener('keydown', onKey);
    document.body.appendChild(ov);
    requestAnimationFrame(function() { ov.classList.add('in'); });
  });
};

// Berichte-Export
window.__berichteExport = async function(format) {
  var s = window.dashboardState; if (!s) return;
  if (format === 'pdf') {
    // PDF via Browser-Print (window.print mit print-CSS)
    var section = document.querySelector('.section[data-section="berichte"]');
    if (!section) return;
    // Hide other sections temporarily, print, restore
    var origDisplay = [];
    document.querySelectorAll('.section').forEach(function(s){
      origDisplay.push({ el: s, hidden: s.hidden });
      if (s !== section) s.hidden = true;
    });
    var sidebar = document.querySelector('.sidebar');
    var sidebarDisplay = sidebar ? sidebar.style.display : '';
    if (sidebar) sidebar.style.display = 'none';
    setTimeout(function() {
      window.print();
      origDisplay.forEach(function(o){ o.el.hidden = o.hidden; });
      if (sidebar) sidebar.style.display = sidebarDisplay;
    }, 100);
    return;
  }
  // CSV oder DATEV — via Backend-Export
  try {
    var resp = await fetch('/api/providers/' + s.provider.id + '/export', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
      body: JSON.stringify({ type: 'bookings', format: format }),
    });
    var json = await resp.json();
    if (!resp.ok) {
      if (window.ukcToast) window.ukcToast('Export fehlgeschlagen: ' + (json.error || resp.status), 'error');
      return;
    }
    var d = json.data || json;
    if (!d.content || !d.filename) return;
    var blob = new Blob(['﻿' + d.content], { type: 'text/csv;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = d.filename;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    if (window.ukcToast) window.ukcToast(format.toUpperCase() + '-Export heruntergeladen', 'success');
  } catch (e) {
    if (window.ukcToast) window.ukcToast('Export fehlgeschlagen: ' + (e.message || ''), 'error');
  }
};

// Marketing-section globals
window.toggleFlow = async function(id) {
  const s = window.dashboardState; if (!s) return;
  try { await s.api('/marketing/flows/' + id + '/toggle', { method: 'POST' });
    if (window.ukcToast) window.ukcToast('Flow umgeschaltet');
    window.sectionLoaders.marketing();
  } catch(e) { alert('Fehler: ' + (e.message || e)); }
};
window.deleteFlow = async function(id) {
  if (!confirm('Flow wirklich löschen?')) return;
  const s = window.dashboardState; if (!s) return;
  try { await s.api('/marketing/flows/' + id, { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Flow gelöscht');
    window.sectionLoaders.marketing();
  } catch(e) { alert('Fehler: ' + (e.message || e)); }
};
window.deleteTemplate = async function(id) {
  if (!confirm('Template wirklich löschen?')) return;
  const s = window.dashboardState; if (!s) return;
  try { await s.api('/marketing/templates/' + id, { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Template gelöscht');
    window.sectionLoaders.marketing();
  } catch(e) { alert('Fehler: ' + (e.message || e)); }
};
// ============================================================
// Marketing-Flow + Template Editor Modals (Phase 2)
// ============================================================
(function() {
  // Trigger-Liste mit Beschreibungen
  var TRIGGERS_OPTIONS = [
    { value:'booking_confirmed',     label:'Buchung bestätigt',          desc:'Direkt nach erfolgreicher Buchung' },
    { value:'customer_signup',       label:'Neuer Kunde registriert',    desc:'Nach Account-Erstellung im Eltern-Portal' },
    { value:'booking_reminder_24h',  label:'24h vor Termin',             desc:'Erinnerung am Vortag' },
    { value:'booking_completed',     label:'Kurs abgeschlossen',         desc:'Nach Ende eines Kursblocks' },
    { value:'trial_completed',       label:'Probestunde absolviert',     desc:'Nachdem Probekurs stattgefunden hat' },
    { value:'trial_no_conversion',   label:'Probestunde ohne Buchung',   desc:'Nach Probestunde, aber keine Buchung in 7 Tagen' },
    { value:'payment_received',      label:'Zahlung eingegangen',        desc:'Bestätigung nach Zahlungseingang' },
    { value:'payment_overdue',       label:'Zahlung überfällig',         desc:'Mahnung bei offener Rechnung' },
    { value:'waitlist_spot_available', label:'Warteliste-Platz frei',    desc:'Wenn jemand auf der Warteliste nachrückt' },
    { value:'child_birthday',        label:'Kind hat Geburtstag',        desc:'Geburtstagsgruß ans Kind' },
    { value:'inactive_customer',     label:'Kunde inaktiv',              desc:'Kunde hat länger nichts gebucht' },
    { value:'course_ending_soon',    label:'Kurspaket endet bald',       desc:'Kurzfristig vor Paket-Ende' },
    { value:'loyalty_tier_upgrade',  label:'Treuestufe Aufstieg',        desc:'Wenn Kunde neue Stufe erreicht' },
    { value:'review_request',        label:'Bewertung anfragen',         desc:'Nach erstem Kursbesuch um Feedback bitten' },
    { value:'seasonal_reminder',     label:'Saisonstart',                desc:'Halbjahresbeginn / neue Anmeldephase' },
  ];
  var CHANNEL_OPTIONS = [
    { value:'email',    label:'E-Mail',    icon:'✉' },
    { value:'whatsapp', label:'WhatsApp',  icon:'💬' },
    { value:'sms',      label:'SMS',       icon:'📱' },
  ];
  var STATUS_OPTIONS = [
    { value:'active',  label:'Aktiv' },
    { value:'paused',  label:'Pausiert' },
    { value:'draft',   label:'Entwurf' },
  ];

  function escAttr(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]); }); }
  function escTxt(s) { return escAttr(s); }

  // Backdrop + Container
  function ensureModalRoot() {
    var root = document.getElementById('mfModalRoot');
    if (!root) {
      root = document.createElement('div');
      root.id = 'mfModalRoot';
      document.body.appendChild(root);
    }
    return root;
  }
  function closeModal() {
    var root = document.getElementById('mfModalRoot');
    if (root) root.innerHTML = '';
  }
  // Esc to close
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var root = document.getElementById('mfModalRoot');
      if (root && root.innerHTML) closeModal();
    }
  });

  // Konvertiere Minuten in {value, unit} mit größtmöglicher Einheit
  function minutesToUnit(min) {
    min = parseInt(min, 10) || 0;
    if (min === 0) return { value: 0, unit: 'min' };
    if (min % (24 * 60) === 0) return { value: min / (24 * 60), unit: 'days' };
    if (min % 60 === 0) return { value: min / 60, unit: 'hours' };
    return { value: min, unit: 'min' };
  }
  function unitToMinutes(value, unit) {
    var v = parseInt(value, 10) || 0;
    if (unit === 'days') return v * 24 * 60;
    if (unit === 'hours') return v * 60;
    return v;
  }

  // ============================================================
  // FLOW-EDITOR
  // ============================================================
  window.openFlowEditor = async function(id) {
    var s = window.dashboardState; if (!s) { alert('Dashboard nicht bereit.'); return; }

    // Existing flow laden falls Edit-Modus
    var existing = null;
    if (id) {
      try {
        var r = await s.api('/providers/' + s.provider.id + '/marketing/flows');
        existing = (r.data || []).find(function(f) { return f.id === id; }) || null;
      } catch(e) { console.warn('[FlowEditor] load existing failed', e); }
    }

    // Templates laden für Picker
    var templates = [];
    try {
      var tr = await s.api('/providers/' + s.provider.id + '/marketing/templates');
      templates = tr.data || [];
    } catch(e) { console.warn('[FlowEditor] load templates failed', e); }

    // API liefert camelCase (trigger, delayMinutes, templateId) — nutze die direkt
    var f = existing || { name:'', trigger:'booking_confirmed', channel:'email', delayMinutes:0, templateId:null, status:'draft', conditions:null };
    var d = minutesToUnit(f.delayMinutes || 0);

    var triggerOpts = TRIGGERS_OPTIONS.map(function(t) {
      return '<option value="' + t.value + '"' + (t.value === f.trigger ? ' selected' : '') + '>' + escTxt(t.label) + '</option>';
    }).join('');

    var channelOpts = CHANNEL_OPTIONS.map(function(c) {
      return '<option value="' + c.value + '"' + (c.value === f.channel ? ' selected' : '') + '>' + c.icon + ' ' + escTxt(c.label) + '</option>';
    }).join('');

    var statusOpts = STATUS_OPTIONS.map(function(o) {
      return '<option value="' + o.value + '"' + (o.value === (f.status || 'draft') ? ' selected' : '') + '>' + escTxt(o.label) + '</option>';
    }).join('');

    function tplOpts(channel) {
      var filtered = templates.filter(function(t) { return !channel || t.channel === channel; });
      var noneSelected = !f.templateId ? ' selected' : '';
      var opts = '<option value=""' + noneSelected + '>— keine Vorlage —</option>';
      filtered.forEach(function(t) {
        opts += '<option value="' + t.id + '"' + (t.id === f.templateId ? ' selected' : '') + '>' + escTxt(t.name) + ' (' + escTxt(t.channel) + ')</option>';
      });
      return opts;
    }

    var triggerDesc = (TRIGGERS_OPTIONS.find(function(t){ return t.value === f.trigger; }) || {}).desc || '';

    var html =
      '<div class="mf-backdrop" onclick="if(event.target===this)window.__mfCloseModal()">' +
      '<div class="mf-modal" role="dialog" aria-labelledby="mfTitle">' +
        '<div class="mf-head">' +
          '<div class="mf-kicker">Marketing · Smart-Flow</div>' +
          '<h2 id="mfTitle" class="mf-title">' + (existing ? 'Flow <em>bearbeiten</em>' : 'Neuer <em>Flow</em>') + '</h2>' +
          '<button class="mf-close" onclick="window.__mfCloseModal()" aria-label="Schließen">×</button>' +
        '</div>' +

        '<div class="mf-body">' +
          '<label class="mf-label">Name <span class="mf-req">*</span></label>' +
          '<input class="mf-input" id="mfName" type="text" placeholder="z.B. Willkommens-Mail nach Buchung" value="' + escAttr(f.name || '') + '" />' +

          '<div class="mf-row">' +
            '<div class="mf-col">' +
              '<label class="mf-label">Auslöser</label>' +
              '<select class="mf-input" id="mfTrigger" onchange="window.__mfTriggerChanged()">' + triggerOpts + '</select>' +
              '<div class="mf-hint" id="mfTriggerDesc">' + escTxt(triggerDesc) + '</div>' +
            '</div>' +
            '<div class="mf-col">' +
              '<label class="mf-label">Wartezeit</label>' +
              '<div class="mf-delay-row">' +
                '<input class="mf-input" id="mfDelayValue" type="number" min="0" step="1" value="' + d.value + '" style="flex:1;" />' +
                '<select class="mf-input" id="mfDelayUnit" style="flex:0 0 110px;">' +
                  '<option value="min"' + (d.unit==='min'?' selected':'') + '>Minuten</option>' +
                  '<option value="hours"' + (d.unit==='hours'?' selected':'') + '>Stunden</option>' +
                  '<option value="days"' + (d.unit==='days'?' selected':'') + '>Tage</option>' +
                '</select>' +
              '</div>' +
              '<div class="mf-hint">Wann nach dem Auslöser-Event versendet wird. 0 = sofort.</div>' +
            '</div>' +
          '</div>' +

          '<div class="mf-row">' +
            '<div class="mf-col">' +
              '<label class="mf-label">Kanal</label>' +
              '<select class="mf-input" id="mfChannel" onchange="window.__mfChannelChanged()">' + channelOpts + '</select>' +
            '</div>' +
            '<div class="mf-col">' +
              '<label class="mf-label">Vorlage</label>' +
              '<select class="mf-input" id="mfTemplate">' + tplOpts(f.channel) + '</select>' +
              '<div class="mf-hint">Nur Vorlagen für den gewählten Kanal werden gezeigt. <a href="#" onclick="event.preventDefault();window.__mfCloseModal();window.openTemplateEditor()">+ Neue Vorlage</a></div>' +
            '</div>' +
          '</div>' +

          '<label class="mf-label">Status</label>' +
          '<select class="mf-input" id="mfStatus">' + statusOpts + '</select>' +
          '<div class="mf-hint">Nur <strong>Aktive</strong> Flows lösen Sends aus. Pausiert/Entwurf wartet bis du sie aktivierst.</div>' +
        '</div>' +

        '<div class="mf-foot">' +
          (existing ? '<button class="mf-btn mf-btn-ghost" onclick="window.__mfDeleteFlow(\'' + escAttr(id) + '\')">Löschen</button>' : '<span></span>') +
          '<div class="mf-foot-right">' +
            '<button class="mf-btn mf-btn-ghost" onclick="window.__mfCloseModal()">Abbrechen</button>' +
            '<button class="mf-btn mf-btn-primary" id="mfSubmit" onclick="window.__mfSaveFlow(' + (existing ? '\'' + escAttr(id) + '\'' : 'null') + ')">' + (existing ? 'Speichern' : 'Anlegen') + '</button>' +
          '</div>' +
        '</div>' +

      '</div>' +
      '</div>';

    var root = ensureModalRoot();
    root.innerHTML = html;

    // Wire trigger description update
    window.__mfTriggerChanged = function() {
      var v = document.getElementById('mfTrigger').value;
      var t = TRIGGERS_OPTIONS.find(function(x){ return x.value === v; });
      var el = document.getElementById('mfTriggerDesc');
      if (el) el.textContent = (t && t.desc) || '';
    };
    window.__mfChannelChanged = function() {
      var ch = document.getElementById('mfChannel').value;
      var sel = document.getElementById('mfTemplate');
      var prev = sel.value;
      sel.innerHTML = tplOpts(ch);
      // Try to keep selection if still applicable
      if (Array.prototype.some.call(sel.options, function(o){ return o.value === prev; })) {
        sel.value = prev;
      }
    };
    window.__mfTemplatesCache = templates;

    setTimeout(function() {
      var nm = document.getElementById('mfName');
      if (nm && !nm.value) nm.focus();
    }, 50);
  };

  // Save flow (create or update)
  window.__mfSaveFlow = async function(id) {
    var s = window.dashboardState; if (!s) return;
    var name = (document.getElementById('mfName').value || '').trim();
    if (!name) {
      var nm = document.getElementById('mfName');
      nm.focus();
      nm.style.borderColor = '#B4523A';
      setTimeout(function(){ nm.style.borderColor = ''; }, 1500);
      return;
    }
    var trigger = document.getElementById('mfTrigger').value;
    var channel = document.getElementById('mfChannel').value;
    var delayValue = document.getElementById('mfDelayValue').value;
    var delayUnit = document.getElementById('mfDelayUnit').value;
    var delayMinutes = unitToMinutes(delayValue, delayUnit);
    var templateId = document.getElementById('mfTemplate').value || null;
    var status = document.getElementById('mfStatus').value;

    var btn = document.getElementById('mfSubmit');
    btn.disabled = true; btn.textContent = 'Speichern…';

    try {
      var payload = { name: name, trigger: trigger, channel: channel, delayMinutes: delayMinutes, templateId: templateId, status: status };
      if (id) {
        await s.api('/marketing/flows/' + id, { method:'PUT', body: JSON.stringify(payload) });
      } else {
        await s.api('/providers/' + s.provider.id + '/marketing/flows', { method:'POST', body: JSON.stringify(payload) });
      }
      if (window.ukcToast) window.ukcToast('Flow ' + (id ? 'gespeichert' : 'angelegt'), 'success', 1800);
      closeModal();
      if (window.sectionLoaders && window.sectionLoaders.marketing) window.sectionLoaders.marketing();
    } catch(e) {
      btn.disabled = false; btn.textContent = id ? 'Speichern' : 'Anlegen';
      alert('Fehler: ' + (e && e.message ? e.message : e));
    }
  };

  window.__mfDeleteFlow = async function(id) {
    if (!confirm('Diesen Flow wirklich löschen?\n\nVergangene Sends bleiben im Audit-Log erhalten.')) return;
    var s = window.dashboardState; if (!s) return;
    try {
      await s.api('/marketing/flows/' + id, { method:'DELETE' });
      if (window.ukcToast) window.ukcToast('Flow gelöscht', 'success', 1600);
      closeModal();
      if (window.sectionLoaders && window.sectionLoaders.marketing) window.sectionLoaders.marketing();
    } catch(e) {
      alert('Fehler: ' + (e && e.message ? e.message : e));
    }
  };

  window.__mfCloseModal = closeModal;

  // ============================================================
  // TEMPLATE-EDITOR
  // ============================================================
  window.openTemplateEditor = async function(id) {
    var s = window.dashboardState; if (!s) { alert('Dashboard nicht bereit.'); return; }
    var existing = null;
    if (id) {
      try {
        var r = await s.api('/providers/' + s.provider.id + '/marketing/templates');
        existing = (r.data || []).find(function(t) { return t.id === id; }) || null;
      } catch(e) { console.warn('[TemplateEditor] load existing failed', e); }
    }
    var t = existing || { name:'', channel:'email', subject:'', body:'', variables:[] };
    var vars = Array.isArray(t.variables) ? t.variables : [];

    var channelOpts = CHANNEL_OPTIONS.map(function(c) {
      return '<option value="' + c.value + '"' + (c.value === t.channel ? ' selected' : '') + '>' + c.icon + ' ' + escTxt(c.label) + '</option>';
    }).join('');

    var commonVars = ['parentName','childName','courseName','providerName','startDate','time','amount','invoiceNumber','dueDate','reviewLink'];

    var html =
      '<div class="mf-backdrop" onclick="if(event.target===this)window.__mfCloseModal()">' +
      '<div class="mf-modal" role="dialog" aria-labelledby="mfTplTitle">' +
        '<div class="mf-head">' +
          '<div class="mf-kicker">Marketing · Vorlage</div>' +
          '<h2 id="mfTplTitle" class="mf-title">' + (existing ? 'Vorlage <em>bearbeiten</em>' : 'Neue <em>Vorlage</em>') + '</h2>' +
          '<button class="mf-close" onclick="window.__mfCloseModal()" aria-label="Schließen">×</button>' +
        '</div>' +

        '<div class="mf-body">' +
          '<label class="mf-label">Name <span class="mf-req">*</span></label>' +
          '<input class="mf-input" id="mfTplName" type="text" placeholder="z.B. Willkommen nach Buchung" value="' + escAttr(t.name || '') + '" />' +

          '<div class="mf-row">' +
            '<div class="mf-col">' +
              '<label class="mf-label">Kanal</label>' +
              '<select class="mf-input" id="mfTplChannel" onchange="window.__mfTplChannelChanged()">' + channelOpts + '</select>' +
            '</div>' +
            '<div class="mf-col" id="mfTplSubjectCol"' + (t.channel === 'email' ? '' : ' style="display:none"') + '>' +
              '<label class="mf-label">Betreff (E-Mail)</label>' +
              '<input class="mf-input" id="mfTplSubject" type="text" placeholder="z.B. Willkommen, {parentName}!" value="' + escAttr(t.subject || '') + '" />' +
            '</div>' +
          '</div>' +

          '<label class="mf-label">Inhalt <span class="mf-req">*</span></label>' +

          '<div class="mf-editor-tabs">' +
            '<button type="button" class="mf-tab active" id="mfTabRich" onclick="window.__mfTplSwitchMode(\'rich\')">Visuell</button>' +
            '<button type="button" class="mf-tab" id="mfTabHtml" onclick="window.__mfTplSwitchMode(\'html\')">Quelltext</button>' +
            '<div class="mf-editor-toolbar" id="mfTplToolbar">' +
              '<button type="button" class="mf-tool" data-cmd="bold" title="Fett (Strg+B)" onclick="window.__mfTplExec(\'bold\')"><strong>B</strong></button>' +
              '<button type="button" class="mf-tool" data-cmd="italic" title="Kursiv (Strg+I)" onclick="window.__mfTplExec(\'italic\')"><em>I</em></button>' +
              '<button type="button" class="mf-tool" data-cmd="underline" title="Unterstrichen (Strg+U)" onclick="window.__mfTplExec(\'underline\')"><u>U</u></button>' +
              '<span class="mf-tool-sep"></span>' +
              '<button type="button" class="mf-tool" title="Aufzählung" onclick="window.__mfTplExec(\'insertUnorderedList\')">• Liste</button>' +
              '<button type="button" class="mf-tool" title="Link einfügen" onclick="window.__mfTplLink()">🔗 Link</button>' +
              '<span class="mf-tool-sep"></span>' +
              '<button type="button" class="mf-tool" title="Vorschau wie im Postfach" onclick="window.__mfTplPreview()">👁 Vorschau</button>' +
            '</div>' +
          '</div>' +

          // Rich (contenteditable)
          '<div class="mf-rich-editor" id="mfTplRich" contenteditable="true" data-placeholder="Hey {parentName}, schön dass {childName} bei {courseName} dabei ist!"></div>' +
          // Source (textarea)
          '<textarea class="mf-input mf-textarea" id="mfTplBody" rows="10" placeholder="<p>Hey {parentName},</p><p>schön dass {childName} bei {courseName} dabei ist!</p>" style="display:none">' + escTxt(t.body || '') + '</textarea>' +

          '<div class="mf-hint">Variablen mit <code>{name}</code> einfügen — werden beim Versand mit Echtdaten ersetzt.</div>' +

          '<div class="mf-vars">' +
            '<div class="mf-vars-label">Schnell einfügen:</div>' +
            commonVars.map(function(v) {
              return '<button type="button" class="mf-var-chip" onclick="window.__mfInsertVar(\'' + v + '\')">{' + v + '}</button>';
            }).join('') +
          '</div>' +
        '</div>' +

        '<div class="mf-foot">' +
          (existing ? '<button class="mf-btn mf-btn-ghost" onclick="window.__mfDeleteTpl(\'' + escAttr(id) + '\')">Löschen</button>' : '<span></span>') +
          '<div class="mf-foot-right">' +
            '<button class="mf-btn mf-btn-ghost" onclick="window.__mfTplPreview()">Vorschau</button>' +
            '<button class="mf-btn mf-btn-ghost" onclick="window.__mfCloseModal()">Abbrechen</button>' +
            '<button class="mf-btn mf-btn-primary" id="mfTplSubmit" onclick="window.__mfSaveTpl(' + (existing ? '\'' + escAttr(id) + '\'' : 'null') + ')">' + (existing ? 'Speichern' : 'Anlegen') + '</button>' +
          '</div>' +
        '</div>' +

      '</div>' +
      '</div>';

    var root = ensureModalRoot();
    root.innerHTML = html;

    // Initialize rich editor with content (interpret as HTML if it contains tags, else as text with line-breaks)
    var initialBody = t.body || '';
    var richEl = document.getElementById('mfTplRich');
    if (initialBody.indexOf('<') >= 0) {
      richEl.innerHTML = initialBody;
    } else if (initialBody) {
      // Plain text → wrap in <p>, preserve line-breaks
      richEl.innerHTML = initialBody.split(/\n\n+/).map(function(p) {
        return '<p>' + p.replace(/\n/g, '<br>') + '</p>';
      }).join('');
    } else {
      richEl.innerHTML = '';
    }
    // Editor mode state: 'rich' (default) or 'html'
    window.__mfTplMode = 'rich';

    window.__mfTplChannelChanged = function() {
      var ch = document.getElementById('mfTplChannel').value;
      var subjCol = document.getElementById('mfTplSubjectCol');
      if (subjCol) subjCol.style.display = (ch === 'email') ? '' : 'none';
    };

    window.__mfTplSwitchMode = function(mode) {
      var rich = document.getElementById('mfTplRich');
      var ta = document.getElementById('mfTplBody');
      var tabRich = document.getElementById('mfTabRich');
      var tabHtml = document.getElementById('mfTabHtml');
      var toolbar = document.getElementById('mfTplToolbar');
      if (mode === 'html') {
        // Sync rich → textarea
        ta.value = rich.innerHTML;
        rich.style.display = 'none';
        ta.style.display = '';
        tabRich.classList.remove('active');
        tabHtml.classList.add('active');
        toolbar.style.opacity = '0.4';
        toolbar.style.pointerEvents = 'none';
      } else {
        // Sync textarea → rich
        rich.innerHTML = ta.value;
        rich.style.display = '';
        ta.style.display = 'none';
        tabRich.classList.add('active');
        tabHtml.classList.remove('active');
        toolbar.style.opacity = '';
        toolbar.style.pointerEvents = '';
      }
      window.__mfTplMode = mode;
    };

    window.__mfTplExec = function(cmd) {
      var rich = document.getElementById('mfTplRich');
      if (rich) rich.focus();
      try { document.execCommand(cmd, false, null); } catch(e) { console.warn('execCommand failed', cmd, e); }
    };

    window.__mfTplLink = function() {
      var url = prompt('URL eingeben (z.B. https://urbankids.club/portal):', 'https://');
      if (!url) return;
      var rich = document.getElementById('mfTplRich');
      if (rich) rich.focus();
      try { document.execCommand('createLink', false, url); } catch(e) {}
    };

    window.__mfTplPreview = function() {
      // Aktuellen Inhalt rendern, Variablen mit Beispielwerten ersetzen
      var bodyHtml;
      if (window.__mfTplMode === 'html') {
        bodyHtml = document.getElementById('mfTplBody').value;
      } else {
        bodyHtml = document.getElementById('mfTplRich').innerHTML;
      }
      var subj = (document.getElementById('mfTplSubject') || {}).value || '(kein Betreff)';
      var ch = document.getElementById('mfTplChannel').value;

      // Beispielwerte für Variablen
      var demo = { parentName:'Sarah', childName:'Mia', courseName:'Eltern/Kind Yoga', providerName:'Socialy',
                   startDate:'15.05.2026', time:'15:45–16:45', amount:'140,00 €',
                   invoiceNumber:'2026-042', dueDate:'30.05.2026', reviewLink:'https://example.com/feedback',
                   scheduleText:'Mittwochs 15:45', startTime:'15:45', locationName:'Kursraum 1',
                   courseListLink:'https://example.com/kurse', daysLeft:'7',
                   discountPercent:'10', couponCode:'WELCOME10', tierName:'Gold', tierIcon:'🥇',
                   seasonName:'Sommer 2026', bookingLink:'https://example.com/buchung' };
      function render(s) {
        return String(s || '').replace(/\{\s*([a-zA-Z0-9_]+)\s*\}/g, function(_m, k) {
          return demo[k] != null ? demo[k] : '{' + k + '}';
        });
      }
      var renderedBody = render(bodyHtml);
      var renderedSubj = render(subj);

      var preview =
        '<div class="mf-backdrop" style="z-index:10001" onclick="if(event.target===this)window.__mfPreviewClose()">' +
        '<div class="mf-modal mf-preview-modal" role="dialog">' +
          '<div class="mf-head">' +
            '<div class="mf-kicker">' + (ch === 'email' ? 'E-Mail-Vorschau' : ch === 'whatsapp' ? 'WhatsApp-Vorschau' : 'SMS-Vorschau') + ' · Beispieldaten</div>' +
            '<h2 class="mf-title">So sieht\'s im <em>Postfach</em> aus</h2>' +
            '<button class="mf-close" onclick="window.__mfPreviewClose()">×</button>' +
          '</div>' +
          '<div class="mf-body">' +
            (ch === 'email'
              ? '<div class="mf-preview-email">' +
                  '<div class="mf-preview-header">' +
                    '<div class="mf-preview-from"><strong>Urban Kids Club</strong> &lt;noreply@urbankids.club&gt;</div>' +
                    '<div class="mf-preview-to">an mich</div>' +
                    '<div class="mf-preview-subj">' + escTxt(renderedSubj) + '</div>' +
                  '</div>' +
                  '<div class="mf-preview-body">' + renderedBody + '</div>' +
                '</div>'
              : '<div class="mf-preview-chat">' +
                  '<div class="mf-preview-bubble">' + renderedBody + '</div>' +
                  '<div class="mf-preview-meta">' + (ch === 'whatsapp' ? '✓✓ WhatsApp Business' : 'SMS · 160 Zeichen') + '</div>' +
                '</div>'
            ) +
            '<div class="mf-hint" style="margin-top:14px">Beispielwerte: Sarah/Mia/Eltern‑Kind Yoga/Socialy. Echtwerte kommen aus der Buchung beim Versand.</div>' +
          '</div>' +
          '<div class="mf-foot">' +
            '<span></span>' +
            '<div class="mf-foot-right">' +
              '<button class="mf-btn mf-btn-primary" onclick="window.__mfPreviewClose()">Schließen</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '</div>';
      var prevRoot = document.getElementById('mfPreviewRoot');
      if (!prevRoot) {
        prevRoot = document.createElement('div');
        prevRoot.id = 'mfPreviewRoot';
        document.body.appendChild(prevRoot);
      }
      prevRoot.innerHTML = preview;
    };
    window.__mfPreviewClose = function() {
      var p = document.getElementById('mfPreviewRoot');
      if (p) p.innerHTML = '';
    };

    window.__mfInsertVar = function(name) {
      var token = '{' + name + '}';
      if (window.__mfTplMode === 'html') {
        var ta = document.getElementById('mfTplBody');
        if (!ta) return;
        var s2 = ta.selectionStart || 0;
        var e2 = ta.selectionEnd || 0;
        ta.value = ta.value.slice(0, s2) + token + ta.value.slice(e2);
        ta.focus();
        ta.selectionStart = ta.selectionEnd = s2 + token.length;
      } else {
        var rich = document.getElementById('mfTplRich');
        if (!rich) return;
        rich.focus();
        try {
          // Try to insert at cursor via execCommand
          document.execCommand('insertText', false, token);
        } catch(e) {
          // Fallback: append
          rich.innerHTML += token;
        }
      }
    };

    setTimeout(function() {
      var nm = document.getElementById('mfTplName');
      if (nm && !nm.value) nm.focus();
    }, 50);
  };

  window.__mfSaveTpl = async function(id) {
    var s = window.dashboardState; if (!s) return;
    var name = (document.getElementById('mfTplName').value || '').trim();
    if (!name) {
      var nm = document.getElementById('mfTplName');
      nm.focus(); nm.style.borderColor = '#B4523A';
      setTimeout(function(){ nm.style.borderColor = ''; }, 1500);
      return;
    }
    var channel = document.getElementById('mfTplChannel').value;
    var subject = (document.getElementById('mfTplSubject').value || '').trim();
    // Body: aus rich oder html mode lesen
    var body;
    if (window.__mfTplMode === 'html') {
      body = (document.getElementById('mfTplBody').value || '').trim();
    } else {
      body = (document.getElementById('mfTplRich').innerHTML || '').trim();
      // Leere <br>/leeres <p>-Edge-Case
      if (body === '<br>' || body === '<p><br></p>' || body === '<p></p>') body = '';
    }
    if (!body) {
      var richEl2 = document.getElementById('mfTplRich');
      var ta2 = document.getElementById('mfTplBody');
      var target = window.__mfTplMode === 'html' ? ta2 : richEl2;
      target.focus(); target.style.borderColor = '#B4523A';
      setTimeout(function(){ target.style.borderColor = ''; }, 1500);
      return;
    }
    // Extract used variables {name}
    var foundVars = {};
    (body + ' ' + subject).replace(/\{\s*([a-zA-Z0-9_]+)\s*\}/g, function(_m, k) { foundVars[k] = true; return ''; });
    var variables = Object.keys(foundVars);

    var btn = document.getElementById('mfTplSubmit');
    btn.disabled = true; btn.textContent = 'Speichern…';
    try {
      var payload = { name: name, channel: channel, subject: channel === 'email' ? subject : null, body: body, variables: variables };
      if (id) {
        await s.api('/marketing/templates/' + id, { method:'PUT', body: JSON.stringify(payload) });
      } else {
        await s.api('/providers/' + s.provider.id + '/marketing/templates', { method:'POST', body: JSON.stringify(payload) });
      }
      if (window.ukcToast) window.ukcToast('Vorlage ' + (id ? 'gespeichert' : 'angelegt'), 'success', 1800);
      closeModal();
      if (window.sectionLoaders && window.sectionLoaders.marketing) window.sectionLoaders.marketing();
    } catch(e) {
      btn.disabled = false; btn.textContent = id ? 'Speichern' : 'Anlegen';
      alert('Fehler: ' + (e && e.message ? e.message : e));
    }
  };

  window.__mfDeleteTpl = async function(id) {
    if (!confirm('Vorlage wirklich löschen?\n\nFlows die diese Vorlage nutzen, werden gelöst (template_id = null).')) return;
    var s = window.dashboardState; if (!s) return;
    try {
      await s.api('/marketing/templates/' + id, { method:'DELETE' });
      if (window.ukcToast) window.ukcToast('Vorlage gelöscht', 'success', 1600);
      closeModal();
      if (window.sectionLoaders && window.sectionLoaders.marketing) window.sectionLoaders.marketing();
    } catch(e) { alert('Fehler: ' + (e && e.message ? e.message : e)); }
  };
})();

window.editFlow = function(id) { window.openFlowEditor(id); };
window.editTemplate = function(id) { window.openTemplateEditor(id); };

// ============================================================
// EMBED SECTION (Phase 4)
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaders.embed = function() {
  var s = window.dashboardState; if (!s) return;
  var prov = s.provider || {};
  var slug = prov.slug || prov.publicSlug || '';
  var origin = window.location.origin;

  // Tracking-Listener-Snippet befüllen
  // Zwei Funktionen in einem:
  //   (1) Outgoing: Hört auf Buchungs-Events aus dem iFrame und leitet sie an Pixel weiter (gtag/fbq/GTM)
  //   (2) Incoming: Reicht _fbp/_fbc/gclid/UTMs an iFrame durch (Match-Quality-Boost für Server-Side CAPI)
  var trackEl = document.getElementById('phEmbedTrackSnippet');
  if (trackEl) {
    trackEl.value = '<script>\n' +
      '// Urban Kids Club — Conversion-Listener + Match-Quality-Bridge\n' +
      '// Einmal in den <head> einfügen (nach Meta-Pixel/GTM/GA4-Snippets).\n' +
      '(function() {\n' +
      '  // Helper: Cookie lesen\n' +
      '  function getCookie(n) {\n' +
      '    var m = document.cookie.match("(^|;)\\\\s*" + n + "\\\\s*=\\\\s*([^;]+)");\n' +
      '    return m ? decodeURIComponent(m.pop()) : null;\n' +
      '  }\n' +
      '  // Helper: URL-Param lesen\n' +
      '  function getParam(n) {\n' +
      '    try { return new URLSearchParams(window.location.search).get(n); } catch(e) { return null; }\n' +
      '  }\n' +
      '  // 1) Tracking-Context bauen (fbp/fbc/gclid + UTMs)\n' +
      '  function getTrackingContext() {\n' +
      '    return {\n' +
      '      fbp: getCookie("_fbp"),\n' +
      '      fbc: getCookie("_fbc") || (getParam("fbclid") ? "fb.1." + Date.now() + "." + getParam("fbclid") : null),\n' +
      '      gclid: getParam("gclid"),\n' +
      '      utm_source: getParam("utm_source"),\n' +
      '      utm_medium: getParam("utm_medium"),\n' +
      '      utm_campaign: getParam("utm_campaign"),\n' +
      '      utm_content: getParam("utm_content"),\n' +
      '      utm_term: getParam("utm_term")\n' +
      '    };\n' +
      '  }\n' +
      '  // 2) Listen für iFrame-Messages\n' +
      '  window.addEventListener("message", function(e) {\n' +
      '    if (!e.data || typeof e.data !== "object") return;\n' +
      '\n' +
      '    // (A) iFrame fragt nach Tracking-Context (beim Load der Buchungs-Seite)\n' +
      '    if (e.data.type === "ukc-iframe-ready" || e.data.type === "ukc-request-tracking") {\n' +
      '      try {\n' +
      '        e.source.postMessage({ type: "ukc-tracking-context", tracking: getTrackingContext() }, e.origin || "*");\n' +
      '      } catch (err) { /* ignore */ }\n' +
      '      return;\n' +
      '    }\n' +
      '\n' +
      '    // (B) iFrame meldet erfolgreiche Buchung → an Pixel weiterleiten\n' +
      '    if (e.data.type !== "ukc-booking-success") return;\n' +
      '    var b = e.data;\n' +
      '\n' +
      '    // Google Analytics 4 (gtag.js direkt)\n' +
      '    if (typeof gtag === "function") {\n' +
      '      gtag("event", "purchase", {\n' +
      '        transaction_id: b.bookingId || b.sessionId,\n' +
      '        value: b.amount || 0,\n' +
      '        currency: b.currency || "EUR",\n' +
      '        items: [{ item_id: b.activityId, item_name: "Kursbuchung" }]\n' +
      '      });\n' +
      '    }\n' +
      '    // Meta / Facebook Pixel\n' +
      '    if (typeof fbq === "function") {\n' +
      '      fbq("track", "Purchase", {\n' +
      '        value: b.amount || 0,\n' +
      '        currency: b.currency || "EUR",\n' +
      '        content_ids: [b.activityId],\n' +
      '        content_type: "product"\n' +
      '      }, { eventID: b.eventId || b.event_id });\n' +
      '    }\n' +
      '    // Google Tag Manager — DataLayer Push\n' +
      '    if (window.dataLayer && typeof window.dataLayer.push === "function") {\n' +
      '      window.dataLayer.push({\n' +
      '        event: "ukc_booking",\n' +
      '        ecommerce: {\n' +
      '          transaction_id: b.bookingId || b.sessionId,\n' +
      '          value: b.amount || 0,\n' +
      '          currency: b.currency || "EUR",\n' +
      '          items: [{ item_id: b.activityId, item_name: "Kursbuchung", price: b.amount || 0 }]\n' +
      '        }\n' +
      '      });\n' +
      '    }\n' +
      '  });\n' +
      '})();\n' +
      '<\/script>';
  }

  // Pixel-Installer wurde nach Integrationen verschoben — keine Init nötig.

  // Slug-Anzeige
  var slugEl = document.getElementById('phEmbedSlugText');
  if (slugEl) slugEl.textContent = slug || '(noch nicht gesetzt)';
  var portalLink = document.getElementById('phEmbedPortalLink');
  if (portalLink && slug) portalLink.href = origin + '/portal?provider=' + encodeURIComponent(slug);

  // Hilfsfunktion: Snippet-Builder
  function buildSnippet(path, height) {
    var url = origin + path;
    return '<iframe src="' + url + '" width="100%" height="' + (height || 720) + '" frameborder="0" style="border:0;border-radius:12px;max-width:920px" title="Urban Kids Club Widget"></iframe>';
  }

  // Cache-bust für Iframes — Status-Änderung in Kurse soll Vorschau aktualisieren
  var bust = '?_v=' + Date.now();

  // 1. Kalender
  if (slug) {
    var calPath = '/embed/' + slug + '/calendar';
    document.getElementById('phEmbedCalSnippet').value = buildSnippet(calPath, 720);
    document.getElementById('phEmbedCalOpen').href = origin + calPath;
    document.getElementById('phEmbedCalPreview').src = origin + calPath + bust;
  }

  // 2. Kursliste
  if (slug) {
    var coursesPath = '/embed/' + slug;
    document.getElementById('phEmbedCoursesSnippet').value = buildSnippet(coursesPath, 600);
    document.getElementById('phEmbedCoursesOpen').href = origin + coursesPath;
    document.getElementById('phEmbedCoursesPreview').src = origin + coursesPath + bust;
  }

  // 3. Einzelkurs — Picker: nur public-fähige Activities (active oder published)
  var sel = document.getElementById('phEmbedSingleSelect');
  if (sel) {
    var allCourses = (s.activities || []).filter(function(a) { return a && a.status !== 'archived' && a.status !== 'cancelled'; });
    var publicCourses = allCourses.filter(function(a) { return a.status === 'active' || a.status === 'published'; });
    var draftCount = allCourses.length - publicCourses.length;

    var hintEl = document.getElementById('phEmbedSingleHint');
    if (publicCourses.length === 0) {
      sel.innerHTML = '<option value="">— keine veröffentlichten Kurse —</option>';
      var snip = document.getElementById('phEmbedSingleSnippet');
      if (snip) snip.value = '';
      var pv = document.getElementById('phEmbedSinglePreview');
      if (pv) pv.removeAttribute('src');
      var openL = document.getElementById('phEmbedSingleOpen');
      if (openL) openL.removeAttribute('href');
      if (hintEl) {
        hintEl.style.display = '';
        hintEl.textContent = draftCount > 0
          ? draftCount + ' Kurs' + (draftCount === 1 ? '' : 'e') + ' als Entwurf vorhanden — zum Einbetten auf Status „Aktiv" umstellen.'
          : 'Lege erst einen Kurs an, um ihn einzubetten.';
      }
    } else {
      sel.innerHTML = publicCourses.map(function(a) {
        return '<option value="' + a.id + '">' + (a.title || 'Kurs').replace(/"/g, '&quot;') + '</option>';
      }).join('');
      window.__embCurSlug = slug;
      window.__embCurOrigin = origin;
      window.__embRefreshSingle();
      if (hintEl) {
        if (draftCount > 0) {
          hintEl.style.display = '';
          hintEl.textContent = draftCount + ' weitere Kurs' + (draftCount === 1 ? '' : 'e') + ' als Entwurf — werden hier nicht gelistet bis Status auf „Aktiv".';
        } else {
          hintEl.style.display = 'none';
        }
      }
    }
  }
};

// ============================================================
// Integrationen — Conversion-Webhook (n8n / Zapier / Make / eigener Endpoint)
// ============================================================
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaders.integrationen = async function() {
  var s = window.dashboardState; if (!s) return;
  // Schema-Vorschau befüllen
  var schemaEl = document.getElementById('phIntegConvSchema');
  if (schemaEl) {
    schemaEl.textContent = JSON.stringify({
      event_id: 'ukc_booking_<uuid>',
      event_name: 'Purchase',
      event_time: 1714305600,
      action_source: 'website',
      provider: { id: '<provider-uuid>', slug: 'socialy' },
      booking: {
        id: '<booking-uuid>',
        activity_id: '<activity-uuid>',
        activity_title: 'Explorer Circle',
        block_id: '<block-uuid>',
        session_id: '<session-uuid>',
        payment_method: 'stripe | onsite | invoice',
        status: 'confirmed | paid'
      },
      value: 140.00,
      currency: 'EUR',
      content_ids: ['<activity-uuid>'],
      content_type: 'product',
      num_items: 1,
      user_data: {
        em_sha256: '<hashed-email>',
        ph_sha256: '<hashed-phone>',
        fn_sha256: '<hashed-firstname>',
        ln_sha256: '<hashed-lastname>',
        client_ip_address: '203.0.113.42',
        client_user_agent: 'Mozilla/5.0 …',
        fbp: '<fbp-cookie>',
        fbc: '<fbc-cookie>',
        gclid: '<google-click-id>',
        external_id: '<parent-uuid>'
      },
      custom_data: {
        utm_source: 'instagram',
        utm_medium: 'paid',
        utm_campaign: 'spring-2026'
      }
    }, null, 2);
  }

  // Aktuelle Config laden
  try {
    var r = await s.api('/providers/' + s.provider.id + '/conversion-webhook');
    var cfg = r.data || r || {};
    if (document.getElementById('phIntegConvUrl')) document.getElementById('phIntegConvUrl').value = cfg.url || '';
    if (document.getElementById('phIntegConvSecret')) document.getElementById('phIntegConvSecret').value = cfg.secret || '';
    var events = cfg.events || ['booking_confirmed', 'payment_received'];
    var map = { booking_confirmed: 'phIntegConvEvtBC', payment_received: 'phIntegConvEvtPR', refund: 'phIntegConvEvtRF', customer_signup: 'phIntegConvEvtSU' };
    Object.keys(map).forEach(function(k) {
      var el = document.getElementById(map[k]);
      if (el) el.checked = events.indexOf(k) !== -1;
    });
  } catch (e) {
    console.warn('[v3] integrationen: load config failed', e);
  }

  // Recent Deliveries
  try {
    var d = await s.api('/providers/' + s.provider.id + '/conversion-webhook/deliveries');
    var deliveries = d.data || d.deliveries || [];
    var html = '';
    if (deliveries.length > 0) {
      html = '<div style="border-top:1px solid var(--border);padding-top:14px;margin-top:6px"><div style="font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted-2);margin-bottom:8px">Letzte Sendungen</div>';
      deliveries.slice(0, 6).forEach(function(x) {
        var statusColor = x.status === 'success' ? '#15803d' : x.status === 'failed' ? '#b45309' : '#64748b';
        var statusBg = x.status === 'success' ? 'rgba(21,128,61,0.08)' : x.status === 'failed' ? 'rgba(180,83,9,0.08)' : 'rgba(100,116,139,0.08)';
        html += '<div style="display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:6px;font-size:12px;margin-bottom:4px;background:rgba(0,0,0,0.02)">'
          + '<span style="font-family:Menlo,monospace;font-size:11px;color:var(--ink-2);min-width:140px">' + new Date(x.created_at || x.createdAt || 0).toLocaleString('de-DE') + '</span>'
          + '<span style="font-family:Menlo,monospace;font-size:11px;color:var(--ink);flex:1">' + (x.event_name || x.eventName || '?') + '</span>'
          + '<span style="font-size:11px;padding:2px 8px;border-radius:4px;color:' + statusColor + ';background:' + statusBg + ';font-weight:600">' + (x.status || '?') + (x.attempts > 1 ? ' (×' + x.attempts + ')' : '') + '</span>'
          + '<span style="font-family:Menlo,monospace;font-size:11px;color:var(--muted-2);min-width:60px;text-align:right">' + (x.response_status || x.responseStatus || '—') + '</span>'
          + '</div>';
      });
      html += '</div>';
    }
    var box = document.getElementById('phIntegConvDeliveries');
    if (box) box.innerHTML = html;
  } catch (e) { /* deliveries optional */ }
};

window.__intgConvSave = async function() {
  var s = window.dashboardState; if (!s) return;
  var url = (document.getElementById('phIntegConvUrl').value || '').trim();
  var secret = (document.getElementById('phIntegConvSecret').value || '').trim();
  var events = [];
  if (document.getElementById('phIntegConvEvtBC').checked) events.push('booking_confirmed');
  if (document.getElementById('phIntegConvEvtPR').checked) events.push('payment_received');
  if (document.getElementById('phIntegConvEvtRF').checked) events.push('refund');
  if (document.getElementById('phIntegConvEvtSU').checked) events.push('customer_signup');

  if (url && !/^https?:\/\//.test(url)) {
    if (window.ukcToast) window.ukcToast('URL muss mit http(s):// beginnen', 'error');
    return;
  }

  var statusEl = document.getElementById('phIntegConvStatus');
  if (statusEl) statusEl.textContent = 'speichere…';
  try {
    await s.api('/providers/' + s.provider.id + '/conversion-webhook', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: url, secret: secret, events: events, active: !!url }),
    });
    if (statusEl) statusEl.textContent = '✓ gespeichert';
    if (window.ukcToast) window.ukcToast('Webhook-Konfiguration gespeichert', 'success');
    setTimeout(function() { if (statusEl) statusEl.textContent = ''; }, 3000);
  } catch (e) {
    if (statusEl) statusEl.textContent = '⚠ ' + (e.message || 'Fehler');
    if (window.ukcToast) window.ukcToast('Speichern fehlgeschlagen: ' + (e.message || e), 'error');
  }
};

window.__intgConvTest = async function() {
  var s = window.dashboardState; if (!s) return;
  var statusEl = document.getElementById('phIntegConvStatus');
  if (statusEl) statusEl.textContent = 'sende Test-Event…';
  try {
    var r = await s.api('/providers/' + s.provider.id + '/conversion-webhook/test', { method: 'POST' });
    var resp = r.data || r;
    if (resp && resp.ok) {
      if (statusEl) statusEl.textContent = '✓ Test gesendet — Response: ' + (resp.responseStatus || resp.response_status || '?');
      if (window.ukcToast) window.ukcToast('Test-Event erfolgreich gesendet', 'success');
    } else {
      if (statusEl) statusEl.textContent = '⚠ ' + (resp.error || 'Test fehlgeschlagen');
      if (window.ukcToast) window.ukcToast('Test fehlgeschlagen: ' + (resp.error || '?'), 'error');
    }
    // Reload deliveries
    if (window.sectionLoaders && window.sectionLoaders.integrationen) window.sectionLoaders.integrationen();
  } catch (e) {
    if (statusEl) statusEl.textContent = '⚠ ' + (e.message || 'Fehler');
    if (window.ukcToast) window.ukcToast('Test fehlgeschlagen: ' + (e.message || e), 'error');
  }
};

window.__embRefreshSingle = function() {
  var sel = document.getElementById('phEmbedSingleSelect');
  if (!sel || !sel.value) return;
  var slug = window.__embCurSlug || '';
  var origin = window.__embCurOrigin || window.location.origin;
  if (!slug) return;
  var actId = sel.value;
  var path = '/embed/' + slug + '/course/' + actId;
  var url = origin + path;
  // Snippet ohne Cache-Bust (User soll cleanen Code copy-pasten)
  document.getElementById('phEmbedSingleSnippet').value = '<iframe src="' + url + '" width="100%" height="720" frameborder="0" style="border:0;border-radius:12px;max-width:520px" title="Urban Kids Club Widget"></iframe>';
  // Preview MIT Cache-Bust — verhindert dass Vorschau stale bleibt nach Status-Wechsel
  var preview = document.getElementById('phEmbedSinglePreview');
  if (preview) preview.src = url + '?_v=' + Date.now();
  var openL = document.getElementById('phEmbedSingleOpen');
  if (openL) openL.href = url;
};

window.__embPixelTab = function(tab) {
  window.__embPixelTabCur = tab;
  // Tab-States
  ['gtm','ga4','fb'].forEach(function(t) {
    var el = document.getElementById('phEmbedTab' + (t === 'gtm' ? 'GTM' : t === 'ga4' ? 'GA4' : 'FB'));
    if (el) el.classList.toggle('active', t === tab);
  });
  var input = document.getElementById('phEmbedPixelId');
  var hint = document.getElementById('phEmbedPixelHint');
  var snip = document.getElementById('phEmbedPixelSnippet');
  if (!snip) return;
  var idVal = (input && input.value || '').trim();
  var template = '';

  if (tab === 'gtm') {
    if (hint) hint.innerHTML = 'GTM-Container-ID eingeben (z.B. <code style="background:rgba(0,0,0,0.06);padding:1px 5px;border-radius:3px;font-family:Menlo,monospace;font-size:11px">GTM-XXXXXXX</code>)';
    if (input && !input.placeholder.includes('GTM')) input.placeholder = 'GTM-XXXXXXX';
    var gtmId = idVal || 'GTM-XXXXXXX';
    template = '<!-- Google Tag Manager -->\n' +
      '<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":\n' +
      'new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],\n' +
      'j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src=\n' +
      '"https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);\n' +
      '})(window,document,"script","dataLayer","' + gtmId + '");<\/script>\n' +
      '<!-- End Google Tag Manager -->';
  } else if (tab === 'ga4') {
    if (hint) hint.innerHTML = 'Measurement-ID eingeben (z.B. <code style="background:rgba(0,0,0,0.06);padding:1px 5px;border-radius:3px;font-family:Menlo,monospace;font-size:11px">G-XXXXXXXXXX</code>)';
    if (input && !input.placeholder.includes('G-')) input.placeholder = 'G-XXXXXXXXXX';
    var gaId = idVal || 'G-XXXXXXXXXX';
    template = '<!-- Google Analytics 4 -->\n' +
      '<script async src="https://www.googletagmanager.com/gtag/js?id=' + gaId + '"><\/script>\n' +
      '<script>\n' +
      '  window.dataLayer = window.dataLayer || [];\n' +
      '  function gtag(){dataLayer.push(arguments);}\n' +
      '  gtag("js", new Date());\n' +
      '  gtag("config", "' + gaId + '");\n' +
      '<\/script>';
  } else if (tab === 'fb') {
    if (hint) hint.innerHTML = 'Pixel-ID eingeben (z.B. <code style="background:rgba(0,0,0,0.06);padding:1px 5px;border-radius:3px;font-family:Menlo,monospace;font-size:11px">123456789012345</code>)';
    if (input && !input.placeholder.includes('123')) input.placeholder = '123456789012345';
    var fbId = idVal || 'YOUR_PIXEL_ID';
    template = '<!-- Meta Pixel -->\n' +
      '<script>\n' +
      '!function(f,b,e,v,n,t,s)\n' +
      '{if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n' +
      'n.callMethod.apply(n,arguments):n.queue.push(arguments)};\n' +
      'if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";\n' +
      'n.queue=[];t=b.createElement(e);t.async=!0;\n' +
      't.src=v;s=b.getElementsByTagName(e)[0];\n' +
      's.parentNode.insertBefore(t,s)}(window, document,"script",\n' +
      '"https://connect.facebook.net/en_US/fbevents.js");\n' +
      'fbq("init", "' + fbId + '");\n' +
      'fbq("track", "PageView");\n' +
      '<\/script>\n' +
      '<noscript><img height="1" width="1" style="display:none"\n' +
      '  src="https://www.facebook.com/tr?id=' + fbId + '&ev=PageView&noscript=1"/></noscript>\n' +
      '<!-- End Meta Pixel -->';
  }
  snip.value = template;
};

window.__embCopy = function(textareaId, btn) {
  var ta = document.getElementById(textareaId);
  if (!ta || !ta.value) return;
  try {
    ta.select();
    ta.setSelectionRange(0, 99999);
    var ok = document.execCommand('copy');
    if (!ok && navigator.clipboard) {
      navigator.clipboard.writeText(ta.value);
    }
    if (btn) {
      var orig = btn.textContent;
      btn.textContent = '✓ Kopiert';
      btn.disabled = true;
      setTimeout(function() { btn.textContent = orig; btn.disabled = false; }, 1600);
    }
    if (window.ukcToast) window.ukcToast('Snippet in Zwischenablage', 'success', 1400);
  } catch (e) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(ta.value).then(function() {
        if (window.ukcToast) window.ukcToast('Snippet in Zwischenablage', 'success', 1400);
      });
    }
  }
};

window.seedDefaultTemplates = async function() {
  const s = window.dashboardState; if (!s) return;
  if (!confirm('11 vorgefertigte Templates importieren?\n\nDu kannst sie danach einzeln anpassen oder löschen.')) return;
  const DEFAULTS = [
    { name:'Willkommen', channel:'whatsapp', body:'Hallo {{parentName}}! 👋 Willkommen bei {{providerName}}. Wir freuen uns, dass {{childName}} bei uns mitmacht!', variables:['parentName','childName','providerName'] },
    { name:'Buchungsbestätigung', channel:'whatsapp', body:'✅ Buchung bestätigt! {{childName}} ist angemeldet für "{{courseName}}" – {{scheduleText}}. Wir freuen uns! 🎉', variables:['childName','courseName','scheduleText','parentName'] },
    { name:'Erinnerung (24h)', channel:'whatsapp', body:'⏰ Erinnerung: Morgen um {{startTime}} findet "{{courseName}}" statt. {{childName}}, wir sehen uns! 😊', variables:['childName','courseName','startTime','locationName'] },
    { name:'Nach Probestunde', channel:'whatsapp', body:'Hallo {{parentName}}! Hat {{childName}} die Probestunde bei "{{courseName}}" gefallen? 🤩 Wir haben noch Plätze frei – sollen wir {{childName}} fest anmelden?', variables:['parentName','childName','courseName'] },
    { name:'Bewertung anfragen', channel:'whatsapp', body:'Hallo {{parentName}}! Wie fand {{childName}} "{{courseName}}"? Wir würden uns über dein Feedback freuen! ⭐ {{reviewLink}}', variables:['parentName','childName','courseName','reviewLink'] },
    { name:'Wir vermissen euch', channel:'whatsapp', body:'Hallo {{parentName}}! Wir haben {{childName}} schon eine Weile nicht gesehen 😢 Schau dir unsere neuen Kurse an: {{courseListLink}}', variables:['parentName','childName','courseListLink','providerName'] },
    { name:'Geburtstag', channel:'whatsapp', body:'🎂 Happy Birthday, {{childName}}! 🎉 Als kleines Geschenk gibts {{discountPercent}}% Rabatt: Code {{couponCode}}', variables:['childName','parentName','discountPercent','couponCode'] },
    { name:'Kurspaket endet bald', channel:'whatsapp', body:'Hallo {{parentName}}! Das Kurspaket von {{childName}} für "{{courseName}}" endet in {{daysLeft}} Tagen. Verlängern? 📩', variables:['parentName','childName','courseName','daysLeft'] },
    { name:'Treuestufe Aufstieg', channel:'whatsapp', body:'🎊 Glückwunsch {{parentName}}! Du bist aufgestiegen zum {{tierName}} {{tierIcon}}! Ab jetzt {{discountPercent}}% Rabatt. ❤️', variables:['parentName','tierName','tierIcon','discountPercent'] },
    { name:'Zahlungserinnerung', channel:'email', subject:'Zahlungserinnerung – {{invoiceNumber}}', body:'Hallo {{parentName}},\n\ndie Rechnung {{invoiceNumber}} über {{amount}} € ist noch offen.\n\nBitte überweisen Sie den Betrag bis zum {{dueDate}}.\n\nMit freundlichen Grüßen\n{{providerName}}', variables:['parentName','invoiceNumber','amount','dueDate','providerName'] },
    { name:'Neues Halbjahr', channel:'whatsapp', body:'📅 Neues Halbjahr, neue Kurse! Hallo {{parentName}}, die Anmeldung für {{seasonName}} ist offen. {{bookingLink}}', variables:['parentName','seasonName','bookingLink','childName'] },
  ];
  let ok = 0, fail = 0;
  for (const t of DEFAULTS) {
    try { await s.api('/providers/' + s.provider.id + '/marketing/templates', { method:'POST', body: JSON.stringify(t) }); ok++; }
    catch(e) { fail++; console.error('seed template failed', t.name, e); }
  }
  if (window.ukcToast) window.ukcToast(ok + ' Templates importiert' + (fail ? ', ' + fail + ' fehlgeschlagen' : ''));
  window.sectionLoaders.marketing();
};

// ============================================================

// ============================================================
// Inline Aktionen fuer Kurse + Buchungen (Sprint D Quick-Fix)
// ============================================================
(function() {
  function api(path, opts) {
    var s = window.dashboardState; if (!s || !s.api) throw new Error('Dashboard nicht geladen');
    return s.api(path, opts || {});
  }
  function refreshAll() {
    var s = window.dashboardState; if (!s || !s.api) return;
    Promise.all([
      s.api('/providers/' + s.provider.id + '/activities').then(function(r){ s.activities = r.data || r.activities || r || []; }).catch(function(){}),
      s.api('/providers/' + s.provider.id + '/bookings').then(function(r){ s.bookings = r.data || r.bookings || r || []; }).catch(function(){}),
    ]).then(function() {
      var hash = (location.hash || '').replace('#','');
      if (window.sectionLoaders && window.sectionLoaders[hash]) window.sectionLoaders[hash]();
      if (typeof window.refreshDashboardCards === 'function') window.refreshDashboardCards(); if (typeof window.renderWeekGlance === 'function') window.renderWeekGlance();
    });
  }
  function toast(msg, kind) {
    if (typeof window.ukcToast === 'function') window.ukcToast(msg, kind || 'info', 2400);
    else alert(msg);
  }

  // ----- KURSE -----

  // ---- Promise-based confirm (gebrandet) ------------------------
  window.ukcConfirm = function(opts) {
    return new Promise(function(resolve) {
      opts = opts || {};
      var prev = document.querySelector('.ukc-detail-overlay'); if (prev) prev.remove();
      var ov = document.createElement('div');
      ov.className = 'ukc-detail-overlay';
      ov.innerHTML = '<div class="ukc-detail-card' + (opts.variant === 'danger' ? ' danger' : '') + '" role="dialog" aria-modal="true">'
        + '<div class="ukc-detail-head">'
          + (opts.kicker ? '<div class="ukc-detail-kicker">' + escapeHtml(opts.kicker) + '</div>' : '')
          + '<h2 class="ukc-detail-title">' + (opts.titleHtml || escapeHtml(opts.title || 'Bestaetigen')) + '</h2>'
          + '<button class="ukc-detail-close" aria-label="Schliessen">×</button>'
        + '</div>'
        + (opts.message ? '<div class="ukc-detail-msg">' + escapeHtml(opts.message) + '</div>' : '')
        + '<div class="ukc-detail-foot">'
          + '<button class="btn btn-ghost btn-sm" data-cancel>' + escapeHtml(opts.cancelLabel || 'Abbrechen') + '</button>'
          + '<button class="btn ' + (opts.variant === 'danger' ? 'btn-danger' : 'btn-primary') + ' btn-sm" data-ok>' + escapeHtml(opts.okLabel || 'Bestaetigen') + '</button>'
        + '</div>'
        + '</div>';
      function cleanup(val) { ov.remove(); document.removeEventListener('keydown', onKey); resolve(val); }
      function onKey(e) { if (e.key === 'Escape') cleanup(false); else if (e.key === 'Enter') cleanup(true); }
      ov.querySelector('[data-ok]').addEventListener('click', function() { cleanup(true); });
      ov.querySelector('[data-cancel]').addEventListener('click', function() { cleanup(false); });
      ov.querySelector('.ukc-detail-close').addEventListener('click', function() { cleanup(false); });
      ov.addEventListener('click', function(e) { if (e.target === ov) cleanup(false); });
      document.addEventListener('keydown', onKey);
      document.body.appendChild(ov);
      requestAnimationFrame(function() { ov.classList.add('in'); });
    });
  };

  // ---- Promise-based action picker (gebrandet) -----------------
  window.ukcChoose = function(opts) {
    return new Promise(function(resolve) {
      opts = opts || {};
      var prev = document.querySelector('.ukc-detail-overlay'); if (prev) prev.remove();
      var optsHtml = (opts.options || []).map(function(o, i) {
        return '<button class="ukc-choose-opt' + (o.variant === 'danger' ? ' danger' : '') + '" data-idx="' + i + '">'
          + '<span class="ukc-choose-opt-title">' + escapeHtml(o.label || '') + '</span>'
          + (o.desc ? '<span class="ukc-choose-opt-desc">' + escapeHtml(o.desc) + '</span>' : '')
          + '</button>';
      }).join('');
      var ov = document.createElement('div');
      ov.className = 'ukc-detail-overlay';
      ov.innerHTML = '<div class="ukc-detail-card" role="dialog" aria-modal="true">'
        + '<div class="ukc-detail-head">'
          + (opts.kicker ? '<div class="ukc-detail-kicker">' + escapeHtml(opts.kicker) + '</div>' : '')
          + '<h2 class="ukc-detail-title">' + (opts.titleHtml || escapeHtml(opts.title || 'Aktion waehlen')) + '</h2>'
          + '<button class="ukc-detail-close" aria-label="Schliessen">×</button>'
        + '</div>'
        + (opts.message ? '<div class="ukc-detail-msg">' + escapeHtml(opts.message) + '</div>' : '')
        + '<div class="ukc-choose-list">' + optsHtml + '</div>'
        + '<div class="ukc-detail-foot">'
          + '<button class="btn btn-ghost btn-sm" data-cancel>Abbrechen</button>'
        + '</div>'
        + '</div>';
      function cleanup(val) { ov.remove(); document.removeEventListener('keydown', onKey); resolve(val); }
      function onKey(e) { if (e.key === 'Escape') cleanup(null); }
      ov.querySelector('[data-cancel]').addEventListener('click', function() { cleanup(null); });
      ov.querySelector('.ukc-detail-close').addEventListener('click', function() { cleanup(null); });
      ov.addEventListener('click', function(e) { if (e.target === ov) cleanup(null); });
      ov.querySelectorAll('.ukc-choose-opt').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var idx = parseInt(btn.getAttribute('data-idx'), 10);
          var opt = (opts.options || [])[idx];
          cleanup(opt ? opt.value : null);
        });
      });
      document.addEventListener('keydown', onKey);
      document.body.appendChild(ov);
      requestAnimationFrame(function() { ov.classList.add('in'); });
    });
  };
  // Invoice detail (Rechnung) — uses ukcShowDetailModal with real fields if available.
  window.viewInvoiceDetail = function(id) {
    var s = window.dashboardState;
    if (!s || !s.api) { alert('Dashboard nicht geladen'); return; }
    if (!id) {
      window.ukcShowDetailModal({ kicker: 'Rechnung', titleHtml: 'Detail <em>folgt</em>', rows: [{ label: 'Status', val: 'PDF-Generierung folgt im naechsten Schritt' }] });
      return;
    }
    s.api('/invoices/' + id).then(function(r) {
      var inv = r.data || r;
      if (!inv || !inv.id) {
        window.ukcShowDetailModal({ kicker: 'Rechnung', titleHtml: 'Nicht <em>gefunden</em>', rows: [{ label: 'ID', val: id }] });
        return;
      }
      window.ukcShowDetailModal({
        kicker: 'Rechnung',
        titleHtml: escapeHtml(inv.invoiceNumber || ('Entwurf-' + (inv.id || '').slice(0,8))) + ' <em>Detail</em>',
        rows: [
          { label: 'Status', val: inv.status || 'entwurf' },
          { label: 'Betrag', val: (inv.totalAmount != null ? inv.totalAmount : '0,00') + ' ' + (inv.currency || 'EUR') },
          { label: 'Erstellt', val: inv.createdAt ? new Date(inv.createdAt).toLocaleDateString('de-DE') : '—' },
          { label: 'Faellig', val: inv.dueDate || '—' },
        ],
      });
    }).catch(function(e) {
      window.ukcShowDetailModal({ kicker: 'Rechnung', titleHtml: 'Detail <em>folgt</em>', rows: [{ label: 'Hinweis', val: 'Rechnungs-Detail-View kommt im naechsten Schritt' }] });
    });
  };

  // ---- Detail-Modal (gebrandet) ---------------------------------
  var escapeHtml = window.escapeHtml || function(str) { var m={'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}; m[String.fromCharCode(39)]='&#39;'; return String(str==null?'':str).replace(/[&<>"']/g, function(c){ return m[c] || c; }); };
  window.escapeHtml = escapeHtml;
  window.ukcShowDetailModal = function(opts) {
    opts = opts || {};
    var prev = document.querySelector('.ukc-detail-overlay'); if (prev) prev.remove();
    var rowsHtml = (opts.rows || []).map(function(r) {
      if (r === '---') return '<div style="height:6px"></div>';
      var val = r.val == null || r.val === '' ? '—' : r.val;
      return '<div class="ukc-detail-row"><span class="ukc-detail-row-label">' + escapeHtml(r.label) + '</span><span class="ukc-detail-row-val">' + (r.html ? r.html : escapeHtml(String(val))) + '</span></div>';
    }).join('');
    var footHtml = opts.footerHtml || '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schliessen</button>';
    var ov = document.createElement('div');
    ov.className = 'ukc-detail-overlay';
    ov.innerHTML = '<div class="ukc-detail-card" role="dialog" aria-modal="true">'
      + '<div class="ukc-detail-head">'
        + (opts.kicker ? '<div class="ukc-detail-kicker">' + escapeHtml(opts.kicker) + '</div>' : '')
        + '<h2 class="ukc-detail-title">' + (opts.titleHtml || escapeHtml(opts.title || 'Detail')) + '</h2>'
        + '<button class="ukc-detail-close" aria-label="Schliessen" onclick="this.closest(\'.ukc-detail-overlay\').remove()">×</button>'
      + '</div>'
      + '<div class="ukc-detail-body">' + rowsHtml + (opts.bodyExtraHtml || '') + '</div>'
      + '<div class="ukc-detail-foot">' + footHtml + '</div>'
      + '</div>';
    ov.addEventListener('click', function(e) { if (e.target === ov) ov.remove(); });
    document.body.appendChild(ov);
    requestAnimationFrame(function() { ov.classList.add('in'); });
    document.addEventListener('keydown', function esc(e) { if (e.key === 'Escape') { ov.remove(); document.removeEventListener('keydown', esc); } });
  };

  function statusPillHtml(s) {
    var label = ({active:'Aktiv', paused:'Pausiert', archived:'Archiviert', in_planning:'In Planung', draft:'Entwurf', cancelled:'Storniert', completed:'Abgeschlossen', confirmed:'Bestaetigt', pending:'Offen'})[s] || (s || '—');
    var cls = ({active:'pill-ok', confirmed:'pill-ok', completed:'pill-ok', paused:'pill-pending', in_planning:'pill-pending', pending:'pill-pending', cancelled:'pill-err', archived:'pill-err'})[s] || 'pill-pending';
    return '<span class="pill ' + cls + '">' + label + '</span>';
  }
  function fmtDayCode(c) { return ({MO:'Montag',TU:'Dienstag',WE:'Mittwoch',TH:'Donnerstag',FR:'Freitag',SA:'Samstag',SU:'Sonntag'})[c] || c || '—'; }

  window.viewCourseDetail = async function(id) {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === id; });
    if (!a) { alert('Kurs nicht gefunden'); return; }
    window.__kdActiveId = id;
    window.showSection('kursdetail');
    // Show overview tab by default
    window.__kdActiveTab = 'overview';
    document.querySelectorAll('#phKdTabs .detail-tab').forEach(function(b) {
      b.classList.toggle('active', b.dataset.kdtab === 'overview');
    });
    document.querySelectorAll('.kdtab-pane').forEach(function(p) {
      p.hidden = (p.dataset.kdpane !== 'overview');
    });
    // Render skeleton immediately
    window.__kdRender();
    // Load deps in parallel
    await window.__kdLoadDeps(id);
    // Re-render with hydrated data
    window.__kdRender();
  };

  window.__kdActiveTab = 'overview';
  window.__kdSessionsCache = window.__kdSessionsCache || {};

  window.__kdLoadDeps = async function(activityId) {
    var s = window.dashboardState; if (!s) return;
    var jobs = [];
    if (typeof window.__kalLoadRooms === 'function' && !s.rooms) {
      jobs.push(window.__kalLoadRooms());
    }
    if (!s.team) {
      jobs.push((async function() {
        try {
          var r = await s.api('/providers/' + s.provider.id + '/team');
          s.team = r.data || r.team || r || [];
        } catch (e) { s.team = []; }
      })());
    }
    if (!s.courseBlocks) {
      jobs.push((async function() {
        try {
          var r = await s.api('/providers/' + s.provider.id + '/course-blocks');
          s.courseBlocks = r.data || r.courseBlocks || r || [];
        } catch (e) { s.courseBlocks = []; }
      })());
    }
    await Promise.all(jobs);
    // Load waitlist (separate per activity, cached)
    if (!s.waitlistByActivity) s.waitlistByActivity = {};
    if (!s.waitlistByActivity[activityId]) {
      try {
        var wr = await s.api('/activities/' + activityId + '/waitlist');
        s.waitlistByActivity[activityId] = wr.data || wr.entries || wr || [];
      } catch (e) { s.waitlistByActivity[activityId] = []; }
    }
    // After course-blocks, load sessions for this activity's block(s)
    var blocks = (s.courseBlocks || []).filter(function(b) { return b && b.activityId === activityId; });
    if (blocks.length > 0 && !window.__kdSessionsCache[activityId]) {
      var allSessions = [];
      await Promise.all(blocks.map(async function(b) {
        try {
          var r = await s.api('/course-blocks/' + b.id + '/sessions');
          var sess = r.data || r.sessions || r || [];
          sess.forEach(function(x) { x.__blockId = b.id; });
          allSessions = allSessions.concat(sess);
        } catch (e) {}
      }));
      window.__kdSessionsCache[activityId] = allSessions;
    }
  };

  window.__kdSwitchTab = function(key) {
    window.__kdActiveTab = key;
    document.querySelectorAll('#phKdTabs .detail-tab').forEach(function(b) {
      b.classList.toggle('active', b.dataset.kdtab === key);
    });
    document.querySelectorAll('.kdtab-pane').forEach(function(p) {
      p.hidden = (p.dataset.kdpane !== key);
    });
    if (key !== 'overview') window.__kdRenderTab(key);
  };

  if (!window.__kdTabsWired) {
    document.addEventListener('click', function(e) {
      var t = e.target.closest('#phKdTabs .detail-tab');
      if (!t) return;
      window.__kdSwitchTab(t.dataset.kdtab);
    });
    window.__kdTabsWired = true;
  }

  // ---------- Helpers ----------
  window.__kdFmtMoney = function(n) {
    return (Math.round(Number(n || 0) * 100) / 100).toFixed(2).replace('.', ',') + ' €';
  };
  window.__kdFmtMoneyNum = function(n) {
    return (Math.round(Number(n || 0) * 100) / 100).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  };
  window.__kdFmtDateDE = function(s) {
    if (!s) return '—';
    var m = String(s).match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (!m) return s;
    return parseInt(m[3],10) + '.' + parseInt(m[2],10) + '.' + m[1];
  };
  window.__kdSeason = function(iso) {
    var m = String(iso).match(/^(\d{4})-(\d{2})/);
    if (!m) return '';
    var month = parseInt(m[2], 10); var year = m[1];
    if (month >= 3 && month <= 5) return 'Frühjahr ' + year;
    if (month >= 6 && month <= 8) return 'Sommer ' + year;
    if (month >= 9 && month <= 11) return 'Herbst ' + year;
    return 'Winter ' + year;
  };
  window.__kdRelTime = function(iso) {
    if (!iso) return '—';
    var d = new Date(iso); var now = new Date();
    var diff = Math.floor((now - d) / 86400000);
    if (diff < 0) return window.__kdFmtDateDE(iso);
    var hh = String(d.getHours()).padStart(2,'0'); var mm = String(d.getMinutes()).padStart(2,'0');
    if (diff === 0) return 'heute, ' + hh + ':' + mm;
    if (diff === 1) return 'gestern, ' + hh + ':' + mm;
    if (diff < 7) return 'vor ' + diff + ' Tagen';
    return window.__kdFmtDateDE(iso);
  };
  window.__kdTrainerName = function(instructorId) {
    var s = window.dashboardState; if (!s || !instructorId) return null;
    var t = (s.team || []).find(function(x) { return x && x.id === instructorId; });
    return (t && (t.name || ((t.firstName || '') + ' ' + (t.lastName || '')).trim())) || null;
  };

  // Build session list — prefer real API sessions, fall back to computed
  window.__kdGetSessions = function(activityId) {
    var s = window.dashboardState; if (!s) return [];
    var a = (s.activities || []).find(function(x){ return x.id === activityId; });
    if (!a) return [];
    var apiSess = window.__kdSessionsCache[activityId];
    if (apiSess && apiSess.length > 0) {
      return apiSess.map(function(x) {
        // I5: TZ-anchor noon to prevent UTC→local rollover for 'YYYY-MM-DD' strings
        var d = typeof x.date === 'string' && x.date.length >= 10
          ? new Date(x.date.slice(0, 10) + 'T12:00:00')
          : new Date(x.date);
        return {
          id: x.id, blockId: x.__blockId,
          date: d, num: x.sessionNumber || 0,
          startTime: x.startTime || '', endTime: x.endTime || '',
          status: x.status || 'scheduled',
          cancelledCount: x.cancelledCount || 0,
          addUpUsedCount: x.addUpUsedCount || 0,
          expectedCount: x.expectedCount || 0,
          isExtra: x.isExtra === true || x.is_extra === true,
          isReal: true,
        };
      });
    }
    // Fallback compute from schedule
    var sched = a.schedule || {}; var slot = (sched.slots || [])[0] || {};
    if (!slot.day || !sched.startDate) return [];
    var dayKeys = ['MO','TU','WE','TH','FR','SA','SU'];
    var sd = dayKeys.indexOf(slot.day);
    if (sd < 0) return [];
    var startD = new Date(sched.startDate); startD.setHours(0,0,0,0);
    var endD = sched.endDate ? new Date(sched.endDate) : new Date(startD.getTime() + 365*86400000);
    var pkg = (a.pricing && a.pricing[0] && a.pricing[0].packageSize) || 0;
    var out = []; var d = new Date(startD); var iter = 0; var n = 1;
    while (d <= endD && out.length < (pkg || 50) && iter < 400) {
      if (((d.getDay() + 6) % 7) === sd) {
        out.push({ date: new Date(d), num: n++, startTime: slot.startTime || '', endTime: slot.endTime || '', status: 'scheduled', isReal: false });
      }
      d.setDate(d.getDate() + 1); iter++;
    }
    return out;
  };

  // Sort: future ascending (next first), then past in reverse chrono (newest past after future).
  window.__kdSortSessions = function(list) {
    var now = new Date(); now.setHours(0,0,0,0);
    var future = list.filter(function(x) { return x.date >= now; }).sort(function(a, b) { return a.date - b.date; });
    var past = list.filter(function(x) { return x.date < now; }).sort(function(a, b) { return b.date - a.date; });
    return future.concat(past);
  };

  // ---------- Render: main page ----------
  window.__kdRender = function() {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;
    var sched = a.schedule || {};
    var slot = (sched.slots || [])[0] || {};
    var price = (a.pricing && a.pricing[0]) || {};
    var bookings = (s.bookings || []).filter(function(b) {
      return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
    });
    var booked = bookings.length;
    var cap = a.capacity || 0;
    var roomLabel = (window.__kalRoomName ? window.__kalRoomName(a.roomId) : null) || a.roomName || (a.roomId ? '—' : 'Kein Raum');
    var trainerName = window.__kdTrainerName(a.instructorId) || a.instructorName || a.trainerName || (a.instructorId ? '—' : 'Kein Kursleiter');

    // Title — split last word into <em>
    var title = a.title || 'Kurs';
    var parts = title.split(' ');
    var titleHtml;
    if (parts.length >= 2) {
      var last = parts.pop();
      titleHtml = (window.escapeHtml ? window.escapeHtml(parts.join(' ')) : parts.join(' ')) + ' <em>' + (window.escapeHtml ? window.escapeHtml(last) : last) + '</em>';
    } else {
      titleHtml = '<em>' + (window.escapeHtml ? window.escapeHtml(title) : title) + '</em>';
    }
    document.getElementById('phKdTitle').innerHTML = titleHtml;
    document.getElementById('phKdBreadcrumb').textContent = title;

    // Meta row 1
    document.getElementById('phKdKategorie').textContent = a.category || 'Sonstige';
    var ageMin = (a.ageRange && a.ageRange.min != null) ? a.ageRange.min : null;
    var ageMax = (a.ageRange && a.ageRange.max != null) ? a.ageRange.max : null;
    var ageUnit = (a.ageRange && a.ageRange.unit) || 'years';
    var ageLabel = '—';
    if (ageMin != null && ageMax != null) {
      ageLabel = ageMin + '–' + ageMax + ' ' + (ageUnit === 'months' ? 'Monate' : 'J.');
    }
    document.getElementById('phKdAge').textContent = ageLabel;
    var dayDe = (window.fmtDayCode ? window.fmtDayCode(slot.day) : (slot.day || '—'));
    var schedLabel = dayDe + 's' + (slot.startTime ? ' · ' + slot.startTime.slice(0,5) : '') + (slot.endTime ? '–' + slot.endTime.slice(0,5) : '');
    document.getElementById('phKdSchedule').textContent = schedLabel;
    var statusEl = document.getElementById('phKdStatus');
    if (a.status === 'paused') { statusEl.textContent = 'Pausiert'; statusEl.className = 'pill pill-pending'; }
    else if (a.status === 'cancelled') { statusEl.textContent = 'Storniert'; statusEl.className = 'pill pill-err'; }
    else if (a.status === 'archived') { statusEl.textContent = 'Archiviert'; statusEl.className = 'pill'; }
    else if (a.status === 'planning' || a.status === 'draft' || a.status === 'in_planning') { statusEl.textContent = 'In Planung'; statusEl.className = 'pill pill-pending'; }
    else { statusEl.textContent = 'Aktiv'; statusEl.className = 'pill pill-ok'; }

    // Meta row 2
    var pkgSize = price.packageSize;
    document.getElementById('phKdSessionsLabel').textContent = (pkgSize ? pkgSize + ' Termine' : 'Laufend') + (sched.startDate ? ' · ' + window.__kdSeason(sched.startDate) : '');
    var amount = price.amount != null ? price.amount : 0;
    document.getElementById('phKdPriceLabel').textContent = window.__kdFmtMoney(amount) + (price.type === 'package' ? ' pro Block' : (price.type === 'subscription' ? ' / Monat' : ''));
    document.getElementById('phKdLocation').textContent = roomLabel;

    // KPI Stats
    document.getElementById('phKdKpiBooked').innerHTML = booked + ' <em>/' + cap + '</em>';
    var weekAgo = Date.now() - 7*86400000;
    var bookedThisWeek = bookings.filter(function(b) { return new Date(b.createdAt || 0) >= weekAgo; }).length;
    document.getElementById('phKdKpiBookedDelta').textContent = bookedThisWeek > 0 ? '+' + bookedThisWeek + ' diese Woche' : 'Keine neuen';
    var rev = booked * (price.amount || 0);
    document.getElementById('phKdKpiRevenue').innerHTML = window.__kdFmtMoneyNum(rev) + ' <em>€</em>';
    var paid = bookings.filter(function(b) { return b.paymentStatus === 'paid'; }).length;
    document.getElementById('phKdKpiRevenueDelta').textContent = paid + ' von ' + booked + ' bezahlt';
    var wlEntries = (s.waitlistByActivity && s.waitlistByActivity[a.id]) || [];
    var wlOpen = wlEntries.filter(function(w) { return w.status === 'waiting'; }).length;
    var wlOffered = wlEntries.filter(function(w) { return w.status === 'offered'; }).length;
    document.getElementById('phKdKpiWait').innerHTML = wlOpen + ' <em>offen</em>';
    if (wlEntries.length === 0) {
      document.getElementById('phKdKpiWaitDelta').textContent = a.waitlistEnabled ? 'Warteliste aktiv · noch keine Anfragen' : 'Warteliste deaktiviert';
    } else if (wlOffered > 0) {
      document.getElementById('phKdKpiWaitDelta').textContent = wlOffered + ' Angebot' + (wlOffered === 1 ? '' : 'e') + ' versendet';
    } else {
      var newest = wlEntries.slice().sort(function(a,b){ return new Date(b.addedAt || 0) - new Date(a.addedAt || 0); })[0];
      document.getElementById('phKdKpiWaitDelta').textContent = newest ? ('zuletzt: ' + window.__kdRelTime(newest.addedAt)) : '—';
    }

    // Sessions metrics
    var sessions = window.__kdSortSessions(window.__kdGetSessions(a.id));
    var now = new Date(); now.setHours(0,0,0,0);
    var sessTotal = pkgSize || sessions.length;
    var sessDone = sessions.filter(function(x) { return x.date < now && x.status !== 'cancelled'; }).length;
    document.getElementById('phKdKpiSessions').innerHTML = sessDone + ' <em>/' + sessTotal + '</em>';
    var nextSess = sessions.filter(function(x){ return x.date >= now && x.status !== 'cancelled'; })[0];
    if (nextSess) {
      var dayLabels = ['So','Mo','Di','Mi','Do','Fr','Sa'];
      document.getElementById('phKdKpiSessionsDelta').textContent = 'Nächste: ' + dayLabels[nextSess.date.getDay()] + ', ' + window.__kdFmtDateDE(nextSess.date.toISOString().slice(0,10));
    } else {
      document.getElementById('phKdKpiSessionsDelta').textContent = '—';
    }

    // Tab counts
    document.getElementById('phKdTabCntBloecke').textContent = sessions.length;
    document.getElementById('phKdTabCntTeilnehmer').textContent = booked;
    document.getElementById('phKdTabCntWarteliste').textContent = (wlOpen + wlOffered) || '0';

    // Description
    var descEl = document.getElementById('phKdDescription');
    if (a.description) {
      var paras = String(a.description).split(/\n\n+/).map(function(p) {
        return '<p>' + (window.escapeHtml ? window.escapeHtml(p) : p) + '</p>';
      }).join('');
      descEl.innerHTML = paras;
    } else {
      descEl.innerHTML = '<p style="color:var(--muted-2);font-style:italic">Noch keine Beschreibung. Klick "Bearbeiten" oben rechts.</p>';
    }

    // Sessions list (overview — first 5 with proper sort)
    document.getElementById('phKdAllSessionsCount').textContent = sessions.length;
    var sListEl = document.getElementById('phKdSessionsList');
    var topSessions = sessions.slice(0, 5);
    if (topSessions.length === 0) {
      sListEl.innerHTML = '<div style="padding:24px 0;color:var(--muted-2);text-align:center;font-size:13px">Keine Termine geplant.</div>';
    } else {
      var nextIdx = topSessions.findIndex(function(x){ return x.date >= now && x.status !== 'cancelled'; });
      sListEl.innerHTML = topSessions.map(function(item, i) {
        return window.__kdRenderTermin(item, a, roomLabel, dayDe, i === nextIdx);
      }).join('');
    }

    // Recent bookings
    var sortedB = bookings.slice().sort(function(x, y) {
      return new Date(y.createdAt || 0) - new Date(x.createdAt || 0);
    }).slice(0, 5);
    var tbody = document.getElementById('phKdBookingsTbody');
    if (sortedB.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="padding:24px;color:var(--muted-2);text-align:center">Noch keine Buchungen.</td></tr>';
    } else {
      tbody.innerHTML = sortedB.map(function(b) { return window.__kdRenderBookingRow(b); }).join('');
    }

    // Auslastung
    var pct = cap > 0 ? Math.round(booked / cap * 100) : 0;
    document.getElementById('phKdAuslVal').innerHTML = booked + ' <em>/ ' + cap + '</em>';
    var addUpInfo = (a.makeupCapacity != null && a.makeupCapacity > 0) ? ' · ' + a.makeupCapacity + ' Add-Up' : '';
    document.getElementById('phKdAuslSub').textContent = pct + ' % · ' + Math.max(0, cap - booked) + ' Pl\u00e4tze frei' + addUpInfo;
    document.getElementById('phKdAuslBar').style.width = Math.min(100, pct) + '%';

    // Avatar strip
    var avatars = bookings.slice(0, 5).map(function(b, i) {
      var name = (b.customerName || (b.customer && b.customer.name) || (b.child && b.child.name) || '?');
      var ini = name.charAt(0).toUpperCase();
      var tones = ['', 'sage', 'taupe', '', 'sage'];
      return '<span class="avatar ' + tones[i] + '">' + ini + '</span>';
    }).join('');
    var moreCount = Math.max(0, booked - 5);
    document.getElementById('phKdAvatarStrip').innerHTML = avatars + (moreCount > 0 ? '<span class="more">+ ' + moreCount + ' weitere</span>' : '');

    // Info list
    document.getElementById('phKdInfoTrainer').textContent = trainerName;
    document.getElementById('phKdInfoRoom').textContent = roomLabel;
    var addUpC = (a.makeupCapacity != null) ? a.makeupCapacity : null;
    document.getElementById('phKdInfoMax').innerHTML = (a.capacity ? '<span style="color:var(--primary);font-weight:600">' + a.capacity + '</span> regul\u00e4r' : '\u2014') + (addUpC ? ' <span style="color:var(--sage-deep);margin-left:6px">+ ' + addUpC + ' Add-Up</span>' : '');
    var dur = '—';
    if (slot.startTime && slot.endTime) {
      var sm = parseInt(slot.startTime.slice(0,2),10)*60 + parseInt(slot.startTime.slice(3,5),10);
      var em = parseInt(slot.endTime.slice(0,2),10)*60 + parseInt(slot.endTime.slice(3,5),10);
      dur = (em - sm) + ' Minuten';
    }
    document.getElementById('phKdInfoDuration').textContent = dur;
    document.getElementById('phKdInfoStart').textContent = sched.startDate ? window.__kdFmtDateDE(sched.startDate) : '—';
    document.getElementById('phKdInfoEnd').textContent = sched.endDate ? window.__kdFmtDateDE(sched.endDate) : 'offen';
    document.getElementById('phKdInfoPrice').textContent = window.__kdFmtMoney(amount) + (price.type === 'package' ? ' / Block' : '');

    // Pause label
    document.getElementById('phKdPauseLabel').textContent = a.status === 'paused' ? 'Kurs aktivieren' : 'Kurs pausieren';

    // If a non-overview tab was active, re-render it (so counts/data refresh)
    if (window.__kdActiveTab !== 'overview') window.__kdRenderTab(window.__kdActiveTab);
  };

  // ---------- Termin-row template ----------
  window.__kdRenderTermin = function(item, activity, roomLabel, dayDeLong, isNext) {
    var monthsShort = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
    var dayShort = ['Mo','Di','Mi','Do','Fr','Sa','So'];
    var d = item.date;
    var now = new Date(); now.setHours(0,0,0,0);
    var isPast = d < now;
    var isCancelled = item.status === 'cancelled';
    var dayIdx = (d.getDay() + 6) % 7;

    var st = (item.startTime || '').slice(0,5);
    var et = (item.endTime || '').slice(0,5);
    var timeLabel = st + (et ? '–' + et : '');

    var rightLabel = '';
    if (isCancelled) {
      rightLabel = '<span class="termin-badge" style="background:var(--signal-tint);color:var(--signal)">Abgesagt</span>';
    } else if (isPast) {
      // Attendance count if available; else "X Plätze"
      var attLabel = (item.attendanceCount != null) ? item.attendanceCount + ' anwesend' : '';
      rightLabel = '<span class="termin-badge done">Erledigt</span>';
      if (attLabel) rightLabel = '<span style="font-size:12px;color:var(--muted-2);margin-right:8px">' + attLabel + '</span>' + rightLabel;
    } else if (isNext) {
      rightLabel = '<span class="termin-badge next">Nächster</span>';
    }

    // Effective participant count:
    //  - regular session: active enrollments (= activity bookings) − Krank-Records + Add-Up
    //  - extra session (isExtra): startet bei 0, nur manuell hinzugefügte Teilnehmer (expectedCount) + Add-Up
    var isExtraSess = item.isExtra === true || item.is_extra === true;
    var baseCount = 0;
    if (isExtraSess) {
      baseCount = item.expectedCount || 0;
    } else {
      baseCount = (window.dashboardState.bookings || []).filter(function(b) {
        return b && b.activityId === activity.id && b.status !== 'cancelled' && b.status !== 'refunded';
      }).length;
    }
    var cancelledForSess = item.cancelledCount || 0;
    var addUpForSess = item.addUpUsedCount || 0;
    var effective = isExtraSess
      ? Math.max(0, baseCount + addUpForSess)
      : Math.max(0, baseCount - cancelledForSess + addUpForSess);
    var cap = activity.capacity || 0;
    var capLabel = '';
    if (!isPast) {
      capLabel = ' · ' + effective + '/' + cap + ' Plätze';
      var hints = [];
      if (isExtraSess) hints.push('Zusatz-Termin');
      if (cancelledForSess > 0) hints.push(cancelledForSess + ' krank');
      if (addUpForSess > 0) hints.push(addUpForSess + ' Add-Up');
      if (hints.length) capLabel += ' (' + hints.join(' · ') + ')';
    }

    var sessionId = item.id || ('virtual-' + d.toISOString());
    var clickAttr = ' onclick="window.__kdShowSession(' + JSON.stringify(JSON.stringify(item)).replace(/"/g, '&quot;') + ')" style="cursor:pointer"';
    return '<div class="termin-item' + ((isPast || isCancelled) ? ' is-done' : '') + '"' + clickAttr + '>'
      + '<div class="termin-date"><div class="termin-date-day">' + d.getDate() + '</div><div class="termin-date-month">' + monthsShort[d.getMonth()] + '</div></div>'
      + '<div class="termin-main"><div class="termin-title">Stunde ' + (item.num || '?') + '</div>'
      + '<div class="termin-sub">' + dayShort[dayIdx] + ', ' + timeLabel + ' · ' + roomLabel + capLabel + '</div></div>'
      + rightLabel + '</div>';
  };

  // ---------- Booking-row template ----------
  window.__kdRenderBookingRow = function(b) {
    var name = b.customerName || (b.customer && b.customer.name) || '—';
    var childName = (b.child && b.child.name) || (b.child && (b.child.firstName + ' ' + (b.child.lastName || '')).trim()) || '—';
    var childAge = (b.child && b.child.age) || '';
    var childLabel = childName + (childAge ? ' (' + childAge + ' J.)' : '');
    var when = window.__kdRelTime(b.createdAt);
    var amt = (b.amountPaid != null ? window.__kdFmtMoney(b.amountPaid) : '—');
    // Cancelled-Override: Buchungs-Status hat Vorrang vor payment_status (Storno-Konsistenz)
    var isCancelled = b.status === 'cancelled' || b.paymentStatus === 'cancelled';
    var status = isCancelled ? 'cancelled' : (b.paymentStatus || 'unpaid');
    var pillCls = 'pill-pending', pillTxt = 'OFFEN';
    if (status === 'paid') { pillCls = 'pill-ok'; pillTxt = 'BEZAHLT'; }
    else if (status === 'cancelled') { pillCls = 'pill-err'; pillTxt = 'STORNIERT'; }
    else if (status === 'refunded') { pillCls = 'pill-err'; pillTxt = 'ERSTATTET'; }
    else if (status === 'partial') { pillCls = 'pill-pending'; pillTxt = 'TEILZAHLUNG'; }
    var pm = (b.paymentMethod === 'stripe') ? '' : ' <span style="font-size:9px;color:var(--muted-2);margin-left:4px">vor Ort</span>';
    var parentId = b.parentId || (b.customer && b.customer.id) || '';
    var clickAttr = parentId ? ' onclick="window.__kdShowParent(\'' + parentId + '\')" style="cursor:pointer"' : '';
    var hoverAttr = parentId ? ' class="kd-row-clickable"' : '';
    return '<tr' + hoverAttr + clickAttr + '>'
      + '<td>' + (window.escapeHtml ? window.escapeHtml(name) : name) + '</td>'
      + '<td>' + (window.escapeHtml ? window.escapeHtml(childLabel) : childLabel) + '</td>'
      + '<td>' + when + '</td>'
      + '<td>' + amt + '</td>'
      + '<td><span class="pill ' + pillCls + '">' + pillTxt + '</span>' + pm + '</td>'
      + '</tr>';
  };

  // ---------- Quick-action wrappers ----------
  window.__kdShare = function() {
    var a = (window.dashboardState.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;
    var url = location.origin + '/v3#kursdetail-' + a.id;
    if (navigator.share) navigator.share({ title: a.title, url: url }).catch(function(){});
    else if (navigator.clipboard) navigator.clipboard.writeText(url).then(function() {
      if (window.ukcToast) window.ukcToast('Link kopiert');
    });
    else alert(url);
  };
  window.__kdEdit = function() {
    if (typeof window.editCourseQuick === 'function') window.editCourseQuick(window.__kdActiveId);
  };
  window.__kdAddParticipant = async function() {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;

    // Open modal with loading state first
    var ageMin = (a.ageRange && a.ageRange.min != null) ? a.ageRange.min : 0;
    var ageMax = (a.ageRange && a.ageRange.max != null) ? a.ageRange.max : 99;
    var category = encodeURIComponent(a.category || '');
    var providerId = s.provider.id;

    function showInviteModal(parents) {
      var rows = parents.map(function(p) {
        var initials = (p.name || '').split(' ').map(function(w){ return w.charAt(0).toUpperCase(); }).slice(0,2).join('');
        var children = (p.childNames || []).map(function(n, i) {
          var age = (p.childAges && p.childAges[i] != null) ? ' (' + p.childAges[i] + ' J.)' : '';
          return n + age;
        }).join(', ') || '—';
        var badges = '';
        (p.matchReasons || []).forEach(function(reason) {
          var cls = 'invite-badge';
          if (/Credit/.test(reason)) cls += ' match-credit';
          else if (/Alter/.test(reason)) cls += ' match-age';
          else if (/Kurs/.test(reason)) cls += ' match-cat';
          else if (/Aktiv/.test(reason)) cls += ' active';
          badges += '<span class="' + cls + '">' + (window.escapeHtml ? window.escapeHtml(reason) : reason) + '</span>';
        });
        var alreadyAttr = p.alreadyInvited ? ' disabled' : '';
        var alreadyBadge = p.alreadyInvited ? '<span class="invite-badge" style="background:var(--signal-tint);color:var(--signal)">Bereits eingeladen</span>' : '';
        return '<label class="invite-row' + (p.alreadyInvited ? ' disabled' : '') + '">'
          + '<input type="checkbox" class="invite-cb" data-pid="' + p.parentId + '"' + alreadyAttr + '>'
          + '<div class="invite-row-main">'
          +   '<div class="invite-row-name">' + (window.escapeHtml ? window.escapeHtml(p.name || '—') : p.name) + '</div>'
          +   '<div class="invite-row-sub">' + (window.escapeHtml ? window.escapeHtml(children) : children) + ' · ' + (p.bookingCount || 0) + ' bisherige Buchung' + ((p.bookingCount === 1) ? '' : 'en') + '</div>'
          +   '<div class="invite-row-badges">' + badges + alreadyBadge + '</div>'
          + '</div></label>';
      }).join('');

      var listHtml = parents.length === 0
        ? '<div class="invite-empty">Keine passenden Eltern in deiner Kunden-Datenbank gefunden.<br><span style="font-size:11px">Tipp: Sobald die ersten Eltern bei dir gebucht haben, schlagen wir hier passende vor.</span></div>'
        : rows;

      var bodyExtraHtml =
          '<div class="invite-card">'
        +   '<div class="invite-toolbar">'
        +     '<div style="font-size:13px;color:var(--ink-2)">' + parents.filter(function(p){ return !p.alreadyInvited; }).length + ' passende Familie' + (parents.length === 1 ? '' : 'n') + '</div>'
        +     '<a class="card-link" id="phInvSelectAll" style="font-size:12px;cursor:pointer">Alle wählen</a>'
        +   '</div>'
        +   '<div class="invite-list" id="phInvList">' + listHtml + '</div>'
        +   '<div class="invite-coupon-field">'
        +     '<label for="phInvCoupon">Rabatt-Code (optional):</label>'
        +     '<input type="text" id="phInvCoupon" placeholder="z.B. WILLKOMMEN10" maxlength="32">'
        +   '</div>'
        + '</div>';

      var courseName = a.title || 'Kurs';
      window.ukcShowDetailModal({
        kicker: 'Kurs-Einladung',
        titleHtml: 'Eltern einladen zu <em>' + (window.escapeHtml ? window.escapeHtml(courseName) : courseName) + '</em>',
        rows: [],
        bodyExtraHtml: bodyExtraHtml,
        footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>'
          + ' <button class="btn btn-primary btn-sm" id="phInvSend">Einladungen senden</button>',
      });

      // Wire after render
      setTimeout(function() {
        var selectAll = document.getElementById('phInvSelectAll');
        if (selectAll) selectAll.addEventListener('click', function() {
          var cbs = document.querySelectorAll('.invite-cb:not([disabled])');
          var allOn = Array.from(cbs).every(function(c){ return c.checked; });
          cbs.forEach(function(c){ c.checked = !allOn; });
          selectAll.textContent = allOn ? 'Alle wählen' : 'Alle abwählen';
        });
        var sendBtn = document.getElementById('phInvSend');
        if (sendBtn) sendBtn.addEventListener('click', async function() {
          var cbs = document.querySelectorAll('.invite-cb:checked:not([disabled])');
          var pids = Array.from(cbs).map(function(c){ return c.dataset.pid; });
          if (pids.length === 0) {
            alert('Wähle mindestens eine Familie aus.');
            return;
          }
          var coupon = (document.getElementById('phInvCoupon') || {}).value || '';
          sendBtn.disabled = true; sendBtn.textContent = 'Sende ' + pids.length + '…';
          try {
            var resp = await fetch('/api/providers/' + providerId + '/invite-parents', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
              body: JSON.stringify({ parentIds: pids, activityId: a.id, couponCode: coupon || undefined }),
            });
            if (!resp.ok) {
              var err = await resp.json().catch(function(){ return {}; });
              throw new Error(err.error || ('HTTP ' + resp.status));
            }
            var data = await resp.json();
            var sum = data.summary || {};
            var msg = sum.sent + ' Einladung' + (sum.sent === 1 ? '' : 'en') + ' gesendet';
            if (sum.skipped > 0) msg += ' · ' + sum.skipped + ' übersprungen';
            if (sum.failed > 0) msg += ' · ' + sum.failed + ' fehlgeschlagen';
            if (window.ukcToast) window.ukcToast(msg);
            // close
            var ov = document.querySelector('.ukc-detail-overlay');
            if (ov) ov.remove();
          } catch (e) {
            sendBtn.disabled = false; sendBtn.textContent = 'Einladungen senden';
            alert('Fehler: ' + (e.message || e));
          }
        });
      }, 50);
    }

    // Show "loading" modal first
    window.ukcShowDetailModal({
      kicker: 'Kurs-Einladung',
      titleHtml: 'Suche passende <em>Eltern…</em>',
      rows: [],
      bodyExtraHtml: '<div class="invite-empty">Lade Vorschläge…</div>',
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>',
    });

    try {
      var qs = '?activityId=' + encodeURIComponent(a.id) + '&ageMin=' + ageMin + '&ageMax=' + ageMax + (category ? '&category=' + category : '');
      var resp = await fetch('/api/providers/' + providerId + '/parents/matching' + qs, {
        headers: { 'Authorization': 'Bearer ' + (s.token || '') },
      });
      if (!resp.ok) throw new Error('Konnte Vorschläge nicht laden');
      var data = await resp.json();
      var ov = document.querySelector('.ukc-detail-overlay');
      if (ov) ov.remove();
      showInviteModal(data.data || []);
    } catch (e) {
      var ov2 = document.querySelector('.ukc-detail-overlay');
      if (ov2) ov2.remove();
      alert('Fehler: ' + (e.message || e));
    }
  };
  window.__kdAddSession = async function() {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;
    // Block für aktive Aktivität finden (active > upcoming > erster)
    var blocks = (s.courseBlocks || []).filter(function(b){ return b && b.activityId === a.id; });
    if (!blocks.length) { window.ukcToast && window.ukcToast('Kein Kursblock vorhanden — erst Block anlegen', 'warn'); return; }
    var block = blocks.find(function(b){ return b.status === 'active'; }) || blocks.find(function(b){ return b.status === 'upcoming'; }) || blocks[0];
    // Letzte Session ermitteln (für Default-Zeit + nächstes Datum)
    var sessions = (window.__kdSessionsCache && window.__kdSessionsCache[a.id]) || [];
    var blockSessions = sessions.filter(function(x){ return x.__blockId === block.id || x.blockId === block.id; });
    blockSessions.sort(function(x, y){ return (x.date || '').localeCompare(y.date || ''); });
    var lastSess = blockSessions[blockSessions.length - 1];
    var defaultDate = (function() {
      var base = lastSess && lastSess.date ? new Date(lastSess.date + 'T12:00:00') : new Date();
      base.setDate(base.getDate() + 7);
      var today = new Date(); today.setHours(0,0,0,0);
      if (base < today) base = new Date(today.getTime() + 24*60*60*1000);
      return base.toISOString().slice(0, 10);
    })();
    var defaultStart = (lastSess && lastSess.startTime) || (block.recurringTime) || (a.schedule && a.schedule.slots && a.schedule.slots[0] && a.schedule.slots[0].startTime) || '16:00';
    var defaultEnd = (lastSess && lastSess.endTime) || (function() {
      var p = String(defaultStart).split(':'); var h = parseInt(p[0]||'16',10), m = parseInt(p[1]||'0',10);
      var dur = (a && a.durationMinutes) || 60; var total = h*60 + m + dur;
      var hh = String(Math.floor(total/60) % 24).padStart(2,'0'); var mm = String(total%60).padStart(2,'0');
      return hh + ':' + mm;
    })();
    var courseName = a.title || 'Kurs';
    var bodyExtraHtml =
        '<div style="display:flex;flex-direction:column;gap:14px;font-size:14px">'
      +   '<div><label style="display:block;font-size:12px;color:var(--ink-2);margin-bottom:4px">Datum</label>'
      +     '<input type="date" id="phKdAddSessDate" value="' + defaultDate + '" min="' + new Date().toISOString().slice(0,10) + '" style="width:100%;padding:9px 11px;border:1px solid rgba(60,33,36,.18);border-radius:10px;background:white"></div>'
      +   '<div style="display:flex;gap:10px">'
      +     '<div style="flex:1"><label style="display:block;font-size:12px;color:var(--ink-2);margin-bottom:4px">Beginn</label>'
      +       '<input type="time" id="phKdAddSessStart" value="' + defaultStart + '" style="width:100%;padding:9px 11px;border:1px solid rgba(60,33,36,.18);border-radius:10px;background:white"></div>'
      +     '<div style="flex:1"><label style="display:block;font-size:12px;color:var(--ink-2);margin-bottom:4px">Ende</label>'
      +       '<input type="time" id="phKdAddSessEnd" value="' + defaultEnd + '" style="width:100%;padding:9px 11px;border:1px solid rgba(60,33,36,.18);border-radius:10px;background:white"></div>'
      +   '</div>'
      +   '<div style="font-size:12px;color:var(--ink-2);line-height:1.5">Eltern werden nicht automatisch benachrichtigt. Schreibe ihnen ggf. anschließend über „Nachricht an alle".</div>'
      + '</div>';
    window.ukcShowDetailModal({
      kicker: 'Zusatz-Termin',
      titleHtml: 'Termin hinzufügen <em>· ' + (window.escapeHtml ? window.escapeHtml(courseName) : courseName) + '</em>',
      rows: [],
      bodyExtraHtml: bodyExtraHtml,
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>'
        + ' <button class="btn btn-primary btn-sm" id="phKdAddSessSave">Termin anlegen</button>',
    });
    setTimeout(function() {
      var saveBtn = document.getElementById('phKdAddSessSave');
      if (!saveBtn) return;
      saveBtn.addEventListener('click', async function() {
        var date = (document.getElementById('phKdAddSessDate') || {}).value || '';
        var st = (document.getElementById('phKdAddSessStart') || {}).value || '';
        var en = (document.getElementById('phKdAddSessEnd') || {}).value || '';
        if (!date) { alert('Bitte ein Datum wählen.'); return; }
        if (st && en && st >= en) { alert('Endzeit muss nach Beginn liegen.'); return; }
        saveBtn.disabled = true; saveBtn.textContent = 'Speichere…';
        try {
          var resp = await s.api('/course-blocks/' + block.id + '/sessions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ date: date, startTime: st || undefined, endTime: en || undefined }),
          });
          if (resp && resp.error) throw new Error(resp.error);
          // Cache leeren + Detail neu laden
          if (window.__kdSessionsCache) delete window.__kdSessionsCache[a.id];
          var ov = document.querySelector('.ukc-detail-overlay'); if (ov) ov.remove();
          if (window.ukcToast) window.ukcToast('Termin am ' + date.split('-').reverse().join('.') + ' angelegt');
          if (typeof window.__kdLoadDeps === 'function') await window.__kdLoadDeps(a.id);
          if (window.__kdActiveTab) window.__kdRenderTab && window.__kdRenderTab(window.__kdActiveTab);
        } catch (e) {
          saveBtn.disabled = false; saveBtn.textContent = 'Termin anlegen';
          alert('Fehler: ' + (e.message || e));
        }
      });
    }, 50);
  };
  window.__kdMessageAll = async function() {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;
    var courseName = a.title || 'Kurs';
    // Empfängerzahl schätzen aus Cache
    var blocks = (s.courseBlocks || []).filter(function(b){ return b && b.activityId === a.id; });
    var enrollmentCount = 0;
    if (window.__kdEnrollmentsCache && window.__kdEnrollmentsCache[a.id]) {
      enrollmentCount = (window.__kdEnrollmentsCache[a.id] || []).filter(function(e){ return e.status === 'active'; }).length;
    }
    var subjPlaceholder = 'Update zu ' + courseName;
    var bodyExtraHtml =
        '<div style="display:flex;flex-direction:column;gap:14px;font-size:14px">'
      +   '<div style="font-size:12px;color:var(--ink-2);line-height:1.5">'
      +     'Wird an alle <strong>aktiven Eltern</strong> dieses Kurses gesendet'
      +     (enrollmentCount > 0 ? ' (≈ <strong>' + enrollmentCount + '</strong> Empfänger).' : '.')
      +     ' Antworten landen in deinem Postfach.'
      +   '</div>'
      +   '<div><label style="display:block;font-size:12px;color:var(--ink-2);margin-bottom:4px">Betreff (optional)</label>'
      +     '<input type="text" id="phKdMsgSubj" maxlength="200" placeholder="' + subjPlaceholder + '" style="width:100%;padding:9px 11px;border:1px solid rgba(60,33,36,.18);border-radius:10px;background:white"></div>'
      +   '<div><label style="display:block;font-size:12px;color:var(--ink-2);margin-bottom:4px">Nachricht</label>'
      +     '<textarea id="phKdMsgBody" maxlength="5000" rows="7" placeholder="Hallo zusammen,&#10;..." style="width:100%;padding:10px 12px;border:1px solid rgba(60,33,36,.18);border-radius:10px;background:white;font:inherit;resize:vertical"></textarea>'
      +     '<div style="font-size:11px;color:var(--ink-2);margin-top:4px"><span id="phKdMsgCount">0</span> / 5000 Zeichen</div>'
      +   '</div>'
      + '</div>';
    window.ukcShowDetailModal({
      kicker: 'Nachricht an alle',
      titleHtml: 'E-Mail an Teilnehmer <em>· ' + (window.escapeHtml ? window.escapeHtml(courseName) : courseName) + '</em>',
      rows: [],
      bodyExtraHtml: bodyExtraHtml,
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>'
        + ' <button class="btn btn-primary btn-sm" id="phKdMsgSend">Senden</button>',
    });
    setTimeout(function() {
      var bodyEl = document.getElementById('phKdMsgBody');
      var cntEl = document.getElementById('phKdMsgCount');
      if (bodyEl && cntEl) bodyEl.addEventListener('input', function(){ cntEl.textContent = String(bodyEl.value.length); });
      var sendBtn = document.getElementById('phKdMsgSend');
      if (!sendBtn) return;
      sendBtn.addEventListener('click', async function() {
        var subj = ((document.getElementById('phKdMsgSubj') || {}).value || '').trim();
        var body = ((document.getElementById('phKdMsgBody') || {}).value || '').trim();
        if (!body) { alert('Bitte Nachrichten-Text ausfüllen.'); return; }
        if (body.length < 5) { alert('Nachricht zu kurz.'); return; }
        sendBtn.disabled = true; sendBtn.textContent = 'Sende…';
        try {
          var resp = await s.api('/messages/broadcast', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ activityId: a.id, subject: subj || ('Update zu ' + courseName), body: body }),
          });
          var count = (resp && (resp.count || (resp.data && resp.data.length))) || 0;
          var ov = document.querySelector('.ukc-detail-overlay'); if (ov) ov.remove();
          // M8: 0-Empfänger als Warnung statt Erfolgsmeldung — sonst denkt Provider die Nachricht ging raus
          if (window.ukcToast) {
            if (count === 0) window.ukcToast('Keine aktiven Familien für „' + courseName + '" — Nachricht nicht versendet', 'warn');
            else window.ukcToast('Nachricht an ' + count + ' Empfänger gesendet');
          }
        } catch (e) {
          sendBtn.disabled = false; sendBtn.textContent = 'Senden';
          alert('Fehler: ' + (e.message || e));
        }
      });
    }, 50);
  };
  // ── Phase 2 Auto-Slide Helpers ─────────────────────────────
  // Findet das nächste Vorkommen eines Wochentag-Keys (MO/TU/WE/TH/FR/SA/SU) NACH dem fromDate.
  window.__kdNextWeekdayAfter = function(weekdayKey, fromDate) {
    var dayMap = { SU: 0, MO: 1, TU: 2, WE: 3, TH: 4, FR: 5, SA: 6 };
    var target = dayMap[weekdayKey];
    if (target == null) return new Date(fromDate);
    var d = new Date(fromDate); d.setHours(0, 0, 0, 0);
    d.setDate(d.getDate() + 1); // mindestens morgen
    while (d.getDay() !== target) d.setDate(d.getDate() + 1);
    return d;
  };
  window.__kdFormatYMD = function(d) {
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  };
  window.__kdParseYMD = function(s) {
    if (!s) return null;
    var p = String(s).slice(0,10).split('-');
    if (p.length !== 3) return null;
    return new Date(parseInt(p[0],10), parseInt(p[1],10)-1, parseInt(p[2],10));
  };

  // Reaktivierungs-Modal mit Datum + Wochentag + Live-Endate-Vorschau.
  // Returnt Promise<{ newStartDate, newEndDate, newWeekday, notifyParents } | null>.
  window.__kdReactivateModal = function(activity, enrolled) {
    return new Promise(function(resolve) {
      var slot = (activity.schedule && activity.schedule.slots && activity.schedule.slots[0]) || {};
      var origDay = String(slot.day || 'MO').toUpperCase();
      var origStart = window.__kdParseYMD(activity.schedule && activity.schedule.startDate);
      var origEnd = window.__kdParseYMD(activity.schedule && activity.schedule.endDate);

      var suggestion = window.__kdNextWeekdayAfter(origDay, new Date());
      var dayLabels = { SU:'Sonntag', MO:'Montag', TU:'Dienstag', WE:'Mittwoch', TH:'Donnerstag', FR:'Freitag', SA:'Samstag' };
      var dayKeys = ['MO','TU','WE','TH','FR','SA','SU'];

      var prev = document.querySelector('.ukc-detail-overlay'); if (prev) prev.remove();
      var ov = document.createElement('div');
      ov.className = 'ukc-detail-overlay';

      var dayOptions = dayKeys.map(function(k){
        return '<option value="' + k + '"' + (k === origDay ? ' selected' : '') + '>' + dayLabels[k] + '</option>';
      }).join('');

      ov.innerHTML = '<div class="ukc-detail-card" role="dialog" aria-modal="true" style="max-width:480px">'
        + '<div class="ukc-detail-head">'
        + '<div class="ukc-detail-kicker">Kurs reaktivieren</div>'
        + '<h2 class="ukc-detail-title">' + (window.escapeHtml ? window.escapeHtml(activity.title) : activity.title) + ' · <em>neuer Start</em></h2>'
        + '<button class="ukc-detail-close" aria-label="Schliessen">×</button>'
        + '</div>'
        + '<div class="ukc-detail-msg">Wann soll der Kurs wieder starten? Die restlichen Termine werden automatisch entsprechend nach hinten verschoben.</div>'
        + '<div style="display:flex;flex-direction:column;gap:14px;padding:0 24px 18px">'
        +   '<label style="display:flex;flex-direction:column;gap:6px;font-size:12px;color:var(--muted-2);text-transform:uppercase;letter-spacing:0.08em;font-weight:600">Wochentag'
        +     '<select id="kdReactDay" style="padding:10px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;color:var(--ink);background:var(--surface);font-family:inherit">' + dayOptions + '</select>'
        +   '</label>'
        +   '<label style="display:flex;flex-direction:column;gap:6px;font-size:12px;color:var(--muted-2);text-transform:uppercase;letter-spacing:0.08em;font-weight:600">Erster Termin'
        +     '<input type="date" id="kdReactStart" value="' + window.__kdFormatYMD(suggestion) + '" style="padding:10px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;color:var(--ink);background:var(--surface);font-family:inherit">'
        +   '</label>'
        +   '<div id="kdReactPreview" style="font-size:13px;color:var(--muted);background:var(--primary-tint, rgba(228,180,142,0.15));padding:10px 14px;border-radius:8px"></div>'
        + (enrolled > 0
            ? '<label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-2)"><input type="checkbox" id="kdReactNotify" checked> ' + enrolled + ' Familie' + (enrolled === 1 ? '' : 'n') + ' per E-Mail informieren</label>'
            : '')
        + '</div>'
        + '<div class="ukc-detail-foot">'
        +   '<button class="btn btn-ghost btn-sm" data-cancel>Abbrechen</button>'
        +   '<button class="btn btn-primary btn-sm" data-ok>Reaktivieren</button>'
        + '</div>'
        + '</div>';

      function cleanup(val) { ov.remove(); document.removeEventListener('keydown', onKey); resolve(val); }
      function onKey(e) { if (e.key === 'Escape') cleanup(null); }

      var daySelect = ov.querySelector('#kdReactDay');
      var dateInput = ov.querySelector('#kdReactStart');
      var previewEl = ov.querySelector('#kdReactPreview');

      function recalcSuggestion() {
        // Wenn User Wochentag wechselt: Datum-Vorschlag anpassen (nächster passender Wochentag ab heute)
        var newDay = daySelect.value;
        var newSuggestion = window.__kdNextWeekdayAfter(newDay, new Date());
        dateInput.value = window.__kdFormatYMD(newSuggestion);
        updatePreview();
      }

      function updatePreview() {
        var newStart = window.__kdParseYMD(dateInput.value);
        if (!newStart || !origStart || !origEnd) { previewEl.textContent = ''; return; }
        var shiftMs = newStart.getTime() - origStart.getTime();
        var newEnd = new Date(origEnd.getTime() + shiftMs);
        var fmt = function(d) { return d.toLocaleDateString('de-DE', { day:'2-digit', month:'short', year:'numeric' }); };
        var weeks = Math.round((newEnd.getTime() - newStart.getTime()) / (7*86400000)) + 1;
        previewEl.innerHTML = '<strong>Letzter Termin:</strong> ' + fmt(newEnd) + ' &middot; <strong>' + weeks + ' Termine</strong>';
      }

      daySelect.addEventListener('change', recalcSuggestion);
      dateInput.addEventListener('input', updatePreview);
      ov.querySelector('[data-ok]').addEventListener('click', function() {
        var newStart = window.__kdParseYMD(dateInput.value);
        if (!newStart) { alert('Bitte ein Datum wählen.'); return; }
        var shiftMs = newStart.getTime() - origStart.getTime();
        var newEnd = new Date(origEnd.getTime() + shiftMs);
        var notifyEl = ov.querySelector('#kdReactNotify');
        cleanup({
          newStartDate: window.__kdFormatYMD(newStart),
          newEndDate: window.__kdFormatYMD(newEnd),
          newWeekday: daySelect.value,
          notifyParents: notifyEl ? notifyEl.checked : false,
        });
      });
      ov.querySelector('[data-cancel]').addEventListener('click', function() { cleanup(null); });
      ov.querySelector('.ukc-detail-close').addEventListener('click', function() { cleanup(null); });
      ov.addEventListener('click', function(e) { if (e.target === ov) cleanup(null); });
      document.addEventListener('keydown', onKey);
      document.body.appendChild(ov);
      requestAnimationFrame(function() { ov.classList.add('in'); updatePreview(); });
    });
  };

  window.__kdTogglePause = function() {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;
    var isCurrentlyActive = a.status !== 'paused' && a.status !== 'archived' && a.status !== 'cancelled';
    var newStatus = isCurrentlyActive ? 'paused' : 'active';
    var verbInf = newStatus === 'paused' ? 'pausieren' : 'aktivieren';
    var verbDone = newStatus === 'paused' ? 'pausiert' : 'aktiviert';
    var enrolled = (s.bookings || []).filter(function(b) {
      return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
    }).length;

    var go = function(notifyParents, newSchedule) {
      a.status = newStatus;
      if (newSchedule) a.schedule = newSchedule;
      window.__kdRender();
      var body = { status: newStatus, notifyParents: notifyParents };
      if (newSchedule) body.schedule = newSchedule;
      fetch('/api/activities/' + a.id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
        body: JSON.stringify(body),
      }).then(function(r) {
        if (!r.ok) throw new Error('Server-Fehler');
        if (window.ukcToast) {
          var note = notifyParents && enrolled > 0 ? ' · ' + enrolled + ' Eltern benachrichtigt' : '';
          var slideNote = newSchedule ? ' · neuer Start ' + newSchedule.startDate : '';
          window.ukcToast('Kurs ' + verbDone + slideNote + note);
        }
      }).catch(function() {
        a.status = newStatus === 'paused' ? 'active' : 'paused';
        window.__kdRender();
        alert('Konnte Status nicht ändern.');
      });
    };

    // ── Reaktivierung mit Auto-Slide-Modal (Phase 2a) ──
    if (newStatus === 'active' && a.status === 'paused' && a.schedule && a.schedule.slots && a.schedule.slots[0]) {
      window.__kdReactivateModal(a, enrolled).then(function(result) {
        if (!result) return;
        // Schedule mit neuem Start/End/Wochentag bauen
        var newSchedule = JSON.parse(JSON.stringify(a.schedule));
        newSchedule.startDate = result.newStartDate;
        newSchedule.endDate = result.newEndDate;
        if (newSchedule.slots && newSchedule.slots[0]) newSchedule.slots[0].day = result.newWeekday;
        go(result.notifyParents, newSchedule);
      });
      return;
    }

    var heading = newStatus === 'paused' ? 'Kurs pausieren?' : 'Kurs wieder aktivieren?';
    var bodyLead = newStatus === 'paused'
      ? 'Der Kurs <strong>' + a.title + '</strong> wird im Widget verborgen. Bestehende Buchungen bleiben gültig.'
      : 'Der Kurs <strong>' + a.title + '</strong> wird im Widget wieder sichtbar und neu buchbar.';

    if (enrolled === 0) {
      // Niemand eingebucht -> einfacher Confirm
      if (typeof window.ukcConfirm === 'function') {
        window.ukcConfirm({ title: heading, body: bodyLead, confirmLabel: verbInf.charAt(0).toUpperCase() + verbInf.slice(1) }).then(function(ok) { if (ok) go(false); });
      } else {
        if (confirm(heading)) go(false);
      }
      return;
    }

    // Mit eingebuchten Eltern: 3-Wege-Dialog
    if (typeof window.ukcChoose === 'function') {
      window.ukcChoose({
        title: heading,
        body: bodyLead + '<br><br>Es sind aktuell <strong>' + enrolled + ' Familie' + (enrolled === 1 ? '' : 'n') + '</strong> eingebucht. Sollen wir sie per E-Mail informieren?',
        choices: [
          { id: 'notify', label: verbInf.charAt(0).toUpperCase() + verbInf.slice(1) + ' & E-Mail an Eltern', tone: 'primary' },
          { id: 'silent', label: 'Nur ' + verbInf + ' (ohne E-Mail)', tone: 'ghost' },
          { id: 'cancel', label: 'Abbrechen', tone: 'ghost' },
        ],
      }).then(function(choice) {
        if (choice === 'notify') go(true);
        else if (choice === 'silent') go(false);
      });
    } else if (typeof window.ukcConfirm === 'function') {
      window.ukcConfirm({
        title: heading,
        body: bodyLead + '<br><br><strong>' + enrolled + ' Familie' + (enrolled === 1 ? '' : 'n') + '</strong> wird/werden per E-Mail informiert.',
        confirmLabel: verbInf.charAt(0).toUpperCase() + verbInf.slice(1) + ' & benachrichtigen',
      }).then(function(ok) { if (ok) go(true); });
    } else {
      var notify = confirm(enrolled + ' Eltern per E-Mail informieren? OK = ja, Abbrechen = nur Status ändern.');
      go(notify);
    }
  };

  // ---------- Tab content renderers ----------
  window.__kdRenderTab = function(key) {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;
    var pane = document.querySelector('[data-kdpane="' + key + '"] > div');
    if (!pane) return;

    var bookings = (s.bookings || []).filter(function(b) {
      return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
    });
    var roomLabel = (window.__kalRoomName ? window.__kalRoomName(a.roomId) : null) || a.roomName || (a.roomId ? '—' : 'Kein Raum');
    var slot = ((a.schedule || {}).slots || [])[0] || {};
    var dayDe = (window.fmtDayCode ? window.fmtDayCode(slot.day) : (slot.day || '—'));

    if (key === 'bloecke') {
      var sessions = window.__kdSortSessions(window.__kdGetSessions(a.id));
      if (sessions.length === 0) {
        pane.innerHTML = '<div class="card"><div class="card-head"><div class="card-title">Alle <em>Termine</em></div></div>'
          + '<div class="empty-state"><div class="empty-state-title">Keine Termine</div><div>Der Kurs hat noch keine geplanten Termine. Bearbeite Start- und Enddatum oder das Termine-Paket.</div></div></div>';
        return;
      }
      var rows = sessions.map(function(item) {
        var now = new Date(); now.setHours(0,0,0,0);
        var isNext = item.date >= now && item.status !== 'cancelled';
        // mark only the very first upcoming as next
        return window.__kdRenderTermin(item, a, roomLabel, dayDe, false);
      });
      // Tag the first future as Nächster
      var firstFuture = sessions.findIndex(function(x){ return x.date >= new Date() && x.status !== 'cancelled'; });
      if (firstFuture >= 0) rows[firstFuture] = window.__kdRenderTermin(sessions[firstFuture], a, roomLabel, dayDe, true);
      pane.innerHTML = '<div class="card"><div class="card-head"><div class="card-title">Alle <em>Termine</em> · ' + sessions.length + '</div>'
        + '<a class="card-link" onclick="window.__kdEdit()">Block bearbeiten →</a></div>'
        + '<div>' + rows.join('') + '</div></div>';
      return;
    }

    if (key === 'teilnehmer') {
      if (bookings.length === 0) {
        pane.innerHTML = '<div class="card"><div class="card-head"><div class="card-title">Alle <em>Teilnehmer</em></div></div>'
          + '<div class="empty-state"><div class="empty-state-title">Noch keine Teilnehmer</div><div>Sobald die ersten Eltern buchen, erscheinen sie hier mit Kontakt und Zahlungsstatus.</div></div></div>';
        return;
      }
      var sortedB = bookings.slice().sort(function(x, y) {
        return new Date(y.createdAt || 0) - new Date(x.createdAt || 0);
      });
      var rows = sortedB.map(function(b) { return window.__kdRenderBookingRow(b); }).join('');
      pane.innerHTML = '<div class="card"><div class="card-head"><div class="card-title">Alle <em>Teilnehmer</em> · ' + bookings.length + '/' + (a.capacity || '?') + '</div>'
        + '<button class="btn btn-ghost btn-sm" onclick="window.__kdAddParticipant()">+ Teilnehmer hinzufügen</button></div>'
        + '<table class="data-table"><thead><tr><th>Kunde</th><th>Kind</th><th>Datum</th><th>Betrag</th><th>Zahlung</th></tr></thead>'
        + '<tbody>' + rows + '</tbody></table></div>';
      return;
    }

    if (key === 'warteliste') {
      var wlList = (s.waitlistByActivity && s.waitlistByActivity[a.id]) || [];
      if (wlList.length === 0) {
        pane.innerHTML = '<div class="card"><div class="card-head"><div class="card-title">Die <em>Warteliste</em></div></div>'
          + '<div class="empty-state"><div class="empty-state-title">Warteliste leer</div>'
          + '<div>Wenn der Kurs voll ist und Eltern sich melden, erscheinen sie hier. '
          + 'Du kannst per Klick auf <strong>Anbieten</strong> einen frei werdenden Platz weiterreichen.</div></div></div>';
        return;
      }
      // Sort: waiting (oldest first) then offered (newest first)
      wlList = wlList.slice().sort(function(x, y) {
        var prio = function(e) { return e.status === 'waiting' ? 0 : (e.status === 'offered' ? 1 : 2); };
        var dp = prio(x) - prio(y);
        if (dp !== 0) return dp;
        return new Date(x.addedAt || 0) - new Date(y.addedAt || 0);
      });
      var rows = wlList.map(function(e, i) {
        var nm = e.parentName || '—';
        var ch = (e.child && (e.child.firstName || e.child.name)) || '—';
        if (e.child && e.child.firstName && e.child.lastName) ch = (e.child.firstName + ' ' + e.child.lastName).trim();
        var birthYear = e.child && (e.child.birthYear || e.child.year);
        var ageStr = birthYear ? ' (' + (new Date().getFullYear() - birthYear) + ' J.)' : '';
        var status = e.status || 'waiting';
        var expDate = e.expiresAt ? new Date(e.expiresAt) : null;
        var isExpired = !!(expDate && expDate.getTime() < Date.now() && status === 'offered');
        var effStatus = isExpired ? 'expired' : status;
        var pillCls = effStatus === 'offered' ? 'pill-pending' : (effStatus === 'waiting' ? 'pill-info' : (effStatus === 'expired' ? 'pill-err' : ''));
        var pillTxt = effStatus === 'offered' ? 'ANGEBOTEN' : (effStatus === 'waiting' ? 'WARTET' : (effStatus === 'expired' ? 'ABGELAUFEN' : status.toUpperCase()));
        var actions = '';
        if (status === 'waiting') {
          actions = '<button class="btn btn-primary btn-sm" onclick="window.__kdOfferSpot(\'' + e.id + '\')">Platz anbieten</button>'
            + ' <button class="btn btn-ghost btn-sm" onclick="window.__kdDeclineWaitlist(\'' + e.id + '\')" style="color:var(--signal)">Entfernen</button>';
        } else if (status === 'offered') {
          var expLabel;
          if (!expDate) {
            expLabel = 'wartet auf Antwort';
          } else {
            var _hh = String(expDate.getHours()).padStart(2, '0');
            var _mm = String(expDate.getMinutes()).padStart(2, '0');
            var _abs = _hh + ':' + _mm + ' Uhr';
            if (isExpired) {
              expLabel = 'abgelaufen um ' + _abs + ' · ' + window.__kdRelTime(e.expiresAt);
            } else {
              expLabel = 'läuft ab um ' + _abs + ' · ' + window.__kdRelTime(e.expiresAt);
            }
          }
          var rightActions = '';
          if (isExpired) {
            rightActions = '<button class="btn btn-ghost btn-sm" onclick="window.__kdOfferSpot(\'' + e.id + '\')">Erneut anbieten</button>'
              + ' <button class="btn btn-ghost btn-sm" onclick="window.__kdDeclineWaitlist(\'' + e.id + '\')" style="color:var(--signal)">Entfernen</button>';
          } else {
            rightActions = '<button class="btn btn-ghost btn-sm" onclick="window.__kdDeclineWaitlist(\'' + e.id + '\')" style="color:var(--signal)">Entfernen</button>';
          }
          actions = '<span style="font-size:11px;color:var(--muted-2)">' + expLabel + '</span> ' + rightActions;
        }
        return '<tr>'
          + '<td>' + (i + 1) + '</td>'
          + '<td>' + (window.escapeHtml ? window.escapeHtml(nm) : nm) + '<div style="font-size:11px;color:var(--muted-2)">' + (window.escapeHtml ? window.escapeHtml(e.parentEmail || '') : (e.parentEmail || '')) + '</div></td>'
          + '<td>' + (window.escapeHtml ? window.escapeHtml(ch) : ch) + ageStr + '</td>'
          + '<td>' + window.__kdRelTime(e.addedAt) + '</td>'
          + '<td><span class="pill ' + pillCls + '">' + pillTxt + '</span></td>'
          + '<td style="text-align:right;white-space:nowrap">' + actions + '</td>'
          + '</tr>';
      }).join('');
      pane.innerHTML = '<div class="card"><div class="card-head">'
        + '<div class="card-title">Die <em>Warteliste</em> · ' + wlList.length + '</div>'
        + '<div style="font-size:12px;color:var(--muted-2)">Sortiert: Wartend (älteste zuerst), dann Angebote</div>'
        + '</div>'
        + '<table class="data-table"><thead><tr><th>#</th><th>Eltern</th><th>Kind</th><th>Eingegangen</th><th>Status</th><th></th></tr></thead>'
        + '<tbody>' + rows + '</tbody></table></div>';
      return;
    }

    if (key === 'finanzen') {
      var price = (a.pricing && a.pricing[0]) || {};
      var amount = price.amount || 0;
      var booked = bookings.length;
      // Storno-Konsistenz: cancelled-Bookings (payment_status='cancelled' oder b.status='cancelled') unter "Storno/Refund" zählen, nicht unter "Offen"
      var isBkCancelled = function(b) { return b.status === 'cancelled' || b.paymentStatus === 'cancelled' || b.paymentStatus === 'refunded'; };
      var paid = bookings.filter(function(b){ return b.paymentStatus === 'paid' && !isBkCancelled(b); });
      var open = bookings.filter(function(b){ return !isBkCancelled(b) && (b.paymentStatus === 'unpaid' || b.paymentStatus === 'pending'); });
      var refunded = (s.bookings || []).filter(function(b){ return b.activityId === a.id && isBkCancelled(b); });
      var sumPaid = paid.reduce(function(acc, b){ return acc + (b.amountPaid || 0); }, 0);
      var sumOpen = open.length * amount;
      var sumRef = refunded.reduce(function(acc, b){ return acc + (b.amountPaid || 0); }, 0);
      var sumPlanned = booked * amount;

      pane.innerHTML = '<div class="card" style="margin-bottom:18px;">'
        + '<div class="card-head"><div class="card-title">Kurs<em>-Finanzen</em></div></div>'
        + '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:6px 0">'
        + '<div><div class="info-label">Geplant</div><div class="info-value" style="text-align:left;font-size:18px;font-family:var(--font-heading);font-weight:700">' + window.__kdFmtMoney(sumPlanned) + '</div><div style="font-size:11px;color:var(--muted-2);margin-top:2px">' + booked + ' × ' + window.__kdFmtMoney(amount) + '</div></div>'
        + '<div><div class="info-label">Bezahlt</div><div class="info-value" style="text-align:left;font-size:18px;font-family:var(--font-heading);font-weight:700;color:var(--sage-deep)">' + window.__kdFmtMoney(sumPaid) + '</div><div style="font-size:11px;color:var(--muted-2);margin-top:2px">' + paid.length + ' Buchungen</div></div>'
        + '<div><div class="info-label">Offen</div><div class="info-value" style="text-align:left;font-size:18px;font-family:var(--font-heading);font-weight:700;color:var(--signal)">' + window.__kdFmtMoney(sumOpen) + '</div><div style="font-size:11px;color:var(--muted-2);margin-top:2px">' + open.length + ' Buchungen</div></div>'
        + '<div><div class="info-label">Storno/Refund</div><div class="info-value" style="text-align:left;font-size:18px;font-family:var(--font-heading);font-weight:700;color:var(--muted-2)">' + window.__kdFmtMoney(sumRef) + '</div><div style="font-size:11px;color:var(--muted-2);margin-top:2px">' + refunded.length + ' Buchungen</div></div>'
        + '</div></div>'
        + '<div class="card"><div class="card-head"><div class="card-title">Buchungen mit <em>Zahlungsstatus</em></div>'
        + '<a class="card-link" onclick="window.showSection(\'rechnungen\')">Zu Rechnungen →</a></div>'
        + '<table class="data-table"><thead><tr><th>Kunde</th><th>Kind</th><th>Gebucht</th><th>Betrag</th><th>Status</th></tr></thead>'
        + '<tbody>' + bookings.map(function(b){ return window.__kdRenderBookingRow(b); }).join('') + '</tbody></table></div>';
      return;
    }

    if (key === 'settings') {
      pane.innerHTML = '<div class="card"><div class="card-head"><div class="card-title">Kurs<em>-Einstellungen</em></div></div>'
        + '<div style="padding:24px 4px;display:flex;flex-direction:column;gap:16px;max-width:560px">'
        + '<div><div class="info-label">Bearbeiten</div><div style="font-size:13px;color:var(--ink-2);margin:6px 0 10px">Titel, Beschreibung, Termine, Preis, Raum, Kapazität — alles im Kurs-Creator.</div>'
        + '<button class="btn btn-primary btn-sm" onclick="window.__kdEdit()">Kurs bearbeiten →</button></div>'
        + '<div><div class="info-label">Pause</div><div style="font-size:13px;color:var(--ink-2);margin:6px 0 10px">Verbirgt den Kurs im Eltern-Widget. Bestehende Buchungen bleiben aktiv.</div>'
        + '<button class="btn btn-ghost btn-sm" onclick="window.__kdTogglePause()">' + (a.status === 'paused' ? 'Wieder aktivieren' : 'Kurs pausieren') + '</button></div>'
        + '<div><div class="info-label" style="color:var(--signal)">Gefahrenzone</div><div style="font-size:13px;color:var(--ink-2);margin:6px 0 10px">Archiviert den Kurs unwiderruflich. Bestehende Buchungen bleiben sichtbar.</div>'
        + '<button class="btn btn-ghost btn-sm" style="color:var(--signal);border-color:var(--signal)" onclick="window.__kdArchive()">Kurs archivieren</button></div>'
        + '</div></div>';
      return;
    }
  };

  window.__kdArchive = function() {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
    if (!a) return;
    var go = function() {
      fetch('/api/activities/' + a.id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
        body: JSON.stringify({ status: 'archived' }),
      }).then(function(r) {
        if (!r.ok) throw new Error('Server-Fehler');
        a.status = 'archived';
        window.showSection('kurse');
        if (window.ukcToast) window.ukcToast('Kurs archiviert');
      }).catch(function(e) { alert('Konnte nicht archivieren: ' + (e.message || e)); });
    };
    if (typeof window.ukcConfirm === 'function') {
      window.ukcConfirm({ title: 'Kurs archivieren?', body: '„' + a.title + '" wird archiviert. Bestehende Buchungen bleiben.', confirmLabel: 'Archivieren', destructive: true }).then(function(ok) { if (ok) go(); });
    } else {
      if (confirm('Kurs „' + a.title + '" archivieren?')) go();
    }
  };
window.__kdOfferSpot = async function(entryId) {
  var s = window.dashboardState; if (!s) return;
  var go = async function() {
    try {
      var resp = await fetch('/api/waitlist/' + entryId + '/offer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
      });
      if (!resp.ok) {
        var err = await resp.json().catch(function() { return {}; });
        throw new Error(err.error || ('HTTP ' + resp.status));
      }
      // Update local cache: mark this entry as offered
      var wlList = (s.waitlistByActivity && s.waitlistByActivity[window.__kdActiveId]) || [];
      var entry = wlList.find(function(e) { return e.id === entryId; });
      if (entry) {
        entry.status = 'offered';
        entry.notifiedAt = new Date().toISOString();
        entry.expiresAt = new Date(Date.now() + 3*60*60*1000).toISOString();
      }
      window.__kdRender();
      if (window.ukcToast) window.ukcToast('Platz angeboten · E-Mail an Eltern raus');
    } catch (e) {
      alert('Fehler: ' + (e.message || e));
    }
  };
  if (typeof window.ukcConfirm === 'function') {
    window.ukcConfirm({
      title: 'Platz anbieten?',
      body: 'Wir schicken eine E-Mail mit Buchungslink. Die Eltern haben <strong>3 Stunden</strong>, um zuzusagen — danach geht das Angebot automatisch an die nächste Familie auf der Warteliste.',
      confirmLabel: 'Anbieten',
    }).then(function(ok) { if (ok) go(); });
  } else {
    if (confirm('Platz anbieten? E-Mail geht raus, Eltern haben 3 Stunden zum Zusagen.')) go();
  }
};

window.__kdDeclineWaitlist = async function(entryId) {
  var s = window.dashboardState; if (!s) return;
  var go = async function() {
    try {
      var resp = await fetch('/api/waitlist/' + entryId + '/decline', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
      });
      if (!resp.ok) {
        var err = await resp.json().catch(function() { return {}; });
        throw new Error(err.error || ('HTTP ' + resp.status));
      }
      // Remove from local cache
      var wlList = (s.waitlistByActivity && s.waitlistByActivity[window.__kdActiveId]) || [];
      s.waitlistByActivity[window.__kdActiveId] = wlList.filter(function(e) { return e.id !== entryId; });
      window.__kdRender();
      if (window.ukcToast) window.ukcToast('Aus Warteliste entfernt');
    } catch (e) {
      alert('Fehler: ' + (e.message || e));
    }
  };
  if (typeof window.ukcConfirm === 'function') {
    window.ukcConfirm({
      title: 'Aus Warteliste entfernen?',
      body: 'Der Eintrag wird gelöscht. Die Eltern bekommen keine Benachrichtigung.',
      confirmLabel: 'Entfernen',
      destructive: true,
    }).then(function(ok) { if (ok) go(); });
  } else {
    if (confirm('Aus Warteliste entfernen?')) go();
  }
};

window.__kdCancelSession = async function(sessionId) {
  if (!sessionId) { alert('Diese Stunde liegt noch nicht als Datensatz vor — speichere den Block oder warte auf den Sync.'); return; }
  var s = window.dashboardState; if (!s) return;
  var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
  if (!a) return;
  var enrolledCount = (s.bookings || []).filter(function(b) {
    return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
  }).length;

  var bodyHtml =
      '<p style="margin:0 0 12px;color:var(--ink-2);line-height:1.55">Wir markieren den Termin als <strong>abgesagt</strong> und schreiben den ' + enrolledCount + ' eingebuchten Familie' + (enrolledCount === 1 ? '' : 'n') + ' automatisch ein <strong>Credit</strong> gut. Mit dem Credit können sie den Termin in einer anderen Add-Up-Stunde nachholen.</p>'
    + '<label style="display:block;font-size:12px;color:var(--muted-2);margin:14px 0 4px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase">Grund (optional)</label>'
    + '<textarea id="phKdCancelReason" placeholder="z.B. krankheitsbedingt, Wetter, Trainerin verhindert" style="width:100%;min-height:70px;padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:13px;resize:vertical"></textarea>';

  var go = async function(reason) {
    try {
      var resp = await fetch('/api/sessions/' + sessionId + '/cancel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
        body: JSON.stringify({ reason: reason || '', compensation: 'credit', cancelledBy: 'provider' }),
      });
      if (!resp.ok) {
        var err = await resp.json().catch(function() { return {}; });
        throw new Error(err.error || ('HTTP ' + resp.status));
      }
      // Drop session cache so next render reloads fresh (with status=cancelled)
      delete (window.__kdSessionsCache || {})[a.id];
      // Reload deps and re-render
      await window.__kdLoadDeps(a.id);
      window.__kdRender();
      var ov = document.querySelectorAll('.ukc-detail-overlay');
      ov.forEach(function(x){ x.remove(); });
      if (window.ukcToast) window.ukcToast('Termin abgesagt · Credits gutgeschrieben');
    } catch (e) {
      alert('Fehler: ' + (e.message || e));
    }
  };

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Termin absagen',
      titleHtml: 'Diese Stunde <em>absagen</em>?',
      rows: [],
      bodyExtraHtml: bodyHtml,
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>'
        + ' <button class="btn btn-primary btn-sm" style="background:var(--signal)" id="phKdCancelGo">Absagen & Credits gutschreiben</button>',
    });
    setTimeout(function() {
      var btn = document.getElementById('phKdCancelGo');
      if (btn) btn.addEventListener('click', function() {
        var rEl = document.getElementById('phKdCancelReason');
        var reason = rEl ? rEl.value.trim() : '';
        btn.disabled = true; btn.textContent = 'Sende…';
        go(reason);
      });
    }, 50);
  } else {
    if (confirm(enrolledCount + ' Familien werden ein Credit bekommen. Wirklich absagen?')) {
      go('');
    }
  }
};



window.__kdRescheduleSession = async function(sessionId, currentDateIso, currentTime) {
  if (!sessionId) { alert('Diese Stunde liegt noch nicht als Datensatz vor — speichere den Block oder warte auf den Sync.'); return; }
  var s = window.dashboardState; if (!s) return;
  var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
  if (!a) return;
  var enrolledCount = (s.bookings || []).filter(function(b) {
    return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
  }).length;

  // Compute min date = tomorrow (no past, no today since same-day reschedule unusual)
  var today = new Date();
  var tomorrow = new Date(today.getTime() + 24*60*60*1000);
  var minIso = tomorrow.toISOString().slice(0, 10);
  // Default value = currentDate + 7 days (one week shift) as starting suggestion
  var defaultDate = currentDateIso || minIso;
  try {
    var cd = new Date(currentDateIso + 'T12:00:00');
    cd.setDate(cd.getDate() + 7);
    defaultDate = cd.toISOString().slice(0, 10);
    if (defaultDate < minIso) defaultDate = minIso;
  } catch(e) {}

  var fmtDE = function(iso) { var p = (iso||'').split('-'); return p.length === 3 ? (p[2]+'.'+p[1]+'.'+p[0]) : iso; };

  var bodyHtml =
      '<p style="margin:0 0 14px;color:var(--ink-2);line-height:1.55">Termin <strong>' + fmtDE(currentDateIso) + (currentTime ? ' um '+currentTime : '') + '</strong> auf neues Datum verschieben.'
      + (enrolledCount > 0 ? ' <strong>' + enrolledCount + '</strong> eingebuchte Familie' + (enrolledCount === 1 ? '' : 'n') + ' bekommt automatisch eine E-Mail mit dem neuen Datum.' : '')
      + '</p>'
    + '<label style="display:block;font-size:12px;color:var(--muted-2);margin:14px 0 6px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase">Neues Datum</label>'
    + '<input type="date" id="phKdReschedDate" min="' + minIso + '" value="' + defaultDate + '" style="width:100%;padding:11px 12px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:14px">'
    + '<div id="phKdReschedHint" style="margin-top:10px;font-size:12px;color:var(--muted-2);line-height:1.4">Die Uhrzeit bleibt gleich (' + (currentTime || '–') + '). Eltern bekommen eine Erinnerung per E-Mail.</div>';

  var go = async function(newDate) {
    try {
      var resp = await fetch('/api/sessions/' + sessionId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
        body: JSON.stringify({ date: newDate }),
      });
      if (!resp.ok) {
        var err = await resp.json().catch(function() { return {}; });
        throw new Error(err.error || ('HTTP ' + resp.status));
      }
      // Drop session cache → next render reloads fresh
      delete (window.__kdSessionsCache || {})[a.id];
      try { await window.__kdLoadDeps(a.id); } catch(_) {}
      try { window.__kdRender(); } catch(_) {}
      // Auch Kalender refreshen falls Loader vorhanden
      try { if (window.sectionLoaders && typeof window.sectionLoaders.dashboard === 'function') window.sectionLoaders.dashboard(); } catch(_) {}
      var ov = document.querySelectorAll('.ukc-detail-overlay');
      ov.forEach(function(x){ x.remove(); });
      var msg = 'Termin verschoben auf ' + fmtDE(newDate);
      if (enrolledCount > 0) msg += ' · ' + enrolledCount + ' Familie' + (enrolledCount === 1 ? '' : 'n') + ' benachrichtigt';
      if (window.ukcToast) window.ukcToast(msg, 'success');
    } catch (e) {
      alert('Fehler: ' + (e.message || e));
    }
  };

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Termin verschieben',
      titleHtml: 'Diese Stunde <em>verschieben</em>?',
      rows: [],
      bodyExtraHtml: bodyHtml,
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>'
        + ' <button class="btn btn-primary btn-sm" id="phKdReschedGo">Verschieben & informieren</button>',
    });
    setTimeout(function() {
      var btn = document.getElementById('phKdReschedGo');
      var input = document.getElementById('phKdReschedDate');
      if (btn && input) {
        btn.addEventListener('click', function() {
          var newDate = input.value;
          if (!newDate || !/^\d{4}-\d{2}-\d{2}$/.test(newDate)) { alert('Bitte ein gültiges Datum wählen.'); return; }
          if (newDate < minIso) { alert('Datum darf nicht in der Vergangenheit liegen.'); return; }
          if (newDate === currentDateIso) { alert('Das ist das aktuelle Datum — bitte ein anderes wählen.'); return; }
          btn.disabled = true; btn.textContent = 'Wird gespeichert…';
          go(newDate);
        });
        // Also update hint to show new weekday
        input.addEventListener('change', function() {
          var hint = document.getElementById('phKdReschedHint');
          if (!hint) return;
          var d = new Date(input.value + 'T12:00:00');
          var dayLabels = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];
          var newWeekday = dayLabels[d.getDay()];
          hint.innerHTML = 'Neuer Termin: <strong>' + newWeekday + ', ' + fmtDE(input.value) + (currentTime ? ' um ' + currentTime + ' Uhr' : '') + '</strong>. Eltern werden per E-Mail benachrichtigt.';
        });
      }
    }, 50);
  } else {
    var newDate = prompt('Neues Datum (YYYY-MM-DD):', defaultDate);
    if (newDate) go(newDate);
  }
};

window.__kdShowSession = async function(itemJson) {
  var item;
  try { item = JSON.parse(itemJson); } catch(e) { return; }
  var s = window.dashboardState; if (!s) return;
  var a = (s.activities || []).find(function(x){ return x.id === window.__kdActiveId; });
  if (!a) return;
  // I5: TZ-anchor at noon to avoid UTC-midnight rollover (Date 'YYYY-MM-DD' parses as UTC,
  // dann lokal verschoben → kann auf den Vortag fallen in westlichen TZs).
  var rawDate = typeof item.date === 'string' ? item.date : (item.date && item.date.toISOString ? item.date.toISOString() : '');
  var d = rawDate.length >= 10 ? new Date(rawDate.slice(0, 10) + 'T12:00:00') : new Date(item.date);
  var dayLabelsLong = ['Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag','Sonntag'];
  var months = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
  var dayIdx = (d.getDay() + 6) % 7;
  var dateLabel = dayLabelsLong[dayIdx] + ', ' + d.getDate() + '. ' + months[d.getMonth()] + ' ' + d.getFullYear();
  var st = (item.startTime || '').slice(0,5);
  var et = (item.endTime || '').slice(0,5);
  var timeLabel = st + (et ? '–' + et : '');
  var roomLabel = (window.__kalRoomName ? window.__kalRoomName(a.roomId) : null) || a.roomName || (a.roomId ? '—' : 'Kein Raum');
  var now = new Date(); now.setHours(0,0,0,0);
  var isPast = d < now;
  var isCancelled = item.status === 'cancelled';

  // Zusatz-Termin (isExtra) → existierende Block-Enrollments NICHT auto-zuweisen.
  // Provider muss bewusst Teilnehmer hinzufügen (z. B. Add-Up / Makeup-Buchung).
  var isExtraSess = item.isExtra === true || item.is_extra === true;
  // Enrolled participants (current bookings for this activity), nur für reguläre Termine
  var bookings = isExtraSess ? [] : (s.bookings || []).filter(function(b) {
    return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
  });

  // Attendance-Records für DIESE Session laden — zeigt wer krank/eingecheckt/Add-Up ist
  var attendanceRecs = [];
  var addUpMeta = { freeAddUpSlots: 0, usedAddUpSlots: 0, availableCredits: 0 };
  if (item.id && typeof s.api === 'function') {
    try {
      var attRes = await s.api('/sessions/' + item.id + '/attendance');
      attendanceRecs = (attRes && attRes.data) || [];
      if (attRes && attRes.meta) addUpMeta = attRes.meta;
    } catch(e) { console.warn('[kdShowSession] attendance fetch failed:', e); }
  }
  // Map per parent_id → status
  var attByParent = {};
  attendanceRecs.forEach(function(rec) {
    if (rec.parent_id) attByParent[rec.parent_id] = rec;
  });
  // Status-Label-Helper
  function attendanceLabel(status, isMakeup) {
    if (isMakeup) return { txt: 'Add-Up', bg: 'rgba(217,108,69,0.16)', color: '#D96C45' };
    switch (status) {
      case 'attended':
      case 'present':           return { txt: 'Eingecheckt', bg: 'rgba(106,120,99,0.18)', color: '#4A5546' };
      case 'cancelled_excused': return { txt: 'Krank gemeldet', bg: 'rgba(217,108,69,0.14)', color: '#B8392A' };
      case 'cancelled_late':    return { txt: 'Kurzfristig abgesagt', bg: 'rgba(184,57,42,0.16)', color: '#B8392A' };
      case 'absent_unexcused':  return { txt: 'Nicht erschienen', bg: 'rgba(184,57,42,0.16)', color: '#B8392A' };
      default: return null;
    }
  }

  var statusBadge = '';
  if (isCancelled) statusBadge = '<span class="pill" style="background:var(--signal-tint);color:var(--signal)">Abgesagt</span>';
  else if (isPast) statusBadge = '<span class="pill" style="background:var(--sage-tint);color:var(--sage-deep)">Erledigt</span>';
  else statusBadge = '<span class="pill pill-ok">Geplant</span>';

  // Effektive Teilnehmer-Anzahl für DIESE Session
  //  - regulär: enrolled (Block-Buchungen) minus Krankmeldungen + Add-Ups
  //  - Zusatz-Termin: nur explizit hinzugefügte Records (expected/attended) + Add-Ups
  var sickCount = attendanceRecs.filter(function(r){ return (r.status === 'cancelled_excused' || r.status === 'cancelled_late' || r.status === 'absent_unexcused' || r.status === 'absent_sick') && !r.is_makeup; }).length;
  var addUpCount = addUpMeta.usedAddUpSlots || 0;
  var expectedCount = attendanceRecs.filter(function(r){ return !r.is_makeup && (r.status === 'expected' || r.status === 'attended' || r.status === 'present'); }).length;
  var effectivePresent = isExtraSess
    ? Math.max(0, expectedCount + addUpCount)
    : Math.max(0, bookings.length - sickCount + addUpCount);
  var capStr = (a.capacity || '?');
  var teilnehmerVal = effectivePresent + '/' + capStr + ' anwesend';
  var teilnehmerHints = [];
  if (sickCount > 0) teilnehmerHints.push(sickCount + ' krank');
  if (addUpCount > 0) teilnehmerHints.push(addUpCount + ' Add-Up');
  if (!isExtraSess && bookings.length !== effectivePresent) teilnehmerHints.push(bookings.length + ' im Block');
  if (isExtraSess) teilnehmerHints.push('Zusatz-Termin');
  var teilnehmerSub = teilnehmerHints.length ? ' <span style="color:var(--muted-2);font-size:11.5px;font-weight:500">· ' + teilnehmerHints.join(' · ') + '</span>' : '';

  var stundeLabel = isExtraSess
    ? 'Nr. ' + (item.num || '?') + ' · Zusatz-Termin'
    : 'Nr. ' + (item.num || '?') + ' · ' + (item.isReal ? 'aus Block' : 'berechnet');
  var rows = [
    { label: 'Stunde', val: stundeLabel },
    { label: 'Wann', val: dateLabel + (timeLabel ? ' · ' + timeLabel : '') },
    { label: 'Raum', val: roomLabel },
    { label: 'Status', html: statusBadge },
    { label: 'Teilnehmer', html: teilnehmerVal + teilnehmerSub },
  ];
  if (item.cancellationReason) rows.push({ label: 'Absage-Grund', val: item.cancellationReason });

  // Add-Up-Slot Hinweis-Box wenn freie Slots wegen Krankmeldung
  var addUpHtml = '';
  if (addUpMeta.freeAddUpSlots > 0) {
    var slotLabel = addUpMeta.freeAddUpSlots === 1 ? '1 Add-Up-Platz frei' : addUpMeta.freeAddUpSlots + ' Add-Up-Plätze frei';
    addUpHtml = '<div style="margin-top:14px;padding:12px 14px;background:rgba(217,108,69,0.10);border:1px solid rgba(217,108,69,0.22);border-radius:12px;display:flex;align-items:center;gap:12px;font-size:13px">'
      + '<div style="width:32px;height:32px;border-radius:50%;background:var(--primary,#D96C45);color:#FBF5EA;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0">+</div>'
      + '<div style="flex:1"><strong>' + slotLabel + '</strong><div style="color:var(--muted-2);font-size:12px;margin-top:2px">Wegen Krankmeldung — du kannst eine andere Familie als Add-Up einladen.</div></div>'
      + '<button class="btn btn-ghost btn-sm" onclick="window.__assignAddUpFromSession(\'' + (item.id || '') + '\',\'' + (a.id || '') + '\')">Vergeben</button>'
      + '</div>';
  }

  // Participants list HTML — mit Attendance-Status-Badges
  var partsHtml = '';
  // Extra-Session Add-Button: erlaubt Provider, Block-Enrollments gezielt einzubuchen
  var extraAddBtn = '';
  if (isExtraSess && !isPast && !isCancelled && item.id) {
    extraAddBtn = '<button class="btn btn-primary btn-sm" style="margin-left:auto" onclick="window.__kdAddSessionAttendee(\'' + (item.id || '') + '\',\'' + (item.blockId || '') + '\',\'' + (a.id || '') + '\')">+ Teilnehmer hinzufügen</button>';
  }
  function renderAttendeeRow(opts) {
    var nm = opts.parentName || '—';
    var ch = opts.childName || '—';
    var lbl = opts.status ? attendanceLabel(opts.status, opts.isMakeup) : null;
    var statusPill = lbl
      ? '<span class="pill" style="background:' + lbl.bg + ';color:' + lbl.color + ';font-size:11px;margin-left:8px">' + lbl.txt + '</span>'
      : '';
    var removeBtn = '';
    if (opts.canRemove && opts.attendanceId && opts.enrollmentId && opts.sessionId) {
      removeBtn = ' <a class="card-link" style="font-size:12px;flex-shrink:0;color:var(--signal)" onclick="window.__kdRemoveSessionAttendee(\'' + opts.sessionId + '\',\'' + opts.enrollmentId + '\')">Entfernen</a>';
    }
    var profileLink = opts.parentId
      ? '<a class="card-link" style="font-size:12px;flex-shrink:0" onclick="this.closest(\'.ukc-detail-overlay\').remove();window.__kdShowParent(\'' + opts.parentId + '\')">Profil →</a>'
      : '';
    return '<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px dashed var(--border);font-size:13px;gap:8px">'
      + '<div style="flex:1;min-width:0"><strong>' + (window.escapeHtml ? window.escapeHtml(nm) : nm) + '</strong>'
      + '<span style="color:var(--muted-2);margin-left:8px">' + (window.escapeHtml ? window.escapeHtml(ch) : ch) + '</span>'
      + statusPill
      + '</div>'
      + profileLink + removeBtn
      + '</div>';
  }

  if (isExtraSess) {
    // Zusatz-Termin: rendere die Attendance-Records selbst (nur die, die zählen oder explizit annulliert sind)
    var visibleRecs = attendanceRecs.filter(function(r){
      // alles außer pure 'expected' nach Stornierungs-Cleanup zeigen
      return r.status !== 'removed';
    });
    var headRow = '<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">'
      + '<div class="info-label" style="margin:0">Teilnehmer · ' + visibleRecs.length + '</div>'
      + extraAddBtn
      + '</div>';
    var bodyRows = '';
    if (visibleRecs.length === 0) {
      bodyRows = '<div style="padding:14px 16px;background:rgba(217,108,69,0.08);border:1px solid rgba(217,108,69,0.18);border-radius:12px;font-size:13px;color:var(--ink-2);line-height:1.5">'
        + '<strong>Zusatz-Termin außerhalb des gebuchten Block-Umfangs.</strong> '
        + 'Die regulären Block-Eltern sind hier nicht automatisch dabei — sie haben für diesen Termin nicht bezahlt. '
        + 'Klick auf <em>+ Teilnehmer hinzufügen</em> um gezielt eine Familie aus dem Block einzubuchen.'
        + '</div>';
    } else {
      bodyRows = visibleRecs.map(function(r){
        return renderAttendeeRow({
          parentId: r.parent_id,
          parentName: r.parent_name,
          childName: r.child_name,
          status: r.status,
          isMakeup: r.is_makeup,
          attendanceId: r.id,
          enrollmentId: r.enrollment_id,
          sessionId: item.id,
          canRemove: !isPast && r.status === 'expected' && !r.is_makeup,
        });
      }).join('');
    }
    partsHtml = addUpHtml
      + '<div style="margin-top:18px;border-top:1px solid var(--border);padding-top:16px">'
      + headRow + bodyRows
      + '</div>';
  } else if (bookings.length > 0) {
    partsHtml = addUpHtml
      + '<div style="margin-top:18px;border-top:1px solid var(--border);padding-top:16px">'
      + '<div class="info-label" style="margin-bottom:10px">Teilnehmer · ' + bookings.length + '</div>'
      + bookings.map(function(b) {
        var pid = b.parentId || (b.customer && b.customer.id);
        var rec = pid ? attByParent[pid] : null;
        return renderAttendeeRow({
          parentId: pid,
          parentName: b.customerName || (b.customer && b.customer.name) || '—',
          childName: (b.child && b.child.name) || ((b.child && b.child.firstName) ? (b.child.firstName + ' ' + (b.child.lastName || '')).trim() : '—'),
          status: rec && rec.status,
          isMakeup: rec && rec.is_makeup,
          canRemove: false,
        });
      }).join('') + '</div>';
  } else if (addUpHtml) {
    partsHtml = addUpHtml;
  }

  var titleHtml = (window.escapeHtml ? window.escapeHtml(a.title) : a.title) + ' · <em>Stunde ' + (item.num || '?') + '</em>';

  var actions = '';
  if (!isPast && !isCancelled && item.id) {
    var dateIso = (item.date || '').slice(0, 10);
    var stShort = (item.startTime || '').slice(0, 5);
    actions = '<button class="btn btn-ghost btn-sm" onclick="window.__kdRescheduleSession(\'' + (item.id || '') + '\',\'' + dateIso + '\',\'' + stShort + '\')">Verschieben</button>'
      + ' <button class="btn btn-ghost btn-sm" style="color:var(--signal)" onclick="window.__kdCancelSession(\'' + (item.id || '') + '\')">Absagen</button>';
  } else if (isPast && !isCancelled && item.id) {
    actions = '<button class="btn btn-ghost btn-sm" onclick="alert(\'Anwesenheit prüfen — folgt im nächsten Sprint (QR-Check-In)\')">Anwesenheit</button>';
  }
  var closeBtn = '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>';

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Termin · ' + (a.category || ''),
      titleHtml: titleHtml,
      rows: rows,
      bodyExtraHtml: partsHtml,
      footerHtml: actions + ' ' + closeBtn,
    });
  } else {
    alert(a.title + ' — ' + dateLabel + ' · ' + timeLabel);
  }
};

// ----- Add-Up vergeben: Modal mit Parent-Selector -----
// Zusatz-Termin: Familie aus diesem Block gezielt für DIESE Session einbuchen
window.__kdAddSessionAttendee = async function(sessionId, blockId, activityId) {
  var s = window.dashboardState; if (!s || !s.api) return;
  if (!sessionId || !blockId) { alert('Session/Block-ID fehlt'); return; }
  // Active enrollments für diesen Block laden + Attendance-Records, um Duplikate auszuschließen
  var enrolls = [];
  var existingEnrIds = new Set();
  try {
    var [er, ar] = await Promise.all([
      s.api('/course-blocks/' + blockId + '/enrollments'),
      s.api('/sessions/' + sessionId + '/attendance'),
    ]);
    enrolls = ((er && er.data) || []).filter(function(e){ return e && e.status === 'active'; });
    ((ar && ar.data) || []).forEach(function(a){ if (a && a.enrollment_id) existingEnrIds.add(a.enrollment_id); });
  } catch (e) {
    alert('Konnte Block-Buchungen nicht laden: ' + (e.message || e));
    return;
  }

  // Modal
  var ov = document.createElement('div');
  ov.className = 'ukc-detail-overlay';
  var rows = enrolls.length === 0
    ? '<div style="padding:18px;text-align:center;color:var(--muted-2);font-size:13px">Noch keine aktiven Buchungen in diesem Block.</div>'
    : enrolls.map(function(e) {
        var nm = e.parentName || e.parent_name || '—';
        var ch = e.childName || e.child_name || '—';
        var age = e.childAge != null ? ' (' + e.childAge + ' J.)' : '';
        var already = existingEnrIds.has(e.id);
        var btn = already
          ? '<span class="pill" style="background:var(--sage-tint);color:var(--sage-deep);font-size:11px">Bereits dabei</span>'
          : '<button class="btn btn-primary btn-sm" data-eid="' + e.id + '">Hinzufügen</button>';
        return '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 4px;border-bottom:1px dashed var(--border);font-size:13px;gap:10px">'
          + '<div style="flex:1;min-width:0"><strong>' + (window.escapeHtml ? window.escapeHtml(nm) : nm) + '</strong>'
          + '<span style="color:var(--muted-2);margin-left:8px">' + (window.escapeHtml ? window.escapeHtml(ch) : ch) + age + '</span>'
          + '</div>'
          + btn
          + '</div>';
      }).join('');
  ov.innerHTML = '<div class="ukc-detail-card" role="dialog" aria-modal="true" style="max-width:560px">'
    + '<div class="ukc-detail-head">'
    +   '<div class="ukc-detail-kicker">Zusatz-Termin</div>'
    +   '<h2 class="ukc-detail-title">Teilnehmer <em>einbuchen</em></h2>'
    +   '<button class="ukc-detail-close" aria-label="Schließen">×</button>'
    + '</div>'
    + '<div class="ukc-detail-msg" style="font-size:13px;color:var(--ink-2);line-height:1.5">Familien aus diesem Block — wer für diesen Zusatz-Termin teilnehmen soll, klick auf <em>Hinzufügen</em>. Sie sehen den Termin im Eltern-Portal als Add-On.</div>'
    + '<div style="padding:8px 24px 4px">' + rows + '</div>'
    + '<div class="ukc-detail-foot">'
    +   '<button class="btn btn-ghost btn-sm" data-cancel>Schließen</button>'
    + '</div>'
    + '</div>';
  function cleanup() { ov.remove(); document.removeEventListener('keydown', onKey); }
  function onKey(ev) { if (ev.key === 'Escape') cleanup(); }
  ov.querySelector('[data-cancel]').addEventListener('click', cleanup);
  ov.querySelector('.ukc-detail-close').addEventListener('click', cleanup);
  ov.addEventListener('click', function(ev) { if (ev.target === ov) cleanup(); });
  document.addEventListener('keydown', onKey);
  // Wire add buttons
  ov.querySelectorAll('button[data-eid]').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var eid = btn.getAttribute('data-eid');
      btn.disabled = true; btn.textContent = '…';
      try {
        await s.api('/sessions/' + sessionId + '/attendees', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ enrollmentId: eid }),
        });
        if (window.ukcToast) window.ukcToast('Familie zum Zusatz-Termin hinzugefügt');
        cleanup();
        // Cache leeren + Sessions refresh + Modal neu öffnen
        if (window.__kdSessionsCache) delete window.__kdSessionsCache[activityId];
        if (typeof window.__kdLoadDeps === 'function') await window.__kdLoadDeps(activityId);
        // Re-open the session detail with refreshed data
        var refreshed = (window.__kdSessionsCache && window.__kdSessionsCache[activityId] || []).find(function(x){ return x.id === sessionId; });
        if (refreshed && typeof window.__kdShowSession === 'function') {
          // I5: keep raw 'YYYY-MM-DD' string — Date-roundtrip via toISOString shifted day in non-UTC TZs
          var asItem = {
            id: refreshed.id, blockId: refreshed.__blockId,
            date: refreshed.date, num: refreshed.sessionNumber,
            startTime: refreshed.startTime, endTime: refreshed.endTime,
            status: refreshed.status,
            cancelledCount: refreshed.cancelledCount, addUpUsedCount: refreshed.addUpUsedCount,
            expectedCount: refreshed.expectedCount,
            isExtra: refreshed.isExtra === true || refreshed.is_extra === true, isReal: true,
          };
          window.__kdShowSession(JSON.stringify(asItem));
        }
        if (window.__kdActiveTab && typeof window.__kdRenderTab === 'function') window.__kdRenderTab(window.__kdActiveTab);
      } catch (e) {
        btn.disabled = false; btn.textContent = 'Hinzufügen';
        alert('Fehler: ' + (e.message || e));
      }
    });
  });
  document.body.appendChild(ov);
  requestAnimationFrame(function() { ov.classList.add('in'); });
};

// Zusatz-Termin: Familie wieder austragen (nur status='expected' Records)
window.__kdRemoveSessionAttendee = async function(sessionId, enrollmentId) {
  var s = window.dashboardState; if (!s || !s.api) return;
  var ok = await (window.ukcConfirm ? window.ukcConfirm({ title: 'Familie austragen?', message: 'Die Familie wird vom Zusatz-Termin entfernt.', okLabel: 'Austragen', variant: 'danger' }) : Promise.resolve(confirm('Familie vom Termin entfernen?')));
  if (!ok) return;
  try {
    await s.api('/sessions/' + sessionId + '/attendees/' + enrollmentId, { method: 'DELETE' });
    if (window.ukcToast) window.ukcToast('Familie vom Termin entfernt');
    var ov = document.querySelector('.ukc-detail-overlay'); if (ov) ov.remove();
    var aId = window.__kdActiveId;
    if (window.__kdSessionsCache && aId) delete window.__kdSessionsCache[aId];
    if (typeof window.__kdLoadDeps === 'function' && aId) await window.__kdLoadDeps(aId);
    if (window.__kdActiveTab && typeof window.__kdRenderTab === 'function') window.__kdRenderTab(window.__kdActiveTab);
  } catch (e) {
    alert('Fehler: ' + (e.message || e));
  }
};

window.__assignAddUpFromSession = async function(sessionId, activityId) {
  var s = window.dashboardState; if (!s || !s.provider) return;
  if (!sessionId) { alert('Session-ID fehlt'); return; }

  // Modal-Skeleton
  var overlay = document.createElement('div');
  overlay.className = 'mf-backdrop';
  overlay.style.cssText = 'position:fixed;inset:0;z-index:1000;background:rgba(31,29,24,0.55);display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.onclick = function(ev) { if (ev.target === overlay) overlay.remove(); };
  overlay.innerHTML = '<div class="mf-card" style="background:var(--surface);border-radius:18px;max-width:560px;width:100%;max-height:80vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,0,0,.18)">'
    + '<div style="padding:22px 24px 14px;border-bottom:1px solid var(--border)">'
    + '<div class="mf-kicker" style="text-transform:uppercase;font-size:11px;letter-spacing:.08em;color:var(--muted-2);margin-bottom:6px">Add-Up vergeben</div>'
    + '<div style="font-family:var(--font-heading);font-size:20px">Familie auswählen</div>'
    + '<div style="font-size:13px;color:var(--muted-2);margin-top:4px">Eltern mit verfügbarem Credit erscheinen hier. Mit einem Klick buchst du sie als Add-Up in diesen Termin.</div>'
    + '</div>'
    + '<div id="addUpListBody" style="overflow-y:auto;padding:10px 0;flex:1"><div style="padding:30px;text-align:center;color:var(--muted-2);font-size:13px">Lade Familien mit Credit …</div></div>'
    + '<div style="padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px">'
    + '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.mf-backdrop\').remove()">Schließen</button>'
    + '</div></div>';
  document.body.appendChild(overlay);

  var listBody = document.getElementById('addUpListBody');
  try {
    var resp = await s.api('/providers/' + s.provider.id + '/available-credits');
    var credits = (resp && resp.data) || [];
    if (!credits.length) {
      listBody.innerHTML = '<div style="padding:30px;text-align:center;color:var(--muted-2);font-size:13px">Aktuell hat keine Familie offene Credits. Sobald jemand sich rechtzeitig krank meldet, erscheinen die Credits hier.</div>';
      return;
    }
    var rows = credits.map(function(c) {
      var nm = (window.escapeHtml ? window.escapeHtml(c.parentName) : c.parentName);
      var ch = (window.escapeHtml ? window.escapeHtml(c.childName) : c.childName);
      var cid = c.creditId || '';
      var sub = (c.activityType ? c.activityType : '') + (c.validUntil ? ' · gültig bis ' + (c.validUntil.split('T')[0]) : '');
      return '<button class="addup-row" data-credit-id="' + cid + '" data-session-id="' + sessionId + '" '
        + 'style="display:flex;align-items:center;gap:14px;width:100%;padding:14px 24px;border:none;background:transparent;text-align:left;cursor:pointer;border-bottom:1px solid var(--border)" '
        + 'onmouseover="this.style.background=\'var(--surface-2,#FBF5EA)\'" onmouseout="this.style.background=\'transparent\'" '
        + 'onclick="window.__assignAddUpExecute(this)">'
        + '<div style="width:36px;height:36px;border-radius:50%;background:var(--primary-tint,#F5E5D9);color:var(--primary-hover,#B4523A);display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0">' + (nm ? nm.charAt(0).toUpperCase() : '?') + '</div>'
        + '<div style="flex:1;min-width:0"><div style="font-weight:600;font-size:14px">' + nm + '</div><div style="font-size:12px;color:var(--muted-2)">' + ch + (sub ? ' · ' + sub : '') + '</div></div>'
        + '<div style="font-size:12px;color:var(--primary-hover,#B4523A);font-weight:600">Vergeben →</div>'
        + '</button>';
    }).join('');
    listBody.innerHTML = rows;
  } catch (e) {
    listBody.innerHTML = '<div style="padding:30px;text-align:center;color:var(--signal,#B4523A);font-size:13px">Fehler beim Laden: ' + (e.message || e) + '</div>';
  }
};

window.__assignAddUpExecute = async function(btn) {
  var s = window.dashboardState; if (!s) return;
  var creditId = btn.getAttribute('data-credit-id');
  var sessionId = btn.getAttribute('data-session-id');
  if (!creditId || !sessionId) return;
  // Disable & show loader
  btn.disabled = true;
  btn.style.opacity = '0.6';
  btn.innerHTML = '<div style="padding:6px 12px;font-size:13px;color:var(--muted-2)">Buche …</div>';
  try {
    var resp = await s.api('/credits/' + creditId + '/book-makeup', {
      method: 'POST',
      body: JSON.stringify({ targetSessionId: sessionId, bookedBy: 'provider' }),
    });
    if (resp && resp.error) throw new Error(resp.error);
    // Success: close add-up modal + close session modal + refresh
    var addUpOverlay = document.querySelector('.mf-backdrop');
    if (addUpOverlay) addUpOverlay.remove();
    var sessOverlay = document.querySelector('.ukc-detail-overlay');
    if (sessOverlay) sessOverlay.remove();
    if (typeof window.toast === 'function') window.toast('Add-Up vergeben — Familie wurde benachrichtigt', 'success');
    else alert('Add-Up vergeben.');
    if (typeof window.refreshDashboardCards === 'function') window.refreshDashboardCards();
    if (typeof window.renderWeekGlance === 'function') window.renderWeekGlance();
  } catch (e) {
    btn.disabled = false;
    btn.style.opacity = '1';
    alert('Fehler: ' + (e.message || e));
  }
};

window.__kdShowParent = async function(parentId) {
  var s = window.dashboardState; if (!s || !parentId) return;
  // Open empty modal first, then hydrate
  var loadingHtml = '<div style="padding:32px;text-align:center;color:var(--muted-2)">Lade Profil…</div>';
  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Kunde',
      titleHtml: 'Profil <em>laden…</em>',
      rows: [],
      bodyExtraHtml: loadingHtml,
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>',
    });
  }
  // Fetch parent details — try /api/parents/:id, fallback to inline data
  var parent = null;
  try {
    var r = await s.api('/parents/' + parentId);
    parent = r.data || r.parent || r || null;
  } catch (e) {}
  // All bookings of this parent (we have them in state already)
  var allBookings = (s.bookings || []).filter(function(b) { return b && (b.parentId === parentId || (b.customer && b.customer.id === parentId)); });
  // Map activityId -> activity title
  var actMap = {};
  (s.activities || []).forEach(function(a) { actMap[a.id] = a; });

  var name = (parent && parent.name) || (allBookings[0] && allBookings[0].customerName) || '—';
  var email = (parent && parent.email) || (allBookings[0] && allBookings[0].customerEmail) || '—';
  var phone = (parent && parent.phone) || (allBookings[0] && (allBookings[0].customer && allBookings[0].customer.phone)) || '—';

  // Children: Stammdaten (parent.children) + abgeleitete aus bookings.child_info
  var stammdatenChildren = (parent && Array.isArray(parent.children)) ? parent.children : [];
  // Map of stammdaten by lower-cased name+birthYear key for quick lookup
  function _ckKey(c) {
    var fn = (c.firstName || (c.name||'').split(' ')[0] || '').toLowerCase().trim();
    var by = c.birthYear || c.birth_year || '';
    return fn + '|' + by;
  }
  var stammIdx = {};
  stammdatenChildren.forEach(function(c, i) { stammIdx[_ckKey(c)] = i; });
  // Derived from bookings (de-dup by stammKey)
  var bookingChildrenMap = {};
  allBookings.forEach(function(b) {
    var ch = b.child || {};
    var fn = ch.firstName || ((ch.name||'').split(' ')[0]) || '';
    if (!fn) return;
    var key = _ckKey(ch);
    if (!bookingChildrenMap[key]) bookingChildrenMap[key] = { firstName: fn, lastName: ch.lastName || '', birthYear: ch.birthYear || ch.birth_year || null, name: ch.name || (fn + ' ' + (ch.lastName||'')).trim(), age: ch.age || null, bookings: [] };
    bookingChildrenMap[key].bookings.push(b);
  });
  // Final list: stammdaten first (with index for edit/delete), then booking-only entries
  var children = stammdatenChildren.map(function(c, i) {
    var key = _ckKey(c);
    var bc = bookingChildrenMap[key];
    return {
      _stammIndex: i,
      _isStamm: true,
      firstName: c.firstName || (c.name||'').split(' ')[0] || '',
      lastName: c.lastName || (c.name||'').split(' ').slice(1).join(' ') || '',
      birthYear: c.birthYear || null,
      name: c.name || ((c.firstName||'') + ' ' + (c.lastName||'')).trim(),
      bookings: bc ? bc.bookings : [],
    };
  });
  Object.keys(bookingChildrenMap).forEach(function(key) {
    if (!(key in stammIdx)) {
      var bc = bookingChildrenMap[key];
      children.push({ _stammIndex: -1, _isStamm: false, firstName: bc.firstName, lastName: bc.lastName, birthYear: bc.birthYear, name: bc.name, bookings: bc.bookings });
    }
  });

  // Active courses (distinct activityIds with active bookings)
  var activeBookings = allBookings.filter(function(b) { return b.status !== 'cancelled' && b.status !== 'refunded'; });
  var activeActIds = {};
  activeBookings.forEach(function(b) { activeActIds[b.activityId] = true; });
  var courseList = Object.keys(activeActIds).map(function(aid) {
    var a = actMap[aid];
    if (!a) return null;
    var b = activeBookings.find(function(x) { return x.activityId === aid; });
    var paidLabel = b && b.paymentStatus === 'paid' ? '<span class="pill pill-ok" style="margin-left:6px">BEZAHLT</span>' : '<span class="pill pill-pending" style="margin-left:6px">OFFEN</span>';
    return '<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px dashed var(--border);font-size:13px">'
      + '<div style="flex:1;cursor:pointer" onclick="this.closest(\'.ukc-detail-overlay\').remove();window.viewCourseDetail(\'' + a.id + '\')">'
      +   '<div><strong>' + (window.escapeHtml ? window.escapeHtml(a.title) : a.title) + '</strong>' + paidLabel + '</div>'
      +   '<div style="font-size:11px;color:var(--muted-2);margin-top:2px">' + (a.category || '—') + '</div>'
      + '</div>'
      + '<a class="card-link" style="font-size:12px" onclick="this.closest(\'.ukc-detail-overlay\').remove();window.viewCourseDetail(\'' + a.id + '\')">Kurs →</a>'
      + '</div>';
  }).filter(Boolean).join('');

  var totalSpend = allBookings.filter(function(b){ return b.paymentStatus === 'paid'; }).reduce(function(acc, b){ return acc + (b.amountPaid || 0); }, 0);

  var rows = [
    { label: 'E-Mail', val: email },
    { label: 'Telefon', val: phone },
    { label: 'Buchungen', val: allBookings.length + ' insgesamt · ' + activeBookings.length + ' aktiv' },
    { label: 'Bezahlt (gesamt)', val: window.__kdFmtMoney(totalSpend) },
  ];

  var childrenHtml = '';
  if (children.length > 0) {
    childrenHtml = '<div style="margin-top:18px;border-top:1px solid var(--border);padding-top:14px">'
      + '<div class="info-label" style="margin-bottom:10px">Kinder · ' + children.length + '</div>'
      + children.map(function(c) {
        var ageStr = c.birthYear ? (new Date().getFullYear() - c.birthYear) + ' J.' : (c.age ? c.age + ' J.' : '');
        var yearStr = c.birthYear ? c.birthYear : '';
        var meta = yearStr && ageStr ? (yearStr + ' · ' + ageStr) : (yearStr || ageStr || '');
        // Pass child data via stash key to avoid quote-escaping hell in inline onclick
        var stashKey = 'ck_' + parentId + '_' + Math.random().toString(36).slice(2,8);
        window.__kdChildStash = window.__kdChildStash || {};
        window.__kdChildStash[stashKey] = { firstName: c.firstName||'', lastName: c.lastName||'', birthYear: c.birthYear||null, stammIndex: c._stammIndex, isStamm: c._isStamm, parentId: parentId };
        var actionsHtml = '<button class="row-action-btn" title="Bearbeiten" onclick="window.__kdEditChild(\'' + stashKey + '\')" style="font-size:14px;padding:2px 6px">✎</button>';
        if (c._isStamm) {
          actionsHtml += ' <button class="row-action-btn" title="Löschen" onclick="window.__kdDeleteChild(\'' + stashKey + '\')" style="font-size:14px;padding:2px 6px;color:#dc2626">×</button>';
        }
        return '<div style="display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13px;padding:6px 0;border-bottom:1px dashed var(--border)">'
          + '<div style="flex:1;min-width:0">'
            + '<strong>' + (window.escapeHtml ? window.escapeHtml(c.name) : c.name) + '</strong>'
            + (meta ? ' <span style="color:var(--muted-2);font-size:12px">(' + meta + ')</span>' : '')
            + (c.bookings.length ? ' <span style="color:var(--muted-2);font-size:11px">· ' + c.bookings.length + ' Buchung' + (c.bookings.length === 1 ? '' : 'en') + '</span>' : '')
            + (!c._isStamm ? ' <span class="pill" style="background:#fef3c7;color:#92400e;font-size:10px;margin-left:4px">aus Buchung</span>' : '')
          + '</div>'
          + '<div style="flex-shrink:0">' + actionsHtml + '</div>'
        + '</div>';
      }).join('') + '</div>';
  }

  var coursesHtml = '';
  if (courseList) {
    coursesHtml = '<div style="margin-top:18px;border-top:1px solid var(--border);padding-top:14px">'
      + '<div class="info-label" style="margin-bottom:6px">Aktive Kurse · ' + Object.keys(activeActIds).length + '</div>'
      + courseList + '</div>';
  }

  // Fetch notes (chronological)
  var notes = [];
  try {
    var nr = await s.api('/providers/' + s.provider.id + '/customers/' + parentId + '/notes');
    notes = nr.data || nr.notes || nr || [];
  } catch (e) { /* no notes endpoint or empty */ }

  function fmtNoteDate(d) {
    if (!d) return '';
    var x = new Date(d);
    var today = new Date();
    var sameDay = x.toDateString() === today.toDateString();
    var yesterday = new Date(today); yesterday.setDate(yesterday.getDate() - 1);
    var isYesterday = x.toDateString() === yesterday.toDateString();
    var time = x.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
    if (sameDay) return 'heute · ' + time;
    if (isYesterday) return 'gestern · ' + time;
    return x.toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: 'numeric' }) + ' · ' + time;
  }

  var notesHtml = '<div style="margin-top:18px;border-top:1px solid var(--border);padding-top:14px">'
    + '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">'
    +   '<div class="info-label">Notizen · ' + notes.length + '</div>'
    +   '<button class="btn btn-ghost btn-sm" onclick="window.__kdAddNote(\'' + parentId + '\', \'' + (name || '').replace(/\'/g, '\\\'') + '\')">+ Notiz</button>'
    + '</div>';
  if (notes.length === 0) {
    notesHtml += '<div style="color:var(--muted-2);font-size:12px;padding:12px 0">Noch keine Notizen — z.B. Beobachtungen, Allergien, Auffälligkeiten.</div>';
  } else {
    notesHtml += '<div style="display:flex;flex-direction:column;gap:10px">'
      + notes.map(function(n) {
          var safeContent = (window.escapeHtml ? window.escapeHtml(n.content || '') : (n.content || ''))
            .replace(/\n/g, '<br>');
          var author = n.authorName || '—';
          return '<div style="background:rgba(0,0,0,.025);border-left:2px solid var(--ochre,#C68A3A);padding:10px 12px;border-radius:0 6px 6px 0;position:relative">'
            + '<div style="position:absolute;top:8px;right:8px;display:flex;gap:4px;opacity:.6">'
            +   '<button class="row-action-btn" title="Bearbeiten" style="font-size:13px;padding:4px 6px" onclick="window.__kdEditNote(\'' + parentId + '\', \'' + n.id + '\')">✎</button>'
            +   '<button class="row-action-btn" title="Löschen" style="font-size:13px;padding:4px 6px;color:var(--signal,#c0392b)" onclick="window.__kdDeleteNote(\'' + parentId + '\', \'' + n.id + '\')">🗑</button>'
            + '</div>'
            + '<div style="font-size:13px;color:var(--text);line-height:1.5;padding-right:60px">' + safeContent + '</div>'
            + '<div style="font-size:11px;color:var(--muted-2);margin-top:6px">'
            +   fmtNoteDate(n.createdAt) + ' · ' + (window.escapeHtml ? window.escapeHtml(author) : author)
            + '</div>'
            + '</div>';
        }).join('')
      + '</div>';
  }
  notesHtml += '</div>';
  // Stash notes-by-id for the edit-flow to look up current content without refetching
  window.__kdNotesCache = window.__kdNotesCache || {};
  notes.forEach(function(n) { window.__kdNotesCache[n.id] = { content: n.content, parentId: parentId }; });

  // Re-render the modal with hydrated content
  var ovs = document.querySelectorAll('.ukc-detail-overlay');
  if (ovs.length > 0) ovs[ovs.length - 1].remove();
  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Kunde',
      titleHtml: (window.escapeHtml ? window.escapeHtml(name.split(' ')[0]) : name.split(' ')[0]) + ' <em>' + (window.escapeHtml ? window.escapeHtml(name.split(' ').slice(1).join(' ') || name) : name.split(' ').slice(1).join(' ') || name) + '</em>',
      rows: rows,
      bodyExtraHtml: childrenHtml + coursesHtml + notesHtml,
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="window.location.href=\'mailto:' + (email || '') + '\'">E-Mail senden</button>'
        + ' <button class="btn btn-ghost btn-sm" onclick="window.__kdFilterBookingsByEmail(\'' + (email || '').replace(/\'/g, '\\\'') + '\')">Buchungen anzeigen</button>'
        + ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>',
    });
  }
};

// =====================================================================
// Kunden-Aktionen Dropdown (⋯ Button)
// =====================================================================
window.__openKundenActions = function(ev, parentId, name, email) {
  if (ev) { ev.stopPropagation(); ev.preventDefault(); }
  // Remove any existing menu
  var existing = document.getElementById('kunden-actions-menu');
  if (existing) { existing.remove(); return; }

  var btn = ev && ev.currentTarget;
  var rect = btn ? btn.getBoundingClientRect() : { top: 100, left: 100, bottom: 130 };

  var menu = document.createElement('div');
  menu.id = 'kunden-actions-menu';
  menu.style.cssText = 'position:fixed;z-index:9999;background:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:0 6px 24px rgba(0,0,0,.18);min-width:200px;padding:6px 0;font-size:13px;';
  menu.style.top = (rect.bottom + 4) + 'px';
  menu.style.left = Math.max(8, rect.left - 160) + 'px';

  function item(label, icon, onClick, danger) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.style.cssText = 'width:100%;text-align:left;background:none;border:0;padding:9px 14px;font-size:13px;cursor:pointer;color:' + (danger ? 'var(--signal,#c0392b)' : 'var(--text)') + ';display:flex;align-items:center;gap:10px;';
    btn.innerHTML = '<span style="opacity:.7;width:14px;text-align:center">' + icon + '</span><span>' + label + '</span>';
    btn.onmouseover = function() { btn.style.background = 'var(--bg-soft, rgba(0,0,0,.04))'; };
    btn.onmouseout = function() { btn.style.background = 'transparent'; };
    btn.onclick = function() { menu.remove(); onClick(); };
    return btn;
  }

  menu.appendChild(item('Profil anzeigen', '⊙', function() { window.__kdShowParent(parentId); }));
  menu.appendChild(item('Buchungen filtern', '📋', function() { window.__kdFilterBookingsByEmail(email); }));
  menu.appendChild(item('E-Mail senden', '✉', function() { window.location.href = 'mailto:' + email; }));
  menu.appendChild(item('Notiz hinzufügen', '✎', function() { window.__kdAddNote(parentId, name); }));
  var sep = document.createElement('div');
  sep.style.cssText = 'height:1px;background:var(--border);margin:4px 0;';
  menu.appendChild(sep);
  menu.appendChild(item('DSGVO-Export', '⤓', function() { window.__kdExportParent(parentId, name); }));

  document.body.appendChild(menu);

  // Close on outside click
  setTimeout(function() {
    function onOutside(e) {
      if (!menu.contains(e.target)) {
        menu.remove();
        document.removeEventListener('click', onOutside, true);
      }
    }
    document.addEventListener('click', onOutside, true);
  }, 0);
};

// ========== Kind editieren / löschen ==========
window.__kdEditChild = async function(stashKey) {
  var s = window.dashboardState; if (!s) return;
  var ck = (window.__kdChildStash || {})[stashKey];
  if (!ck) { alert('Kind-Daten nicht gefunden'); return; }
  var firstName = ck.firstName || '';
  var lastName = ck.lastName || '';
  var birthYear = ck.birthYear || '';
  var isStamm = !!ck.isStamm;
  var html = '<div class="ukc-detail-overlay in" style="z-index:10500;opacity:1">'
    + '<div style="background:#fff;border-radius:16px;padding:24px;max-width:420px;width:92%;box-shadow:0 8px 32px rgba(0,0,0,.25)">'
    + '<h3 style="font-size:18px;font-weight:700;margin-bottom:6px">Kind bearbeiten</h3>'
    + '<p style="font-size:12px;color:var(--muted-2);margin-bottom:18px">' + (isStamm ? 'Änderungen wirken auf zukünftige Buchungen. Alte Buchungen behalten den ursprünglichen Namen.' : 'Wird in die Stammdaten übernommen — alte Buchungen behalten den ursprünglichen Namen.') + '</p>'
    + '<label style="font-size:11px;color:var(--muted-2);display:block;margin-bottom:4px">Vorname *</label>'
    + '<input id="kdEditFn" type="text" value="' + (window.escapeHtml?window.escapeHtml(firstName):firstName) + '" style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:10px;font-size:14px;margin-bottom:12px;outline:none">'
    + '<label style="font-size:11px;color:var(--muted-2);display:block;margin-bottom:4px">Nachname</label>'
    + '<input id="kdEditLn" type="text" value="' + (window.escapeHtml?window.escapeHtml(lastName):lastName) + '" style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:10px;font-size:14px;margin-bottom:12px;outline:none">'
    + '<label style="font-size:11px;color:var(--muted-2);display:block;margin-bottom:4px">Geburtsjahr *</label>'
    + '<input id="kdEditYr" type="number" min="2005" max="' + new Date().getFullYear() + '" value="' + birthYear + '" style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:10px;font-size:14px;margin-bottom:18px;outline:none">'
    + '<div style="display:flex;gap:8px;justify-content:flex-end">'
      + '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Abbrechen</button>'
      + '<button class="btn btn-primary btn-sm" id="kdEditSave">Speichern</button>'
    + '</div></div></div>';
  var div = document.createElement('div'); div.innerHTML = html; document.body.appendChild(div.firstChild);
  document.getElementById('kdEditSave').onclick = async function() {
    var fn = document.getElementById('kdEditFn').value.trim();
    var ln = document.getElementById('kdEditLn').value.trim();
    var yr = parseInt(document.getElementById('kdEditYr').value);
    if (!fn || !yr || yr < 2005 || yr > new Date().getFullYear()) { alert('Vorname und gültiges Geburtsjahr erforderlich'); return; }
    this.disabled = true; this.textContent = 'Speichern…';
    try {
      var name = (fn + ' ' + (ln||'')).trim();
      if (isStamm) {
        await s.api('/parents/' + ck.parentId + '/children/' + ck.stammIndex, { method: 'PUT', body: JSON.stringify({ firstName: fn, lastName: ln, birthYear: yr, name: name }) });
      } else {
        // matchOld: ermöglicht Cascade-Update der bookings.child_info (alte Daten überschreiben)
        await s.api('/parents/' + ck.parentId + '/children', { method: 'POST', body: JSON.stringify({
          firstName: fn, lastName: ln, birthYear: yr, name: name,
          matchOld: { firstName: ck.firstName, birthYear: ck.birthYear }
        }) });
      }
      document.querySelectorAll('.ukc-detail-overlay').forEach(function(el){el.remove()});
      window.__kdShowParent(ck.parentId);
    } catch(e) { alert('Fehler: ' + (e && e.message ? e.message : 'Unbekannt')); this.disabled = false; this.textContent = 'Speichern'; }
  };
};

window.__kdDeleteChild = async function(stashKey) {
  var s = window.dashboardState; if (!s) return;
  var ck = (window.__kdChildStash || {})[stashKey];
  if (!ck || !ck.isStamm) return;
  var displayName = ((ck.firstName||'') + ' ' + (ck.lastName||'')).trim() || 'Kind';
  if (!confirm('Kind "' + displayName + '" aus den Stammdaten entfernen?\n\nBestehende Buchungen bleiben erhalten — nur das Stammdaten-Profil wird gelöscht.')) return;
  try {
    await s.api('/parents/' + ck.parentId + '/children/' + ck.stammIndex, { method: 'DELETE' });
    document.querySelectorAll('.ukc-detail-overlay').forEach(function(el){el.remove()});
    window.__kdShowParent(ck.parentId);
  } catch(e) { alert('Fehler: ' + (e && e.message ? e.message : 'Unbekannt')); }
};

// Show all bookings of a parent in a modal
window.__kdShowParentBookings = async function(parentId, name) {
  var s = window.dashboardState; if (!s || !parentId) return;
  var allBookings = (s.bookings || []).filter(function(b) {
    return b && (b.parentId === parentId || (b.customer && b.customer.id === parentId));
  });
  // Sort newest first
  allBookings.sort(function(a, b) {
    return new Date(b.createdAt || b.bookedAt || 0) - new Date(a.createdAt || a.bookedAt || 0);
  });
  var actMap = {};
  (s.activities || []).forEach(function(a) { actMap[a.id] = a; });

  function statusPill(b) {
    var st = (b.status || '').toLowerCase();
    if (st === 'cancelled') return '<span class="pill" style="background:#f3d3d3;color:#7a2828">Storniert</span>';
    if (st === 'refunded') return '<span class="pill" style="background:#e0e0e0;color:#555">Erstattet</span>';
    if (st === 'pending') return '<span class="pill pill-pending">Ausstehend</span>';
    return '<span class="pill pill-ok">Bestätigt</span>';
  }
  function payPill(b) {
    var ps = (b.paymentStatus || '').toLowerCase();
    if (ps === 'paid') return '<span class="pill pill-ok" style="margin-left:6px">Bezahlt</span>';
    if (ps === 'refunded') return '<span class="pill" style="background:#e0e0e0;color:#555;margin-left:6px">Erstattet</span>';
    if (ps === 'cancelled') return '';
    return '<span class="pill pill-pending" style="margin-left:6px">Offen</span>';
  }
  function fmtMoney(v) {
    var num = (typeof v === 'number') ? v : parseFloat(v || 0);
    if (isNaN(num)) num = 0;
    return num.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }
  function fmtDate(d) {
    if (!d) return '—';
    var x = new Date(d);
    return x.toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  var bodyHtml;
  if (allBookings.length === 0) {
    bodyHtml = '<div style="padding:32px;text-align:center;color:var(--muted-2)">Noch keine Buchungen.</div>';
  } else {
    bodyHtml = '<div style="display:flex;flex-direction:column;gap:0">'
      + allBookings.map(function(b) {
          var act = actMap[b.activityId];
          var title = (act && act.title) || b.activityTitle || b.activityName || 'Kurs';
          var category = (act && act.category) || '';
          var ch = (b.child && b.child.name) || ((b.child && b.child.firstName) ? (b.child.firstName + ' ' + (b.child.lastName || '')).trim() : '');
          var amount = (b.amountPaid != null) ? fmtMoney(b.amountPaid) : '';
          return '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px dashed var(--border);font-size:13px">'
            + '<div style="flex:1;min-width:0">'
            +   '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">'
            +     '<strong style="cursor:pointer" onclick="this.closest(\'.ukc-detail-overlay\').remove();window.viewCourseDetail(\'' + (b.activityId || '') + '\')">' + (window.escapeHtml ? window.escapeHtml(title) : title) + '</strong>'
            +     statusPill(b) + payPill(b)
            +   '</div>'
            +   '<div style="font-size:11px;color:var(--muted-2);margin-top:4px">'
            +     fmtDate(b.createdAt || b.bookedAt)
            +     (ch ? ' · ' + (window.escapeHtml ? window.escapeHtml(ch) : ch) : '')
            +     (category ? ' · ' + category : '')
            +     (amount ? ' · ' + amount : '')
            +   '</div>'
            + '</div>'
            + '<a class="card-link" style="font-size:12px;margin-left:12px" onclick="this.closest(\'.ukc-detail-overlay\').remove();window.viewCourseDetail(\'' + (b.activityId || '') + '\')">Kurs →</a>'
            + '</div>';
        }).join('')
      + '</div>';
  }

  var counts = {
    total: allBookings.length,
    active: allBookings.filter(function(b) { return b.status !== 'cancelled' && b.status !== 'refunded'; }).length,
    paid: allBookings.filter(function(b) { return b.paymentStatus === 'paid'; }).length,
  };

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Buchungen · ' + (name || 'Kunde'),
      titleHtml: counts.total + ' <em>Buchung' + (counts.total === 1 ? '' : 'en') + '</em>',
      rows: [
        { label: 'Aktiv', val: counts.active + ' von ' + counts.total },
        { label: 'Bezahlt', val: counts.paid + ' von ' + counts.total },
      ],
      bodyExtraHtml: bodyHtml,
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove();window.__kdShowParent(\'' + parentId + '\')">Profil anzeigen</button>'
        + ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>',
    });
  }
};

// Switch to bookings tab and filter by email
window.__kdFilterBookingsByEmail = function(email) {
  // Close any open detail modal
  var ovs = document.querySelectorAll('.ukc-detail-overlay');
  ovs.forEach(function(o) { o.remove(); });
  // Navigate to buchungen section
  var navLink = document.querySelector('[data-section="buchungen"], a[href="#buchungen"]');
  if (navLink) navLink.click();
  // Set search/filter if there's a search box
  setTimeout(function() {
    var searchInput = document.getElementById('phBuchungenSearch') || document.querySelector('#section-buchungen input[type="search"], #section-buchungen input[placeholder*="uche"]');
    if (searchInput) {
      searchInput.value = email;
      searchInput.dispatchEvent(new Event('input', { bubbles: true }));
      searchInput.dispatchEvent(new Event('change', { bubbles: true }));
    } else {
      // Fallback: use global search
      var global = document.querySelector('input[placeholder*="Kunden"], input[placeholder*="suchen"]');
      if (global) {
        global.value = email;
        global.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  }, 200);
};

// Add a CRM note for this parent (server resolves authorId from auth)
window.__kdAddNote = async function(parentId, name) {
  var s = window.dashboardState; if (!s) return;
  var content = window.prompt('Notiz zu ' + (name || 'Kunde') + ':', '');
  if (!content || !content.trim()) return;
  try {
    await s.api('/providers/' + s.provider.id + '/customers/' + parentId + '/notes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content: content.trim() }),
    });
    if (typeof window.ukcToast === 'function') window.ukcToast('Notiz gespeichert', 'success');
    else alert('Notiz gespeichert');
    // Re-open the profile so the user immediately sees the new note
    var existing = document.querySelectorAll('.ukc-detail-overlay');
    if (existing.length > 0) {
      existing.forEach(function(o) { o.remove(); });
      setTimeout(function() { window.__kdShowParent(parentId); }, 100);
    }
  } catch (e) {
    console.error('[v3] note save failed', e);
    if (typeof window.ukcToast === 'function') window.ukcToast('Fehler beim Speichern: ' + (e.message || ''), 'error');
    else alert('Fehler beim Speichern: ' + (e.message || ''));
  }
};

// QR-Check-In Modal: zeigt + lädt + druckt QR-Code für den aktuellen Provider
window.__openQrCheckin = function() {
  var s = window.dashboardState;
  if (!s || !s.provider) { alert('Provider-Daten nicht geladen'); return; }
  var providerId = s.provider.id;
  var providerName = s.provider.companyName || s.provider.displayName || s.provider.name || 'Studio';
  var checkinUrl = window.location.origin + '/checkin/' + providerId;
  // QR via api.qrserver.com (kostenlos, kein Signup)
  var qrSrc512 = 'https://api.qrserver.com/v1/create-qr-code/?size=512x512&margin=2&format=png&data=' + encodeURIComponent(checkinUrl);
  var qrSrc1024 = 'https://api.qrserver.com/v1/create-qr-code/?size=1024x1024&margin=2&format=png&data=' + encodeURIComponent(checkinUrl);

  var safeName = (window.escapeHtml ? window.escapeHtml(providerName) : providerName);
  var safeUrl = (window.escapeHtml ? window.escapeHtml(checkinUrl) : checkinUrl);

  var rows = [
    { label: 'Studio', val: safeName },
    { label: 'URL', val: '<code style="font-size:11px;background:rgba(0,0,0,.04);padding:3px 6px;border-radius:4px">' + safeUrl + '</code>' },
  ];

  var bodyHtml = '<div style="text-align:center;padding:8px 0">'
    + '<div style="background:#fff;display:inline-block;padding:18px;border-radius:14px;box-shadow:0 4px 16px rgba(0,0,0,.08)">'
    +   '<img id="qrcode-img" src="' + qrSrc512 + '" alt="QR-Code Check-In" style="display:block;width:240px;height:240px;image-rendering:pixelated">'
    + '</div>'
    + '<div style="margin-top:14px;color:var(--muted-2);font-size:12px;line-height:1.5">'
    +   'Drucke den QR-Code aus und hänge ihn am Eingang auf.<br>'
    +   'Eltern scannen ihn beim Eintreffen → wählen ihr Kind aus → eingecheckt.'
    + '</div>'
    + '</div>';

  var footerHtml = '<button class="btn btn-ghost btn-sm" onclick="navigator.clipboard.writeText(\'' + checkinUrl.replace(/\'/g, '\\\'') + '\').then(function(){window.ukcToast && window.ukcToast(\'URL kopiert\', \'success\')})">URL kopieren</button>'
    + ' <button class="btn btn-ghost btn-sm" onclick="window.__downloadQrCode(\'' + qrSrc1024.replace(/\'/g, '\\\'') + '\', \'qr-checkin-' + providerId + '.png\')">PNG herunterladen</button>'
    + ' <button class="btn btn-ghost btn-sm" onclick="window.__printQrCode(\'' + qrSrc1024.replace(/\'/g, '\\\'') + '\', \'' + providerName.replace(/\'/g, '\\\'') + '\', \'' + checkinUrl.replace(/\'/g, '\\\'') + '\')">Drucken</button>'
    + ' <button class="btn btn-primary btn-sm" onclick="window.open(\'' + checkinUrl + '\', \'_blank\')">Vorschau öffnen</button>'
    + ' <button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schließen</button>';

  if (typeof window.ukcShowDetailModal === 'function') {
    window.ukcShowDetailModal({
      kicker: 'Anwesenheit · QR Check-In',
      titleHtml: 'QR-<em>Code</em>',
      rows: rows,
      bodyExtraHtml: bodyHtml,
      footerHtml: footerHtml,
    });
  }
};

// Hilfs-Funktionen für QR-Code Download / Print
window.__downloadQrCode = async function(src, filename) {
  try {
    var resp = await fetch(src);
    var blob = await resp.blob();
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    if (window.ukcToast) window.ukcToast('QR-Code heruntergeladen', 'success');
  } catch (e) {
    console.error('QR download failed', e);
    alert('Download fehlgeschlagen — bitte rechte Maustaste auf den QR-Code → Bild speichern.');
  }
};

window.__printQrCode = function(src, providerName, checkinUrl) {
  var safeName = String(providerName || 'Studio').replace(/</g, '&lt;');
  var safeUrl = String(checkinUrl || '').replace(/</g, '&lt;');
  var w = window.open('', '_blank', 'width=800,height=900');
  if (!w) { alert('Popup wurde blockiert. Bitte Popups erlauben und erneut versuchen.'); return; }
  w.document.write('<!DOCTYPE html><html><head><title>QR-Code Check-In</title>'
    + '<style>'
    +   'body{font-family:Inter,system-ui,sans-serif;margin:0;padding:48px;text-align:center;color:#3C2225}'
    +   '.brand{font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:#8B7355;margin-bottom:8px}'
    +   'h1{font-size:32px;margin:8px 0 4px;font-weight:600}'
    +   '.studio{font-size:18px;color:#8B7355;margin-bottom:32px}'
    +   '.qr{margin:24px auto;padding:20px;background:#fff;border:2px solid #e8e0d8;border-radius:24px;display:inline-block}'
    +   '.qr img{width:480px;height:480px;display:block;image-rendering:pixelated}'
    +   '.url{margin-top:16px;font-size:13px;color:#8B7355;word-break:break-all}'
    +   '.steps{margin-top:32px;text-align:left;display:inline-block;font-size:14px;line-height:2;color:#3C2225}'
    +   '.steps li{margin-bottom:4px}'
    +   '@media print { body{padding:0} .no-print{display:none} }'
    + '</style></head><body>'
    + '<div class="brand">Anwesenheits-Check-In</div>'
    + '<h1>Bitte scannen</h1>'
    + '<div class="studio">' + safeName + '</div>'
    + '<div class="qr"><img src="' + src + '" alt="QR Check-In"></div>'
    + '<div class="url">' + safeUrl + '</div>'
    + '<ol class="steps">'
    +   '<li>QR-Code mit deinem Handy scannen</li>'
    +   '<li>E-Mail-Adresse eingeben</li>'
    +   '<li>Kind(er) auswählen</li>'
    +   '<li>Auf „Einchecken" tippen — fertig.</li>'
    + '</ol>'
    + '<div class="no-print" style="margin-top:32px"><button onclick="window.print()" style="padding:12px 28px;background:#D4956A;color:#fff;border:0;border-radius:10px;font-size:15px;cursor:pointer">Drucken</button></div>'
    + '</body></html>');
  w.document.close();
  // Print-Dialog automatisch öffnen, sobald das Bild geladen ist
  setTimeout(function() {
    try {
      var img = w.document.querySelector('.qr img');
      if (img && img.complete) { w.focus(); w.print(); }
      else if (img) { img.onload = function() { w.focus(); w.print(); }; }
    } catch (e) {}
  }, 400);
};

// Edit an existing note
window.__kdEditNote = async function(parentId, noteId) {
  var s = window.dashboardState; if (!s) return;
  var cached = (window.__kdNotesCache || {})[noteId];
  var current = cached ? cached.content : '';
  var content = window.prompt('Notiz bearbeiten:', current);
  if (content == null) return; // cancelled
  if (!content.trim()) {
    if (typeof window.ukcToast === 'function') window.ukcToast('Notiz darf nicht leer sein', 'error');
    return;
  }
  if (content.trim() === current) return; // unchanged
  try {
    await s.api('/providers/' + s.provider.id + '/customers/' + parentId + '/notes/' + noteId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content: content.trim() }),
    });
    if (typeof window.ukcToast === 'function') window.ukcToast('Notiz aktualisiert', 'success');
    // Refresh modal
    var existing = document.querySelectorAll('.ukc-detail-overlay');
    existing.forEach(function(o) { o.remove(); });
    setTimeout(function() { window.__kdShowParent(parentId); }, 100);
  } catch (e) {
    console.error('[v3] note update failed', e);
    if (typeof window.ukcToast === 'function') window.ukcToast('Update fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Update fehlgeschlagen: ' + (e.message || ''));
  }
};

// Delete a note
window.__kdDeleteNote = async function(parentId, noteId) {
  var s = window.dashboardState; if (!s) return;
  if (!confirm('Notiz wirklich löschen?\n\nDieser Vorgang kann nicht rückgängig gemacht werden.')) return;
  try {
    await s.api('/providers/' + s.provider.id + '/customers/' + parentId + '/notes/' + noteId, {
      method: 'DELETE',
    });
    if (typeof window.ukcToast === 'function') window.ukcToast('Notiz gelöscht', 'success');
    // Refresh modal
    var existing = document.querySelectorAll('.ukc-detail-overlay');
    existing.forEach(function(o) { o.remove(); });
    setTimeout(function() { window.__kdShowParent(parentId); }, 100);
  } catch (e) {
    console.error('[v3] note delete failed', e);
    if (typeof window.ukcToast === 'function') window.ukcToast('Löschen fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Löschen fehlgeschlagen: ' + (e.message || ''));
  }
};

// DSGVO data export for this parent
window.__kdExportParent = async function(parentId, name) {
  var s = window.dashboardState; if (!s) return;
  if (!confirm('DSGVO-Datenexport für ' + (name || 'diesen Kunden') + ' anfordern?\n\nDie Daten werden als JSON heruntergeladen.')) return;
  try {
    var r = await s.api('/parents/' + parentId + '/data-export');
    var data = r.data || r;
    var blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'kundendaten_' + (name || parentId).replace(/\s+/g, '_') + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    if (typeof window.ukcToast === 'function') window.ukcToast('Export heruntergeladen', 'success');
  } catch (e) {
    console.error('[v3] export failed', e);
    if (typeof window.ukcToast === 'function') window.ukcToast('Export fehlgeschlagen: ' + (e.message || ''), 'error');
    else alert('Export fehlgeschlagen');
  }
};

  window.editCourseQuick = function(id) {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === id; });
    if (!a) { alert('Kurs nicht gefunden'); return; }
    if (typeof window.openKursCreatorV2 !== 'function') { alert('Kurs-Creator noch nicht geladen.'); return; }

    window.openKursCreatorV2({
      mode: 'edit',
      prefill: a,
      onSubmit: async function(data) {
        // Build PUT payload — same shape as create
        var dayMap = { MO:'MO', DI:'TU', MI:'WE', DO:'TH', FR:'FR', SA:'SA', SO:'SU' };
        var slots = (data.schedule || []).filter(function(x){ return x.day && x.start && x.end; })
          .map(function(x){ return { day: dayMap[x.day] || x.day, startTime: x.start, endTime: x.end }; });
        var startDate = (data.schedule[0] && data.schedule[0].from) || undefined;
        var endDate = (data.schedule[0] && data.schedule[0].until) || undefined;

        var typeMap = { package:'package', single:'single', monthly:'subscription', free:'package' };
        var pricing = [{
          label: data.priceLabel || (data.priceModel === 'package' ? 'Paket' : 'Einzelstunde'),
          type: typeMap[data.priceModel] || 'package',
          amount: parseFloat(data.priceAmount) || 0,
          currency: 'EUR',
          packageSize: data.priceModel === 'package' ? (parseInt(data.priceUnits, 10) || 8) : undefined,
          intervalMonths: data.priceModel === 'monthly' ? (parseInt(data.priceUnits, 10) || 1) : undefined,
          siblingDiscount: parseFloat(data.siblingDiscount) || 0,
        }];
        if (data.addSecondPrice && parseFloat(data.priceAmount2) > 0) {
          pricing.push({
            label: data.priceLabel2 || 'Zweite Option',
            type: typeMap[data.priceModel2] || 'single',
            amount: parseFloat(data.priceAmount2),
            currency: 'EUR',
            packageSize: data.priceModel2 === 'package' ? (parseInt(data.priceUnits2, 10) || 1) : undefined,
            intervalMonths: data.priceModel2 === 'monthly' ? (parseInt(data.priceUnits2, 10) || 1) : undefined,
          });
        }
        var trainerVal = (data.trainer && data.trainer !== 'Kein Kursleiter zugewiesen' && data.trainer !== '') ? data.trainer : null;
        var roomVal = (data.room && data.room !== 'Kein Raum zugewiesen' && data.room !== '') ? data.room : null;
        var payload = {
          title: data.title,
          description: data.description || '',
          category: data.category || 'sonstige',
ageRange: (function() {
            function parseAge(v) {
              if (v == null) return { val: 0, unit: 'years' };
              var s = String(v);
              if (s.charAt(0) === 'm') return { val: parseInt(s.slice(1), 10) || 0, unit: 'months' };
              return { val: parseInt(s, 10) || 0, unit: 'years' };
            }
            var pmin = parseAge(data.ageMin);
            var pmax = parseAge(data.ageMax);
            // If units differ, normalize to months for safety (1J = 12 Mo)
            var unit = pmin.unit;
            if (pmin.unit !== pmax.unit) {
              var minM = pmin.unit === 'months' ? pmin.val : pmin.val * 12;
              var maxM = pmax.unit === 'months' ? pmax.val : pmax.val * 12;
              return { min: Math.min(minM, maxM), max: Math.max(minM, maxM), unit: 'months' };
            }
            return { min: Math.min(pmin.val, pmax.val), max: Math.max(pmin.val, pmax.val), unit: unit };
          })(),
          schedule: slots.length ? { type: 'recurring', slots: slots, startDate: startDate, endDate: endDate } : undefined,
          capacity: parseInt(data.capacity, 10) || 10,
          pricing: pricing,
          paymentOnline: !!data.payOnline,
          paymentOnsite: !!data.payOnSite,
          waitlistEnabled: data.waitlistEnabled !== false,
          makeupCapacity: data.addUpSlots != null ? Math.max(0, parseInt(data.addUpSlots, 10)) : 2,
          color: data.color || undefined,
          roomId: roomVal,
          instructorId: trainerVal,
        };
        try {
          console.log('[v3] PUT /activities/' + id + ' payload:', JSON.parse(JSON.stringify(payload)));
          await s.api('/activities/' + id, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
          toast('Kurs gespeichert', 'success');
          refreshAll();
        } catch (e) {
          alert('Speichern fehlgeschlagen: ' + (e.message || e));
        }
      },
    });
  };

  window.handleCourseAction = async function(id, action, btn) {
    var s = window.dashboardState; if (!s) return;
    var a = (s.activities || []).find(function(x){ return x.id === id; });
    if (!a) { alert('Kurs nicht gefunden'); return; }
    if (!action) {
      var current = (typeof statusOf === 'function') ? statusOf(a) : (a.status || 'in_planning');
      var options = [];
      if (current === 'paused')          options.push({ value: 'activate',  label: 'Wieder aktivieren', desc: 'Kurs läuft wieder, Eltern können benachrichtigt werden.' });
      else if (current !== 'active')     options.push({ value: 'activate',  label: 'Aktivieren',        desc: 'Kurs wird im Widget sichtbar und buchbar.' });
      if (current === 'active')          options.push({ value: 'pause',     label: 'Pausieren',         desc: 'Vorübergehend ausblenden, keine neuen Buchungen.' });
                                         options.push({ value: 'duplicate', label: 'Duplizieren',       desc: 'Kopie als Entwurf anlegen.' });
      if (current !== 'archived')        options.push({ value: 'archive',   label: 'Archivieren',       desc: 'Aus aktiver Liste entfernen (umkehrbar).', variant: 'danger' });
      action = await window.ukcChoose({
        kicker: 'Kurs',
        titleHtml: escapeHtml(a.title || '') + ' <em>Aktion</em>',
        message: 'Status aktuell: ' + (current),
        options: options,
      });
      if (!action) return;
    }
    var promise;
    // For status transitions on courses with enrolled parents, ask whether to notify
    if (action === 'pause' || action === 'activate') {
      var enrolled = (s.bookings || []).filter(function(b) {
        return b && b.activityId === id && b.status !== 'cancelled' && b.status !== 'refunded';
      }).length;
      var notify = false;
      if (enrolled > 0 && typeof window.ukcChoose === 'function') {
        var verb = action === 'pause' ? 'pausieren' : 'aktivieren';
        var choice = await window.ukcChoose({
          kicker: 'Kurs',
          titleHtml: escapeHtml(a.title || '') + ' <em>' + (action === 'pause' ? 'pausieren' : 'aktivieren') + '</em>',
          message: enrolled + ' Familie' + (enrolled === 1 ? '' : 'n') + ' eingebucht. Per E-Mail informieren?',
          options: [
            { value: 'notify', label: verb.charAt(0).toUpperCase() + verb.slice(1) + ' & E-Mail an Eltern' },
            { value: 'silent', label: 'Nur ' + verb + ' (ohne E-Mail)' },
            { value: 'cancel', label: 'Abbrechen', variant: 'danger' },
          ],
        });
        if (!choice || choice === 'cancel') return;
        notify = (choice === 'notify');
      }
      var body = JSON.stringify({ notifyParents: notify });
      var headers = { 'Content-Type': 'application/json' };
      if (action === 'pause') {
        promise = api('/activities/' + id, { method: 'PUT', headers: headers, body: JSON.stringify({ status: 'paused', notifyParents: notify }) });
      } else {
        promise = api('/activities/' + id + '/publish', { method: 'POST', headers: headers, body: body });
      }
    } else if (action === 'duplicate') promise = api('/activities/' + id + '/duplicate', { method: 'POST' });
    else if (action === 'archive')   promise = api('/activities/' + id + '/archive',   { method: 'POST' });
    else { toast('Aktion nicht implementiert: ' + action, 'warning'); return; }
    promise.then(function(){
      var verbDone = action === 'pause' ? 'pausiert' : (action === 'activate' ? 'aktiviert' : 'erledigt');
      toast('Kurs ' + verbDone, 'success');
      refreshAll();
    }).catch(function(e){ alert('Fehler: ' + (e.message || e)); });
  };

  // ----- BUCHUNGEN -----
  window.viewBookingDetail = function(id) {
    var s = window.dashboardState; if (!s) return;
    var b = (s.bookings || []).find(function(x){ return x.id === id; });
    if (!b) { alert('Buchung nicht gefunden'); return; }
    var c = b.customer || {};
    var ch = b.child || {};
    var ageStr = ch.birthYear ? (new Date().getFullYear() - ch.birthYear) + ' J.' : '';
    var childName = ((ch.firstName || ch.name || '') + ' ' + (ch.lastName || '')).trim() || '—';
    var paymentTxt = (({stripe:'Stripe', paypal:'PayPal', onsite:'Vor Ort', invoice:'Rechnung'})[b.paymentMethod] || b.paymentMethod || '?');
    var amount = (b.amountPaid != null ? b.amountPaid : 0).toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' ' + (b.currency || 'EUR');
    window.ukcShowDetailModal({
      kicker: 'Buchung · ' + (b.id || '').slice(0,8),
      titleHtml: escapeHtml(c.name || b.customerName || 'Unbekannt') + ' <em>Detail</em>',
      rows: [
        { label: 'Kind', val: childName + (ageStr ? ' (' + ageStr + ')' : '') },
        { label: 'Email', val: c.email || b.customerEmail || '—' },
        { label: 'Kurs', val: b.activityTitle || b.activityName || '—' },
        { label: 'Status', html: statusPillHtml(b.status || 'pending') },
        { label: 'Zahlung', val: paymentTxt + ' · ' + (b.status === 'cancelled' ? 'storniert' : (b.paymentStatus || 'unpaid')) },
        { label: 'Betrag', val: amount },
        { label: 'Erstellt', val: new Date(b.createdAt || 0).toLocaleString('de-DE') },
      ],
      footerHtml: '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove()">Schliessen</button>'
        + ' <button class="btn btn-primary btn-sm" onclick="this.closest(\'.ukc-detail-overlay\').remove();window.handleBookingAction(\'' + b.id + '\')">Aktionen</button>',
    });
  };

  // Block-Detail (Kursbloecke)
  window.viewBlockDetail = function(blockId) {
    var s = window.dashboardState; if (!s) return;
    s.api('/course-blocks/' + blockId).then(function(r) {
      var b = r.data || r;
      if (!b || !b.id) { alert('Block nicht gefunden'); return; }
      var dayLabel = fmtDayCode((b.recurringDay || b.recurring_day || '').toUpperCase());
      var time = (b.recurringTime || b.recurring_time || '').slice(0,5);
      window.ukcShowDetailModal({
        kicker: 'Kursblock',
        titleHtml: escapeHtml(b.activityName || b.activityTitle || 'Block') + ' <em>' + escapeHtml(b.seasonLabel || b.season_label || 'Block 1') + '</em>',
        rows: [
          { label: 'Status', html: statusPillHtml(b.status || 'active') },
          { label: 'Start', val: b.startDate || b.start_date || '—' },
          { label: 'Ende', val: b.endDate || b.end_date || '—' },
          { label: 'Termine', val: (b.totalSessions || b.total_sessions || '?') + ' Wochen · ' + (b.durationMinutes || b.duration_minutes || 60) + ' Min' },
          { label: 'Tag/Zeit', val: dayLabel + (time ? ' · ' + time : '') },
          { label: 'Kapazitaet', val: (b.capacity || '?') + (b.makeupCapacity || b.makeup_capacity ? ' (+' + (b.makeupCapacity || b.makeup_capacity) + ' Add-Up)' : '') },
          { label: 'Preis', val: (b.pricePerBlock || b.price_per_block || 0) + ' ' + (b.currency || 'EUR') },
        ],
      });
    }).catch(function(e) { alert('Block-Detail laden fehlgeschlagen: ' + (e.message || e)); });
  };

  window.handleBookingAction = async function(id, action, btn) {
    var s = window.dashboardState; if (!s) return;
    var b = (s.bookings || []).find(function(x){ return x.id === id; });
    if (!b) { alert('Buchung nicht gefunden'); return; }
    if (!action) {
      var options = [];
      if (b.status !== 'cancelled')             options.push({ value: 'cancel',   label: 'Stornieren', desc: 'Buchung absagen, optional Stripe-Refund.', variant: 'danger' });
      if (b.status !== 'cancelled' && b.paymentStatus !== 'paid')           options.push({ value: 'pay',      label: 'Als bezahlt markieren', desc: 'Vor-Ort-Zahlung erhalten?' });
      if (b.status !== 'completed' && b.status !== 'cancelled') options.push({ value: 'complete', label: 'Als abgeschlossen markieren', desc: 'Buchung ist erfuellt.' });
      action = await window.ukcChoose({
        kicker: 'Buchung',
        titleHtml: escapeHtml((b.customer && b.customer.name) || 'Unbekannt') + ' <em>Aktion</em>',
        message: 'Kurs: ' + (b.activityTitle || b.activityName || '—'),
        options: options,
      });
      if (!action) return;
    }
    var body = null;
    if (action === 'cancel') {
      var refund = await window.ukcConfirm({
        kicker: 'Stornierung',
        titleHtml: 'Mit Stripe-<em>Refund</em>?',
        message: 'OK = Buchung stornieren UND ' + ((b.amountPaid || 0) > 0 ? (b.amountPaid + ' ' + (b.currency || 'EUR')) : 'Betrag') + ' an Kunde zurueckerstatten. Abbrechen = nur Status auf "storniert" setzen, kein Refund.',
        okLabel: 'Stornieren + Refund',
        cancelLabel: 'Nur stornieren',
        variant: 'danger',
      });
      // ukcConfirm returns true (OK) or false (Cancel/Esc); we treat false as 'no refund'.
      body = JSON.stringify({ refund: !!refund });
    }
    if (action === 'pay') {
      // Derive expected amount from activity's pricing (fallback to amountPaid or 0)
      var act = (s.activities || []).find(function(x) { return x.id === b.activityId; });
      var defaultAmt = (b.amountPaid && b.amountPaid > 0) ? b.amountPaid
        : (act && act.pricing && act.pricing[0] && act.pricing[0].amount) || 0;
      var amtStr = window.prompt(
        'Wie viel hat der Kunde vor Ort bezahlt? (€)\n\nKurs: ' + (b.activityTitle || 'Kurs') + '\nKunde: ' + ((b.customer && b.customer.name) || '—'),
        String(defaultAmt)
      );
      if (amtStr == null) return; // cancelled
      var amt = parseFloat(String(amtStr).replace(',', '.'));
      if (isNaN(amt) || amt < 0) {
        if (window.ukcToast) window.ukcToast('Ungültiger Betrag', 'error'); else alert('Ungültiger Betrag');
        return;
      }
      body = JSON.stringify({ amount: amt });
    }
    var promise;
    if (action === 'cancel')        promise = api('/bookings/' + id + '/cancel',   { method: 'POST', headers: {'Content-Type':'application/json'}, body: body || '{}' });
    else if (action === 'pay')      promise = api('/bookings/' + id + '/pay',      { method: 'POST', headers: {'Content-Type':'application/json'}, body: body || '{}' });
    else if (action === 'complete') promise = api('/bookings/' + id + '/complete', { method: 'POST' });
    else { toast('Aktion nicht implementiert: ' + action, 'warning'); return; }
    promise.then(function(){ toast('Erledigt', 'success'); refreshAll(); })
           .catch(function(e){ alert('Fehler: ' + (e.message || e)); });
  };
})();

  
// === Dashboard Week-Glance Renderer ===
window.renderWeekGlance = function(activitiesArg) {
  var c = document.getElementById('phWeekGlance');
  if (!c) return;
  var s = window.dashboardState;
  var activities = activitiesArg || (s && s.activities) || [];
  var dayKeys = ['MO','TU','WE','TH','FR','SA','SU'];
  var dayLabels = ['MON','DIE','MIT','DON','FRE','SAM','SON'];
  // Build dates for current week (Monday-based)
  var now = new Date();
  var dow = now.getDay(); // 0..6, 0=Sun
  var diffToMon = (dow + 6) % 7;
  var monday = new Date(now); monday.setDate(now.getDate() - diffToMon); monday.setHours(0,0,0,0);
  function localYmd(d) { return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); }
  var todayKey = localYmd(now);

  // Build per-day buckets, but check that each cell's date is within
  // the activity's schedule.startDate / endDate window.
  var byDay = { MO: [], TU: [], WE: [], TH: [], FR: [], SA: [], SU: [] };
  // Pre-compute the seven dates of this week
  var weekDates = [];
  for (var di = 0; di < 7; di++) {
    var dd = new Date(monday); dd.setDate(monday.getDate() + di);
    dd.setHours(0,0,0,0);
    weekDates.push(dd);
  }
  function inRange(date, sd, ed) {
    if (sd) {
      var s = new Date(sd + (sd.length === 10 ? 'T00:00:00' : '')); s.setHours(0,0,0,0);
      if (date < s) return false;
    }
    if (ed) {
      var e = new Date(ed + (ed.length === 10 ? 'T23:59:59' : '')); e.setHours(23,59,59,999);
      if (date > e) return false;
    }
    return true;
  }
  activities.forEach(function(a) {
    if (!a || a.status === 'archived' || a.status === 'cancelled' || a.status === 'paused') return;
    var sched = a.schedule || {};
    if (sched.type === 'recurring' && Array.isArray(sched.slots)) {
      sched.slots.forEach(function(slot) {
        if (!slot || !byDay[slot.day]) return;
        var dayIdx = dayKeys.indexOf(slot.day);
        if (dayIdx < 0) return;
        var cellDate = weekDates[dayIdx];
        if (!inRange(cellDate, sched.startDate, sched.endDate)) return;
        byDay[slot.day].push({ title: a.title || 'Kurs', startTime: (slot.startTime||'').slice(0,5), endTime: (slot.endTime||'').slice(0,5), category: a.category || 'sonstige', id: a.id });
      });
    } else if (sched.type === 'single' && sched.date) {
      var d = new Date(sched.date + 'T00:00:00');
      if (d >= monday && d - monday < 7*24*3600*1000) {
        var k = dayKeys[(d.getDay()+6) % 7];
        byDay[k].push({ title: a.title || 'Kurs', startTime: (sched.startTime||'').slice(0,5), endTime: (sched.endTime||'').slice(0,5), category: a.category || 'sonstige', id: a.id });
      }
    }
  });

  var html = '';
  for (var i = 0; i < 7; i++) {
    var d = new Date(monday); d.setDate(monday.getDate() + i);
    var iso = localYmd(d);
    var isToday = iso === todayKey;
    var key = dayKeys[i];
    var label = dayLabels[i];
    var datStr = String(d.getDate()).padStart(2, '0');
    var monthStr = String(d.getMonth() + 1).padStart(2, '0');
    var events = byDay[key] || [];
    events.sort(function(a, b) { return (a.startTime || '').localeCompare(b.startTime || ''); });
    html += '<div class="week-day' + (isToday ? ' today' : '') + '">'
      + '<div class="week-label">' + label + '</div>'
      + '<div class="week-date">' + datStr + '.' + monthStr + '</div>';
    if (events.length === 0) {
      html += '<div class="week-empty">—</div>';
    } else {
      events.slice(0, 4).forEach(function(ev) {
        var catCls = ev.category ? (' cat-' + String(ev.category).toLowerCase().replace(/[^a-z0-9-]/g,'')) : '';
        var timeTxt = ev.startTime || '';
        html += '<div class="week-event' + catCls + '" onclick="window.viewCourseDetail(\'' + ev.id + '\')" title="' + escapeHtml(ev.title) + '">'
          + (timeTxt ? '<span class="week-event-time">' + timeTxt + '</span>' : '')
          + escapeHtml(ev.title)
          + '</div>';
      });
      if (events.length > 4) {
        html += '<div class="week-empty">+ ' + (events.length - 4) + ' weitere</div>';
      }
    }
    html += '</div>';
  }
  c.innerHTML = html;
};

  
// === Kalender-Section Loader ===
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaders.kalender = async function() {
  await window.__kalLoadRooms();
  var s = window.dashboardState; if (!s) return;
  if (!window.__kalState) {
    var today = new Date(); today.setHours(0,0,0,0);
    window.__kalState = { view: 'week', anchor: today, dayDate: new Date(today), room: '' };
  }
  // Populate room dropdown once
  var roomSel = document.getElementById('phKalRoom');
  if (roomSel && roomSel.options.length <= 1) {
    var roomMap = {};
    (s.activities || []).forEach(function(a) {
      if (a && a.roomId) roomMap[a.roomId] = a.roomName || ('Raum ' + a.roomId);
    });
    Object.keys(roomMap).forEach(function(rid) {
      var o = document.createElement('option');
      o.value = rid;
      o.textContent = window.__kalRoomName(rid) || roomMap[rid];
      roomSel.appendChild(o);
    });
  }
  // ICS export wiring (best-effort link to API; fallback alert)
  var ics = document.getElementById('phKalIcsBtn');
  if (ics && !ics.__wired) {
    ics.addEventListener('click', function(ev) {
      ev.preventDefault();
      var token = (s && s.token) || '';
      var url = '/api/calendar/export.ics' + (token ? ('?token=' + encodeURIComponent(token)) : '');
      window.open(url, '_blank');
    });
    ics.__wired = true;
  }
  window.__renderKalender();
};

// Helpers
window.__kalCatClass = function(a) {
  var c = ((a && a.category) || '').toLowerCase();
  if (/eltern|baby|peki|p[ae]kip/.test(c)) return 'eltern-kind';
  if (/yoga|turn|sport|beweg/.test(c)) return 'bewegung';
  if (/music|musik|gesang|gitarr|klavier/.test(c)) return 'musik';
  if (/kreat|mal|kunst|werk|bast/.test(c)) return 'kreativ';
  // hash fallback so each course gets a stable color
  var keys = ['eltern-kind','bewegung','musik','kreativ'];
  var h = 0; var id = String((a && (a.id || a.title)) || '');
  for (var i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
  return keys[h % keys.length];
};

window.__kalDayDE = function(key) {
  var m = { MO: 'Montag', TU: 'Dienstag', WE: 'Mittwoch', TH: 'Donnerstag', FR: 'Freitag', SA: 'Samstag', SU: 'Sonntag' };
  return m[key] || key;
};
window.__kalRoomName = function(roomId) {
  var s = window.dashboardState; if (!s || !roomId) return null;
  var rooms = s.rooms || [];
  var r = rooms.find(function(x) { return x && x.id === roomId; });
  return (r && (r.name || r.title)) || null;
};
window.__kalLoadRooms = async function() {
  var s = window.dashboardState; if (!s) return;
  if (s.rooms && s.rooms.length >= 0) return;  // already attempted
  try {
    var r = await s.api('/rooms');
    s.rooms = r.data || r.rooms || r || [];
  } catch (e) {
    s.rooms = [];
    console.warn('[Kal] /rooms load failed', e);
  }
};

window.__kalStartOfWeek = function(d) {
  var x = new Date(d); x.setHours(0,0,0,0);
  var dow = x.getDay();
  var diff = (dow + 6) % 7;
  x.setDate(x.getDate() - diff);
  return x;
};
window.__kalActivitiesOnDate = function(date) {
  var s = window.dashboardState; if (!s) return [];
  var ks = window.__kalState || {};
  var dayKeys = ['MO','TU','WE','TH','FR','SA','SU'];
  var dKey = dayKeys[(date.getDay() + 6) % 7];
  // TZ-safe: parse YYYY-MM-DD into local midnight to match `date`
  function _parseLocalDate(s) {
    if (!s) return null;
    var p = String(s).slice(0, 10).split('-');
    if (p.length !== 3) return null;
    return new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
  }
  var out = [];
  (s.activities || []).forEach(function(a) {
    // Pause-Sync: pausierte Kurse werden im Kalender ausgeblendet (konsistent mit Dashboard-Hauptseite)
    if (!a || a.status === 'archived' || a.status === 'cancelled' || a.status === 'paused' || a.pausedAt) return;
    if (ks.room && a.roomId !== ks.room) return;
    var slots = (a.schedule && a.schedule.slots) || [];
    slots.forEach(function(slot) {
      if (slot.day !== dKey) return;
      var sdRaw = a.schedule && a.schedule.startDate;
      var edRaw = a.schedule && a.schedule.endDate;
      var sd = _parseLocalDate(sdRaw);
      var ed = _parseLocalDate(edRaw);
      if (sd && sd > date) return;
      if (ed && ed < date) return;
      out.push({ a: a, slot: slot });
    });
  });
  return out;
};
window.__kalCountBooked = function(a) {
  var s = window.dashboardState; if (!s) return 0;
  return (s.bookings || []).filter(function(b) {
    return b && b.activityId === a.id && b.status !== 'cancelled' && b.status !== 'refunded';
  }).length;
};
// Effective booked count for a specific date — adjusts for today's krank/Add-Up.
// For non-today dates, returns block-level count (no per-day adjustment).
window.__kalEffectiveBooked = function(a, dateObj) {
  var raw = window.__kalCountBooked(a);
  if (!dateObj || !a) return raw;
  var s = window.dashboardState; if (!s) return raw;
  var canc = s.todayCancByActivity || {};
  var todayYmd = (function(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); })(new Date());
  var thisYmd = (function(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); })(dateObj);
  if (thisYmd !== todayYmd) return raw;
  var meta = canc[a.id] || { cancelled: 0, addUp: 0 };
  return Math.max(0, raw - (meta.cancelled || 0) + (meta.addUp || 0));
};
// Returns { sick, addUp } for a specific date (today only currently).
window.__kalCancMeta = function(a, dateObj) {
  if (!dateObj || !a) return { sick: 0, addUp: 0 };
  var s = window.dashboardState; if (!s) return { sick: 0, addUp: 0 };
  var canc = s.todayCancByActivity || {};
  var todayYmd = (function(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); })(new Date());
  var thisYmd = (function(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); })(dateObj);
  if (thisYmd !== todayYmd) return { sick: 0, addUp: 0 };
  var meta = canc[a.id] || { cancelled: 0, addUp: 0 };
  return { sick: meta.cancelled || 0, addUp: meta.addUp || 0 };
};
window.__kalAssignLanes = function(events) {
  events.sort(function(x, y) { return (x.startMin - y.startMin) || (x.endMin - y.endMin); });
  var lanes = []; // each lane = list of placed events
  events.forEach(function(ev) {
    var placed = false;
    for (var li = 0; li < lanes.length; li++) {
      var last = lanes[li][lanes[li].length - 1];
      if (last.endMin <= ev.startMin) {
        ev.lane = li; lanes[li].push(ev); placed = true; break;
      }
    }
    if (!placed) { ev.lane = lanes.length; lanes.push([ev]); }
  });
  events.forEach(function(ev) { ev.laneCount = lanes.length; });
  return events;
};

window.__renderKalender = function() {
  var s = window.dashboardState; if (!s) return;
  var ks = window.__kalState;
  var months = ['Januar','Februar','Mär'+'z','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
  var monthsShort = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  var dayLabels = ['Mo','Di','Mi','Do','Fr','Sa','So'];
  var dayLabelsLong = ['Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag','Sonntag'];

  // ---------- toggle buttons + panel visibility ----------
  document.querySelectorAll('.cal-view-btn').forEach(function(btn) {
    if (btn.dataset.view === ks.view) btn.classList.add('active');
    else btn.classList.remove('active');
  });
  document.querySelectorAll('#phKalWeek, #phKalDay, #phKalMonth').forEach(function(p) {
    if (p.dataset.view === ks.view) p.classList.add('active');
    else p.classList.remove('active');
  });

  // ---------- header label ----------
  var titleEl = document.getElementById('phKalTitle');
  var subEl = document.getElementById('phKalSub');
  var kickerEl = document.getElementById('phKalKicker');
  var headerLabel = '', kickerLabel = '';
  if (ks.view === 'week') {
    var ws = window.__kalStartOfWeek(ks.anchor);
    var we = new Date(ws); we.setDate(ws.getDate() + 6);
    var jsWeekNum = (function(d) {
      var t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
      var dow = t.getUTCDay() || 7;
      t.setUTCDate(t.getUTCDate() + 4 - dow);
      var ys = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
      return Math.ceil(((t - ys) / 86400000 + 1) / 7);
    })(ws);
    kickerLabel = 'Woche ' + jsWeekNum + ' · ' + ws.getDate() + '. ' + monthsShort[ws.getMonth()] + ' – ' + we.getDate() + '. ' + monthsShort[we.getMonth()] + ' ' + we.getFullYear();
    headerLabel = months[ws.getMonth()] + ' <em>' + ws.getFullYear() + '</em>';
  } else if (ks.view === 'day') {
    kickerLabel = 'Tagesansicht';
    headerLabel = dayLabelsLong[(ks.dayDate.getDay() + 6) % 7] + ' ' + ks.dayDate.getDate() + '. ' + monthsShort[ks.dayDate.getMonth()] + ' <em>' + ks.dayDate.getFullYear() + '</em>';
  } else {
    kickerLabel = 'Monatsansicht';
    headerLabel = months[ks.anchor.getMonth()] + ' <em>' + ks.anchor.getFullYear() + '</em>';
  }
  if (titleEl) titleEl.innerHTML = headerLabel;
  if (kickerEl) kickerEl.textContent = kickerLabel;

  // ---------- WEEK ----------
  if (ks.view === 'week') {
    var ws = window.__kalStartOfWeek(ks.anchor);
    var today = new Date(); today.setHours(0,0,0,0);

    // Find min/max hours from events to size grid (default 09-18, expand if needed)
    var minH = 9, maxH = 18;
    for (var di = 0; di < 7; di++) {
      var dd = new Date(ws); dd.setDate(ws.getDate() + di);
      var evs = window.__kalActivitiesOnDate(dd);
      evs.forEach(function(e) {
        var st = (e.slot.startTime || '09:00');
        var et = (e.slot.endTime || st);
        var sH = parseInt(st.slice(0,2),10);
        var eH = parseInt(et.slice(0,2),10) + (parseInt(et.slice(3,5),10) > 0 ? 1 : 0);
        if (sH < minH) minH = sH;
        if (eH > maxH) maxH = eH;
      });
    }
    if (minH > 7) minH = Math.max(7, minH);
    if (maxH < 19) maxH = Math.min(22, Math.max(maxH, 18));
    var hourCount = maxH - minH;
    var slotPx = 56;

    // header row
    var head = '<div class="cal-grid"><div class="cal-grid-head"><div></div>';
    var totalThisWeek = 0;
    for (var i = 0; i < 7; i++) {
      var d = new Date(ws); d.setDate(ws.getDate() + i);
      var isToday = d.getTime() === today.getTime();
      head += '<div' + (isToday ? ' class="today"' : '') + '><span class="day-label">' + dayLabels[i] + '</span><span class="day-date">' + String(d.getDate()).padStart(2,'0') + '</span></div>';
    }
    head += '</div>';

    // body
    var body = '<div class="cal-grid-body">';
    var timeCol = '<div class="cal-time-col">';
    for (var h = 0; h < hourCount; h++) {
      timeCol += '<div class="cal-time-slot">' + String(minH + h).padStart(2,'0') + ':00</div>';
    }
    timeCol += '</div>';
    body += timeCol;

    var totalParticipants = 0;
    for (var i = 0; i < 7; i++) {
      var d = new Date(ws); d.setDate(ws.getDate() + i);
      var isToday = d.getTime() === today.getTime();
      var isWeekend = (i === 5 || i === 6);
      var classes = ['cal-day-col'];
      if (isToday) classes.push('today');
      if (isWeekend) classes.push('weekend');
      var col = '<div class="' + classes.join(' ') + '" data-iso="' + d.toISOString() + '" data-min-h="' + minH + '" data-slot-px="' + slotPx + '">';
      // hour cells
      for (var h = 0; h < hourCount; h++) {
        var hr = String(minH + h).padStart(2,'0') + ':00';
        col += '<div class="cal-hour" onclick="window.__kalCellClick(\'' + d.toISOString() + '\',\'' + hr + '\')"></div>';
      }
      // events
      var evs = window.__kalActivitiesOnDate(d);
      var evBlocks = evs.map(function(e) {
        var st = (e.slot.startTime || '09:00');
        var et = (e.slot.endTime || st);
        var sH = parseInt(st.slice(0,2),10) + parseInt(st.slice(3,5),10)/60;
        var eH = parseInt(et.slice(0,2),10) + parseInt(et.slice(3,5),10)/60;
        if (eH <= sH) eH = sH + 1;
        return {
          a: e.a, slot: e.slot,
          startMin: sH * 60, endMin: eH * 60,
          top: (sH - minH) * slotPx,
          height: Math.max(28, (eH - sH) * slotPx - 2),
          startTime: st, endTime: et,
        };
      });
      window.__kalAssignLanes(evBlocks);
      evBlocks.forEach(function(ev) {
        var booked = window.__kalEffectiveBooked(ev.a, d);
        var cap = ev.a.capacity || 0;
        var isFull = cap > 0 && booked >= cap;
        var roomLabel = window.__kalRoomName(ev.a.roomId) || ev.a.roomName || '';
        var cMeta = window.__kalCancMeta(ev.a, d);
        var hintBits = [];
        if (cMeta.sick > 0) hintBits.push(cMeta.sick + ' krank');
        if (cMeta.addUp > 0) hintBits.push(cMeta.addUp + ' Add-Up');
        var hintTxt = hintBits.length ? ' (' + hintBits.join(' · ') + ')' : '';
        var meta = ev.startTime + (roomLabel ? ' · ' + roomLabel : '') + ' · ' + (isFull ? 'voll' : (booked + '/' + cap)) + hintTxt;
        var cls = ['cal-event', window.__kalCatClass(ev.a)];
        if (isFull) cls.push('full');
        if (ev.laneCount > 1) cls.push('lane-' + ev.lane + '-of-' + ev.laneCount);
        var titleEsc = (window.escapeHtml || function(x){ return x; })(ev.a.title || 'Kurs');
        col += '<div class="' + cls.join(' ') + '" draggable="true" data-act-id="' + ev.a.id + '" data-dur="' + (ev.endMin - ev.startMin) + '" data-orig-day="' + ev.slot.day + '" data-orig-start="' + ev.startTime + '" data-orig-end="' + ev.endTime + '" style="top:' + ev.top + 'px;height:' + ev.height + 'px;" onclick="event.stopPropagation();if(!window.__kalSuppressClick){window.viewCourseDetail(\'' + ev.a.id + '\')}" title="' + titleEsc + ' · ' + meta + ' · Ziehen zum Verschieben">'
          + '<div class="cal-event-title">' + titleEsc + '</div>'
          + '<div class="cal-event-meta">' + meta + '</div>'
          + '</div>';
      });
      // now-line on today
      if (isToday) {
        var nowD = new Date();
        var nowH = nowD.getHours() + nowD.getMinutes()/60;
        if (nowH >= minH && nowH <= maxH) {
          var nowTop = (nowH - minH) * slotPx;
          col += '<div style="position:absolute;left:0;right:0;top:' + nowTop + 'px;height:2px;background:var(--primary);z-index:5;pointer-events:none">'
            + '<div style="position:absolute;left:-5px;top:-4px;width:10px;height:10px;border-radius:50%;background:var(--primary)"></div>'
            + '</div>';
        }
      }
      col += '</div>';
      body += col;
      totalThisWeek += evs.length;
      evs.forEach(function(e) { totalParticipants += window.__kalEffectiveBooked(e.a, d); });
    }
    body += '</div></div>';
    document.getElementById('phKalWeek').innerHTML = head + body;
    window.__kalDragInit && window.__kalDragInit();

    if (subEl) subEl.textContent = totalThisWeek + ' Termin' + (totalThisWeek === 1 ? '' : 'e') + ' in dieser Woche · ' + totalParticipants + ' Teilnehmer';
  }

  // ---------- DAY ----------
  if (ks.view === 'day') {
    var ws = window.__kalStartOfWeek(ks.anchor);
    var today = new Date(); today.setHours(0,0,0,0);

    // Day strip
    var stripHtml = '<div class="day-strip">';
    for (var i = 0; i < 7; i++) {
      var d = new Date(ws); d.setDate(ws.getDate() + i);
      var isActive = d.getTime() === ks.dayDate.getTime();
      var evs = window.__kalActivitiesOnDate(d);
      var dotsHtml = '<div class="day-strip-dots">';
      evs.slice(0, 3).forEach(function(e) {
        var cc = window.__kalCatClass(e.a);
        var cls = (cc === 'eltern-kind' || cc === 'kreativ') ? '' : (cc === 'bewegung' ? 'sage' : 'musik');
        dotsHtml += '<span class="d ' + cls + '"></span>';
      });
      dotsHtml += '</div>';
      stripHtml += '<button class="day-strip-day' + (isActive ? ' active' : '') + '" onclick="window.__kalSetDay(\'' + d.toISOString() + '\')">'
        + '<div class="day-strip-label">' + dayLabels[i] + '</div>'
        + '<div class="day-strip-date">' + String(d.getDate()).padStart(2,'0') + '</div>'
        + dotsHtml
        + '</button>';
    }
    stripHtml += '</div>';

    // Build room columns:
    //  - Wenn Provider 2+ konfigurierte Räume hat → alle Räume als Spalten (auch leere)
    //  - Wenn Provider 0/1 Räume → 1 einzelne Spalte (keine "frei"-Pads)
    var todayEvs = window.__kalActivitiesOnDate(ks.dayDate);
    var roomMap = {};
    todayEvs.forEach(function(e) {
      var rid = e.a.roomId || '_none_';
      var rname = window.__kalRoomName(e.a.roomId) || e.a.roomName || (e.a.roomId ? 'Raum' : 'Ohne Raum');
      roomMap[rid] = rname;
    });
    var configuredRooms = (s && s.rooms) || [];
    var roomIds;
    if (configuredRooms.length >= 2) {
      // Multi-Room-Provider: alle konfigurierten Räume zeigen
      roomIds = configuredRooms.map(function(r) { return r.id; });
      configuredRooms.forEach(function(r) {
        if (!roomMap[r.id]) roomMap[r.id] = r.name || r.title || ('Raum ' + r.id);
      });
    } else {
      // Single-Room oder kein Raum: nur eine Spalte, kein Padding
      roomIds = Object.keys(roomMap);
      if (roomIds.length === 0) roomIds = ['_none_'];
      else if (roomIds.length > 1) roomIds = roomIds.slice(0, 1); // safety: collapse falls heute mehrere Rooms in events
    }

    // Determine hour range
    var minH = 9, maxH = 18;
    todayEvs.forEach(function(e) {
      var st = e.slot.startTime || '09:00';
      var et = e.slot.endTime || st;
      var sH = parseInt(st.slice(0,2),10);
      var eH = parseInt(et.slice(0,2),10) + (parseInt(et.slice(3,5),10) > 0 ? 1 : 0);
      if (sH < minH) minH = Math.max(7, sH);
      if (eH > maxH) maxH = Math.min(22, eH);
    });
    var hourCount = maxH - minH;
    var slotPx = 80;

    // Head
    var head = '<div class="day-grid"><div class="day-grid-head" style="grid-template-columns:80px repeat(' + roomIds.length + ', 1fr)"><div></div>';
    roomIds.forEach(function(rid) {
      if (rid === '_none_') {
        head += '<div><span class="room-label">—</span><span class="room-sub">Heute</span></div>';
      } else {
        var rname = window.__kalRoomName(rid) || roomMap[rid] || rid;
        head += '<div><span class="room-label">' + (window.escapeHtml ? window.escapeHtml(rname) : rname) + '</span><span class="room-sub">Heute</span></div>';
      }
    });
    head += '</div>';
    // body
    var body = '<div class="day-grid-body" style="grid-template-columns:80px repeat(' + roomIds.length + ', 1fr)">';
    var timeCol = '<div class="day-time-col">';
    for (var h = 0; h < hourCount; h++) {
      timeCol += '<div class="day-time-slot">' + String(minH + h).padStart(2,'0') + ':00</div>';
    }
    timeCol += '</div>';
    body += timeCol;

    roomIds.forEach(function(rid) {
      var col = '<div class="day-room-col" data-room-id="' + rid + '" data-iso="' + ks.dayDate.toISOString() + '" data-min-h="' + minH + '" data-slot-px="' + slotPx + '">';
      for (var h = 0; h < hourCount; h++) {
        var hr = String(minH + h).padStart(2,'0') + ':00';
        col += '<div class="day-hour" onclick="window.__kalCellClick(\'' + ks.dayDate.toISOString() + '\',\'' + hr + '\')"></div>';
      }
      if (rid.indexOf('_pad_') !== 0) {
        var roomEvs = todayEvs.filter(function(e) { return (e.a.roomId || '_none_') === rid; });
        var blocks = roomEvs.map(function(e) {
          var st = e.slot.startTime || '09:00';
          var et = e.slot.endTime || st;
          var sH = parseInt(st.slice(0,2),10) + parseInt(st.slice(3,5),10)/60;
          var eH = parseInt(et.slice(0,2),10) + parseInt(et.slice(3,5),10)/60;
          if (eH <= sH) eH = sH + 1;
          return { a: e.a, top: (sH - minH) * slotPx, height: Math.max(40, (eH - sH) * slotPx - 4), startTime: st, endTime: et };
        });
        blocks.forEach(function(ev) {
          var booked = window.__kalEffectiveBooked(ev.a, ks.dayDate);
          var cap = ev.a.capacity || 0;
          var isFull = cap > 0 && booked >= cap;
          var cMeta = window.__kalCancMeta(ev.a, ks.dayDate);
          var hintBits = [];
          if (cMeta.sick > 0) hintBits.push(cMeta.sick + ' krank');
          if (cMeta.addUp > 0) hintBits.push(cMeta.addUp + ' Add-Up');
          var hintTxt = hintBits.length ? ' · ' + hintBits.join(' · ') : '';
          var cls = ['day-event', window.__kalCatClass(ev.a)];
          if (isFull) cls.push('full');
          var titleEsc = (window.escapeHtml || function(x){ return x; })(ev.a.title || 'Kurs');
          col += '<div class="' + cls.join(' ') + '" draggable="true" data-act-id="' + ev.a.id + '" data-dur="' + Math.round(((parseInt(ev.endTime.slice(0,2),10)*60+parseInt(ev.endTime.slice(3,5),10)) - (parseInt(ev.startTime.slice(0,2),10)*60+parseInt(ev.startTime.slice(3,5),10)))) + '" data-orig-start="' + ev.startTime + '" data-orig-end="' + ev.endTime + '" data-orig-room="' + (ev.a.roomId || '') + '" style="top:' + ev.top + 'px;height:' + ev.height + 'px;" onclick="event.stopPropagation();if(!window.__kalSuppressClick){window.viewCourseDetail(\'' + ev.a.id + '\')}">'
            + '<div class="day-event-title">' + titleEsc + '</div>'
            + '<div class="day-event-time">' + ev.startTime + ' – ' + ev.endTime + '</div>'
            + '<div class="day-event-meta">' + (isFull ? 'ausgebucht' : (booked + '/' + cap + ' Pl' + 'ä' + 'tze')) + hintTxt + '</div>'
            + '</div>';
        });
      }
      col += '</div>';
      body += col;
    });
    body += '</div></div>';
    document.getElementById('phKalDay').innerHTML = stripHtml + head + body;
    window.__kalDayDragInit && window.__kalDayDragInit();
    if (subEl) subEl.textContent = todayEvs.length + ' Termin' + (todayEvs.length === 1 ? '' : 'e') + ' an diesem Tag';
  }

  // ---------- MONTH ----------
  if (ks.view === 'month') {
    var first = new Date(ks.anchor.getFullYear(), ks.anchor.getMonth(), 1);
    var firstDow = (first.getDay() + 6) % 7;
    var gridStart = new Date(first); gridStart.setDate(first.getDate() - firstDow);
    var today = new Date(); today.setHours(0,0,0,0);

    var html = '<div class="month-grid"><div class="month-head">';
    dayLabelsLong.forEach(function(l) { html += '<div>' + l + '</div>'; });
    html += '</div><div class="month-body">';

    var monthCount = 0;
    for (var c = 0; c < 42; c++) {
      var d = new Date(gridStart); d.setDate(gridStart.getDate() + c);
      var inMonth = d.getMonth() === ks.anchor.getMonth();
      var isToday = d.getTime() === today.getTime();
      var isWeekend = ((d.getDay() + 6) % 7) >= 5;
      var classes = ['month-day'];
      if (!inMonth) classes.push('other-month');
      if (isToday) classes.push('today');
      if (isWeekend) classes.push('weekend');

      var evs = window.__kalActivitiesOnDate(d);
      evs.sort(function(x, y) { return (x.slot.startTime || '').localeCompare(y.slot.startTime || ''); });
      if (inMonth) monthCount += evs.length;

      var maxShow = 3;
      var evHtml = evs.slice(0, maxShow).map(function(e) {
        var st = (e.slot.startTime || '').slice(0,5);
        var titleEsc = (window.escapeHtml || function(x){ return x; })(e.a.title || 'Kurs');
        return '<div class="month-evt ' + window.__kalCatClass(e.a) + '" onclick="event.stopPropagation();window.viewCourseDetail(\'' + e.a.id + '\')"><span style="opacity:.7;margin-right:3px">' + st + '</span>' + titleEsc + '</div>';
      }).join('');
      if (evs.length > maxShow) evHtml += '<div class="month-more">+' + (evs.length - maxShow) + ' weitere</div>';

      html += '<div class="' + classes.join(' ') + '" onclick="window.__kalSetDay(\'' + d.toISOString() + '\')">'
        + '<div class="month-day-num">' + d.getDate() + '</div>'
        + evHtml
        + '</div>';
    }
    html += '</div></div>';
    document.getElementById('phKalMonth').innerHTML = html;
    if (subEl) subEl.textContent = monthCount + ' Termin' + (monthCount === 1 ? '' : 'e') + ' in diesem Monat';
  }
};

window.__kalNav = function(dir) {
  var ks = window.__kalState; if (!ks) return;
  var d = new Date(ks.anchor);
  if (ks.view === 'week') d.setDate(d.getDate() + dir * 7);
  else if (ks.view === 'day') {
    d = new Date(ks.dayDate); d.setDate(d.getDate() + dir);
    ks.dayDate = d; ks.anchor = d;
    return window.__renderKalender();
  }
  else d.setMonth(d.getMonth() + dir);
  ks.anchor = d;
  window.__renderKalender();
};
window.__kalToday = function() {
  if (!window.__kalState) return;
  var t = new Date(); t.setHours(0,0,0,0);
  window.__kalState.anchor = t;
  window.__kalState.dayDate = new Date(t);
  window.__renderKalender();
};
window.__kalSetView = function(v) {
  if (!window.__kalState) return;
  window.__kalState.view = v;
  window.__renderKalender();
};
window.__kalSetDay = function(iso) {
  if (!window.__kalState) return;
  var d = new Date(iso); d.setHours(0,0,0,0);
  window.__kalState.dayDate = d;
  window.__kalState.anchor = d;
  window.__kalState.view = 'day';
  window.__renderKalender();
};
window.__kalSetRoom = function(rid) {
  if (!window.__kalState) return;
  window.__kalState.room = rid || '';
  window.__renderKalender();
};
window.__kalCellClick = function(iso, hr) {
  // Create a course at this slot — pre-fill kurs creator if possible
  if (typeof window.openKursCreatorV2 === 'function') {
    var d = new Date(iso);
    var dayKeys = ['MO','TU','WE','TH','FR','SA','SU'];
    var dKey = dayKeys[(d.getDay() + 6) % 7];
    window.openKursCreatorV2({ prefill: { schedule: { slots: [{ day: dKey, startTime: hr, endTime: '' }] } } });
  }
};

window.__kalDragInit = function() {
  var root = document.getElementById('phKalWeek');
  if (!root || root.__dragWired) return;
  root.__dragWired = true;
  var dragData = null;
  var ghostEl = null;

  function pad2(n) { n = Math.round(n); return (n < 10 ? '0' : '') + n; }
  function snap15(min) { return Math.round(min / 15) * 15; }
  function timeFromMin(m) {
    var h = Math.floor(m / 60); var mm = m % 60;
    if (h < 0) h = 0; if (h > 23) h = 23;
    return pad2(h) + ':' + pad2(mm);
  }
  function dayKeyFromIso(iso) {
    var d = new Date(iso);
    var keys = ['MO','TU','WE','TH','FR','SA','SU'];
    return keys[(d.getDay() + 6) % 7];
  }

  root.addEventListener('dragstart', function(e) {
    var ev = e.target.closest('.cal-event');
    if (!ev) return;
    var col = ev.parentElement;
    var minH = parseInt(col.dataset.minH || '9', 10);
    var slotPx = parseInt(col.dataset.slotPx || '56', 10);
    dragData = {
      actId: ev.dataset.actId,
      dur: parseInt(ev.dataset.dur, 10),
      origDay: ev.dataset.origDay,
      origStart: ev.dataset.origStart,
      origEnd: ev.dataset.origEnd,
      minH: minH,
      slotPx: slotPx,
      offsetY: e.offsetY || 0,
      el: ev,
    };
    e.dataTransfer.effectAllowed = 'move';
    try { e.dataTransfer.setData('text/plain', ev.dataset.actId); } catch (_) {}
    ev.style.opacity = '0.4';
    window.__kalSuppressClick = true;
  });

  root.addEventListener('dragend', function(e) {
    if (dragData && dragData.el) dragData.el.style.opacity = '';
    if (ghostEl && ghostEl.parentElement) ghostEl.parentElement.removeChild(ghostEl);
    ghostEl = null;
    dragData = null;
    setTimeout(function() { window.__kalSuppressClick = false; }, 50);
  });

  root.addEventListener('dragover', function(e) {
    if (!dragData) return;
    var col = e.target.closest('.cal-day-col');
    if (!col) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    // Place ghost
    var rect = col.getBoundingClientRect();
    var y = e.clientY - rect.top - dragData.offsetY;
    if (y < 0) y = 0;
    var minH = parseInt(col.dataset.minH, 10);
    var slotPx = parseInt(col.dataset.slotPx, 10);
    var minutes = (y / slotPx) * 60 + minH * 60;
    minutes = snap15(minutes);
    var top = (minutes - minH * 60) / 60 * slotPx;
    var heightPx = (dragData.dur / 60) * slotPx;
    if (!ghostEl) {
      ghostEl = document.createElement('div');
      ghostEl.style.cssText = 'position:absolute;left:6px;right:6px;background:rgba(204,137,94,0.18);border:2px dashed var(--primary);border-radius:8px;pointer-events:none;z-index:10;';
      ghostEl.innerHTML = '<div style="position:absolute;top:4px;left:8px;font-size:11px;font-weight:700;color:var(--primary);">' + timeFromMin(minutes) + '</div>';
    }
    if (ghostEl.parentElement !== col) col.appendChild(ghostEl);
    ghostEl.style.top = top + 'px';
    ghostEl.style.height = Math.max(28, heightPx) + 'px';
    ghostEl.firstChild.textContent = timeFromMin(minutes);
    ghostEl.dataset.iso = col.dataset.iso;
    ghostEl.dataset.minutes = minutes;
  });

  root.addEventListener('drop', async function(e) {
    if (!dragData) return;
    var col = e.target.closest('.cal-day-col');
    if (!col) return;
    e.preventDefault();
    var rect = col.getBoundingClientRect();
    var y = e.clientY - rect.top - dragData.offsetY;
    if (y < 0) y = 0;
    var minH = parseInt(col.dataset.minH, 10);
    var slotPx = parseInt(col.dataset.slotPx, 10);
    var startMin = snap15((y / slotPx) * 60 + minH * 60);
    var endMin = startMin + dragData.dur;
    var newDayKey = dayKeyFromIso(col.dataset.iso);
    var newStart = timeFromMin(startMin);
    var newEnd = timeFromMin(endMin);

    if (newDayKey === dragData.origDay && newStart === dragData.origStart) {
      // No effective change — clean up
      if (ghostEl && ghostEl.parentElement) ghostEl.parentElement.removeChild(ghostEl);
      ghostEl = null;
      return;
    }

    // Optimistic update
    var s = window.dashboardState; if (!s) return;
    var act = (s.activities || []).find(function(a) { return a && a.id === dragData.actId; });
    if (!act) return;
    var newSchedule = JSON.parse(JSON.stringify(act.schedule || { slots: [] }));
    if (!newSchedule.slots || !newSchedule.slots.length) newSchedule.slots = [{}];
    newSchedule.slots[0].day = newDayKey;
    newSchedule.slots[0].startTime = newStart;
    newSchedule.slots[0].endTime = newEnd;

    var origSchedule = act.schedule;
    act.schedule = newSchedule;
    window.__renderKalender();

    // Send PUT
    try {
      var token = (s.token) || '';
      var resp = await fetch('/api/activities/' + dragData.actId, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token,
        },
        body: JSON.stringify({ schedule: newSchedule }),
      });
      if (!resp.ok) {
        var errBody = await resp.json().catch(function() { return {}; });
        throw new Error((errBody && (errBody.error || errBody.message)) || ('Server-Fehler ' + resp.status));
      }
      // Toast
      if (typeof window.ukcToast === 'function') {
        window.ukcToast('Kurs verschoben: ' + window.__kalDayDE(newDayKey) + ' ' + newStart);
      } else {
        var t = document.createElement('div');
        t.textContent = 'Kurs verschoben auf ' + newStart;
        t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:999px;font-size:13px;font-weight:500;z-index:10000;box-shadow:0 6px 24px rgba(0,0,0,.2)';
        document.body.appendChild(t);
        setTimeout(function() { t.style.opacity = '0'; t.style.transition = 'opacity .3s'; }, 1800);
        setTimeout(function() { t.remove(); }, 2200);
      }
    } catch (err) {
      // Revert
      act.schedule = origSchedule;
      window.__renderKalender();
      var msg = err && err.message ? err.message : 'Konnte Kurs nicht verschieben.';
      if (typeof window.ukcShowDetailModal === 'function') {
        window.ukcShowDetailModal({ title: 'Verschieben fehlgeschlagen', body: '<p style="color:var(--signal)">' + msg + '</p>' });
      } else {
        alert(msg);
      }
    }
  });
};
window.__kalDayDragInit = function() {
  var root = document.getElementById('phKalDay');
  if (!root || root.__dragWired) return;
  root.__dragWired = true;
  var dragData = null;
  var ghostEl = null;

  function pad2(n) { n = Math.round(n); return (n < 10 ? '0' : '') + n; }
  function snap15(min) { return Math.round(min / 15) * 15; }
  function timeFromMin(m) {
    var h = Math.floor(m / 60); var mm = m % 60;
    if (h < 0) h = 0; if (h > 23) h = 23;
    return pad2(h) + ':' + pad2(mm);
  }

  root.addEventListener('dragstart', function(e) {
    var ev = e.target.closest('.day-event');
    if (!ev) return;
    var col = ev.parentElement;
    dragData = {
      actId: ev.dataset.actId,
      dur: parseInt(ev.dataset.dur, 10) || 60,
      origStart: ev.dataset.origStart,
      origEnd: ev.dataset.origEnd,
      origRoom: ev.dataset.origRoom,
      minH: parseInt(col.dataset.minH || '9', 10),
      slotPx: parseInt(col.dataset.slotPx || '80', 10),
      offsetY: e.offsetY || 0,
      el: ev,
    };
    e.dataTransfer.effectAllowed = 'move';
    try { e.dataTransfer.setData('text/plain', ev.dataset.actId); } catch (_) {}
    ev.style.opacity = '0.4';
    window.__kalSuppressClick = true;
  });

  root.addEventListener('dragend', function() {
    if (dragData && dragData.el) dragData.el.style.opacity = '';
    if (ghostEl && ghostEl.parentElement) ghostEl.parentElement.removeChild(ghostEl);
    ghostEl = null;
    dragData = null;
    setTimeout(function() { window.__kalSuppressClick = false; }, 50);
  });

  root.addEventListener('dragover', function(e) {
    if (!dragData) return;
    var col = e.target.closest('.day-room-col');
    if (!col || !col.dataset.roomId || col.dataset.roomId.indexOf('_pad_') === 0) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    var rect = col.getBoundingClientRect();
    var y = e.clientY - rect.top - dragData.offsetY;
    if (y < 0) y = 0;
    var minH = parseInt(col.dataset.minH, 10);
    var slotPx = parseInt(col.dataset.slotPx, 10);
    var minutes = (y / slotPx) * 60 + minH * 60;
    minutes = snap15(minutes);
    var top = (minutes - minH * 60) / 60 * slotPx;
    var heightPx = (dragData.dur / 60) * slotPx;
    if (!ghostEl) {
      ghostEl = document.createElement('div');
      ghostEl.style.cssText = 'position:absolute;left:6px;right:6px;background:rgba(204,137,94,0.18);border:2px dashed var(--primary);border-radius:8px;pointer-events:none;z-index:10;';
      ghostEl.innerHTML = '<div style="position:absolute;top:6px;left:10px;font-size:12px;font-weight:700;color:var(--primary);">' + timeFromMin(minutes) + '</div>';
    }
    if (ghostEl.parentElement !== col) col.appendChild(ghostEl);
    ghostEl.style.top = top + 'px';
    ghostEl.style.height = Math.max(40, heightPx) + 'px';
    ghostEl.firstChild.textContent = timeFromMin(minutes);
  });

  root.addEventListener('drop', async function(e) {
    if (!dragData) return;
    var col = e.target.closest('.day-room-col');
    if (!col || !col.dataset.roomId || col.dataset.roomId.indexOf('_pad_') === 0) return;
    e.preventDefault();
    var rect = col.getBoundingClientRect();
    var y = e.clientY - rect.top - dragData.offsetY;
    if (y < 0) y = 0;
    var minH = parseInt(col.dataset.minH, 10);
    var slotPx = parseInt(col.dataset.slotPx, 10);
    var startMin = snap15((y / slotPx) * 60 + minH * 60);
    var endMin = startMin + dragData.dur;
    var newStart = timeFromMin(startMin);
    var newEnd = timeFromMin(endMin);
    var newRoomId = col.dataset.roomId === '_none_' ? null : col.dataset.roomId;

    if (newRoomId === (dragData.origRoom || null) && newStart === dragData.origStart) {
      if (ghostEl && ghostEl.parentElement) ghostEl.parentElement.removeChild(ghostEl);
      ghostEl = null;
      return;
    }

    var s = window.dashboardState; if (!s) return;
    var act = (s.activities || []).find(function(a) { return a && a.id === dragData.actId; });
    if (!act) return;
    var origSchedule = act.schedule;
    var origRoomId = act.roomId;
    var newSchedule = JSON.parse(JSON.stringify(act.schedule || { slots: [] }));
    if (!newSchedule.slots || !newSchedule.slots.length) newSchedule.slots = [{}];
    newSchedule.slots[0].startTime = newStart;
    newSchedule.slots[0].endTime = newEnd;
    act.schedule = newSchedule;
    if (newRoomId !== undefined) act.roomId = newRoomId;

    window.__renderKalender();

    try {
      var token = (s.token) || '';
      var resp = await fetch('/api/activities/' + dragData.actId, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ schedule: newSchedule, roomId: newRoomId }),
      });
      if (!resp.ok) {
        var errBody = await resp.json().catch(function() { return {}; });
        throw new Error((errBody && (errBody.error || errBody.message)) || ('Server-Fehler ' + resp.status));
      }
      var roomLabel = window.__kalRoomName(newRoomId) || 'Ohne Raum';
      if (typeof window.ukcToast === 'function') {
        window.ukcToast('Kurs verschoben: ' + newStart + ' · ' + roomLabel);
      } else {
        var t = document.createElement('div');
        t.textContent = 'Kurs verschoben auf ' + newStart;
        t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:999px;font-size:13px;font-weight:500;z-index:10000;box-shadow:0 6px 24px rgba(0,0,0,.2)';
        document.body.appendChild(t);
        setTimeout(function() { t.style.opacity = '0'; t.style.transition = 'opacity .3s'; }, 1800);
        setTimeout(function() { t.remove(); }, 2200);
      }
    } catch (err) {
      act.schedule = origSchedule;
      act.roomId = origRoomId;
      window.__renderKalender();
      var msg = err && err.message ? err.message : 'Konnte Kurs nicht verschieben.';
      if (typeof window.ukcShowDetailModal === 'function') {
        window.ukcShowDetailModal({ title: 'Verschieben fehlgeschlagen', body: '<p style="color:var(--signal)">' + msg + '</p>' });
      } else {
        alert(msg);
      }
    }
  });
};


  // Phase 2a: SPA-Router (Section-Switching ohne Page-Reload)
// ============================================================
window.showSection = function(name) {
  document.querySelectorAll('.section').forEach(s => {
    s.hidden = (s.dataset.section !== name);
  });
  document.querySelectorAll('.nav-item').forEach(b => {
    if (b.dataset.sectionTarget === name) b.classList.add('active');
    else b.classList.remove('active');
  });
  // Scroll to top
  window.scrollTo({ top: 0, behavior: 'instant' });
  // Update URL
  if (location.hash !== '#' + name) {
    history.pushState({ section: name }, '', '#' + name);
  }
  // Trigger lazy load if section has loader.
  // Sections in alwaysRefresh re-run on every navigation (not cached) — prevents stale data
  // when user toggles status in another section and comes back.
  const alwaysRefresh = { embed: true, kursbloecke: true, integrationen: true };
  if (window.sectionLoaders && window.sectionLoaders[name]) {
    if (alwaysRefresh[name] || !window.sectionLoaded[name]) {
      window.sectionLoaders[name]();
      window.sectionLoaded[name] = true;
    }
  }
};
window.sectionLoaders = window.sectionLoaders || {};
window.sectionLoaded = window.sectionLoaded || {};

// Init: load section based on URL hash
function initSection() {
  const hash = location.hash.slice(1) || 'dashboard';
  const valid = !!document.querySelector('[data-section="' + hash + '"]');
  showSection(valid ? hash : 'dashboard');
}

window.addEventListener('hashchange', () => {
  const hash = location.hash.slice(1) || 'dashboard';
  showSection(hash);
});
window.addEventListener('popstate', initSection);

// Run init after DOMContentLoaded
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initSection);
} else {
  initSection();
}

// Logout — global function (called via onclick attribute)
window.dashboardV3Logout = function() {
  for (let i = localStorage.length - 1; i >= 0; i--) {
    const k = localStorage.key(i);
    if (k && k.startsWith('sb-')) localStorage.removeItem(k);
  }
  window.location.href = '/';
};
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.logout-btn').forEach(btn => {
    btn.onclick = window.dashboardV3Logout;
  });
});
document.querySelectorAll('.logout-btn').forEach(btn => {
  btn.onclick = window.dashboardV3Logout;
});
</script>

<script>

// ── Provider Postfach Loader ──
(function(){
  if (!window.sectionLoaders) window.sectionLoaders = {};

  var pfState = { threads: [], filter: 'all', activeParent: null };

  function escHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
  function relTime(iso) {
    if (!iso) return '';
    var d = new Date(iso);
    var diff = Date.now() - d.getTime();
    var mins = Math.floor(diff / 60000);
    if (mins < 1) return 'gerade eben';
    if (mins < 60) return 'vor ' + mins + ' Min';
    var hrs = Math.floor(mins / 60);
    if (hrs < 24) return 'vor ' + hrs + ' Std';
    var days = Math.floor(hrs / 24);
    if (days < 7) return 'vor ' + days + (days === 1 ? ' Tag' : ' Tagen');
    return d.toLocaleDateString('de-DE', { day: '2-digit', month: 'short' });
  }
  function tagFor(thread) {
    var b = (thread.latestPreview || '').toLowerCase();
    if (thread.latestType === 'system') return '<span class="pf-tag system">System</span>';
    if (b.indexOf('krank') >= 0) return '<span class="pf-tag urgent">Krank</span>';
    if (b.indexOf('storno') >= 0 || b.indexOf('pausier') >= 0) return '<span class="pf-tag eltern">Stornierung</span>';
    if (b.indexOf('probe') >= 0) return '<span class="pf-tag eltern">Probestunde</span>';
    if (b.indexOf('empfehl') >= 0) return '<span class="pf-tag eltern">Empfehlung</span>';
    if (thread.latestType === 'parent') return '<span class="pf-tag eltern">Frage</span>';
    return '';
  }

  function renderThreadList() {
    var listEl = document.getElementById('pfThreadList');
    if (!listEl) return;
    var threads = pfState.threads;

    // Filter
    var filtered = threads;
    if (pfState.filter === 'unread') filtered = threads.filter(function(t){ return t.unread > 0; });
    else if (pfState.filter === 'parent') filtered = threads.filter(function(t){
      return (t.messages || []).some(function(m){ return m.type === 'parent'; });
    });
    else if (pfState.filter === 'provider') filtered = threads.filter(function(t){
      return (t.messages || []).some(function(m){ return m.type === 'provider' || m.type === 'direct'; });
    });
    else if (pfState.filter === 'system') filtered = threads.filter(function(t){
      return (t.messages || []).some(function(m){ return m.type === 'system'; });
    });

    document.getElementById('pfThreadCount').textContent = filtered.length;

    if (!filtered.length) {
      listEl.innerHTML = '<div style="padding:40px 18px;text-align:center;color:var(--muted);font-size:13px"><div style="font-family:Lora,serif;font-size:18px;color:var(--ink);margin-bottom:6px">Keine <em>Nachrichten</em>.</div>Sobald Eltern dir schreiben oder du selbst schreibst, taucht es hier auf.</div>';
      return;
    }

    listEl.innerHTML = filtered.map(function(t) {
      var isActive = (t.parentId === pfState.activeParent);
      var unreadCls = t.unread > 0 ? ' unread' : '';
      var activeCls = isActive ? ' active' : '';
      var subject = (t.latestPreview || '').slice(0, 50);
      return '<div class="pf-thread' + unreadCls + activeCls + '" data-parent="' + escHtml(t.parentId) + '" onclick="__pfOpen(\'' + escHtml(t.parentId) + '\')">'
        + '<div class="pf-thread-head"><div class="pf-thread-name">' + escHtml(t.parentName) + '</div><div class="pf-thread-time">' + escHtml(relTime(t.latestAt)) + '</div></div>'
        + '<div class="pf-thread-subject">' + tagFor(t) + escHtml(subject) + (subject.length >= 50 ? '…' : '') + '</div>'
        + '<div class="pf-thread-preview">' + escHtml(t.latestPreview) + '</div>'
        + '</div>';
    }).join('');
  }

  function renderCounts() {
    var t = pfState.threads;
    document.getElementById('pfCntAll').textContent = t.length;
    document.getElementById('pfCntUnread').textContent = t.filter(function(x){ return x.unread > 0; }).length;
    document.getElementById('pfCntParent').textContent = t.filter(function(x){ return (x.messages || []).some(function(m){ return m.type === 'parent'; }); }).length;
    document.getElementById('pfCntProvider').textContent = t.filter(function(x){ return (x.messages || []).some(function(m){ return m.type === 'provider' || m.type === 'direct'; }); }).length;
    document.getElementById('pfCntSystem').textContent = t.filter(function(x){ return (x.messages || []).some(function(m){ return m.type === 'system'; }); }).length;
  }

  window.__pfOpen = function(parentId) {
    pfState.activeParent = parentId;
    var thread = pfState.threads.find(function(t){ return t.parentId === parentId; });
    if (!thread) return;
    var detailEl = document.getElementById('pfDetail');
    if (!detailEl) return;
    var firstChild = (thread.children || [])[0];
    var childInfo = firstChild ? (firstChild.firstName + ' (' + (firstChild.birthYear ? (new Date().getFullYear() - firstChild.birthYear) + ' J.' : '') + ')') : '';
    var msgsHtml = (thread.messages || []).slice().reverse().map(function(m){
      var cls = m.type === 'parent' ? 'in' : (m.type === 'system' ? 'system' : 'out');
      var sender = m.type === 'parent' ? thread.parentName.split(' ')[0] : (m.type === 'system' ? 'System' : 'Du');
      return '<div class="pf-msg ' + cls + '"><div>' + escHtml(m.body || '') + '</div><div class="pf-msg-meta">' + escHtml(sender) + ' · ' + escHtml(relTime(m.sent_at || m.created_at)) + '</div></div>';
    }).join('');
    detailEl.innerHTML =
      '<div class="pf-detail-head">'
      + '<div><div class="pf-detail-name">' + escHtml(thread.parentName) + (childInfo ? (' <em>· ' + escHtml(childInfo) + '</em>') : '') + '</div>'
      + '<div class="pf-detail-sub">' + escHtml(thread.parentEmail) + '</div></div>'
      + '<div style="display:flex;gap:6px"><button class="btn btn-ghost btn-sm" onclick="alert(\'Profil folgt\')">→ Profil</button></div>'
      + '</div>'
      + '<div class="pf-messages">' + (msgsHtml || '<div style="text-align:center;color:var(--muted);padding:40px 0">Noch keine Nachrichten.</div>') + '</div>'
      + '<div class="pf-reply">'
      + '<textarea id="pfReplyText" placeholder="Antwort schreiben..." rows="3"></textarea>'
      + '<div class="pf-reply-row">'
      + '<div class="pf-reply-meta">Geht per E-Mail an <strong>' + escHtml(thread.parentEmail) + '</strong></div>'
      + '<button class="btn btn-primary btn-sm" onclick="__pfSendReply(\'' + escHtml(parentId) + '\')">Senden</button>'
      + '</div>'
      + '</div>';

    // Mark as read
    if (thread.unread > 0) {
      var token = (window.dashboardState && window.dashboardState.token) || '';
      fetch('/api/parents/' + parentId + '/messages', { headers: { 'Authorization': 'Bearer ' + token } }).catch(function(){});
      thread.unread = 0;
      renderCounts();
      renderThreadList();
    }
  };

  window.__pfSendReply = async function(parentId) {
    var t = document.getElementById('pfReplyText');
    if (!t || !t.value.trim()) return;
    var token = (window.dashboardState && window.dashboardState.token) || '';
    try {
      var resp = await fetch('/api/parents/' + parentId + '/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ content: t.value.trim() }),
      });
      if (resp.ok) {
        t.value = '';
        await window.sectionLoaders.postfach();
        window.__pfOpen(parentId);
      } else {
        alert('Senden fehlgeschlagen.');
      }
    } catch(e) { alert('Senden fehlgeschlagen.'); }
  };

  // Nav-Badge dynamisch aus unread-count (C1)
  function updatePostfachBadge(threads) {
    var unread = (threads || []).reduce(function(acc, t){ return acc + (t.unread || 0); }, 0);
    var badge = document.getElementById('navBadgePostfach');
    if (badge) {
      if (unread > 0) { badge.textContent = unread; badge.style.display = ''; }
      else { badge.style.display = 'none'; }
    }
  }

  // Globale Funktion für initial-fetch (Page-Load) ohne Postfach-Section-Render
  window.__refreshPostfachBadge = async function() {
    var token = (window.dashboardState && window.dashboardState.token) || '';
    if (!token) return;
    try {
      var resp = await fetch('/api/messages/threads', { headers: { 'Authorization': 'Bearer ' + token } });
      var json = await resp.json();
      updatePostfachBadge(json.data || []);
    } catch(e) { /* silent */ }
  };

  window.sectionLoaders.postfach = async function() {
    var token = (window.dashboardState && window.dashboardState.token) || '';
    try {
      var resp = await fetch('/api/messages/threads', { headers: { 'Authorization': 'Bearer ' + token } });
      var json = await resp.json();
      pfState.threads = json.data || [];
      renderCounts();
      renderThreadList();
      updatePostfachBadge(pfState.threads);
      // Auto-open first
      if (pfState.threads.length && !pfState.activeParent) {
        window.__pfOpen(pfState.threads[0].parentId);
      }
    } catch(e) {
      console.error('[postfach] load failed:', e);
      var listEl = document.getElementById('pfThreadList');
      if (listEl) listEl.innerHTML = '<div style="padding:24px;text-align:center;color:var(--danger,#B8392A);font-size:13px">Konnte nicht laden.</div>';
    }
  };

  // Initial-Fetch beim Page-Load + Refresh alle 60s
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(function(){ if (window.__refreshPostfachBadge) window.__refreshPostfachBadge(); }, 1500);
    setInterval(function(){ if (window.__refreshPostfachBadge) window.__refreshPostfachBadge(); }, 60000);
  });

  // Filter clicks
  document.addEventListener('click', function(e){
    var f = e.target.closest('#pfFilters .pf-filter');
    if (!f) return;
    pfState.filter = f.getAttribute('data-filter') || 'all';
    document.querySelectorAll('#pfFilters .pf-filter').forEach(function(x){ x.classList.remove('active'); });
    f.classList.add('active');
    renderThreadList();
  });
})();
</script>

<script>
// ── Attendance API helpers ──
(function(){
  window.__attMark = async function(attendanceId, sessionId, status) {
    var s = window.dashboardState; if (!s) return;
    if (!attendanceId || !sessionId) {
      alert('Fehlende IDs — bitte Seite neu laden.');
      return;
    }
    try {
      var resp = await fetch('/api/sessions/' + sessionId + '/mark-attendance', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
        body: JSON.stringify({ attendanceId: attendanceId, status: status }),
      });
      if (!resp.ok) {
        var err = await resp.json().catch(function(){ return {}; });
        alert('Fehler: ' + (err.error || resp.status));
        return;
      }
      if (window.ukcToast) window.ukcToast('Status aktualisiert');
      // Reload anwesenheit if loader exists
      if (window.sectionLoaders && window.sectionLoaders.anwesenheit) {
        window.sectionLoaders.anwesenheit();
      }
    } catch(e) {
      alert('Netzwerkfehler beim Speichern');
    }
  };

  window.__attBulkPresent = async function(sessionId) {
    var s = window.dashboardState; if (!s) return;
    if (!confirm('Alle Teilnehmer als anwesend markieren?')) return;
    var rows = document.querySelectorAll('.att-row[data-attendance-id]');
    var promises = [];
    rows.forEach(function(r) {
      var aId = r.getAttribute('data-attendance-id');
      if (!aId) return;
      promises.push(fetch('/api/sessions/' + sessionId + '/mark-attendance', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (s.token || '') },
        body: JSON.stringify({ attendanceId: aId, status: 'attended' }),
      }));
    });
    try {
      await Promise.all(promises);
      if (window.ukcToast) window.ukcToast(rows.length + ' Teilnehmer markiert');
      if (window.sectionLoaders && window.sectionLoaders.anwesenheit) {
        window.sectionLoaders.anwesenheit();
      }
    } catch(e) {
      alert('Bulk-Update fehlgeschlagen');
    }
  };
})();
</script>

<!-- Bell loader moved to dashboard-topbar.js (single source of truth, populates .ukc-notif-list) -->
</body>
</html>
